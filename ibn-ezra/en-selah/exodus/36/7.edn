{:tier :glm-5.2, :verse 7, :comments ["<b>And the work.</b> That was already done." "<b>The mem of די.</b> It returned to all the wise men." "<b>For all the work.</b> That they needed to make." "<b>And הותר.</b> A verb form; the sense is והותר — it left over."], :book :exodus, :voice :ibn-ezra, :lang :en, :chapter 36, :notes {}, :source-witnesses [["Piotrkow, 1907-1911" "https://www.nli.org.il/he/books/NNL_ALEPH990020973480205171/NLI"]], :timestamp "2026-07-09T18:40:45.636446864Z", :translated-from :he, :model "glm-5.2"}