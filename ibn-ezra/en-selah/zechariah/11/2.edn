{:tier :glm-5.2, :verse 2, :comments ["<b>Howl, O cypress</b> — the princes of Israel." "<b>For the cedar has fallen</b> — the kings of the Hasmoneans." "<b>Oaks of Bashan</b> — those who give fruit." "<b>For the dense forest has come down</b> — for it is more esteemed than they."], :book :zechariah, :voice :ibn-ezra, :lang :en, :chapter 11, :notes {}, :source-witnesses [["Ibn Ezra on Zecharia -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/zecharya"] ["1" "http://www.daat.ac.il/daat/olam_hatanah/mefaresh.asp?book=25&perek=5&mefaresh=ezra"]], :timestamp "2026-07-09T19:46:45.547462246Z", :translated-from :he, :model "glm-5.2"}