{:tier :glm-5.2, :verse 15, :comments ["<b>לך אתננה [I will give it to you].</b> In the [construct] word, and likewise ונתן אותם על ראש השעיר [and he shall lay them on the head of the goat] (Leviticus 16:21)."], :book :genesis, :voice :ibn-ezra, :lang :en, :chapter 13, :notes {0 "Reading בדבור as referring to the construct/attached form of the word לך; alternatively may mean 'in speech.'"}, :source-witnesses [["On Your Way" "http://mobile.tora.ws/"] ["Piotrkow, 1907-1911" "https://www.nli.org.il/he/books/NNL_ALEPH990020973480205171/NLI"]], :timestamp "2026-07-09T18:44:30.452347251Z", :translated-from :he, :model "glm-5.2"}