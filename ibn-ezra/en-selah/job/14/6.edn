{:tier :glm-5.2, :verse 6, :comments ["<b>שעה</b> — relax, like: שעו מני (Job 10:20)." "<b>ויחדל</b> — let him rejoice in his חלד, like: כל יושבי חלד (Psalms 39:13), or: let him cease from anger." "<b>עד ירצה</b> — complete, like: והרצה את שבתותיה (Leviticus 26:34)."], :book :job, :voice :ibn-ezra, :lang :en, :chapter 14, :notes {}, :source-witnesses [["Ibn Ezra on Job -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/eyov/"]], :timestamp "2026-07-09T19:02:34.429738785Z", :translated-from :he, :model "glm-5.2"}