{:tier :glm-5.2, :verse 45, :comments ["The meaning of <b>for I am YHWH.</b> For I did not bring you up from the land of Egypt except to be for you as Elohim. And if you are not holy, I will not be for you as Elohim. Therefore, if it is your desire that I be for you as Elohim, be holy:"], :book :leviticus, :voice :ibn-ezra, :lang :en, :chapter 11, :notes {}, :source-witnesses [["On Your Way" "http://mobile.tora.ws/"]], :timestamp "2026-07-09T19:09:39.199256668Z", :translated-from :he, :model "glm-5.2"}