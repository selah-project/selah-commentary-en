{:tier :glm-5.2, :verse 21, :comments ["<b>Môreh</b> — written with he; its sense is with alef, the reverse of קָרָאוּן לִי מוֹרָא ('they call me terror')." "<b>Enosh</b> — from the root of וְאֱנוֹשׁ הוּא ('and he is mortal')." "<b>Selah</b> — truly."], :book :psalms, :voice :ibn-ezra, :lang :en, :chapter 9, :notes {}, :source-witnesses [["Ibn Ezra on Psalms -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/tehilim"] ["Wikisource Mikraot Gedolot" "http://en.wikisource.org/wiki/Mikraot_Gedolot/"] ["Tanakh, Venice, 1617-1619" "https://dlib.rsl.ru/viewer/01007514045#?page=4"]], :timestamp "2026-07-09T19:26:51.843755199Z", :translated-from :he, :model "glm-5.2"}