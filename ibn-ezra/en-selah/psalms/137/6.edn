{:tier :glm-5.2, :verse 6, :comments ["<b>תדבק</b> — My tongue, for the tongue utters songs." "<b>אזכרכי</b> — In speech, like ומשא ה׳ לא תזכרו עוד (Jeremiah 23:36)." "<b>אם לא אעלה</b> — The meaning is that he places the remembrance of Jerusalem at the head of his joy."], :book :psalms, :voice :ibn-ezra, :lang :en, :chapter 137, :notes {}, :source-witnesses [["Ibn Ezra on Psalms -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/tehilim"] ["Wikisource Mikraot Gedolot" "http://en.wikisource.org/wiki/Mikraot_Gedolot/"] ["Tanakh, Venice, 1617-1619" "https://dlib.rsl.ru/viewer/01007514045#?page=4"]], :timestamp "2026-07-09T19:41:56.532955735Z", :translated-from :he, :model "glm-5.2"}