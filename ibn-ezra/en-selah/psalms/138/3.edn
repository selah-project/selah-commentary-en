{:tier :glm-5.2, :verse 3, :comments ["<b>ביום, תרהיבני</b> — תחזקני (You strengthened me)." "<b>עוז</b> — pa'ol form (i.e., a noun derived from a doubled/intensive root). And behold, the word תרהיבני yields two pa'al verbs (i.e., it governs two verbal senses)."], :book :psalms, :voice :ibn-ezra, :lang :en, :chapter 138, :notes {}, :source-witnesses [["Ibn Ezra on Psalms -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/tehilim"] ["Wikisource Mikraot Gedolot" "http://en.wikisource.org/wiki/Mikraot_Gedolot/"] ["Tanakh, Venice, 1617-1619" "https://dlib.rsl.ru/viewer/01007514045#?page=4"]], :timestamp "2026-07-09T19:41:59.802650922Z", :translated-from :he, :model "glm-5.2"}