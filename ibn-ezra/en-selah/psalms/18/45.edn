{:tier :glm-5.2, :verse 45, :comments ["<b>לשמע, ישמעו</b> — like the pattern of וישמע שאול יתחברו." "<b>יכחשו לי</b> — the meaning of יכחשו לי is that they would boast in their might, against my might, as in: ברוב עזך יכחשו לך אויביך."], :book :psalms, :voice :ibn-ezra, :lang :en, :chapter 18, :notes {}, :source-witnesses [["Ibn Ezra on Psalms -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/tehilim"] ["Wikisource Mikraot Gedolot" "http://en.wikisource.org/wiki/Mikraot_Gedolot/"] ["Tanakh, Venice, 1617-1619" "https://dlib.rsl.ru/viewer/01007514045#?page=4"]], :timestamp "2026-07-09T19:27:44.791918393Z", :translated-from :he, :model "glm-5.2"}