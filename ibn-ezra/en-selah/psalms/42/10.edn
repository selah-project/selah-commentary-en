{:tier :glm-5.2, :verse 10, :comments ["<b>אומרה</b> — the reason for <b>סלעי</b> [my Rock] is that <b>סלעי</b> came first." "<b>למה שכחתני</b> — the meaning is on account of the length of the exile." "<b>למה קודר אלך</b> — like a mourner who dons dark garments."], :book :psalms, :voice :ibn-ezra, :lang :en, :chapter 42, :notes {}, :source-witnesses [["Ibn Ezra on Psalms -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/tehilim"] ["Wikisource Mikraot Gedolot" "http://en.wikisource.org/wiki/Mikraot_Gedolot/"] ["Tanakh, Venice, 1617-1619" "https://dlib.rsl.ru/viewer/01007514045#?page=4"]], :timestamp "2026-07-09T19:30:36.771668414Z", :translated-from :he, :model "glm-5.2"}