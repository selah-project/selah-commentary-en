{:tier :glm-5.2, :verse 2, :comments ["<b>My food.</b> I have explained it." "<b>For My fire.</b> I have explained it. And the sense: food for My fire, for a pleasing aroma." "<b>At its appointed time.</b> That they not offer it before morning and not delay it after evening."], :book :numbers, :voice :ibn-ezra, :lang :en, :chapter 28, :notes {}, :source-witnesses [["On Your Way" "http://mobile.tora.ws/"]], :timestamp "2026-07-09T19:19:41.765604989Z", :translated-from :he, :model "glm-5.2"}