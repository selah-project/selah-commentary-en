{:tier :glm-5.2, :verse 1, :comments ["<b>וימן</b> — like <b>זמון</b>." "<b>ויהי יונה</b> — No human being has the power to live in the belly of the fish even for an hour, all the more so [for] this number [of days], except by way of a miracle."], :book :jonah, :voice :ibn-ezra, :lang :en, :chapter 2, :notes {}, :source-witnesses [["Ibn Ezra on Jonah -- Daat" "http://www.daat.ac.il/daat/olam_hatanah/mefaresh.asp?book=19&perek=1&mefaresh=ezra"]], :timestamp "2026-07-09T19:07:01.930609795Z", :translated-from :he, :model "glm-5.2"}