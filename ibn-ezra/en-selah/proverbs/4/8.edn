{:tier :glm-5.2, :verse 8, :comments ["<b>סלסלה</b> — Raised and exalted her, from סולו to ride. The root is סלל." "<b>תכבדך</b> — She will set you in a rank of honor." "<b>כי תחבקנה</b> — To learn her always."], :book :proverbs, :voice :ibn-ezra, :lang :en, :chapter 4, :notes {}, :source-witnesses [["Ibn Ezra on Proverbs -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/mishley/"]], :timestamp "2026-07-09T19:20:59.405603214Z", :translated-from :he, :model "glm-5.2"}