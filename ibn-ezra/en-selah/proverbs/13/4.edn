{:tier :glm-5.2, :verse 4, :comments ["<b>Craves</b> — food." "<b>but his soul</b> — of the sluggard, and he has nothing." "<b>but the soul of the diligent</b> — those who bestir themselves." "<b>will be enriched</b> — will be sated with fat."], :book :proverbs, :voice :ibn-ezra, :lang :en, :chapter 13, :notes {}, :source-witnesses [["Ibn Ezra on Proverbs -- Daat" "http://www.daat.ac.il/he-il/tanach/parshanut_hamikra/full-text/eben-ezra/mishley/"]], :timestamp "2026-07-09T19:22:28.561128723Z", :translated-from :he, :model "glm-5.2"}