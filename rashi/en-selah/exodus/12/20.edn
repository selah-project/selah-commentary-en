{:tier :glm-5.2, :verse 20, :comments ["<b>Nothing leavened shall you eat.</b> A warning against eating leaven." "<b>Anything leavened.</b> To include its mixture." "<b>In all your settlements shall you eat unleavened bread.</b> This comes to teach that it must be fit for eating in all your settlements — excluding second tithe and thank-offering loaves (Mekhilta)."], :book :exodus, :voice :rashi, :lang :en, :chapter 12, :notes {}, :source-witnesses nil, :timestamp "2026-08-02T08:51:40.008571052Z", :translated-from :he, :model "glm-5.2"}