{:tier :glm-5.2, :verse 29, :comments ["<b>And all your counted ones, for all your number.</b> Everyone counted for any number that you are counted in — such as for going out and coming in to the army and for giving shekels — all those counted for all those numbers shall die, and these are <b>from twenty years old and upward;</b> to exclude the tribe of Levi, whose counted ones are not from twenty."], :book :numbers, :voice :rashi, :lang :en, :chapter 14, :notes {}, :source-witnesses nil, :timestamp "2026-08-02T09:10:52.435829541Z", :translated-from :he, :model "glm-5.2"}