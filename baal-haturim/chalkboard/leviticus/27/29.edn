{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "יחרם", :translit "yacharam", :gloss "shall be banned"} {:he "כל חרם אשר יחרם", :translit "kol cherem asher yacharam", :gloss "any ban that is banned"} {:he "לא יפדה", :translit "lo yipadeh", :gloss "he shall not be redeemed"} {:he "זובח לאלהים יחרם", :translit "zoveiach leilohim yacharam", :gloss "one who sacrifices to god shall be banned"} {:he "יחרם כל רכושו", :translit "yacharam kol rechusho", :gloss "all his property shall be banned"} {:he "מה חייבי מיתות לא נשקול ממונא ונפטריה", :translit "mah chayavei mitot lo nashkol mamonah venifatreih", :gloss "just as those liable to death — we do not take money and absolve him"} {:he "אף חייבי ממון אין לנו לפוטרו עד שישלם", :translit "af chayavei mamon ein lanu lefotro ad sheyeshalem", :gloss "so too one liable to monetary payment — we may not absolve him until he pays"} {:he "לא יפדה", :translit "lo yipadeh", :gloss "he shall not be redeemed"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["כל חרם אשר יחרם" "זובח לאלהים יחרם" "יחרם כל רכושו"]} {:kind :other, :note "hekeresh: יחרם כל רכושו juxtaposed to זובח לאלהים יחרם to teach לא יפדה applies to both"} {:kind :other, :note "kal va-chomer: from one liable to death to one liable to monetary payment"}], :frame {:text "The phrase זובח לאלהים יחרם in Leviticus 27:29 is interpreted in the Sifre as referring to one liable to the death penalty, who cannot ransom himself with money (Sifrei Zuta 27:29). Ba'al HaTurim extends this by reading יחרם כל רכושו — also in Leviticus 27:29 — as referring to one liable to a monetary ban, who likewise cannot be absolved until full payment is made. The juxtaposition of both occurrences of יחרם under the shared phrase לא יפדה teaches that neither category can be redeemed.", :sources ["Leviticus 27:29" "Sifrei Zuta 27:29"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["כל חרם אשר יחרם" "זובח לאלהים יחרם" "יחרם כל רכושו"], :by :selah, :located [{:phrase "כל חרם אשר יחרם", :refs ["Leviticus 27:28" "Leviticus 27:29"], :n 2, :lens :exact} {:phrase "זובח לאלהים יחרם", :refs ["Exodus 22:19"], :n 1, :lens :plene-insensitive} {:phrase "יחרם כל רכושו", :refs ["Ezra 10:8"], :n 1, :lens :exact}]} {:kind :other, :note "hekeresh: יחרם כל רכושו juxtaposed to זובח לאלהים יחרם to teach לא יפדה applies to both", :by :selah, :ran? false} {:kind :other, :note "kal va-chomer: from one liable to death to one liable to monetary payment", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:26.127486147Z", :model "glm-5.2"}