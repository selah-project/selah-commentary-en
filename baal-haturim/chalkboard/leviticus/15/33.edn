{:tier :glm-5.2, :verse 33, :comments [{:quotes [{:he "ולאיש", :translit "v'la'ish", :gloss "and for a man"} {:he "ולאיש שתים מכסות", :translit "v'la'ish shtayim m'chasot", :gloss "and for a man two coverings"} {:he "ולאיש בושת בן שאול", :translit "v'la'ish bushet ben sha'ul", :gloss "and for a man shame of Saul"} {:he "ולאיש אשר ישכב", :translit "v'la'ish asher yishkav", :gloss "and for a man who lies"} {:he "בושת", :translit "bushet", :gloss "shame"} {:he "ולאיש בושת", :translit "v'la'ish bushet", :gloss "and for a man shame"} {:he "ולאיש שתים מכסות", :translit "v'la'ish shtayim m'chasot", :gloss "and for a man two coverings"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ולאיש שתים מכסות" "ולאיש בושת בן שאול" "ולאיש אשר ישכב"]} {:kind :other, :note "Wordplay linking the phrase ולאיש to בושת (shame), then reading ולאיש שתים מכסות as 'and for a man — two coverings,' describing R. Eliezer's modesty practice of alternating uncovering and covering a handbreadth."}], :frame {:text "Rabbi Eliezer's practice of extreme modesty is recorded in the Talmud, where he is described as never exposing his body. The phrase 'uncover a handbreadth and cover a handbreadth' refers to changing garments in a manner so rapid that one is never fully exposed, and the comparison to one seized by a demon appears in Yalkut Shimoni on 2 Samuel 10:4 in connection with the shame of Hanun's treatment of David's envoys.", :sources ["Yalkut Shimoni 2 Samuel 10:4"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ולאיש שתים מכסות" "ולאיש בושת בן שאול" "ולאיש אשר ישכב"], :by :selah, :located [{:phrase "ולאיש שתים מכסות", :refs ["Ezekiel 1:23"], :n 1, :lens :exact} {:phrase "ולאיש בושת בן שאול", :refs ["2 Samuel 2:15"], :n 1, :lens :plene-insensitive} {:phrase "ולאיש אשר ישכב", :refs ["Leviticus 15:33"], :n 1, :lens :exact}]} {:kind :other, :note "Wordplay linking the phrase ולאיש to בושת (shame), then reading ולאיש שתים מכסות as 'and for a man — two coverings,' describing R. Eliezer's modesty practice of alternating uncovering and covering a handbreadth.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:39.971697019Z", :model "glm-5.2"}