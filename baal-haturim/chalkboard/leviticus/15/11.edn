{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "שטף", :translit "shetef", :gloss "flow / flood"} {:he "וחלף", :translit "ve-chalaf", :gloss "and it passed / swept on"} {:he "שטף ועבר", :translit "shetef ve-avar", :gloss "flood and passed"} {:he "שזב צריך מים חיים", :translit "sh-zav tzarikh mayim chayim", :gloss "a zav requires living water"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["שטף" "וחלף"]} {:kind :gematria, :a "שטף", :b "ועבר"} {:kind :other, :note "Second occurrence of שטף identified as וחלף in Judah"}], :frame {:text "Leviticus 15:13 states that a zav, after his zav-discharge ceases, must immerse in מים חיים — 'living water' — meaning a natural spring or river, not a drawn-water mikveh. Leviticus 15:11 uses the word שטף in describing the zav's discharge. The word שטף appears again in Isaiah 8:8, וחלף ביהודה שטף, describing waters sweeping through Judah, which Onkelos renders with the Aramaic שטף ועבר. By equating these two שטף instances, Ba'al HaTurim links the zav's שטף-discharge to the requirement of living water.", :sources ["Leviticus 15:13" "Leviticus 15:11" "Isaiah 8:8" "Onkelos Isaiah 8:8"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["שטף" "וחלף"], :by :selah, :located [{:phrase "שטף", :refs ["Leviticus 15:11" "Isaiah 8:8" "Ezekiel 13:13"], :n 3, :lens :exact} {:phrase "וחלף", :refs ["Isaiah 8:8" "Psalms 90:6"], :n 2, :lens :exact}]} {:kind :gematria, :a "שטף", :a-value 389, :b "ועבר", :b-value 278, :lens :standard, :by :selah, :equal? false} {:kind :other, :note "Second occurrence of שטף identified as וחלף in Judah", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:35.347444466Z", :model "glm-5.2"}