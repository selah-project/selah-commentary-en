{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "וינחוהו", :translit "vayinachuhu", :gloss "and they placed him"} {:he "ויניחוהו במשמר", :translit "vaynichuhu bamishmar", :gloss "and they placed him in custody"} {:he "ויניחוהו מחוץ לעיר", :translit "vaynichuhu michutz la'ir", :gloss "and they placed him outside the city"} {:he "וינחוהו במשמר", :translit "vayinachuhu bamishmar", :gloss "and they placed him in custody"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויניחוהו במשמר" "ויניחוהו מחוץ לעיר"]}], :frame {:text "The word ויניחוהו appears twice in the Masoretic corpus, once here regarding the blasphemer placed in custody (Leviticus 24:12) and once regarding Lot being led outside the city (Genesis 19:16). Ba'al HaTurim further notes the wordplay: the phrase וינחוהו במשמר ('and they placed him in custody') echoes לשמרו ('to guard him'), since the root משמר shares the root שמר meaning to guard or protect.", :sources ["Leviticus 24:12" "Genesis 19:16"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויניחוהו במשמר" "ויניחוהו מחוץ לעיר"], :by :selah, :located [{:phrase "ויניחוהו במשמר", :refs ["Leviticus 24:12"], :n 1, :lens :plene-insensitive} {:phrase "ויניחוהו מחוץ לעיר", :refs ["Genesis 19:16"], :n 1, :lens :plene-insensitive}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:19.321449255Z", :model "glm-5.2"}