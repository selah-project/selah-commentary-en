{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "ואפית אותה", :translit "v'afita otah", :gloss "and you shall bake it"} {:he "תבה פרוצה", :translit "tivah p'rutza", :gloss "open box"} {:he "ספינה רקדת", :translit "s'finah rak'det", :gloss "dancing ship"} {:he "בלחם הפנים", :translit "balechem hapanim", :gloss "in the Bread of the Presence"} {:he "כנגד י\"ב מזלות", :translit "k'neged y\"b maz'lot", :gloss "corresponding to 12 zodiac signs"}], :mechanisms [{:kind :gematria, :a "ואפית אותה", :b "תבה פרוצה"} {:kind :gematria, :a "ואפית אותה", :b "ספינה רקדת"}], :frame {:text "The Bread of the Presence consists of 12 loaves arranged in two stacks of six; Leviticus 24:5–6 specifies one tenth of an ephah per loaf, yielding 24 tenths total. The twelve loaves correspond to the twelve tribes of Israel (Leviticus Rabbah 5:9). The twelve zodiac signs rotating through the hours of the day reflect the cosmological scheme described in Sefer Yetzirah 5:2, which maps the twelve diagonal letters to the twelve months and twelve organs. The idea that the world's ongoing existence depends on Israel's merit is rooted in Jeremiah 33:25–26, where God's covenant with day, night, and the host of heaven is linked to His covenant with the seed of Jacob.", :sources ["Leviticus 24:5–6" "Leviticus Rabbah 5:9" "Sefer Yetzirah 5:2" "Jeremiah 33:25–26"]}}], :arithmetic [{:kind :gematria, :a "ואפית אותה", :a-value 909, :b "תבה פרוצה", :b-value 788, :lens :standard, :by :selah, :equal? false} {:kind :gematria, :a "ואפית אותה", :a-value 909, :b "ספינה רקדת", :b-value 909, :lens :standard, :by :selah, :equal? true}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:18.707290738Z", :model "glm-5.2"}