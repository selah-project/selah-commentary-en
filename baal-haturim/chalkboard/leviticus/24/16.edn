{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "בנקבו שם", :translit "b'nokvo sheim", :gloss "when he pronounces the Name"} {:he "ואיש כי יכה", :translit "ve'ish ki yakeh", :gloss "and a man if he strikes"} {:he "יוסי את יוסי", :translit "Yosi et Yosi", :gloss "Yosi [strikes] Yosi"} {:he "איש כי יכה", :translit "ish ki yakeh", :gloss "a man if he strikes"} {:he "מקלל", :translit "mekalel", :gloss "one who curses"} {:he "בהר סיני", :translit "be'har Sinai", :gloss "at Mount Sinai"} {:he "כאשר צוה ה' את משה", :translit "ka'asher tzivah Hashem et Moshe", :gloss "as the LORD commanded Moses"} {:he "סקל יסקל או ירה יירה", :translit "sakol yissakel o yoreh yiyareh", :gloss "he shall surely be stoned or shot"}], :mechanisms [{:kind :other, :note "Semikhah parshiyot: adjacency of בנקבו שם to ואיש כי יכה"} {:kind :other, :note "Wordplay: יכה (strikes) read as hinting to יכה יוסי את יוסי"} {:kind :other, :note "Semikhah parshiyot: adjacency of מקלל to section beginning בהר סיני"} {:kind :other, :note "Semikhah parshiyot: adjacency of כאשר צוה ה' את משה to בהר סיני"} {:kind :other, :note "Gezeirah shavah: סקל יסקל או ירה יירה from Lev 24:21 linked back to Sinai legislation"}], :frame {:text "The phrase 'יוסי את יוסי' references the talmudic discussion where R. Yosi b. R. Hanina infers from the doubled language of נקב (Leviticus 24:16) that there are two forms of cursing God: with an explicit divine Name and with a euphemism (Sanhedrin 56a). The claim that striking an Israelite is likened to striking the Shekhinah draws on the rabbinic principle that the Jewish people are identified with God's presence, expressed in the dictum 'he who touches them touches the apple of His eye' (Zechariah 2:12), as applied in Shabbat 118b and expounded in Midrash Tehillim. The larger teaching that the blasphemer cursed the Name he heard at Sinai reflects the tradition that at Sinai all Israel experienced direct divine revelation (Deuteronomy 4:35, 5:19), while the specific penalties of stoning and shooting appear in Leviticus 24:23 and Numbers 15:36.", :sources ["Sanhedrin 56a" "Shabbat 118b" "Zechariah 2:12" "Deuteronomy 4:35" "Deuteronomy 5:19" "Leviticus 24:23" "Numbers 15:36"]}}], :arithmetic [{:kind :other, :note "Semikhah parshiyot: adjacency of בנקבו שם to ואיש כי יכה", :by :selah, :ran? false} {:kind :other, :note "Wordplay: יכה (strikes) read as hinting to יכה יוסי את יוסי", :by :selah, :ran? false} {:kind :other, :note "Semikhah parshiyot: adjacency of מקלל to section beginning בהר סיני", :by :selah, :ran? false} {:kind :other, :note "Semikhah parshiyot: adjacency of כאשר צוה ה' את משה to בהר סיני", :by :selah, :ran? false} {:kind :other, :note "Gezeirah shavah: סקל יסקל או ירה יירה from Lev 24:21 linked back to Sinai legislation", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:26.749312380Z", :model "glm-5.2"}