{:tier :glm-5.2, :verse 1, :comments [{:quotes [{:he "אם לוא יגיד", :translit "im lo yagid", :gloss "if he does not tell"} {:he "אם לו יגיד", :translit "im lo yagid", :gloss "if to him he tells"} {:he "ונשא עונו", :translit "venasa ono", :gloss "and he bears his iniquity"}], :mechanisms [{:kind :other, :note "Plene spelling of לוא (with vav) read as לו ('to him') by reinterpreting the same consonants."}], :frame {:text "Leviticus 5:1 obligates a witness who withholds testimony to bear his iniquity. The plene spelling of לוא with a vav allows it to be repointed as לו ('to him'), yielding the sense 'if he has told him' — that is, once a witness has already discharged his obligation to inform the designated party, he need not repeat his testimony.", :sources ["Leviticus 5:1"]}}], :arithmetic [{:kind :other, :note "Plene spelling of לוא (with vav) read as לו ('to him') by reinterpreting the same consonants.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 5, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:08.639032663Z", :model "glm-5.2"}