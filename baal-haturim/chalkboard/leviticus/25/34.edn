{:tier :glm-5.2, :verse 34, :comments [{:quotes [{:he "ושדה", :translit "u'sdeh", :gloss "and the field"} {:he "ושדי תרומות", :translit "u'sdei t'rumot", :gloss "and fields of contributions"} {:he "ושדה מגרש עריהם לא ימכר", :translit "u'sdeh m'gresh areihem lo yimaker", :gloss "and the field of the open land of their cities shall not be sold"} {:he "אל טל ואל מטר", :translit "el tal v'el matar", :gloss "not dew and not rain"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ושדה" "ושדי תרומות"]}], :frame {:text "The phrase ושדה מגרש עריהם לא ימכר appears in the context of Levitical cities, and is interpreted in Arakhin as 'it shall not be changed' — meaning the Levitical pasturelands may not be converted to a different use. Ba'al HaTurim links this to another rare phrase, ושדי תרומות, suggesting it too is permanent and unalterable, as expressed by אל טל ואל מטר, a phrase drawn from its biblical context where the earth is cursed to withhold dew and rain.", :sources ["Arakhin" "Leviticus 25:34" "2 Samuel 1:21"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ושדה" "ושדי תרומות"], :by :selah, :located [{:phrase "ושדה", :refs ["Leviticus 25:34" "Jeremiah 35:9" "Nehemiah 5:16"], :n 3, :lens :exact} {:phrase "ושדי תרומות", :refs ["2 Samuel 1:21"], :n 1, :lens :plene-insensitive}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:42.333734741Z", :model "glm-5.2"}