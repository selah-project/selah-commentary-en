{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "ענבי", :translit "invei", :gloss "grapes of"} {:he "ב' במסורה", :translit "bet b'masorah", :gloss "two in the Masorah"} {:he "ענבימו ענבי רוש", :translit "inveimo invei rosh", :gloss "his grapes are grapes of poison"} {:he "בשביעית", :translit "b'shvi'it", :gloss "in the seventh year"} {:he "גלו ישראל", :translit "galu yisrael", :gloss "Israel was exiled"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ענבי"]} {:kind :other, :note "The second occurrence of ענבי is in Hosea 10:4: ענבימו ענבי רוש."} {:kind :other, :note "Wordplay links pruning in shemittah to the Hosea phrase; Israel's exile came in a seventh year."}], :frame {:text "The phrase ענבי רוש ('grapes of poison') appears in Hosea 10:4. The wordplay in Hosea 10:4 was read as a rebuke of Israel's covenant violations (Hosea 10:4). Leviticus 26:34–35 and 26:43 state that the land will enjoy its sabbatical years during Israel's exile, compensating for the sabbatical years Israel failed to observe. Leviticus Rabbah 17:9 derives from these verses that Israel's exile was tied to neglect of sabbatical-year laws.", :sources ["Hosea 10:4" "Leviticus 26:34-35" "Leviticus 26:43" "Leviticus Rabbah 17:9"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ענבי"], :by :selah, :located [{:phrase "ענבי", :refs ["Leviticus 25:5" "Deuteronomy 32:32"], :n 2, :lens :exact}]} {:kind :other, :note "The second occurrence of ענבי is in Hosea 10:4: ענבימו ענבי רוש.", :by :selah, :ran? false} {:kind :other, :note "Wordplay links pruning in shemittah to the Hosea phrase; Israel's exile came in a seventh year.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:26.394254222Z", :model "glm-5.2"}