{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "איש את עמיתו ויראת", :translit "ish et amito v'yirat", :gloss "a man his fellow and you shall fear"} {:he "ס\"ת", :translit "sa\"t", :gloss "end-letters of words"} {:he "שתות", :translit "shitot", :gloss "a sixth"} {:he "אונאה", :translit "ona'ah", :gloss "oppression"} {:he "שתות", :translit "shitot", :gloss "a sixth"}], :mechanisms [{:kind :sofei-tevot, :phrase "איש את עמיתו ויראת", :spells "שתות"}], :frame {:text "The law of ona'ah establishes that overcharging by up to one-sixth of an item's value constitutes fraud and the sale can be voided (Bava Metzia 49b). The phrase 'a man his fellow and you shall fear' warns against verbal wrongdoing in business dealings.", :sources ["Bava Metzia 49b" "Leviticus 25:17"]}} {:quotes [{:he "אני ה' אלהיכם", :translit "ani Hashem Elokeichem", :gloss "I am YHWH your Elohim"} {:he "ועשיתם את חקותי", :translit "va'asitem et chukotai", :gloss "and you shall do My statutes"} {:he "יעשה המצות לשם פועלם", :translit "ya'aseh ha-mitzvot l'shem po'alam", :gloss "one who performs the commandments for the sake of their Author"}], :mechanisms [{:kind :other, :note "Semikhah: the phrase 'and you shall do My statutes' (Leviticus 25:18) is read as a sequel to 'I am YHWH your Elohim' (Leviticus 25:17)."}], :frame {:text "The principle that commandments should be performed for the sake of their Author is articulated in multiple rabbinic sources (Pesachim 50b; Bereshit Rabbah 1:1, Rashi citing it on Genesis 1:1). The adjacency of 'I am YHWH your Elohim' to 'and you shall do My statutes' signals that the performance of commandments should be motivated by devotion to the One who commanded them.", :sources ["Pesachim 50b" "Bereshit Rabbah 1:1" "Leviticus 25:17" "Leviticus 25:18"]}}], :arithmetic [{:kind :sofei-tevot, :phrase "איש את עמיתו ויראת", :spells "שתות", :letters ["ש" "ת" "ו" "ת"], :by :selah, :order :in-order} {:kind :other, :note "Semikhah: the phrase 'and you shall do My statutes' (Leviticus 25:18) is read as a sequel to 'I am YHWH your Elohim' (Leviticus 25:17).", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:37.903440188Z", :model "glm-5.2"}