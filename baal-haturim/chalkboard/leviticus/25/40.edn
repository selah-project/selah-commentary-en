{:tier :glm-5.2, :verse 40, :comments [{:quotes [{:he "כשכיר", :translit "k'sakhir", :gloss "like a hired worker"} {:he "עד ירצה כשכיר יומו", :translit "ad yirtzeh k'sakhir yomo", :gloss "until he desires, a hired worker of his day"} {:he "כשכיר יהיה עמך", :translit "k'sakhir yihyeh imakh", :gloss "like a hired worker he shall be with you"} {:he "ביומו", :translit "b'yomo", :gloss "in his day"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["כשכיר" "עד ירצה כשכיר יומו"]}], :frame {:text "Mishnah Bava Metzi'a 7:6 states that just as the employer can retract, so too the hired worker can retract, and therefore a worker who retracts at midday loses only the value of his morning labor. The word כשכיר in Leviticus 25:40, governing the treatment of an indentured Hebrew servant, links his standing to that of an ordinary day laborer, who per Mishnah Bava Metzi'a 7:6 may walk off the job even at midday.", :sources ["Mishnah Bava Metzi'a 7:6" "Leviticus 25:40"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["כשכיר" "עד ירצה כשכיר יומו"], :by :selah, :located [{:phrase "כשכיר", :refs ["Leviticus 25:40" "Leviticus 25:53" "Job 14:6"], :n 3, :lens :exact} {:phrase "עד ירצה כשכיר יומו", :refs ["Job 14:6"], :n 1, :lens :exact}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:43.147256958Z", :model "glm-5.2"}