{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "לא תעשה חמץ", :translit "lo ta'aseh chametz", :gloss "you shall not make leavened"} {:he "יצר הרע", :translit "yetzer ha-ra", :gloss "the evil inclination"} {:he "שאור", :translit "se'or", :gloss "leaven"} {:he "דבש", :translit "devash", :gloss "honey"}], :mechanisms [{:kind :other, :note "Analogy: leaven expands imperceptibly like the evil inclination; honey symbolizes seductive sweetness."}], :frame {:text "The comparison of the evil inclination to leaven is found at Berakhot 17a and is developed at Shabbat 105b. Rabbi Alexandri's prayer at Berakhot 17a asks God to save him from the evil inclination, which is likened to dough that ferments. Proverbs 25:16 and 25:27 warn against excess honey, read as symbolic of overindulgence.", :sources ["Berakhot 17a" "Shabbat 105b" "Proverbs 25:16" "Proverbs 25:27"]}}], :arithmetic [{:kind :other, :note "Analogy: leaven expands imperceptibly like the evil inclination; honey symbolizes seductive sweetness.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 2, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:49.063718210Z", :model "glm-5.2"}