{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "אני ה' מקדשכם", :translit "ani ha' mekadishkhem", :gloss "I am YHWH who sanctifies you"} {:he "אביו ואמו", :translit "aviv v'imo", :gloss "his father and his mother"}], :mechanisms [{:kind :other, :note "smikhut of verse segments: 'I am YHWH who sanctifies you' juxtaposed to 'his father and his mother' in the preceding verse"}], :frame {:text "The Talmud (Kiddushin 30b) states that there are three partners in a person: the Holy One, his father, and his mother. The Ba'al HaTurim reads the juxtaposition of 'I am YHWH who sanctifies you' to 'a man, his father and his mother' in the preceding verse as an allusion to this teaching.", :sources ["Kiddushin 30b"]}}], :arithmetic [{:kind :other, :note "smikhut of verse segments: 'I am YHWH who sanctifies you' juxtaposed to 'his father and his mother' in the preceding verse", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:32.095219400Z", :model "glm-5.2"}