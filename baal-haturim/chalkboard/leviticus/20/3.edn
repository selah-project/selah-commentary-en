{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "ואני אתן", :translit "v'ani etein", :gloss "and I will give/set"} {:he "ואני אתן את שכרך", :translit "v'ani etein et s'kharekha", :gloss "and I will give your reward"} {:he "ואני אתן שכרך", :translit "v'ani etein s'kharekha", :gloss "and I will give your reward"}], :mechanisms [{:kind :other, :note "Two occurrences of ואני אתן in the verse, each carrying a different sense of divine recompense"}], :frame {:text "The phrase ואני אתן appears twice in this verse; Ba'al HaTurim reads each occurrence as a distinct mode of divine giving. The second sense — that sins are reckoned as merits when one repents — reflects the rabbinic principle articulated at Yoma 86b: זדונות נעשות לו כזכיות, based on the doubling of 'love' in Ezekiel 18:22 (ולא יזכר ... במעשיו).", :sources ["Yoma 86b" "Ezekiel 18:22"]}}], :arithmetic [{:kind :other, :note "Two occurrences of ואני אתן in the verse, each carrying a different sense of divine recompense", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:30.741373031Z", :model "glm-5.2"}