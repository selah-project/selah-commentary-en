{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "קרבו", :translit "kirbu", :gloss "they drew near"} {:he "ב' טעמים", :translit "b'te'amim", :gloss "two accents/marks"} {:he "לא קרבו אליהם להיכל", :translit "lo kirbu aleihem la'heikhal", :gloss "they did not draw near to them into the Sanctuary"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["קרבו"]}], :frame {:text "The two cantillation marks on קרבו indicate that the bearers did not approach the bodies of Nadab and Abihu inside the Sanctuary itself. Rather, they used iron implements to drag the corpses out from afar, so as not to enter the sacred space where the divine presence had descended. The detail that an iron spear or tool was used to remove the bodies is found in Sifrei and referenced in Zevahim. The reluctance to enter the Sanctuary is itself grounded in the warning of Leviticus 10:3.", :sources ["Leviticus 10:3" "Sifrei Numbers 60" "Zevahim 23a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["קרבו"], :by :selah, :located [{:phrase "קרבו", :refs ["Exodus 12:9" "Exodus 16:9" "Exodus 29:17" "Exodus 32:27" "Leviticus 10:4" "Deuteronomy 31:14" "Joshua 10:24" "1 Kings 2:7"], :n 23, :lens :exact}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:26.413073520Z", :model "glm-5.2"}