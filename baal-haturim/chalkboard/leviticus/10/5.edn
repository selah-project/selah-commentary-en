{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "וישאום", :translit "v'yisa'um", :gloss "and they carried them"} {:he "וישאום בכתנותם", :translit "v'yisa'um b'chutnoteihem", :gloss "and they carried them in their tunics"} {:he "וישאום בני קיש אחיהם", :translit "v'yisa'um b'nei kish acheihem", :gloss "and they carried them, the sons of Kish their brothers"} {:he "הנושא אשה", :translit "ha'nosei ishah", :gloss "one who takes a wife"} {:he "וכסותה לא יגרע", :translit "u'ch'sutah lo yigra", :gloss "and her clothing he shall not diminish"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וישאום בכתנותם" "וישאום בני קיש אחיהם"]} {:kind :other, :note "Wordplay: וישאום read as 'they married them' (from נשא), linking to the obligation of clothing a wife."}], :frame {:text "The phrase וכסותה לא יגרע appears in Exodus 21:10 as part of the laws of a Hebrew maidservant: a husband must not diminish her clothing. The Talmud (Ketubot 54a) derives from this verse that a husband is obligated to provide clothing for his wife. Ba'al HaTurim reads וישאום in both occurrences as though the root is נ-ש-א ('to marry'), so that 'they carried them' yields 'they married them,' and since marrying obligates a husband to clothe his wife, the verse fittingly adds 'in their tunics.'", :sources ["Exodus 21:10" "Ketubot 54a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וישאום בכתנותם" "וישאום בני קיש אחיהם"], :by :selah, :located [{:phrase "וישאום בכתנותם", :refs ["Leviticus 10:5"], :n 1, :lens :plene-insensitive} {:phrase "וישאום בני קיש אחיהם", :refs ["1 Chronicles 23:22"], :n 1, :lens :exact}]} {:kind :other, :note "Wordplay: וישאום read as 'they married them' (from נשא), linking to the obligation of clothing a wife.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:30.174981559Z", :model "glm-5.2"}