{:tier :glm-5.2, :verse 1, :comments [{:quotes [{:he "אשר", :translit "asher", :gloss "which/that"} {:he "לא צוה", :translit "lo tzavah", :gloss "[He] did not command"} {:he "לא צוה להביא אש זרה", :translit "lo tzavah lehavi esh zarah", :gloss "[He] did not command to bring strange fire"} {:he "לא צוה שלא להביאו", :translit "lo tzavah shelo lehavi'o", :gloss "[He] did not command not to bring it"} {:he "אשר צוי של לא", :translit "asher tzavui shel lo", :gloss "which is a command of 'lo'"} {:he "צוה אותם", :translit "tzavah otam", :gloss "[He] commanded them"} {:he "ולכל צבא השמים אשר לא צויתי", :translit "ulechol tzva ha-shamayim asher lo tzaviti", :gloss "and to all the host of heaven which I did not command"}], :mechanisms [{:kind :other, :note "Lexical parallel: Leviticus 10:1 'asher lo tzavah' is read like Deuteronomy 17:3 'asher lo tzaviti' — 'asher' meaning 'which' (i.e., 'concerning which He commanded them not')"}], :frame {:text "Leviticus 10:1 states that Nadav and Avihu offered fire 'asher lo tzavah' — literally 'which He did not command.' Leviticus 10:1 reports their death as a result. Deuteronomy 17:3 uses the identical phrase 'asher lo tzaviti' in the context of worshipping the host of heaven, 'which I did not command.' Ba'al HaTurim reads the word 'lo' in Leviticus 10:1 as the object marker meaning 'to him' or 'them' rather than the negative particle 'not,' yielding 'which He commanded them,' parallel to the usage in Deuteronomy 17:3.", :sources ["Leviticus 10:1" "Deuteronomy 17:3"]}}], :arithmetic [{:kind :other, :note "Lexical parallel: Leviticus 10:1 'asher lo tzavah' is read like Deuteronomy 17:3 'asher lo tzaviti' — 'asher' meaning 'which' (i.e., 'concerning which He commanded them not')", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:25.330205899Z", :model "glm-5.2"}