{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "וידום", :translit "vayyidom", :gloss "and he was silent"} {:he "וידום אהרן", :translit "vayyidom aharon", :gloss "and Aaron was silent"} {:he "וידום השמש", :translit "vayyidom hashamesh", :gloss "and the sun was silent"} {:he "מאורות לוקין על אב בית דין שמת", :translit "me'orot lokin al av bet din shemet", :gloss "the luminaries are stricken on account of an av bet din who died"} {:he "ובני אהרן היו אב ב\"ד", :translit "uvnei aharon hayu av bet din", :gloss "and the sons of Aaron were av bet din"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וידום אהרן" "וידום השמש"]}], :frame {:text "Joshua 10:13 states that the sun stood still (וידום השמש) in the midst of heaven. The rabbis interpret this event as a sign of mourning: the luminaries are stricken on account of the death of an av bet din, who was none other than Joshua himself (Shabbat 105b). By linking the identical rare word וידום in Leviticus 10:3 to Joshua 10:13, the comment applies the same principle to Aaron's silence after the death of his sons — their death likewise extinguished the luminaries, because they held the rank of av bet din.", :sources ["Joshua 10:13" "Shabbat 105b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וידום אהרן" "וידום השמש"], :by :selah, :located [{:phrase "וידום אהרן", :refs ["Leviticus 10:3"], :n 1, :lens :plene-insensitive} {:phrase "וידום השמש", :refs ["Joshua 10:13"], :n 1, :lens :plene-insensitive}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:36.689935381Z", :model "glm-5.2"}