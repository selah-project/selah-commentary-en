{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "בבן בקר כתיב וקרבו וכרעיו", :translit "b'ben bakar katuv v'kirbo v'chrasav", :gloss "in cattle it is written 'its innards and its legs'"} {:he "ובצאן כתיב והקרב והכרעים", :translit "uvtzon katuv v'hakerev v'hachra'ayim", :gloss "and in sheep it is written 'the innards and the legs'"} {:he "בתנא דבי אליהו", :translit "b'tana d'vei eliyahu", :gloss "in Tanna deBei Eliyahu"} {:he "בבן הבקר לא כתיב אלא והקטיר", :translit "b'ben habakar lo katuv ela v'hiktir", :gloss "in cattle it is not written except 'and he shall burn'"} {:he "ובצאן כתיב והקריב והקטיר", :translit "uvtzon katuv v'hikriv v'hiktir", :gloss "and in sheep it is written 'and he shall bring and he shall burn'"} {:he "בבן בקר לא כתיב הוא", :translit "b'ben bakar lo katuv hu", :gloss "in cattle 'hu' is not written"} {:he "ובצאן ובעוף כתיב הוא", :translit "uvtzon u've'of katuv hu", :gloss "and in sheep and in bird 'hu' is written"} {:he "בבן בקר כתיב לרצונו", :translit "b'ben bakar katuv l'ratsono", :gloss "in cattle it is written 'for acceptance'"} {:he "ולא בצאן ובעוף", :translit "v'lo batzon uva'of", :gloss "and not in sheep and bird"}], :mechanisms [{:kind :other, :note "Spelling comparison: וקרבו וכרעיו (cattle, Lev 1:9) vs והקרב והכרעים (sheep, Lev 1:13) — suffix vs definite article forms"} {:kind :other, :note "Verb presence/absence: cattle has only והקטיר (Lev 1:9), sheep has והקריב והקטיר (Lev 1:13-15)"} {:kind :other, :note "Presence/absence of הוא: absent in cattle (Lev 1:9), present in bird offering (Lev 1:15) — limiting the bird offering to its own category"} {:kind :other, :note "Presence/absence of לרצונו: present in cattle (Lev 1:4), absent in sheep and bird offerings"}], :frame {:text "Ba'al HaTurim cites Tanna deBei Eliyahu for a zoological distinction: small animals move their legs diagonally (like warp and woof) whereas large animals move legs on the same side together, which affects their digestion. The word הוא in the bird offering section (Leviticus 1:15) is understood midrashically as a limiting exclusion, so that if one offered a bird using the procedures of cattle it would be invalid. The phrase לרצונו appears at Leviticus 1:4 for the cattle offering. The tannaaitic/midrashic method of comparing slight verbal differences between parallel sacrificial passages is characteristic of Torat Kohanim (Sifra) on Leviticus chapter 1.", :sources ["Tanna Debei Eliyahu" "Leviticus 1:4" "Leviticus 1:9" "Leviticus 1:13" "Leviticus 1:15" "Sifra Vayikra 1"]}}], :arithmetic [{:kind :other, :note "Spelling comparison: וקרבו וכרעיו (cattle, Lev 1:9) vs והקרב והכרעים (sheep, Lev 1:13) — suffix vs definite article forms", :by :selah, :ran? false} {:kind :other, :note "Verb presence/absence: cattle has only והקטיר (Lev 1:9), sheep has והקריב והקטיר (Lev 1:13-15)", :by :selah, :ran? false} {:kind :other, :note "Presence/absence of הוא: absent in cattle (Lev 1:9), present in bird offering (Lev 1:15) — limiting the bird offering to its own category", :by :selah, :ran? false} {:kind :other, :note "Presence/absence of לרצונו: present in cattle (Lev 1:4), absent in sheep and bird offerings", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:57.400657037Z", :model "glm-5.2"}