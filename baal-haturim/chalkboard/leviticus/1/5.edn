{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "בן בקר", :translit "ben bakar", :gloss "son of cattle"} {:he "עולה", :translit "olah", :gloss "burnt offering"} {:he "שנ\"ד", :translit "shin nun dalet", :gloss "shin-nun-dalet (abbreviation)"}], :mechanisms [{:kind :sofei-tevot, :phrase "עולה שנה דקדיש", :spells "שנ\"ד"}], :frame {:text "The phrase שנה דקדיש, 'a year old, it is sanctified,' appears in the Talmud as a mnemonic for the rule that an ox brought as a burnt offering must be in its first year, derived from the phrase בן בקר in Leviticus 1:5.", :sources ["Zevachim 24b" "Leviticus 1:5"]}} {:quotes [{:he "וזרקו את הדם", :translit "vezaraku et ha-dam", :gloss "and they shall throw the blood"} {:he "את הדם", :translit "et ha-dam", :gloss "et the blood"} {:he "את דמו", :translit "et damo", :gloss "et his blood"} {:he "דמו", :translit "damo", :gloss "his blood"} {:he "דמו של צאן", :translit "damo shel tzon", :gloss "blood of sheep"} {:he "דם האדם", :translit "dam ha-adam", :gloss "blood of man"} {:he "כאלו הקריב דמו", :translit "ke'ilu hikriv damo", :gloss "as though he offered his blood"}], :mechanisms [{:kind :other, :note "Contrast between את הדם for cattle and את דמו for sheep; the possessive suffix on דמו enables reading 'his [the offerer's] blood.'"}], :frame {:text "Leviticus 1:5 uses את הדם for cattle, while Leviticus 1:11 uses ואת דמו for the sheep. The possessive suffix דמו is read both as 'its blood' and as 'his blood,' yielding the interpretation that the offerer's own blood is at stake, so that the verse says the priest makes atonement for the person on their behalf (Leviticus 1:4–5).", :sources ["Leviticus 1:5" "Leviticus 1:11" "Leviticus 1:4"]}}], :arithmetic [{:kind :sofei-tevot, :phrase "עולה שנה דקדיש", :spells "שנ\"ד", :letters ["ה" "ה" "ש"], :by :selah, :order :mismatch} {:kind :other, :note "Contrast between את הדם for cattle and את דמו for sheep; the possessive suffix on דמו enables reading 'his [the offerer's] blood.'", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:52.647280427Z", :model "glm-5.2"}