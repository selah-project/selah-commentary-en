{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "ונודעה", :translit "venod'ah", :gloss "and it shall be known"} {:he "ונודעה החטאת", :translit "venod'ah hachatat", :gloss "and the sin-offering shall be known"} {:he "ונודעה יד ה' את עבדיו", :translit "venod'ah yad Hashem et avadav", :gloss "and the hand of the LORD shall be made known to His servants"} {:he "וזעם את אויביו", :translit "veza'am et oyvav", :gloss "and His indignation toward His enemies"}], :mechanisms [{:kind :other, :note "Gezerah shavah linking ונודעה in our verse to the identical word in Isaiah 66:14"}], :frame {:text "Isaiah 66:14 reads: 'ונודעה יד ה' את עבדיו וזעם את אויביו' — 'the hand of the LORD shall be known to His servants, and His indignation toward His enemies.' Ba'al HaTurim reads this verse as reward and punishment: God's servants are those who bring their obligatory offerings; His enemies are those who shirk them. The word ונודעה appears with the definite article (ה' הידיעה) here in Leviticus 4:14 and without it in Isaiah 66:14, and he flags this with the notation ב'.", :sources ["Isaiah 66:14" "Leviticus 4:14"]}} {:quotes [{:he "והביאו אותו", :translit "vehevi'u oto", :gloss "and they shall bring it"} {:he "והביאו אבנים אחרות", :translit "vehevi'u avanim acherot", :gloss "and they shall bring other stones"} {:he "והביאו בניך בחוצן", :translit "vehevi'u banecha bechotzan", :gloss "and they shall bring your sons in the bosom"} {:he "והביאו את כל אחיכם", :translit "vehevi'u et kol acheichem", :gloss "and they shall bring all your brothers"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["והביאו אותו" "והביאו אבנים אחרות" "והביאו בניך בחוצן" "והביאו את כל אחיכם"]}], :frame {:text "Leviticus 14:45 commands a metzora to remove afflicted stones from his house and bring replacement ones: 'והביאו אבנים אחרות.' Isaiah 66:12 and 66:20 use והביאו in promises of restoration. Ba'al HaTurim builds a homiletic chain: one who withholds his offering will eventually need the kohen to inspect a plagued house (cf. Leviticus 14:34–45), while one who brings it merits the blessings of ingathering described in Isaiah 66.", :sources ["Leviticus 14:45" "Leviticus 14:34" "Isaiah 66:12" "Isaiah 66:20"]}}], :arithmetic [{:kind :other, :note "Gezerah shavah linking ונודעה in our verse to the identical word in Isaiah 66:14", :by :selah, :ran? false} {:kind :masorah, :count 4, :occurrences ["והביאו אותו" "והביאו אבנים אחרות" "והביאו בניך בחוצן" "והביאו את כל אחיכם"], :by :selah, :located [{:phrase "והביאו אותו", :refs ["Genesis 42:34" "Genesis 43:16" "Genesis 46:7" "Exodus 27:7" "Exodus 35:21" "Exodus 35:24" "Exodus 35:27" "Leviticus 4:4"], :n 25, :lens :plene-insensitive} {:phrase "והביאו אבנים אחרות", :refs [], :n 0, :lens :plene-insensitive} {:phrase "והביאו בניך בחוצן", :refs ["Isaiah 49:22"], :n 1, :lens :plene-insensitive} {:phrase "והביאו את כל אחיכם", :refs ["Isaiah 66:20"], :n 1, :lens :exact}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 4, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:51.523248154Z", :model "glm-5.2"}