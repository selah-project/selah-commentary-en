{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "אחרים והוציא", :translit "acherim ve-hotzi", :gloss "others and he shall remove"} {:he "הכהנים בעלי מומים", :translit "ha-kohanim ba'alei mumin", :gloss "the kohanim, masters of blemishes"} {:he "שבעל מום כשר להוציא הדשן", :translit "sheba'al mum kasher lehotzi et ha-deshen", :gloss "for one with a blemish is fit to remove the ashes"}], :mechanisms [{:kind :gematria, :a "אחרים והוציא", :b "הכהנים בעלי מומים"}], :frame {:text "The Torah permits priests with physical blemishes to perform the terumat ha-deshen, removing the ashes from the altar, as stated at Leviticus 21:21–22, which excludes them from offering the bread of God but allows them to eat of the holy things. The word \"acherim\" (\"others\") in Leviticus 6:4 is thus read as a hint that disqualified priests may perform this specific task of ash-removal.", :sources ["Leviticus 21:21-22" "Leviticus 6:4"]}}], :arithmetic [{:a-value 377, :b-value 378, :lens :standard, :equal? false, :kind :gematria, :b "הכהנים בעלי מומים", :by :selah, :colel? true, :a "אחרים והוציא"}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 6, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:08.486243539Z", :model "glm-5.2"}