{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "השורץ", :translit "ha-shoretz", :gloss "the swarming thing"} {:he "כשעורה", :translit "k'se'orah", :gloss "like a barley grain"} {:he "ששעורו כשעורה", :translit "she-shi'uro k'se'orah", :gloss "whose measure is like a barley grain"}], :mechanisms [{:kind :gematria, :a "השורץ", :b "כשעורה"} {:kind :other, :note "The gematria equation establishes a halakhic standard: the minimum volume of these creeping creatures is equivalent to a barley grain."}], :frame {:text "The minimum quantity (shi'ur) required for various halakhic obligations is frequently compared to a barley grain (כשעורה). Specific halakhic measurements expressed in terms of agricultural produce are discussed in the Talmud, including the volume of a barley grain as a standard unit (Pesachim 109a). The Ba'al HaTurim draws a verbal pun: the word ששעורו ('whose measure') echoes שעורה ('barley'), suggesting that the verse's term השורץ carries within it the halakhic standard of a barley grain.", :sources ["Pesachim 109a"]}}], :arithmetic [{:kind :gematria, :a "השורץ", :a-value 601, :b "כשעורה", :b-value 601, :lens :standard, :by :selah, :equal? true} {:kind :other, :note "The gematria equation establishes a halakhic standard: the minimum volume of these creeping creatures is equivalent to a barley grain.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 11, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:57.453524366Z", :model "glm-5.2"}