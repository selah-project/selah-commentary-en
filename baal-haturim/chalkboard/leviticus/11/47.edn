{:tier :glm-5.2, :verse 47, :comments [{:quotes [{:he "להבדיל", :translit "lehavdil", :gloss "to distinguish"} {:he "ובין החיה הנאכלת ובין החיה אשר לא תאכל", :translit "u'vein ha-chayah ha-ne'echelet u'vein ha-chayah asher lo to'achel", :gloss "and between the living creature that may be eaten and between the living creature that may not be eaten"}], :mechanisms [{:kind :other, :note "Verse begins with lamed (ל) and ends with lamed (ל)"} {:kind :other, :note "Lamed (ל) has gematria value 30, twice = 60, alluding to the 1:60 ratio of prohibited substances"} {:kind :gematria, :a "ובין החיה הנאכלת ובין החיה אשר לא תאכל", :b "זה שמנה עשר טריפות"}], :frame {:text "The halakhic principle that a prohibited substance mixed into a permitted substance is nullified when it constitutes less than one part in sixty (1:60) is established in the Talmud (Chullin 98a, Pesachim 30a). The number of categories of treifot (slaughter disqualifications) in an animal that render it prohibited is enumerated by the Talmud as eighteen (Chullin 42a).", :sources ["Chullin 98a" "Pesachim 30a" "Chullin 42a"]}}], :arithmetic [{:kind :other, :note "Verse begins with lamed (ל) and ends with lamed (ל)", :by :selah, :ran? false} {:kind :other, :note "Lamed (ל) has gematria value 30, twice = 60, alluding to the 1:60 ratio of prohibited substances", :by :selah, :ran? false} {:a-value 1681, :b-value 1682, :lens :standard, :equal? false, :kind :gematria, :b "זה שמנה עשר טריפות", :by :selah, :colel? true, :a "ובין החיה הנאכלת ובין החיה אשר לא תאכל"}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 11, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:58.641391614Z", :model "glm-5.2"}