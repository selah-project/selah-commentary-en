{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "ואמרת אליהם", :translit "v'amarta aleihem", :gloss "and you shall say to them"} {:he "מלא י'", :translit "malei yod", :gloss "plene with yod"}], :mechanisms [{:kind :other, :note "Plene spelling of ואמרת with full yod signals public speech requiring a minyan of ten."}], :frame {:text "The requirement to publicize certain matters before ten (a minyan) is addressed in multiple talmudic contexts, such as the public reading of Torah (Berakhot 21b, requiring ten for devarim she-bi-kh'tav) and the public announcement of leap years (Sanhedrin 10b). The association of public speech with a quorum of ten is grounded in the term edah, which the Torah applies to a group of ten (Numbers 14:27).", :sources ["Berakhot 21b" "Sanhedrin 10b" "Numbers 14:27"]}}], :arithmetic [{:kind :other, :note "Plene spelling of ואמרת with full yod signals public speech requiring a minyan of ten.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 17, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:47.424121300Z", :model "glm-5.2"}