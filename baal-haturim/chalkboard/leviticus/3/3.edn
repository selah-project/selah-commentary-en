{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "את החלב המכסה את הקרב", :translit "et he-chelev ha-mechaseh et ha-kerev", :gloss "the fat that covers the innards"} {:he "שמנת עבית כשית", :translit "shamant avit kashit", :gloss "you grew fat, you grew thick, you grew gorged"} {:he "וישמן ישורון ויבעט", :translit "vayishman yeshurun vayiva'et", :gloss "and Jeshurun grew fat and kicked"}], :mechanisms [{:kind :other, :note "Wordplay: the sacrificial fat (chelev) atones for the sin of bodily fat from overindulgence."}], :frame {:text "Moses warns that becoming fat from satiety leads to forgetting God and kicking against Him, as stated in Deuteronomy 32:15. The verse וישמן ישורון ויבעט is read as the paradigmatic warning that physical corpulence breeds spiritual rebellion. By bringing the sacrificial fat upon the altar, the offerer symbolically surrenders the very substance of his excess.", :sources ["Deuteronomy 32:15"]}}], :arithmetic [{:kind :other, :note "Wordplay: the sacrificial fat (chelev) atones for the sin of bodily fat from overindulgence.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 3, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:54.943127365Z", :model "glm-5.2"}