{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "ובן יונה או תור", :translit "uven yonah o tor", :gloss "and a young pigeon or a turtledove"} {:he "בכ\"מ מקדים תורים לבני יונה", :translit "becham makdim torim livnei yonah", :gloss "in all places it puts turtledoves before young pigeons"} {:he "חוץ מכאן", :translit "chutz mikan", :gloss "except here"} {:he "לפי שאינו מביא אלא אחד", :translit "lefi she'eino meivi ela echad", :gloss "because he does not bring but one"} {:he "שאם ימצא יונה לא יקח תור", :translit "she'im yimatza yonah lo yikach tor", :gloss "for if he finds a pigeon he does not take a turtledove"} {:he "לפי שבן זוגו מתאבל עליו", :translit "lefi sheben zugo mit'avel alav", :gloss "because its mate mourns over it"} {:he "ואינו מזדווג לאחר", :translit "ve'eino mizdaveg le'acher", :gloss "and does not pair with another"}], :mechanisms [{:kind :masorah, :count 24, :occurrences ["תורים ובני יונה"]}], :frame {:text "The standard pairing in sacrificial contexts is 'turtledoves and young pigeons' (תורים ובני יונה), as in Leviticus 1:14 and Leviticus 5:7. The turtledove is a species known for lifelong fidelity to a single mate; once paired, it does not accept another partner. This behavioral trait underlies the halakhic preference order when only a single bird is needed.", :sources ["Leviticus 1:14" "Leviticus 5:7"]}}], :arithmetic [{:kind :masorah, :count 24, :occurrences ["תורים ובני יונה"], :by :selah, :located [{:phrase "תורים ובני יונה", :refs [], :n 0, :lens :plene-insensitive}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:05.849403786Z", :model "glm-5.2"}