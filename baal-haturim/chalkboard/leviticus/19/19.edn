{:tier :glm-5.2, :verse 19, :comments [{:quotes [{:he "לא תרביע כל", :translit "lo tarbia kol", :gloss "you shall not let mate every"} {:he "ואיש כי ישכב את אשה", :translit "ve'ish ki yishkav et isha", :gloss "and a man when he lies with a woman"} {:he "שפחה נרחפת", :translit "shifcha necherefet", :gloss "a designated maidservant"} {:he "כלאים", :translit "kil'ayim", :gloss "mixed kinds"} {:he "שפחה חרופה", :translit "shifcha charufa", :gloss "a designated maidservant"} {:he "ערלתו את פריו", :translit "arlah et piryo", :gloss "his foreskin its fruit"} {:he "פרי", :translit "pri", :gloss "fruit"} {:he "נטיע' מקטע רגליהון דבועלי נדות", :translit "neti'a mekatei ragleihon devo'alei niddot", :gloss "plantings cut off at the legs of those who lie with menstruants"}], :mechanisms [{:kind :other, :note "Juxtaposition: the prohibition of kil'ayim is placed next to the case of a man lying with a shifcha charufa"} {:kind :other, :note "Juxtaposition: shifcha charufa is placed next to arlah et piryo to hint that offspring of relations with a shifcha charufa will be wicked"} {:kind :sofei-tevot, :phrase "ואיש כי ישכב את אשה שז", :spells "שז"} {:kind :other, :note "Aramaizing phrase from rabbinic literature: neti'a mekatei ragleihon devo'alei niddot — the offspring of those who cohabit with menstruants have crippled legs"}], :frame {:text "The shifcha charufa is a half-free, half-slave maidservant who has been designated for a slave but not yet freed; cohabiting with her is likened here to kil'ayim because she is a mixture of statuses (Gittin 40a–41a, Yevamot 66a). The phrase neti'a mekatei ragleihon devo'alei niddot refers to a tradition that offspring of relations with a menstruant are physically deformed; see Niddah 13a in the name of Rabbi Yitzchak and parallels in Bereshit Rabbah 76:6 and Vayikra Rabbah 24:6.", :sources ["Gittin 40a" "Gittin 41a" "Yevamot 66a" "Niddah 13a" "Bereshit Rabbah 76:6" "Vayikra Rabbah 24:6"]}}], :arithmetic [{:kind :other, :note "Juxtaposition: the prohibition of kil'ayim is placed next to the case of a man lying with a shifcha charufa", :by :selah, :ran? false} {:kind :other, :note "Juxtaposition: shifcha charufa is placed next to arlah et piryo to hint that offspring of relations with a shifcha charufa will be wicked", :by :selah, :ran? false} {:kind :sofei-tevot, :phrase "ואיש כי ישכב את אשה שז", :spells "שז", :letters ["ש" "י" "ב" "ת" "ה" "ז"], :by :selah, :order :mismatch} {:kind :other, :note "Aramaizing phrase from rabbinic literature: neti'a mekatei ragleihon devo'alei niddot — the offspring of those who cohabit with menstruants have crippled legs", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:24.992069800Z", :model "glm-5.2"}