{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "לא תגנובו", :translit "lo tignovu", :gloss "you shall not steal"} {:he "ולא תכחשו", :translit "v'lo techacheshu", :gloss "and you shall not deny"} {:he "לא תכחשו", :translit "lo techacheshu", :gloss "you shall not deny"} {:he "לא תשקרו", :translit "lo tishkeru", :gloss "you shall not lie"} {:he "לא תשבעו", :translit "lo tishav'u", :gloss "you shall not swear falsely"}], :mechanisms [{:kind :other, :note "smikhut (juxtaposition): adjacent prohibitions in Lev 19:11-12 linked causally — theft leads to false denial, lying, and oath"}], :frame {:text "The principle of semikhut parshiyot (juxtaposition of passages) holds that adjacent topics in the Torah convey causal or thematic links. The sequence of prohibitions in Leviticus 19:11-12 (stealing, denial, lying, false oath) is read as a chain: a thief, confronted about the stolen item, will deny it, then lie about it, and ultimately swear falsely. A similar causal chain from theft to false oath appears at Shabbat 88a.", :sources ["Shabbat 88a"]}}], :arithmetic [{:kind :other, :note "smikhut (juxtaposition): adjacent prohibitions in Lev 19:11-12 linked causally — theft leads to false denial, lying, and oath", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:11.326571112Z", :model "glm-5.2"}