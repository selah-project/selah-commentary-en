{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "בצדק תשפוט עמיתך", :translit "b'tzedek tishpot amitekha", :gloss "in righteousness shall you judge your fellow"} {:he "בצדק", :translit "b'tzedek", :gloss "in righteousness"} {:he "צדק", :translit "tzedek", :gloss "Jupiter / righteousness"} {:he "לא תלך רכיל", :translit "lo telekh rakhill", :gloss "you shall not go as a talebearer"}], :mechanisms [{:kind :other, :note "Astrological association: the planet צדק (Jupiter) governs the second day (Monday) and the fifth day (Thursday), the days courts convene."} {:kind :other, :note "Parshanut: the adjacent verse לא תלך רכיל is read as a warning to judges about unequal treatment and forewarning colleagues."}], :frame {:text "Courts convene on Mondays and Thursdays, which are market days when people gather in town (Bava Kamma 82a; Shabbat 86a in some readings). The word צדק doubles as the Hebrew name for the planet Jupiter, linking the judicial calendar to astrological governance. The adjacent prohibition of talebearing (Leviticus 19:16) is extended to a judge who treats litigants unequally, parallel to Talmudic warnings against favoritism on the bench (Shevuot 30a; Sanhedrin 7b).", :sources ["Bava Kamma 82a" "Shevuot 30a" "Sanhedrin 7b" "Leviticus 19:15" "Leviticus 19:16"]}}], :arithmetic [{:kind :other, :note "Astrological association: the planet צדק (Jupiter) governs the second day (Monday) and the fifth day (Thursday), the days courts convene.", :by :selah, :ran? false} {:kind :other, :note "Parshanut: the adjacent verse לא תלך רכיל is read as a warning to judges about unequal treatment and forewarning colleagues.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:16.418721847Z", :model "glm-5.2"}