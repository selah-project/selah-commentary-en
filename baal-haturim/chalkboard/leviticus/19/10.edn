{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "לא תלקט", :translit "lo talaket", :gloss "you shall not glean"} {:he "לא תגנובו", :translit "lo tignovu", :gloss "you shall not steal"} {:he "ב' לקט ג' אינו לקט", :translit "bet leket gimel eino leket", :gloss "two are leket, three are not leket"}], :mechanisms [{:kind :other, :note "Semikhah: the adjacency of 'you shall not glean' (19:10) to 'you shall not steal' (19:11) drives the derashah."}], :frame {:text "The Mishnah at Pe'ah 6:5 rules that two fallen stalks count as leket and must be left for the poor, but three do not count as leket and the owner may keep them. The Ba'al HaTurim reads the juxtaposition of 'you shall not glean' (Leviticus 19:10) with 'you shall not steal' (Leviticus 19:11) as applying this law in both directions: a householder who keeps what should be leket steals from the poor, and a poor person who takes more than the halakhic threshold steals from the owner.", :sources ["Mishnah Pe'ah 6:5" "Leviticus 19:10" "Leviticus 19:11"]}}], :arithmetic [{:kind :other, :note "Semikhah: the adjacency of 'you shall not glean' (19:10) to 'you shall not steal' (19:11) drives the derashah.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:10.042883069Z", :model "glm-5.2"}