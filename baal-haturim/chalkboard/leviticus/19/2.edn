{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "קדשים תהיו", :translit "kedoshim tihyu", :gloss "holy you shall be"} {:he "ושמרתם את משמרתי", :translit "u'shemartem et mishmarti", :gloss "and you shall keep My charge"} {:he "קדושים תהיו", :translit "kedoshim tihyu", :gloss "holy you shall be"}], :mechanisms [{:kind :other, :note "Semikh: the juxtaposition of 'you shall keep My charge' (Lev 18:30) to 'holy you shall be' (Lev 19:2) teaches that guarding from sin draws sanctification from above."}], :frame {:text "The principle that guarding oneself from sin leads to further protection from sin is expressed at BT Shabbat 104a: 'one who comes to purify is helped.' The concept that avoiding sin brings heavenly sanctification appears in BT Yoma 38b-39a.", :sources ["BT Shabbat 104a" "BT Yoma 38b-39a"]}} {:quotes [{:he "אני ה' אלהיכם", :translit "ani Hashem Elokeichem", :gloss "I am YHWH your Elohim"} {:he "דבר אל כל עדת בני ישראל", :translit "daber el kol adat b'nei Yisrael", :gloss "Speak to all the congregation of the children of Israel"}], :mechanisms [{:kind :other, :note "Semikh: 'I am YHWH your Elohim' (Lev 19:2–3) juxtaposed to 'Speak to all the congregation' (Lev 19:2) teaches that Israel's collective declaration crowns God as one."}], :frame {:text "The concept that Israel crowns God through their declaration of His oneness is found in the phrase 'Israel crown You from above' in the liturgical poem L'kha Dodi attributed to Shlomo Alkabetz. The wider midrashic tradition that God is King only when Israel proclaims Him so appears in Shemot Rabbah 29:1.", :sources ["Shemot Rabbah 29:1"]}} {:quotes [{:he "עדת בני ישראל", :translit "adat b'nei Yisrael", :gloss "congregation of the children of Israel"} {:he "קדושים", :translit "kedoshim", :gloss "holy"} {:he "ה' אלהיכם", :translit "Hashem Elokeichem", :gloss "YHWH your Elohim"} {:he "אני ה' אלהיכם", :translit "ani Hashem Elokeichem", :gloss "I am YHWH your Elohim"} {:he "איש אמו ואביו תיראו", :translit "ish imo v'aviv tir'u", :gloss "each man his mother and father you shall revere"} {:he "את שבתותי תשמורו", :translit "et shabtotai tishmoru", :gloss "My Sabbaths you shall keep"} {:he "ע\"ג", :translit "avodah zarah", :gloss "idolatry"}], :mechanisms [{:kind :masorah, :count 5, :occurrences ["ה' אלהיכם"]} {:kind :other, :note "Semikh: 'holy' (Lev 19:2) juxtaposed to 'congregation' teaches that matters of holiness require ten."} {:kind :other, :note "Semikh: revering parents (Lev 19:3) juxtaposed to 'I am YHWH your Elohim' (Lev 19:3) equates honoring parents with honoring God."} {:kind :other, :note "Semikh: Sabbath (Lev 19:3) juxtaposed to revering parents teaches that if a parent commands Sabbath desecration, do not listen."} {:kind :other, :note "Semikh: Sabbath (Lev 19:3) juxtaposed to idolatry (Lev 19:4) teaches libating to idolatry and Sabbath desecration are weighed equally."}], :frame {:text "A quorum of ten Israelites is called an 'edah' (congregation), as established at BT Megillah 23b. The principle that one must not obey a parent's command to violate Torah law derives from the juxtaposition of Sabbath and parents at Lev 19:3 (BT Yevamot 5b). The equation of libating to idolatry with Sabbath desecration is stated at BT Chullin 5a.", :sources ["BT Megillah 23b" "BT Yevamot 5b" "BT Chullin 5a"]}}], :arithmetic [{:kind :other, :note "Semikh: the juxtaposition of 'you shall keep My charge' (Lev 18:30) to 'holy you shall be' (Lev 19:2) teaches that guarding from sin draws sanctification from above.", :by :selah, :ran? false} {:kind :other, :note "Semikh: 'I am YHWH your Elohim' (Lev 19:2–3) juxtaposed to 'Speak to all the congregation' (Lev 19:2) teaches that Israel's collective declaration crowns God as one.", :by :selah, :ran? false} {:kind :masorah, :count 5, :occurrences ["ה' אלהיכם"], :by :selah, :located [{:phrase "ה' אלהיכם", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Semikh: 'holy' (Lev 19:2) juxtaposed to 'congregation' teaches that matters of holiness require ten.", :by :selah, :ran? false} {:kind :other, :note "Semikh: revering parents (Lev 19:3) juxtaposed to 'I am YHWH your Elohim' (Lev 19:3) equates honoring parents with honoring God.", :by :selah, :ran? false} {:kind :other, :note "Semikh: Sabbath (Lev 19:3) juxtaposed to revering parents teaches that if a parent commands Sabbath desecration, do not listen.", :by :selah, :ran? false} {:kind :other, :note "Semikh: Sabbath (Lev 19:3) juxtaposed to idolatry (Lev 19:4) teaches libating to idolatry and Sabbath desecration are weighed equally.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:17.993196187Z", :model "glm-5.2"}