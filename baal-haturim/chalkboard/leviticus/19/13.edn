{:tier :glm-5.2, :verse 13, :comments [{:quotes [{:he "לא תלין פעולת שכיר", :translit "lo talin pe'ulat sakhir", :gloss "you shall not withhold the wages of a hired worker"} {:he "לא תקלל", :translit "lo tekallel", :gloss "do not curse"}], :mechanisms [{:kind :other, :note "Juxtaposition (semikhut): the prohibition against withholding wages is immediately followed by the prohibition against cursing, implying a causal scenario."}], :frame {:text "The method of deriving law from the juxtaposition (semikhut) of adjacent verses is a standard hermeneutical technique. The broader principle that one should pursue restitution through the judicial system rather than taking punitive action is reflected in the command to establish courts (Exodus 22:27–28 in its immediate sequence, and Deuteronomy 16:18).", :sources ["Leviticus 19:13" "Leviticus 19:14" "Deuteronomy 16:18"]}}], :arithmetic [{:kind :other, :note "Juxtaposition (semikhut): the prohibition against withholding wages is immediately followed by the prohibition against cursing, implying a causal scenario.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:10.295951191Z", :model "glm-5.2"}