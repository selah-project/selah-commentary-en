{:tier :glm-5.2, :verse 44, :comments [{:quotes [{:he "טמא", :translit "tamei", :gloss "unclean"} {:he "למען טמא את מקדשי", :translit "l'ma'an tamei et mikdashai", :gloss "so as to defile my sanctuary"} {:he "ובידו מקטרת להקטיר והצרעת זרחה במצחו", :translit "u-v'yado miktarah l'haktir va-hatzara'at zarchah b'mitzcho", :gloss "and in his hand a censer to burn incense and the tzara'at broke out on his forehead"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["טמא" "למען טמא את מקדשי"]} {:kind :other, :note "The shared word טמא links our verse to Ezekiel 44:7, yielding the homiletical connection."}], :frame {:text "Ezekiel 44:7 warns against admitting foreigners who defile the sanctuary (למען טמא את מקדשי), understood by the rabbis as a prohibition against a non-priest (zar) entering to perform the sacred avodah. 2 Chronicles 26:19 records that King Uzziah, a non-priest who entered the Temple to burn incense, was immediately stricken with tzara'at on his forehead. The Ba'al HaTurim reads the Masoretic link between the two occurrences of טמא as encoding this punishment: a zar who serves in the sanctuary is stricken with tzara'at just as Uzziah was.", :sources ["Ezekiel 44:7" "2 Chronicles 26:19"]}} {:quotes [{:he "נגעו", :translit "nega'o", :gloss "his affliction"} {:he "אשר ידע איש את נגעו", :translit "asher yada ish et nega'o", :gloss "which a man knows as his affliction"} {:he "בראשו נגעו", :translit "b'rosho nega'o", :gloss "at its beginning, his affliction"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["נגעו" "אשר ידע איש את נגעו"]}], :frame {:text "The other occurrence of the word נגעו appears in Solomon's prayer at the dedication of the Temple in 1 Kings 8:38, where supplicants are described as each knowing 'the plague of his own heart' (אשר ידע איש את נגעו). The Ba'al HaTurim uses this shared word to draw a practical homily: before one prays one must recognize one's own affliction — understood as one's sin — and cleanse it through teshuvah.", :sources ["1 Kings 8:38"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["טמא" "למען טמא את מקדשי"], :by :selah, :located [{:phrase "טמא", :refs ["Genesis 34:5" "Genesis 34:13" "Leviticus 5:2" "Leviticus 7:19" "Leviticus 7:21" "Leviticus 11:4" "Leviticus 11:5" "Leviticus 11:7"], :n 50, :lens :exact} {:phrase "למען טמא את מקדשי", :refs ["Leviticus 20:3"], :n 1, :lens :exact}]} {:kind :other, :note "The shared word טמא links our verse to Ezekiel 44:7, yielding the homiletical connection.", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["נגעו" "אשר ידע איש את נגעו"], :by :selah, :located [{:phrase "נגעו", :refs ["Leviticus 13:44" "Isaiah 16:8" "Jeremiah 48:32" "Hosea 4:2" "2 Chronicles 6:29" "2 Chronicles 26:20"], :n 6, :lens :exact} {:phrase "אשר ידע איש את נגעו", :refs [], :n 0, :lens :plene-insensitive}]}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 13, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:18.462018161Z", :model "glm-5.2"}