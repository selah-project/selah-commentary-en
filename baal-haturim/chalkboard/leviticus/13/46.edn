{:tier :glm-5.2, :verse 46, :comments [{:quotes [{:he "בדד ישב", :translit "badad yashav", :gloss "alone he shall dwell"}], :mechanisms [{:kind :other, :note "Wordplay: בדד (alone) read as the consequence of dividing בין אחים (between brothers)"}], :frame {:text "The Talmud states that the affliction of tzara'at comes as punishment for evil speech (Arakhin 15b). The verse 'He shall dwell alone' is understood to mean that the metzora is separated from society because evil speech itself separates people — the speaker causes discord, making this one dwell alone and that one dwell alone.", :sources ["Arakhin 15b"]}}], :arithmetic [{:kind :other, :note "Wordplay: בדד (alone) read as the consequence of dividing בין אחים (between brothers)", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 13, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:13.972106497Z", :model "glm-5.2"}