{:tier :glm-5.2, :verse 33, :comments [{:quotes [{:he "והתגלח", :translit "vehitgallach", :gloss "and he shall shave himself"} {:he "גימ\"ג גדולה", :translit "gimel gedolah", :gloss "large gimel"} {:he "שג' צריכים גילוח גדול בכ\"מ שיש בו שער", :translit "she-g' tzrichim giluch gadol b'chol makom she'yesh bo se'ar", :gloss "that three require large shaving wherever there is hair"} {:he "נזיר ומצורע ולוים", :translit "nazir u'metzora u'levi'im", :gloss "nazirite and metzora and Levites"}], :mechanisms [{:kind :other, :note "Letter-count: gimel (ג) has numerical value 3, corresponding to three categories requiring full-body shaving"}], :frame {:text "The nazirite must shave his consecrated hair at the completion of his vow (Numbers 6:18). The metzora shaves all his hair on the seventh day of purification (Leviticus 14:9). The Levites shave their entire body as part of their consecration rite (Numbers 8:7). Ba'al HaTurim reads the gimel of והתגלח as signaling that three types of persons require full-body shaving.", :sources ["Numbers 6:18" "Leviticus 14:9" "Numbers 8:7"]}}], :arithmetic [{:kind :other, :note "Letter-count: gimel (ג) has numerical value 3, corresponding to three categories requiring full-body shaving", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 13, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:12.274566092Z", :model "glm-5.2"}