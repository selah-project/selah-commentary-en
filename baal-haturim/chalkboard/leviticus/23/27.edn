{:tier :glm-5.2, :verse 27, :comments [{:quotes [{:he "אך", :translit "akh", :gloss "however / only"} {:he "מיעוטא", :translit "mi'uta", :gloss "a restriction / limitation"} {:he "שבים", :translit "shavim", :gloss "those who return"} {:he "אינו מכפר לשאינן שבים", :translit "eino mechaper le'she'einan shavim", :gloss "it does not atone for those who do not return"} {:he "חמשה עינויים", :translit "chamisha inuyim", :gloss "five afflictions"} {:he "אכילה ושתיה ורחיצה וסיכה ונעילת הסנדל ותשמיש המטה", :translit "achiyah u'shtiyah u'rechitzah u'sichah u'ne'ilat ha'sandel u'tashmish ha'mitah", :gloss "eating and drinking and washing and anointing and wearing the sandal and marital relations"} {:he "ה\"פ נפש", :translit "hamesh pe'amim nefesh", :gloss "five times nefesh"} {:he "דכתיבי בפרשה", :translit "d'chativ ba'parashah", :gloss "that are written in the portion"} {:he "ה' שמות שיש לנפש", :translit "chamesh shemot she'yesh la'nefesh", :gloss "five names that the soul has"} {:he "ה' טבילות לכ\"ג", :translit "chamesh tevilot la'kohen gadol", :gloss "five immersions for the High Priest"}], :mechanisms [{:kind :masorah, :count 5, :occurrences ["נפש"]} {:kind :other, :note "Five afflictions structurally correspond to five occurrences of נפש in the portion, five names of the soul, and five High Priest immersions on Yom Kippur"}], :frame {:text "The word אך is interpreted as a restriction excluding atonement for those who do not repent (Yoma 85b; Shevuot 13a). The Yom Kippur afflictions are enumerated as eating, drinking, washing, anointing, wearing shoes, and marital relations (Yoma 73b; Mishnah Yoma 8:1). Five names for the soul are listed as נפש, רוח, נשמה, חיה, יחידה (Berakhot 10a). The High Priest immerses five times on Yom Kippur and washes his hands and feet ten times (Yoma 30a, 32a; Mishnah Yoma 3:3, 7:3).", :sources ["Yoma 85b" "Shevuot 13a" "Yoma 73b" "Mishnah Yoma 8:1" "Berakhot 10a" "Yoma 30a" "Yoma 32a" "Mishnah Yoma 3:3" "Mishnah Yoma 7:3"]}}], :arithmetic [{:kind :masorah, :count 5, :occurrences ["נפש"], :by :selah, :located [{:phrase "נפש", :refs ["Genesis 1:20" "Genesis 1:21" "Genesis 1:24" "Genesis 1:30" "Genesis 2:19" "Genesis 9:5" "Genesis 9:10" "Genesis 9:12"], :n 131, :lens :exact}]} {:kind :other, :note "Five afflictions structurally correspond to five occurrences of נפש in the portion, five names of the soul, and five High Priest immersions on Yom Kippur", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:13.272526182Z", :model "glm-5.2"}