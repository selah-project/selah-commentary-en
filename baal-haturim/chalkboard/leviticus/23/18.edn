{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "על הלחם", :translit "al ha-lachem", :gloss "upon the bread"} {:he "והקרבתם על הלחם שבעת כבשים", :translit "ve-hikravtem al ha-lachem shiv'at kvasim", :gloss "and you shall bring upon the bread seven lambs"} {:he "כי לא על הלחם לבדו יחיה האדם", :translit "ki lo al ha-lachem levado yichyeh ha-adam", :gloss "for not upon bread alone does man live"} {:he "כי אכילת המזבח מעין אכילת אדם", :translit "ki achilat ha-mizbe'ach ma'ein achilat adam", :gloss "for the eating of the altar resembles the eating of man"} {:he "מה אכילת אדם אכילה מרובה משתייה", :translit "mah achilat adam achilah merubah mi-shetiyah", :gloss "just as man's eating — eating exceeds drinking"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והקרבתם על הלחם שבעת כבשים"]} {:kind :other, :note "Analogy: the sacrificial order parallels human consumption, derived from libation law"}], :frame {:text "Deuteronomy 8:3 states 'man does not live by bread alone.' The Talmud establishes that sacrificial portions and libations follow the pattern of human eating and drinking: just as a person's eating is greater than his drinking, so the number of sacrificial animals exceeds the quantity of libations (Sukkah 46b; cf. Menachot 88b). The Ba'al HaTurim connects the phrase 'upon the bread' to this principle, reading the seven lambs offered upon the bread as reflecting man's own relationship to bread and sustenance.", :sources ["Deuteronomy 8:3" "Sukkah 46b" "Menachot 88b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והקרבתם על הלחם שבעת כבשים"], :by :selah, :located [{:phrase "והקרבתם על הלחם שבעת כבשים", :refs ["Leviticus 23:18"], :n 1, :lens :exact}]} {:kind :other, :note "Analogy: the sacrificial order parallels human consumption, derived from libation law", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:09.097397573Z", :model "glm-5.2"}