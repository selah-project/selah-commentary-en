{:tier :glm-5.2, :verse 43, :comments [{:quotes [{:he "למען ידעו דורותיכם כי בסכות הושבתי", :translit "lema'an yed'u doroteichem ki basukot hoshavti", :gloss "so that your generations may know that in sukkot I caused you to dwell"} {:he "תגין על כ\"ף דבסכות", :translit "tagin al kaf de-vassukot", :gloss "tagin on the kaf of ba-sukkot"} {:he "דעד כ' אמה אדם יודע שיושב בצל סוכה", :translit "she-ad kaf amah adam yodeia she-yoshev be-tzel sukkah", :gloss "for up to 20 cubits a person knows that he sits in the shade of the sukkah"}], :mechanisms [{:kind :other, :note "Tagin (crownlets) on the letter kaf of בסכות signal the 20-cubit maximum height for a valid sukkah"}], :frame {:text "Mishnah Sukkah 1:1 states that a sukkah taller than twenty cubits is invalid (פסולה), because at that height a person is no longer sitting in the shade of the sukkah's covering (סכך) but rather in the shade of the walls. Rabba explains there (Sukkah 2a) that up to twenty cubits, a person is aware he sits in the shade of the sukkah; above twenty cubits, he is not. The Ba'al HaTurim reads the tagin on the kaf (numerically 20) of בסכות as an allusion to this halakhic boundary.", :sources ["Mishnah Sukkah 1:1" "Sukkah 2a"]}}], :arithmetic [{:kind :other, :note "Tagin (crownlets) on the letter kaf of בסכות signal the 20-cubit maximum height for a valid sukkah", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:12.441025839Z", :model "glm-5.2"}