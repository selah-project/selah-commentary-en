{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "והכהן הגדול", :translit "veha-kohen ha-gadol", :gloss "and the high priest"} {:he "גדול מאחיו", :translit "gadol me-echav", :gloss "greater than his brothers"} {:he "בנוי", :translit "be-vano", :gloss "in his build"} {:he "בכח", :translit "be-koach", :gloss "in strength"} {:he "בעושר", :translit "be-oshar", :gloss "in wealth"} {:he "בחכמה", :translit "be-chochmah", :gloss "in wisdom"} {:he "ובשנים", :translit "u-ve-shanim", :gloss "and in years"}], :mechanisms [{:kind :masorah, :count 5, :occurrences ["בנוי" "בכח" "בעושר" "בחכמה" "ובשנים"]}], :frame {:text "The phrase \"greater than his brothers\" is expounded to mean the high priest must exceed his fellow priests in five qualities: beauty, strength, wealth, wisdom, and age. If he lacks any of these, his fellow priests are required to supply the deficit from their own resources.", :sources ["Horiyyot 12a" "Yoma 18a"]}} {:quotes [{:he "יוצק", :translit "yotzeik", :gloss "he pours"} {:he "ונהר יוצק יסודם", :translit "ve-nahar yotzeik yesodam", :gloss "and a flowing river, their foundation"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יוצק" "ונהר יוצק יסודם"]}], :frame {:text "Moses made twelve logs of anointing oil and used it to anoint the Tabernacle and its vessels and Aaron and his sons. Miraculously none of the oil was diminished, and the remainder was hidden away. From that hidden remainder all the kings of Israel and the high priests were anointed.", :sources ["Keritot 5b" "Horayot 11b"]}} {:quotes [{:he "ללבוש", :translit "le-lavush", :gloss "to wear"} {:he "ובגד ללבוש", :translit "u-veged le-lavush", :gloss "and a garment to wear"} {:he "ונתן לי לחם לאכול ובגד ללבוש", :translit "ve-natan li lechem le-echol u-veged le-lavush", :gloss "and he gave me bread to eat and a garment to wear"} {:he "גדלהו משל אחיו", :translit "gadleihu mi-shel echav", :gloss "make him greater from what is his brothers'"} {:he "כיון שמלא ידו ללבוש הבגדים", :translit "keivan she-mala yado le-lavush ha-begadim", :gloss "once his hand was filled to wear the garments"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ללבוש" "ובגד ללבוש"]} {:kind :other, :note "Gezera shavah linking ללבוש in our verse to Genesis 28:20."}], :frame {:text "The phrase ובגד ללבוש appears in Jacob's vow at Bethel, where the term לבוש refers to garments of dignity. The midrashic reading of that verse as \"he gave me bread to eat and a garment of dignity to wear\" is applied to the high priest: just as Jacob received garment-dignity from Laban's house, the high priest's vestments confer corresponding honor, and his fellow priests must contribute to elevate him above them.", :sources ["Genesis Rabbah 70:11" "Yerushalmi Yoma 3:6"]}}], :arithmetic [{:kind :masorah, :count 5, :occurrences ["בנוי" "בכח" "בעושר" "בחכמה" "ובשנים"], :by :selah, :located [{:phrase "בנוי", :refs ["Song of Songs 4:4" "Ezra 8:33" "Nehemiah 3:24" "Nehemiah 7:15" "Nehemiah 10:10" "Nehemiah 12:8"], :n 6, :lens :exact} {:phrase "בכח", :refs ["Exodus 15:6" "Exodus 32:11" "Judges 16:30" "1 Samuel 2:9" "1 Kings 19:8" "2 Kings 17:36" "Isaiah 10:13" "Isaiah 40:9"], :n 14, :lens :exact} {:phrase "בעושר", :refs ["Genesis 8:5" "Exodus 12:3" "Leviticus 16:29" "Leviticus 23:27" "Leviticus 25:9" "Numbers 29:7" "Joshua 4:19" "2 Kings 25:1"], :n 19, :lens :plene-insensitive} {:phrase "בחכמה", :refs ["Exodus 31:3" "Exodus 35:26" "Exodus 35:31" "Psalms 104:24" "Proverbs 3:19" "Proverbs 24:3" "Proverbs 28:26" "Proverbs 31:26"], :n 16, :lens :exact} {:phrase "ובשנים", :refs ["Esther 9:1"], :n 1, :lens :exact}]} {:kind :masorah, :count 2, :occurrences ["יוצק" "ונהר יוצק יסודם"], :by :selah, :located [{:phrase "יוצק", :refs ["Leviticus 21:10" "Job 22:16"], :n 2, :lens :exact} {:phrase "ונהר יוצק יסודם", :refs ["Job 22:16"], :n 1, :lens :plene-insensitive}]} {:kind :masorah, :count 2, :occurrences ["ללבוש" "ובגד ללבוש"], :by :selah, :located [{:phrase "ללבוש", :refs ["Genesis 28:20" "Leviticus 21:10"], 