{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "אך אל הפרוכת לא יבא", :translit "akh el ha-parokhet lo yavo", :gloss "only to the parochet he shall not come"} {:he "אך", :translit "akh", :gloss "only / but"} {:he "אם אין כהנים נכנסין לוים אם אין טהורין נכנסין טמאין אם אין טמאין נכנסין בעלי מומין", :translit "im ein kohanim nikhnesin levi'im im ein tehorim nikhnesin temei'im im ein temei'im nikhnesin ba'alei mumim", :gloss "if no priests enter, Levites; if none pure enter, impure ones; if none impure enter, those with blemishes"}], :mechanisms [{:kind :other, :note "Limiting force of אך teaches the blemished priest may enter past the parochet under cascading fallback conditions"}], :frame {:text "The particle אך serves across Scripture as a limitation (מיעוטא). The Talmud records a cascading rule for situations where the standard officiants are unavailable: if no qualified priests enter, Levites may enter; if none pure enter, impure ones may enter; if none impure enter, blemished priests may enter (Yoma 25a). Ba'al HaTurim reads this principle back into the word אך of Leviticus 21:23.", :sources ["Yoma 25a"]}}], :arithmetic [{:kind :other, :note "Limiting force of אך teaches the blemished priest may enter past the parochet under cascading fallback conditions", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:48.938660887Z", :model "glm-5.2"}