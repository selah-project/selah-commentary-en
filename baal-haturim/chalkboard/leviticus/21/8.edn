{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "וקדשתו", :translit "u'kidashto", :gloss "and you shall sanctify him"}], :mechanisms [{:kind :other, :note "Three-fold reading of the root קדש in this verse applied to priestly honor"}], :frame {:text "The command to sanctify the priest is read as mandating three forms of precedence: he opens the Torah reading first, he is called to recite the priestly blessing first, and he receives a choice portion first. These rights of priestly precedence are codified in the Talmud, which lists the kohen's prerogatives in Torah reading, blessing, and fine portions.", :sources ["Gittin 59b" "Megillah 28a"]}}], :arithmetic [{:kind :other, :note "Three-fold reading of the root קדש in this verse applied to priestly honor", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:40.072503007Z", :model "glm-5.2"}