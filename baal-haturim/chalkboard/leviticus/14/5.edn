{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "על מים חיים", :translit "al mayim chayim", :gloss "over living water"} {:he "בנעמן שנתרפא מצרעתו במים חיים", :translit "b'na'aman she'nitrapei mi'tzara'ato b'mayim chayim", :gloss "with Naaman who was healed of his tzara'at by living water"} {:he "ולכך זב צריך טבילה במים חיים", :translit "u'l'chach zav tzarich t'vilah b'mayim chayim", :gloss "and therefore a zav requires immersion in living water"} {:he "משא\"כ בשאר טמאים שאינן צריכין", :translit "mish'ach b'sha'ar t'mei'im she'einan tz'richin", :gloss "unlike other impure persons who do not require it"} {:he "להתרפאות ע\"י מים חיים", :translit "l'hitrapei'ot al y'dei mayim chayim", :gloss "for healing through living water"}], :mechanisms [{:kind :other, :note "Halakhic comparison: zav immersion requires living water unlike other impurities; modeled on Naaman's healing in II Kings 5."}], :frame {:text "Naaman the Aramean was healed of tzara'at by immersing seven times in the Jordan River at the prophet Elisha's instruction (II Kings 5:14). The requirement that a zav immerse specifically in a ma'ayan (spring/living water) is stated at Leviticus 15:13, while other persons rendered impure immerse in any valid mikveh water.", :sources ["II Kings 5:14" "Leviticus 15:13"]}} {:quotes [{:he "על מים חיים", :translit "al mayim chayim", :gloss "over living water"} {:he "לא במים מלוחים", :translit "lo b'mayim m'luchim", :gloss "not in salt water"}], :mechanisms [{:kind :gematria, :a "על מים חיים", :b "לא במים מלוחים"}], :frame nil}], :arithmetic [{:kind :other, :note "Halakhic comparison: zav immersion requires living water unlike other impurities; modeled on Naaman's healing in II Kings 5.", :by :selah, :ran? false} {:a-value 258, :b-value 257, :lens :standard, :equal? false, :kind :gematria, :b "לא במים מלוחים", :by :selah, :colel? true, :a "על מים חיים"}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-