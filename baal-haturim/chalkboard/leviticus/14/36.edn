{:tier :glm-5.2, :verse 36, :comments [{:quotes [{:he "ואחר כן", :translit "v'achar kein", :gloss "and afterward"} {:he "דין", :translit "din", :gloss "judgment / instance"} {:he "ואחר כן תבא אליה ובעלתה", :translit "v'achar kein tavo eleiha u've'al'tah", :gloss "and afterward you shall come to her and have relations with her"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ואחר כן" "ואחר כן תבא אליה ובעלתה"]} {:kind :other, :note "Gezerah shavah linking the phrase ואחר כן across two contexts"}], :frame {:text "The phrase ואחר כן occurs in Leviticus 14:36 regarding the priest clearing the house before inspecting nega-im, and in Deuteronomy 24:1–2 in the passage of the divorcée (ואחר כן תבא אליה ובעלתה). Ba'al HaTurim reads both as requiring removal of fine vessels: here literally to spare them from impurity, and there figuratively so the woman becomes undesirable in the second husband's eyes. He calls these instances of דין, a Masorah term for a fixed usage. The laws of tzara'at of houses are given in Leviticus 14:33–53; the sotah laws appear in Numbers 5:11–31.", :sources ["Leviticus 14:36" "Deuteronomy 24:1–2" "Leviticus 14:33–53" "Numbers 5:11–31"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ואחר כן" "ואחר כן תבא אליה ובעלתה"], :by :selah, :located [{:phrase "ואחר כן", :refs ["Leviticus 14:36" "Deuteronomy 21:13"], :n 2, :lens :exact} {:phrase "ואחר כן תבא אליה ובעלתה", :refs ["Deuteronomy 21:13"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Gezerah shavah linking the phrase ואחר כן across two contexts", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:28.902337876Z", :model "glm-5.2"}