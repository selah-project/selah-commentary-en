{:tier :glm-5.2, :verse 35, :comments [{:quotes [{:he "נראה לי", :translit "nir'ah li", :gloss "it appears to me"} {:he "ה' נראה לי", :translit "ha' nir'ah li", :gloss "the five [instances] it appears to me"} {:he "מרחוק", :translit "merachok", :gloss "from afar"} {:he "נגע", :translit "nega", :gloss "affliction"} {:he "כנגע", :translit "kenega", :gloss "like an affliction"} {:he "ת\"ח", :translit "t\"ch", :gloss "Torah scholar"} {:he "נגעים", :translit "nega'im", :gloss "afflictions"}], :mechanisms [{:kind :masorah, :count 5, :occurrences ["נראה לי דין" "נראה לי"]} {:kind :other, :note "Even a nega'im expert says 'kenega' not 'nega,' matching 'it appears from afar' — the priest withholds definitive pronouncement."}], :frame {:text "The priest examining a suspected tzara'at lesion on a house is instructed to say 'like a nega it appears to me' (Leviticus 14:35), not 'a nega it appears to me.' The midrashic tradition derives that even an expert must withhold a definitive declaration, saying 'kenega' rather than 'nega,' keeping the matter at a distance. The broader principle that even a Torah scholar expert in nega'im must not definitively pronounce 'nega' is articulated in the tannaitic discussion of priestly examination procedures in Negaim.", :sources ["Leviticus 14:35" "Negaim 3:1"]}}], :arithmetic [{:kind :masorah, :count 5, :occurrences ["נראה לי דין" "נראה לי"], :by :selah, :located [{:phrase "נראה לי דין", :refs [], :n 0, :lens :plene-insensitive} {:phrase "נראה לי", :refs ["Leviticus 14:35" "Jeremiah 31:3"], :n 2, :lens :exact}]} {:kind :other, :note "Even a nega'im expert says 'kenega' not 'nega,' matching 'it appears from afar' — the priest withholds definitive pronouncement.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:26.645114737Z", :model "glm-5.2"}