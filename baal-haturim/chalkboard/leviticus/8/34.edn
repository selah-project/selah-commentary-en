{:tier :glm-5.2, :verse 34, :comments [{:quotes [{:he "לעשת", :translit "la'asot", :gloss "to do / to make"} {:he "לעשות", :translit "la'asot", :gloss "to do / to make (full spelling)"}], :mechanisms [{:kind :other, :note "לעשת written without vav (chasser), linking to מעשה פרה"}], :frame {:text "The Gemara derives from the defective spelling לעשת (without vav) in Numbers 19:2 that the designation 'this is the statute of the Torah / לעשת' refers specifically to the rite of the red heifer (parah adumah). The Kohen who burns the heifer is sprinkled with the purification waters on each of the six weekdays but not on Shabbat.", :sources ["Yoma 14a"]}}], :arithmetic [{:kind :other, :note "לעשת written without vav (chasser), linking to מעשה פרה", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 8, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:20.924196049Z", :model "glm-5.2"}