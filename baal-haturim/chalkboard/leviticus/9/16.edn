{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "ויעשה", :translit "va'ya'asehu", :gloss "and he offered it"} {:he "ויעשה לאיש הבא אליו", :translit "va'ya'asehu la'ish ha'ba eilav", :gloss "and she made it for the man who came to her"} {:he "כמשפט", :translit "ka'mishpat", :gloss "according to the ordinance"} {:he "ואת הכבשה ישלם ארבעתים", :translit "ve'et ha'kesev yeshaleim arba'tayim", :gloss "and the lamb he shall restore fourfold"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויעשה"]} {:kind :other, :note "Wordplay linking the two occurrences of ויעשה to David's parable about the poor man's lamb"}], :frame {:text "Nathan the prophet tells David a parable of a rich man who took a poor man's sole lamb (2 Samuel 12:1-4). David condemns the rich man, saying the lamb must be restored fourfold (2 Samuel 12:6). Nathan then reveals: \"You are the man\" (2 Samuel 12:7). The midrashic reading sees the phrase ויעשה לאיש הבא אליה (2 Samuel 12:3, with the suffix spelling identical to Leviticus 9:16's ויעשה) as echoing the priestly ויעשה כמשפט, suggesting David himself pronounced and fulfilled his own sentence.", :sources ["2 Samuel 12:1-6" "2 Samuel 12:7"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויעשה"], :by :selah, :located [{:phrase "ויעשה", :refs ["Leviticus 9:16" "2 Samuel 12:4" "1 Kings 16:25" "2 Kings 3:2" "2 Kings 13:11" "Ezekiel 12:25" "Ezekiel 12:28" "Ezekiel 18:19"], :n 8, :lens :exact}]} {:kind :other, :note "Wordplay linking the two occurrences of ויעשה to David's parable about the poor man's lamb", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 9, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:22:24.363525711Z", :model "glm-5.2"}