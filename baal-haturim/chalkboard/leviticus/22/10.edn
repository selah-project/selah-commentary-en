{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "תושב כהן ושכיר", :translit "toshav kohen u-sakhir", :gloss "a resident of a priest and a hired worker"} {:he "זה קנוי קנין עולם וקנוי קנין שנים", :translit "zeh kenuy kin'yan olam u-kenuy kin'yan shanim", :gloss "this is acquired with a permanent acquisition and acquired with a two-year acquisition"}], :mechanisms [{:kind :gematria, :a "תושב כהן ושכיר", :b "קנוי קנין עולם וקנוי קנין שנים"}], :frame {:text "Leviticus 22:10 prohibits a priest's resident (toshav) and hired worker (sakhir) from eating priestly food (terumah). The Sifrei on this verse derives that a priest's resident may eat terumah only if he is acquired as a permanent possession, while a hired worker's term is limited. The gematria links the two categories of persons to the two modes of acquisition named in the verse's drashah.", :sources ["Sifrei Zuta 22:10" "b. Yevamot 70b" "b. Berakhot 31a"]}}], :arithmetic [{:kind :gematria, :a "תושב כהן ושכיר", :a-value 1319, :b "קנוי קנין עולם וקנוי קנין שנים", :b-value 1304, :lens :standard, :by :selah, :equal? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:24:49.557471833Z", :model "glm-5.2"}