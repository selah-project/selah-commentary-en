{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "וכפר", :translit "u'khipper", :gloss "and he shall atone"} {:he "ובוידוי דברים", :translit "u'vi'vidui devarim", :gloss "and by confession of words"}], :mechanisms [{:kind :gematria, :a "וכפר", :b "ובוידוי דברים"}], :frame {:text "Confession (vidui) is an integral component of the atonement process for sins. The Mishnah states that for all sins the goat offered as a sin-offering effects atonement, provided that one has repented; if one said, 'I have sinned,' he has done confession (Yoma 36a). This establishes verbal confession as a prerequisite for the sacrificial atonement described in Leviticus 16:6.", :sources ["Yoma 36a" "Leviticus 16:6"]}}], :arithmetic [{:kind :gematria, :a "וכפר", :a-value 306, :b "ובוידוי דברים", :b-value 300, :lens :standard, :by :selah, :equal? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:42.681544404Z", :model "glm-5.2"}