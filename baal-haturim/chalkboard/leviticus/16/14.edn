{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "יזה", :translit "yizhe", :gloss "he shall sprinkle"} {:he "כן יזה גוים רבים", :translit "khen yizhe goyim rabim", :gloss "so shall he sprinkle many nations"} {:he "הנה ישכיל עבדי", :translit "hineh yaskil avdi", :gloss "behold my servant shall prosper"} {:he "ב' המשפחות", :translit "bet ha-mishpechot", :gloss "two families"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יזה" "כן יזה גוים רבים"]}], :frame {:text "The verse כן יזה גוים רבים (Isaiah 52:15) appears in the passage beginning הנה ישכיל עבדי (Isaiah 52:13), understood as the fourth of the Servant Songs. Rabbinic tradition identifies this servant as King Messiah; the Ba'al HaTurim extends the promised restoration to include both the Davidic dynasty and the priestly family returning to their respective services. The phrase 'two families' evokes Jeremiah 33:24, where the two families (the kingship and the priesthood) are addressed in the context of restoration.", :sources ["Isaiah 52:13–15" "Jeremiah 33:24"]}} {:quotes [{:he "ולפני הכפורת יזה", :translit "u-lifnei ha-kapporet yizhe", :gloss "and before the kapporet he shall sprinkle"} {:he "ז\"פ", :translit "z\"p", :gloss "seven times"} {:he "ז' הללו את ה' מן השמים", :translit "sheva halelu et Hashem min ha-shamayim", :gloss "seven: praise the LORD from the heavens"} {:he "וא' הללו את ה' מן הארץ", :translit "ve-echad halelu et Hashem min ha-aretz", :gloss "and one: praise the LORD from the earth"} {:he "האזינו", :translit "ha'azinu", :gloss "Give ear"} {:he "ט\"ז הזאות על הכפורת", :translit "tesha-esreh hazza'ot al ha-kapporet", :gloss "sixteen sprinklings upon the kapporet"} {:he "ט\"ז על הפרוכת", :translit "tesha-esreh al ha-parokhet", :gloss "sixteen upon the parokhet"} {:he "ט\"ז על מזבח הזהב", :translit "tesha-esreh al mizbeach ha-zahav", :gloss "sixteen upon the golden altar"} {:he "דם הברית", :translit "dam ha-berit", :gloss "blood of the covenant"} {:he "ה' טבילות", :translit "chet tevilot", :gloss "five immersions"} {:he "ה' עבודות", :translit "chet avodot", :gloss "five services"} {:he "ה' תפלות", :translit "chet tefilot", :gloss "five prayers"} {:he "מלך הכבוד", :translit "melech ha-kavod", :gloss "King of Glory"} {:he "לה' הארץ ומלואה", :translit "la-Shem ha-aretz u-melo'ah", :gloss "to the LORD the earth and its fullness"} {:he "ה' שמות", :translit "chet shemot", :gloss "five names"} {:he "י' קידושין", :translit "yod kiddushin", :gloss "ten sanctifications"} {:he "י\"פ שמזכיר השם", :translit "yud pe'amim she-mazkir ha-Shem", :gloss "ten times the Name is mentioned"} {:he "תטהרו", :translit "titharu", :gloss "you shall be clean"} {:he "כ\"ד כפרות", :translit "kaf-arba kapparot", :gloss "twenty-four atonements"} {:he "ובאתה תצוה", :translit "u-ve'atah tetzaveh", :gloss "and you shall command"} {:he "בהר סיני", :translit "be-har sinai", :gloss "at Mount Sinai"} {:he "אמור אל הכהנים", :translit "emor el ha-kohanim", :gloss "say to the priests"} {:he "פנחס לכפר", :translit "pinchas le-chapper", :gloss "Phinehas, to atone"} {:he "הודע את ירושלים", :translit "hoda'et et yerushalayim", :gloss "make known to Jerusalem"} {:he "כ\"ד עריות", :translit "kaf-arba arayot", :gloss "twenty-four forbidden relations"}], :mechanisms [{:kind :other, :note "1 above + 7 below = 8 on kapporet; sprinklings counted across the day's services"} {:kind :masorah, :count 7, :occurrences ["הללו את ה' מן השמים"]} {:kind :other, :note "Moses delayed mentioning the Name 21 words into Ha'azinu, leaving him as 1 of 7 angelic praisers"} {:kind :masorah, :count 16, :occurrences ["ט\"ז הזאות על הכפורת כנגד ט\"ז בריתות שנכרתו בסיני"]} {:kind :masorah, :count 16, :occurrences ["ט\"ז על הפרוכת כנגד ט\"ז שבאוהל מועד"]} {:kind :masorah, :count 16, :occurrences ["ט\"ז על מזבח הזהב עם שיורי הדם...כנגד ט\"ז שבערבות מואב"]} {:kind :masorah, :count 5, :occurrences ["ה' טבילות"]} {:kind :masorah, :count 5, :occurrences ["מלך הכבוד"]} {:kind :masorah, :count 10, :occurrences ["י' קידושין...י\"פ