{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "והניחם", :translit "ve-hinisham", :gloss "and he shall leave them"}], :mechanisms [{:kind :gematria, :a "והניחם", :b "י\"ח מנה"}], :frame {:text "On Yom Kippur the High Priest serves in white linen garments in the morning service and in golden garments in the afternoon service; after the morning service he removes the white garments and sets them aside (Leviticus 16:23). The Mishnah describes the total value of all the High Priest's Yom Kippur garments and the daily priestly garments at a substantial sum, reflecting the splendor of the Temple service (Yoma 38b).", :sources ["Leviticus 16:23" "Yoma 38b"]}}], :arithmetic [{:kind :gematria, :a "והניחם", :a-value 119, :b "י\"ח מנה", :b-value 113, :lens :standard, :by :selah, :equal? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:23:45.408088226Z", :model "glm-5.2"}