{:tier :glm-5.2, :verse 13, :comments [{:quotes [{:he "קוממיות", :translit "komemiyut", :gloss "upright stature"} {:he "קו\"ף", :translit "kuf", :gloss "the letter qof"}], :mechanisms [{:kind :other, :note "Two tagin on the letter qof correspond to two opinions on future stature: 100 cubits and 200 cubits."}], :frame {:text "The righteous in the world to come are restored to the stature of Adam, which is stated as one hundred cubits. The same source records a dispute about the exact measure, with some stating the stature as one hundred cubits and others as two hundred. Ba'al HaTurim links the two tagin on the qof to these two traditions.", :sources ["Shabbat 92b" "Berakhot 28a"]}}], :arithmetic [{:kind :other, :note "Two tagin on the letter qof correspond to two opinions on future stature: 100 cubits and 200 cubits.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:01.508587354Z", :model "glm-5.2"}