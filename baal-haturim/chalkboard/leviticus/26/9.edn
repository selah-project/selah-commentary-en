{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "ופניתי אליכם", :translit "u'feniti aleichem", :gloss "and I will turn toward you"} {:he "פני", :translit "panai", :gloss "My face"} {:he "ת\"י", :translit "tay", :gloss "410"} {:he "שת\"י שנים", :translit "shetay shanim", :gloss "two years/times"} {:he "שעמד הבית", :translit "she'amad ha-bayit", :gloss "that the Temple stood"} {:he "והיו עיני ולבי שם כל הימים", :translit "ve-hayu einai ve-libi sham kol ha-yamim", :gloss "My eyes and My heart shall be there all the days"} {:he "אנה פנה דודך", :translit "anah panah dodakh", :gloss "where has your beloved turned"}], :mechanisms [{:kind :gematria, :a "פני", :b "ת\"י"} {:kind :other, :note "The two Temples stood for 410 and 420 years respectively, each matching the gematria of פני in a different counting."}], :frame {:text "The First Temple stood for 410 years (Seder Olam Rabbah 25, Yoma 9a). The Second Temple stood for 420 years (Yoma 9a, Seder Olam Rabbah 30). The verse 'My eyes and My heart shall be there all the days' is 1 Kings 9:3, God's promise to Solomon regarding the Temple. The phrase 'where has your beloved turned?' cites Song of Songs 1:7, read allegorically as Israel seeking God's presence after the exile.", :sources ["Seder Olam Rabbah 25" "Seder Olam Rabbah 30" "Yoma 9a" "1 Kings 9:3" "Song of Songs 1:7"]}}], :arithmetic [{:kind :gematria, :a "פני", :a-value 140, :b "ת\"י", :b-value 410, :lens :standard, :by :selah, :equal? false} {:kind :other, :note "The two Temples stood for 410 and 420 years respectively, each matching the gematria of פני in a different counting.", :by :selah, :ran? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:25:59.724091514Z", :model "glm-5.2"}