{:tier :glm-5.2, :verse 19, :comments [{:quotes [{:he "את גאון", :translit "et ga'on", :gloss "the pride of"} {:he "זה המקדש", :translit "zeh ha-mikdash", :gloss "this is the Temple"} {:he "את גאון עוזכם", :translit "et ga'on uzchem", :gloss "the pride of your might"} {:he "זה ירושלים", :translit "zeh yerushalayim", :gloss "this is Jerusalem"}], :mechanisms [{:kind :gematria, :a "את גאון", :b "זה המקדש"} {:kind :gematria, :a "את גאון עוזכם", :b "זה ירושלים"}], :frame {:text "The verse Leviticus 26:19 threatens 'I will break the pride of your might,' which rabbinic tradition reads as referring to the Temple in Jerusalem. As Rashi on Leviticus 26:19 (citing Torat Kohanim, Bechukotai 6:5) states, 'this is the Temple.' The Ba'al HaTurim encodes this identification through two gematria equations: the shorter phrase 'את גאון' equals 'זה המקדש,' while the full phrase 'את גאון עוזכם' equals 'זה ירושלים.'", :sources ["Leviticus 26:19" "Rashi on Leviticus 26:19" "Torat Kohanim, Bechukotai 6:5"]}}], :arithmetic [{:kind :gematria, :a "את גאון", :a-value 461, :b "זה המקדש", :b-value 461, :lens :standard, :by :selah, :equal? true} {:kind :gematria, :a "את גאון עוזכם", :a-value 604, :b "זה ירושלים", :b-value 608, :lens :standard, :by :selah, :equal? false}], :book :leviticus, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:07.595524449Z", :model "glm-5.2"}