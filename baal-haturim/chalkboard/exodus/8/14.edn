{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "ולא יכלו", :translit "v'lo yakh'lu", :gloss "and they could not"} {:he "ג' במסורה", :translit "gimel b'masorah", :gloss "three in the Masorah"} {:he "ואידך", :translit "v'idakh", :gloss "and the other"} {:he "ולא יכולו", :translit "v'lo yakholu", :gloss "and they could not"} {:he "ולא יכולו", :translit "v'lo yakholu", :gloss "and they could not"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ולא יכלו" "ולא יכולו" "ולא יכולו"]} {:kind :other, :note "Midrashic inference from the shared phrase: lice would pursue even into the sea, paralleling kings who could not break through another king's border."}], :frame {:text "The phrase ולא יכלו at Exodus 8:14 describes the magicians' failure to replicate the lice. The two other occurrences involve inability to prevail in battle: the kings' alliance unable to break through to the king of Edom at Numbers 22:26, and the sailors unable to return to dry land at Jonah 1:13. Ba'al HaTurim reads the shared phrase as a midrashic link: just as those forces were trapped with no escape route, the Egyptians could not have fled the lice even by retreating to the sea.", :sources ["Exodus 8:14" "Numbers 22:26" "Jonah 1:13"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ולא יכלו" "ולא יכולו" "ולא יכולו"], :by :selah, :located [{:phrase "ולא יכלו", :refs ["Genesis 13:6" "Genesis 37:4" "Genesis 45:3" "Exodus 7:21" "Exodus 8:14" "Exodus 9:11" "Exodus 12:39" "Exodus 15:23"], :n 27, :lens :exact} {:phrase "ולא יכולו", :refs ["Genesis 13:6" "Genesis 32:26" "Genesis 37:4" "Genesis 44:22" "Genesis 45:1" "Genesis 45:3" "Genesis 48:10" "Exodus 7:21"], :n 84, :lens :plene-insensitive} {:phrase "ולא יכולו", :refs ["Genesis 13:6" "Genesis 32:26" "Genesis 37:4" "Genesis 44:22" "Genesis 45:1" "Genesis 45:3" "Genesis 48:10" "Exodus 7:21"], :n 84, :lens :plene-insensitive}]} {:kind :other, :note "Midrashic inference from the shared phrase: lice would pursue even into the sea, parall