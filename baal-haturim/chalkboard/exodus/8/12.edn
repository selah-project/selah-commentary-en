{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "והך", :translit "ve'hach", :gloss "and strike"} {:he "והך את עפר הארץ", :translit "ve'hach et afar ha'aretz", :gloss "and strike the dust of the earth"} {:he "והך כף אל כף", :translit "ve'hach kaf el kaf", :gloss "and strike palm to palm"}], :mechanisms [{:kind :other, :note "Word repetition: the verb והך appears twice, prompting the drash that the lice actively struck the Egyptians."}], :frame {:text "The Midrash explains that the Egyptians barred Israel from the bathhouses so that the Israelites would be infested with lice; measure-for-measure, the Egyptians were therefore punished with lice (Shemot Rabbah 10:5; Tanchuma, Va'era 14). The doubling of the verb 'strike' is read as signaling that the lice themselves were striking the Egyptians.", :sources ["Shemot Rabbah 10:5" "Tanchuma Va'era 14"]}}], :arithmetic [{:kind :other, :note "Word repetition: the verb והך appears twice, prompting the drash that the lice actively struck the Egyptians.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 8, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:25.768369961Z", :model "glm-5.2"}