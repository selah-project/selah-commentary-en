{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "ויזבחו", :translit "vizbechu", :gloss "and they shall slaughter"} {:he "ויזבחו לה'", :translit "vizbechu laShem", :gloss "and they shall slaughter to the LORD"} {:he "ויזבחו זבחי תודה", :translit "vizbechu zivchei todah", :gloss "and they shall slaughter sacrifices of thanksgiving"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויזבחו לה'" "ויזבחו זבחי תודה"]}], :frame {:text "The Mishnah lists four categories of people who must bring a thanksgiving offering: one who crosses the sea, one who traverses a desert, one who recovers from illness, and one who is released from prison (Berakhot 54b). The thanksgiving offering is described as 'zivchei todah' (Leviticus 7:12). By linking our verse to the phrase 'vizbechu zivchei todah' (Psalms 107:22), Ba'al HaTurim activates the rabbinic reading of Psalm 107, which portrays four redeemed groups—desert travelers, released prisoners, the sick, and sea voyagers—as those obligated to bring thanks (Berakhot 54b).", :sources ["Berakhot 54b" "Psalms 107:22" "Leviticus 7:12"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויזבחו לה'" "ויזבחו זבחי תודה"], :by :selah, :located [{:phrase "ויזבחו לה'", :refs [], :n 0, :lens :plene-insensitive} {:phrase "ויזבחו זבחי תודה", :refs ["Psalms 107:22"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 8, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:23.000234691Z", :model "glm-5.2"}