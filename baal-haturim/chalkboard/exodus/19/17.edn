{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "בתחתית ההר", :translit "b'tachtit ha-har", :gloss "at the bottom of the mountain"} {:he "והר סיני", :translit "ve-har sinai", :gloss "and Mount Sinai"}], :mechanisms [{:kind :other, :note "Reading 'be-tachtit ha-har' as 'at the underside of the mountain' rather than merely 'at the foot of it'"}], :frame {:text "The Talmud reads the phrase 'at the bottom of the mountain' (Exodus 19:17) literally: Israel stood underneath the mountain itself. God held the mountain over them like a barrel and said, 'If you accept the Torah, fine; if not, there shall be your burial.' This is the tradition of the mountain uprooted and suspended over Israel.", :sources ["Shabbat 88a" "Avodah Zarah 2b"]}}], :arithmetic [{:kind :other, :note "Reading 'be-tachtit ha-har' as 'at the underside of the mountain' rather than merely 'at the foot of it'", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:17:23.879815912Z", :model "glm-5.2"}