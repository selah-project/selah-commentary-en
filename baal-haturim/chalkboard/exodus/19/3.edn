{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "ותגיד", :translit "v'tagid", :gloss "and you shall tell"}], :mechanisms [{:kind :other, :note "Plene spelling with extra yod in ותגיד signals the Ten Commandments"}], :frame {:text "The word ותגיד appears with a plene (full) spelling including the letter yod. The letter yod, whose own numerical value is ten, alludes to the aseret ha-dibrot — the Ten Commandments — that Moses was to transmit to Israel at Sinai (Exodus 20:2–14). The fuller spelling of the word 'tell' signals that the content of the telling is specifically the Decalogue.", :sources ["Exodus 20:2–14"]}}], :arithmetic [{:kind :other, :note "Plene spelling with extra yod in ותגיד signals the Ten Commandments", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:17:13.474207387Z", :model "glm-5.2"}