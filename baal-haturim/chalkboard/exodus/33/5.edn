{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "הורד עדיך", :translit "horad imkha", :gloss "bring down [from] upon you"} {:he "באף עמים הורד אלהים", :translit "b'af amim horad elohim", :gloss "in anger nations God brought down"} {:he "הורד אותם אל המים", :translit "horad otam el ha-mayim", :gloss "bring them down to the water"} {:he "בגדעון", :translit "b'gid'on", :gloss "in [the episode of] Gideon"} {:he "הורד", :translit "horad", :gloss "[the word] horad"} {:he "באף עמים הורד", :translit "b'af amim horad", :gloss "in anger nations bring down"} {:he "עכו\"ם", :translit "akum", :gloss "idolatry [abbreviation]"} {:he "ע\"ג", :translit "akum", :gloss "idol [abbreviation]"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["הורד עדיך" "באף עמים הורד אלהים" "הורד אותם אל המים"]}], :frame {:text "The phrase הורד אותם אל המים refers to the test Gideon employed at God's instruction: he brought the men down to the water, and those who lapped by kneeling were separated from those who lapped with hand to mouth (Judges 7:5–6). The Midrash identifies the three hundred who lapped with their hands as righteous and the majority who knelt as idol worshippers, reading their posture as a sign of idolatrous practice (Tanchuma, Amalek 4). The parallel verse באף עמים הורד אלהים (Psalms 56:8) speaks of God casting down nations in wrath.", :sources ["Judges 7:5" "Judges 7:6" "Psalms 56:8" "Tanchuma Amalek 4"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["הורד עדיך" "באף עמים הורד אלהים" "הורד אותם אל המים"], :by :selah, :located [{:phrase "הורד עדיך", :refs ["Exodus 33:5"], :n 1, :lens :exact} {:phrase "באף עמים הורד אלהים", :refs ["Psalms 56:8"], :n 1, :lens :exact} {:phrase "הורד אותם אל המים", :refs ["Judges 7:4"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:51.238953408Z", :model "glm-5.2"}