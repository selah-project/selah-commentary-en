{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "וצא", :translit "u'tze", :gloss "and go out"} {:he "וצא השדה", :translit "u'tze ha-sadeh", :gloss "and go out to the field"}], :mechanisms [{:kind :other, :note "Rare word occurrence: the phrase וצא appears only twice in Tanakh"}], :frame {:text "The Ba'al HaTurim links the two occurrences of 'go out' (וצא): Exodus 17:9, where Moses tells Joshua to go out against Amalek, and Genesis 27:3, where Isaac tells Esau to go out to the field to hunt. Isaac's charge to Esau is read as a directive to leave the shelter of the divine clouds, from which Esau had been protected during his youth (see Genesis Rabbah 63:10 on Genesis 25:27).", :sources ["Genesis 27:3" "Genesis Rabbah 63:10"]}}], :arithmetic [{:kind :other, :note "Rare word occurrence: the phrase וצא appears only twice in Tanakh", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 17, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:50.171919634Z", :model "glm-5.2"}