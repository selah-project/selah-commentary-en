{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "עזי", :translit "ozi", :gloss "my strength"} {:he "עזי וזמרת יה ה' ויהי לי לישועה", :translit "ozi vezimrat yah hashem vayehi li liyshuah", :gloss "my strength and the song of Yah, the LORD, and He was to me for salvation"} {:he "ושאבתם מים בששון ממעיני הישועה", :translit "ush'avtem mayim b'sason mima'aynei ha-yeshuah", :gloss "and you shall draw water with joy from the springs of salvation"} {:he "שמים מתוקים היו נוזלים מקרקע הים", :translit "mayim metukim hayu nozlim mi-karka ha-yam", :gloss "sweet waters would flow from the floor of the sea"} {:he "ושאבו מים בששון", :translit "v'shavu mayim b'sason", :gloss "and they drew water with joy"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["עזי" "עזי וזמרת יה ה' ויהי לי לישועה" "ושאבתם מים בששון ממעיני הישועה"]}], :frame {:text "Isaiah 12:3 promises 'you shall draw water with joy from the springs of salvation.' The Ba'al HaTurim reads this verse as fulfilled at the splitting of the Sea: the word עזי links the Song of the Sea to Hallel (Psalm 118:14, which quotes this very phrase) and to the Isaiah verse. Rabbinic tradition records that at the splitting of the Sea, sweet waters flowed from the sea floor for Israel to drink, fulfilling 'they drew water with joy' (Shemot Rabbah 22:4; Rashi on Exodus 15:25).", :sources ["Isaiah 12:3" "Psalm 118:14" "Shemot Rabbah 22:4" "Rashi on Exodus 15:25"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["עזי" "עזי וזמרת יה ה' ויהי לי לישועה" "ושאבתם מים בששון ממעיני הישועה"], :by :selah, :located [{:phrase "עזי", :refs ["Exodus 15:2" "Isaiah 12:2" "Isaiah 49:5" "Isaiah 56:11" "Jeremiah 16:19" "Psalms 28:7" "Psalms 59:18" "Psalms 62:8"], :n 17, :lens :exact} {:phrase "עזי וזמרת יה ה' ויהי לי לישועה", :refs [], :n 0, :lens :plene-insensitive} {:phrase "ושאבתם מים בששון ממעיני הישועה", :refs ["Isaiah 12:3"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkbo