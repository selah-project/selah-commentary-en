{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "מרתה", :translit "marah", :gloss "Marah (bitter)"} {:he "כי אותי מרתה", :translit "ki oti marah", :gloss "for Me they rebelled"} {:he "מה התם היו ממרים בה' אף הכא נמי", :translit "mah sham hayu mam'rim ba-shem af ha-kan nami", :gloss "just as there they were rebellious against HaShem, so too here"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["מרתה" "מרתה"]} {:kind :other, :note "Gezera shava linking two occurrences of מרתה: Exodus 15:23 and Jeremiah."}], :frame {:text "The Israelites' complaint at Marah—grumbling that the water was undrinkable—is their first act of rebellion after the splitting of the sea (Exodus 15:23–24). In Jeremiah 5:23, God declares 'this people has a rebellious and defiant heart,' using the root מרה, and that same root designates the place Marah. Ba'al HaTurim reads the shared root as evidence of a shared character: as they were rebellious there, so they are here.", :sources ["Exodus 15:23" "Jeremiah 5:23"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["מרתה" "מרתה"], :by :selah, :located [{:phrase "מרתה", :refs ["Exodus 15:23" "Jeremiah 4:17" "Hosea 14:1"], :n 3, :lens :exact} {:phrase "מרתה", :refs ["Exodus 15:23" "Jeremiah 4:17" "Hosea 14:1"], :n 3, :lens :exact}]} {:kind :other, :note "Gezera shava linking two occurrences of מרתה: Exodus 15:23 and Jeremiah.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:24.030126180Z", :model "glm-5.2"}