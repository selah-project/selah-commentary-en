{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "במראות", :translit "b'mar'ot", :gloss "in mirrors"} {:he "במראות הצובאות", :translit "b'mar'ot ha'tzov'ot", :gloss "in the mirrors of the multitudes [of women]"} {:he "ויאמר אלהים", :translit "va'yomer elohim", :gloss "and Elohim said"} {:he "לישראל במראות", :translit "l'yisra'el b'mar'ot", :gloss "to Israel in mirrors"} {:he "במראות אלהים", :translit "b'mar'ot elohim", :gloss "in mirrors of Elohim"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["במראות הצובאות" "ויאמר אלהים" "לישראל במראות" "במראות אלהים"]}], :frame {:text "The righteous women of Israel possessed copper mirrors they used to adorn themselves and entice their husbands after exhausting labor in Egypt; they brought these mirrors as their contribution to the Tabernacle. Moses initially disdained them as instruments of vanity, but the Holy One said they are most beloved, for through them the women raised multitudes in Egypt. From these mirrors the laver and its base were fashioned (Exodus 38:8). The word הצובאות conveys that the women assembled in multitudes by means of these mirrors.", :sources ["Midrash Tanchuma Pekudei 9" "Exodus 38:8"]}} {:quotes [{:he "הצובאות", :translit "ha'tzov'ot", :gloss "the multitudes [of women]"} {:he "במראות הצובאות אשר ישכבון", :translit "b'mar'ot ha'tzov'ot asher yish'kavun", :gloss "in the mirrors of the multitudes who would lie"} {:he "הנשים הצובאות", :translit "ha'na'shim ha'tzov'ot", :gloss "the women of the multitudes"} {:he "ישכבון הנשים הצובאות", :translit "yish'kavun ha'na'shim ha'tzov'ot", :gloss "the women of the multitudes would lie"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["במראות הצובאות אשר ישכבון" "הנשים הצובאות"]}], :frame {:text "The word הצובאות appears in 1 Samuel 2:22, where the women who assembled at the entrance of the Tent of Meeting lay with the sons of Eli. Ba'al HaTurim reads there as here: the women would lie with men. In the Midrash, these mirrors are the ones the Israelite women used in Egypt to adorn themselves and entice their husbands, who would then consort with them (Midrash Tanchuma Pekudei 9).", :sources ["1 Samuel 2:22" "Midrash Tanchuma Pekudei 9"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["במראות הצובאות" "ויאמר אלהים" "לישראל במראות" "במראות אלהים"], :by :selah, :located [{:phrase "במראות הצובאות", :refs ["Exodus 38:8"], :n 1, :lens :plene-insensitive} {:phrase "ויאמר אלהים", :refs ["Genesis 1:3" "Genesis 1:6" "Genesis 1:9" "Genesis 1:11" "Genesis 1:14" "Genesis 1:20" "Genesis 1:24" "Genesis 1:26"], :n 26, :lens :exact} {:phrase "לישראל במראות", :refs ["Genesis 46:2"], :n 1, :lens :plene-insensitive} {:phrase "במראות אלהים", :refs ["Ezekiel 8:3" "Ezekiel 40:2"], :n 2, :lens :exact}]} {:kind :masorah, :count 2, :occurrences ["במראות הצובאות אשר ישכבון" "הנשים הצובאות"], :by :selah, :located [{:phrase "במראות הצובאות אשר ישכבון", :refs [], :n 0, :lens :plene-insensitive} {:phrase "הנשים הצובאות", :refs ["1 Samuel 2:22"], :n 1, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 37, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:22.071601101Z", :model "glm-5.2"}