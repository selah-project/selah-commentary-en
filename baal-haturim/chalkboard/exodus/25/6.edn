{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "שמן למאר", :translit "shemen l'ma'or", :gloss "oil for illumination"} {:he "חסר", :translit "chaser", :gloss "defective (spelled without vav)"} {:he "דלאו לאורה הוא צריך", :translit "d'lo l'orah hu tzarich", :gloss "for it is not needed for illumination"} {:he "וי\"ג דברים נמנו כאן", :translit "v'yud-gimel d'varim nim'nu kan", :gloss "and thirteen things are enumerated here"} {:he "ואנעלך תחש", :translit "v'a'n'al'cha tachash", :gloss "and I shod you with tahash"} {:he "ואעדך עדי", :translit "v'a'ad'cha adi", :gloss "and I adorned you with jewelry"} {:he "ויתנצלו בני ישראל את עדים", :translit "v'yitnatz'lu b'nei yisra'el et ad'yhem", :gloss "and the children of Israel stripped themselves of their ornaments"}], :mechanisms [{:kind :other, :note "Word שמן למאור written without vav in מאור, read as מאר"} {:kind :masorah, :count 13, :occurrences []} {:kind :masorah, :count 13, :occurrences ["ואנעלך תחש" "ואעדך עדי"]}], :frame {:text "The plural form עדים in Exodus 33:6—where Israel strips off ornaments after the golden calf—is read by tradition as עדיים, 'ornaments,' on the level of drash. The broader theme of Israel receiving and then losing spiritual adornments through sin appears in rabbinic literature; e.g., Shabbat 145b–146a discusses how Israel lost the crowns received at Sinai. The verse שמן למאור is found at Exodus 25:6.", :sources ["Exodus 25:6" "Exodus 33:6" "Shabbat 145b"]}}], :arithmetic [{:kind :other, :note "Word שמן למאור written without vav in מאור, read as מאר", :by :selah, :ran? false} {:kind :masorah, :count 13, :occurrences [], :by :selah, :located []} {:kind :masorah, :count 13, :occurrences ["ואנעלך תחש" "ואעדך עדי"], :by :selah, :located [{:phrase "ואנעלך תחש", :refs ["Ezekiel 16:10"], :n 1, :lens :exact} {:phrase "ואעדך עדי", :refs ["Ezekiel 16:11"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:1