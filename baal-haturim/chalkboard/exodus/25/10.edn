{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "ועשו ארון", :translit "va'asu aron", :gloss "and they shall make an ark"} {:he "בכולם כתיב ועשית", :translit "b'cholam katuv va'asita", :gloss "in all of them it is written 'and you shall make'"} {:he "ועשו", :translit "va'asu", :gloss "and they shall make"} {:he "ארון", :translit "aron", :gloss "ark"} {:he "אותיות אורן", :translit "otiyot oran", :gloss "letters: their light"} {:he "אורן", :translit "oran", :gloss "their light"} {:he "אותיות נורא", :translit "otiyot nora", :gloss "letters: awesome"} {:he "נורא", :translit "nora", :gloss "awesome"} {:he "אש אוכלה", :translit "esh ochlah", :gloss "consuming fire"} {:he "ארון בגימ' נזר", :translit "aron b'gimatria nezer", :gloss "aron in gematria nezer"} {:he "נזר", :translit "nezer", :gloss "crown"} {:he "כתר תורה", :translit "keter torah", :gloss "crown of Torah"} {:he "ועשית עליו זר זהב", :translit "va'asita alav zar zahav", :gloss "and you shall make upon it a crown of gold"} {:he "ועשית לו", :translit "va'asita lo", :gloss "and you shall make for it"} {:he "אמתים וחצי ארכו ואמה וחצי רחבו ואמה וחצי קומתו", :translit "amotayim vachatzi archó v'amah vachatzi rochbo v'amah vachatzi komato", :gloss "two and a half cubits its length and a cubit and a half its width and a cubit and a half its height"}], :mechanisms [{:kind :other, :note "Plural verb ועשו instead of singular ועשית: all vessels Solomon remade except the ark"} {:kind :other, :note "Letter rearrangement: ארון = אורן"} {:kind :other, :note "Letter rearrangement: ארון = נורא"} {:kind :gematria, :a "ארון", :b "נזר"} {:kind :other, :note "Symbolic reading: all ark measurements include fractions, teaching that Torah students must humble themselves"}], :frame {:text "1 Kings 7:48–50 relates that Solomon made all the vessels, but the ark is absent from that list because Israel carried the original ark into the Temple. The letters of ארון rearrange to אורן ('their light'), recalling Isaiah 60:3 which speaks of light to the nations, and to נורא ('awesome'), recalling the description of God as consuming fire in Deuteronomy 4:24. The phrase 'crown of Torah' appears in Avot 4:17 alongside the 'crown of kingship' and the 'crown of priesthood', and Avot 6:4 identifies the crown of Torah as superior to the others. The term 'crown of gold' (זר זהב) in Exodus 25:11 and the corresponding phrase for the table in Exodus 25:24 are read as allusions to these crowns. The teaching that Torah study requires humility is expressed in the dictum of Rav in Shabbat 88a that one must make oneself like a desert for Torah, and in the warning of Avot 2:4, 'do not be arrogant.'", :sources ["1 Kings 7:48–50" "Isaiah 60:3" "Deuteronomy 4:24" "Exodus 25:11" "Exodus 25:24" "Avot 4:17" "Avot 6:4" "Shabbat 88a" "Avot 2:4"]}} {:quotes [{:he "ועשו ארון", :translit "va'asu aron", :gloss "and they shall make an ark"} {:he "י' פרשיות מתחילין בעשייה", :translit "yud parshiyot matchilin b'asiyah", :gloss "ten sections begin with making"} {:he "עשרה מאמרות שבהן נברא העולם", :translit "asarah ma'amarot shebahen nivra ha'olam", :gloss "ten utterances by which the world was created"}], :mechanisms [{:kind :other, :note "Correspondence: ten scriptural sections beginning with 'making' parallel the ten utterances of creation"}], :frame {:text "Mishnah Avot 5:1 enumerates 'ten utterances' (asarah ma'amarot) by which God created the world, derived by counting the word ויאמר ten times in Genesis 1. The ten parshiyot that begin with the root עשה, commencing with 'And they shall make an ark' in Exodus 25:10, are read as corresponding to these ten utterances of creation.", :sources ["Avot 5:1" "Genesis 1" "Exodus 25:10"]}}], :arithmetic [{:kind :other, :note "Plural verb ועשו instead of singular ועשית: all vessels Solomon remade except the ark", :by :selah, :ran? false} {:kind :other, :note "Letter rearrangement: ארון = אורן", :by :selah, :ran? false} {:kind :other, :note "Letter rearrangement: ארון = נורא", :by :selah, :ran? false} {:kind :gematria, :a "ארון", :a-value 257, :b "נזר", :b-value 257, :lens :standard, :by :selah, :equal? true} {:kind :other, :note "Symbolic reading: all ark measurements include fractions, teaching that Torah students must humble themselves", :by :selah, :ran? false} {:kind :other, :note "Correspondence: ten scriptural sections beginning with 'making' parallel the ten utterances of creation", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:19:25.046808688Z", :model "glm-5.2"}