{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "תשרוף באש", :translit "tisrof ba'esh", :gloss "you shall burn with fire"} {:he "ואת מרכבותיהם תשרף באש", :translit "v'et merkavoteihem tisrof ba'esh", :gloss "and their chariots you shall burn with fire"} {:he "ואת העיר הזאת תשרף באש", :translit "v'et ha'ir ha'zot tisrof ba'esh", :gloss "and this city you shall burn with fire"} {:he "ג' הכא ואידך", :translit "g' Haka v'idach", :gloss "three here and the others"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["תשרוף באש" "ואת מרכבותיהם תשרף באש" "ואת העיר הזאת תשרף באש"]} {:kind :other, :note "Linking three identical phrases across Joshua, Kings, and Exodus into a causal narrative about the merit of sacrifices."}], :frame {:text "Joshua was commanded to burn the chariots of the defeated Canaanite kings (Joshua 11:6, 11:9). Jeremiah prophesied to Zedekiah that Jerusalem would be burned (Jeremiah 38:18, repeated at 38:23). The Ba'al HaTurim reads the shared rare phrase תשרף באש as a thread linking these events: the sacrificial order established at Sinai stood as merit for Joshua's victories; when that order was neglected and Jerusalem was besieged, that merit was lost and the city fell.", :sources ["Joshua 11:6" "Joshua 11:9" "Jeremiah 38:18" "Jeremiah 38:23"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["תשרוף באש" "ואת מרכבותיהם תשרף באש" "ואת העיר הזאת תשרף באש"], :by :selah, :located [{:phrase "תשרוף באש", :refs ["Exodus 29:14" "Joshua 11:6" "Jeremiah 38:17" "Jeremiah 38:23"], :n 4, :lens :plene-insensitive} {:phrase "ואת מרכבותיהם תשרף באש", :refs ["Joshua 11:6"], :n 1, :lens :plene-insensitive} {:phrase "ואת העיר הזאת תשרף באש", :refs ["Jeremiah 38:23"], :n 1, :lens :exact}]} {:kind :other, :note "Linking three identical phrases across Joshua, Kings, and Exodus into a causal narrative about the merit of sacrifices.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :