{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "והלבשתם", :translit "u-v'halbashtam", :gloss "and you shall dress them"} {:he "והלבשתם את אלעזר", :translit "u-v'halbashtam et el'azar", :gloss "and you shall dress Elazar"} {:he "והלבשתם כתנות", :translit "u-v'halbashtam kutnot", :gloss "and you shall dress them in tunics"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והלבשתם" "והלבשתם את אלעזר"]}], :frame {:text "The phrase והלבשתם appears exactly twice in the Torah: here in Exodus 29:8 at the investiture of Aaron's sons and in Numbers 20:28 at the investiture of Elazar. The Ba'al HaTurim reasons from this verbal link: Elazar, son of Aharon the High Priest, succeeded his father as High Priest and required anointing oil just as Aaron's sons did at the original consecration in Exodus 29. The broader question of whether a High Priest who is the son of a High Priest requires anointing is addressed in tractate Horayot 12b and in Sifrei Zuta 20:28.", :sources ["Horayot 12b" "Sifrei Zuta 20:28"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והלבשתם" "והלבשתם את אלעזר"], :by :selah, :located [{:phrase "והלבשתם", :refs ["Exodus 29:8" "Numbers 20:26"], :n 2, :lens :exact} {:phrase "והלבשתם את אלעזר", :refs ["Numbers 20:26"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:02.267004544Z", :model "glm-5.2"}