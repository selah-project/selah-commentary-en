{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "ובגדיו", :translit "u-vigdav", :gloss "and his garments"} {:he "ובגדיו קרועים", :translit "u-vigdav keru'im", :gloss "and his garments were torn"} {:he "ובגדיו לא יפרום", :translit "u-vigdav lo yifrom", :gloss "and his garments he shall not tear"} {:he "ובגדיו לא תשרפנה", :translit "u-vigdav lo tisrafnah", :gloss "and his garments you shall not burn them"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["ובגדיו קרועים" "ובגדיו לא יפרום" "ובגדיו לא תשרפנה"]}], :frame {:text "The high priest may not tear his garments in mourning, as stated at Leviticus 21:10. David mourned Saul's death wearing torn garments, as recorded at 2 Samuel 1:11. The flesh of Nadav and Avihu was consumed by fire, as stated at Leviticus 10:2. The Talmud records a dispute: Rav says their souls were burned but their bodies remained, while Rabbi Yochanan says their bodies were burned but their garments remained (Zevachim 115b). The Talmud derives that a mourner is obligated in keriah (tearing) from the verse about David (Mo'ed Katan 26b).", :sources ["Leviticus 21:10" "2 Samuel 1:11" "Leviticus 10:2" "Zevachim 115b" "Mo'ed Katan 26b"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["ובגדיו קרועים" "ובגדיו לא יפרום" "ובגדיו לא תשרפנה"], :by :selah, :located [{:phrase "ובגדיו קרועים", :refs ["2 Samuel 1:2"], :n 1, :lens :plene-insensitive} {:phrase "ובגדיו לא יפרום", :refs ["Leviticus 21:10"], :n 1, :lens :plene-insensitive} {:phrase "ובגדיו לא תשרפנה", :refs ["Proverbs 6:27"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:05.769332307Z", :model "glm-5.2"}