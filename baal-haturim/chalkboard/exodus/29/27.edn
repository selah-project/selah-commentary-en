{:tier :glm-5.2, :verse 27, :comments [{:quotes [{:he "ומאשר", :translit "u-me'ashar", :gloss "and from what was presented"} {:he "ומאשר לאבינו עשה את כל הכבוד הזה", :translit "u-me'ashar lo avinu asah et kol ha-kavod ha-zeh", :gloss "and from what was presented to our father he did all this honor"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ומאשר" "ומאשר לאבינו עשה את כל הכבוד הזה"]} {:kind :other, :note "Homiletical link: Aaron's service brought priestly honor to his sons."}], :frame {:text "The Ba'al HaTurim records a Masoretic note that the word ומאשר appears exactly twice in Scripture. He then draws a homiletical connection between the two occurrences: just as the verse in Proverbs 31:29 describes a father's merit producing honor, so Aaron's dedication brought priestly anointing to his sons. The concept that Aaron's sons received the priesthood through his merit aligns with the priestly covenant described in Numbers 25:13, where Pinhas and his descendants receive a covenant of eternal priesthood.", :sources ["Numbers 25:13" "Proverbs 31:29"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ומאשר" "ומאשר לאבינו עשה את כל הכבוד הזה"], :by :selah, :located [{:phrase "ומאשר", :refs ["Genesis 31:1" "Exodus 29:27" "1 Chronicles 12:37"], :n 3, :lens :exact} {:phrase "ומאשר לאבינו עשה את כל הכבוד הזה", :refs ["Genesis 31:1"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Homiletical link: Aaron's service brought priestly honor to his sons.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:05.683870891Z", :model "glm-5.2"}