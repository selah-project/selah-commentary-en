{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "האסיף", :translit "ha'asif", :gloss "the gathering"} {:he "ב' במס'", :translit "bet b'masoret", :gloss "two in the Masoretic count"} {:he "האסיף תקופת השנה", :translit "ha'asif tekufat ha-shanah", :gloss "the gathering, the cycle of the year"} {:he "וחג האסיף תקופת השנה", :translit "ve-chag ha'asif tekufat ha-shanah", :gloss "and the festival of the gathering, the cycle of the year"} {:he "חג האסיף", :translit "chag ha'asif", :gloss "festival of the gathering"} {:he "בתקופה חדשה", :translit "b'tekufah chadashah", :gloss "in a new cycle"} {:he "בתקופה ישנה", :translit "b'tekufah yeshanah", :gloss "in an old cycle"} {:he "חג האסיף", :translit "chag ha'asif", :gloss "festival of the gathering"} {:he "בצאת השנה", :translit "b'tzeit ha-shanah", :gloss "at the going out of the year"} {:he "תקופת השנה", :translit "tekufat ha-shanah", :gloss "cycle of the year"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["האסיף"]} {:kind :other, :note "Derives from Exodus 23:16 and Deuteronomy 16:13 that חג האסיף must coincide with a new tekufah."}], :frame {:text "The phrase חג האסיף appears in Exodus 23:16 in the context of בצאת השנה, 'when the year goes out.' Deuteronomy 16:13 parallels it with the phrase חג האסיף תקופת השנה, 'the festival of gathering, the cycle of the year.' Sanhedrin 13a cites this to teach that חג האסיף must fall in a new tekufah, i.e., after the autumnal equinox. Ba'al HaTurim resolves the apparent difficulty that Exodus 23:16's phrase בצאת השנה sounds like the end of an old cycle by arguing that 'going out of the year' necessitates entering a new tekufah.", :sources ["Exodus 23:16" "Deuteronomy 16:13" "Sanhedrin 13a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["האסיף"], :by :selah, :located [{:phrase "האסיף", :refs ["Exodus 34:22"], :n 1, :lens :exact}]} {:kind :other, :note "Derives from Exodus 23:16 and Deuteronomy 16:13 that חג האסיף must coincide with a new tekufah.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:46.110243913Z", :model "glm-5.2"}