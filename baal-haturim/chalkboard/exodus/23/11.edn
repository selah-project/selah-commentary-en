{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "ויתרם", :translit "v'yitram", :gloss "and their remainder"} {:he "ואידך", :translit "v'ideich", :gloss "and the other"} {:he "ואידך ויתרם אכלה אש", :translit "v'ideich v'yitram achlah eish", :gloss "and the other 'their remainder fire consumed'"} {:he "שפירות שביעית אסורים בהנאה", :translit "she-pirotei shvi'it asurim b'han'ah", :gloss "that the fruits of the Sabbatical year are forbidden in benefit"} {:he "ותופסין את דמיהן", :translit "v'tofsin et dmeyhen", :gloss "and their monies are held"} {:he "וצריך לבערן", :translit "v'tzarich l'ba'eran", :gloss "and one must destroy them"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויתרם" "ואידך ויתרם אכלה אש"]}], :frame {:text "The phrase ותופסין את דמיהן refers to the rabbinic principle of kedushat perot shvi'it, whereby the holiness of the Sabbatical year attaches to the fruit themselves so that any money received in exchange for them is consecrated and may only be used for equivalent food, which must then itself be consumed or destroyed (Mishnah Shevi'it 7:3–4). The obligation לבערן, to destroy what remains, is articulated at Mishnah Shevi'it 9:8 and elaborated in Pesachim 52b.", :sources ["Mishnah Shevi'it 7:3" "Mishnah Shevi'it 7:4" "Mishnah Shevi'it 9:8" "Pesachim 52b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויתרם" "ואידך ויתרם אכלה אש"], :by :selah, :located [{:phrase "ויתרם", :refs ["Exodus 23:11" "Job 22:20"], :n 2, :lens :exact} {:phrase "ואידך ויתרם אכלה אש", :refs [], :n 0, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:45.700629839Z", :model "glm-5.2"}