{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "מה תצעק אלי", :translit "mah titz'ak elai", :gloss "Why do you cry out to Me"} {:he "אל נא רפא נא לה", :translit "el na refa na lah", :gloss "Please God heal her please"} {:he "דבר אל בני ישראל ויסעו", :translit "daber el b'nei yisra'el v'yisa'u", :gloss "Speak to the children of Israel and let them journey"}], :mechanisms [{:kind :other, :note "He reads the rebuke as a veiled allusion to Moses's future prayer episodes"} {:kind :gematria, :a "מה תצעק אלי", :b "להתפלל"} {:kind :masorah, :count 7, :occurrences ["אל נא רפא נא לה"]}], :frame {:text "Moses spent forty days and forty nights on Mount Sinai receiving the Torah (Exodus 24:18; Deuteronomy 9:9). Miriam was afflicted with tzara'at and Moses prayed for her healing with the five-word petition 'El na refa na lah' (Numbers 12:13). Ecclesiastes 3:1 states there is an appointed time for every matter, and Ecclesiastes 3:5 distinguishes 'a time to cast away stones and a time to gather stones,' which rabbinic interpretation reads as a time to shorten prayer and a time to lengthen prayer (Shabbat 30b). God's instruction that Israel should journey forward into the sea appears in Exodus 14:15.", :sources ["Exodus 24:18" "Deuteronomy 9:9" "Numbers 12:13" "Ecclesiastes 3:1" "Ecclesiastes 3:5" "Shabbat 30b" "Exodus 14:15"]}}], :arithmetic [{:kind :other, :note "He reads the rebuke as a veiled allusion to Moses's future prayer episodes", :by :selah, :ran? false} {:kind :gematria, :a "מה תצעק אלי", :a-value 746, :b "להתפלל", :b-value 575, :lens :standard, :by :selah, :equal? false} {:kind :masorah, :count 7, :occurrences ["אל נא רפא נא לה"], :by :selah, :located [{:phrase "אל נא רפא נא לה", :refs ["Numbers 12:13"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:50.068537663Z", :model "glm-5.2"}