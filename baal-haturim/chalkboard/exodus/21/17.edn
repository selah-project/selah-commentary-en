{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "ומקלל אביו", :translit "umekaleil aviv", :gloss "and he who curses his father"} {:he "בסקילה", :translit "b'skilah", :gloss "by stoning"}], :mechanisms [{:kind :gematria, :a "ומקלל אביו", :b "בסקילה"}], :frame {:text "The penalty for cursing a parent is death by stoning, explicitly stated at Exodus 21:17 and paralleled at Leviticus 20:9. The Mishnah records the judicial procedure for stoning executions (Sanhedrin 6:4).", :sources ["Exodus 21:17" "Leviticus 20:9" "Mishnah Sanhedrin 6:4"]}} {:quotes [{:he "ומקלל", :translit "umekaleil", :gloss "and he who curses"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ומקלל אביו ואמו" "ולא יסף לקלל"]} {:kind :other, :note "The phrase occurs once here at a verse head and once at a verse tail, signaling a fall from head to tail."}], :frame {:text "Shimei son of Gera cursed King David and was later executed by Solomon (I Kings 2:8–9, 36–46). David instructed Solomon not to hold Shimei innocent, and Solomon confined him to Jerusalem; when Shimei left to retrieve slaves, Solomon had him killed. The proverbial 'head and tail' idiom for leaders and their ruin is drawn from Deuteronomy 28:44, 'you shall be only a head and not a tail,' inverted in curse.", :sources ["I Kings 2:8-9" "I Kings 2:36-46" "Deuteronomy 28:44"]}}], :arithmetic [{:kind :gematria, :a "ומקלל אביו", :a-value 225, :b "בסקילה", :b-value 207, :lens :standard, :by :selah, :equal? false} {:kind :masorah, :count 2, :occurrences ["ומקלל אביו ואמו" "ולא יסף לקלל"], :by :selah, :located [{:phrase "ומקלל אביו ואמו", :refs ["Exodus 21:17"], :n 1, :lens :exact} {:phrase "ולא יסף לקלל", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "The phrase occurs once here at a verse head and once at a verse tail, signaling a fall from head to tail.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:02.2711