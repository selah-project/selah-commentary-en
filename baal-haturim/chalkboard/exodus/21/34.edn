{:tier :glm-5.2, :verse 34, :comments [{:quotes [{:he "לבעליו", :translit "l'ba'alav", :gloss "to its owner"} {:he "ישלם לבעליו", :translit "yeshalem l'ba'alav", :gloss "he shall pay to its owner"} {:he "עושר שמור לבעליו לרעתו", :translit "osher shamur l'ba'alav l'ra'ato", :gloss "wealth guarded for its owner to his detriment"} {:he "ישיב", :translit "yashiv", :gloss "he shall restore"} {:he "בשומר שכר", :translit "b'shomel sakhar", :gloss "in [the passage of] a paid watchman"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["לבעליו" "ישלם לבעליו" "לבעליו"]} {:kind :other, :note "לבעליו read as לרעתו ('to his detriment'): wealth that obligates the owner to pay damages"}], :frame {:text "The phrase עושר שמור לבעליו לרעתו echoes Ecclesiastes 5:12, ועושר שמור לבעליו לרעתו, 'and wealth kept for its owner to his hurt.' The rabbinic principle that one who digs a pit in the public domain is fully liable for damages is stated at Bava Kamma 28b. The teaching that ישיב, 'he shall restore,' includes even low-value items such as bran is found at Bava Kamma 7b. The same principle is extended to a paid watchman's liability in the parallel passage.", :sources ["Ecclesiastes 5:12" "Bava Kamma 28b" "Bava Kamma 7b"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["לבעליו" "ישלם לבעליו" "לבעליו"], :by :selah, :located [{:phrase "לבעליו", :refs ["Exodus 21:34" "Exodus 22:11" "Ecclesiastes 5:12"], :n 3, :lens :exact} {:phrase "ישלם לבעליו", :refs ["Exodus 22:11"], :n 1, :lens :exact} {:phrase "לבעליו", :refs ["Exodus 21:34" "Exodus 22:11" "Ecclesiastes 5:12"], :n 3, :lens :exact}]} {:kind :other, :note "לבעליו read as לרעתו ('to his detriment'): wealth that obligates the owner to pay damages", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:17.504735489Z", :model "glm-5.2"}