{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "וכי ינצו אנשים", :translit "v'chi yinatzu anashim", :gloss "and when men struggle"} {:he "וכי יחדיו כי ינצו אנשים יחדו איש ואחיו", :translit "v'chi yachdav ki yinatzu anashim yachdo ish v'achiv", :gloss "and when together men struggle together, a man and his brother"} {:he "וקצותה את כפה", :translit "v'katzatah et kappah", :gloss "and you shall cut off her hand"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וכי ינצו אנשים" "וכי יחדיו כי ינצו אנשים יחדו איש ואחיו"]}], :frame {:text "The phrase 'וקצותה את כפה' (Deut 25:12) is interpreted by R. Yishmael as monetary compensation rather than literal mutilation, cited at Bava Kamma 28b and Sanhedrin 84a–b. The other occurrence is Deut 25:11, where two men struggle and a woman intervenes. A gezeirah shavah links these two verses both using 'כי ינצו אנשים': just as there the payment is monetary, so too here, where the fighters intended to kill one person but accidentally killed another, they are exempt from capital punishment and liable monetarily.", :sources ["Deuteronomy 25:11" "Deuteronomy 25:12" "Bava Kamma 28b" "Sanhedrin 84b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וכי ינצו אנשים" "וכי יחדיו כי ינצו אנשים יחדו איש ואחיו"], :by :selah, :located [{:phrase "וכי ינצו אנשים", :refs ["Exodus 21:22"], :n 1, :lens :exact} {:phrase "וכי יחדיו כי ינצו אנשים יחדו איש ואחיו", :refs [], :n 0, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:08.701032793Z", :model "glm-5.2"}