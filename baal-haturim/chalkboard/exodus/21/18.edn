{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "באגרוף", :translit "b'agrof", :gloss "with a fist"} {:he "במסה", :translit "b'masah", :gloss "in a quarrel"} {:he "ולהכות באגרוף", :translit "u'l'hakot b'agrof", :gloss "and to strike with a fist"} {:he "באגרוף רשע", :translit "b'agrof rasha", :gloss "with a wicked fist"}], :mechanisms [{:kind :other, :note "Rare phrase במסה appears only twice; the other instance is Numbers 35:21 ולהכות באגרוף"} {:kind :other, :note "Context of באגרוף רשע links to imprisonment pending outcome, per Mishnah Sanhedrin 9:1"}], :frame {:text "Mishnah Sanhedrin 9:1 distinguishes the striker in a quarrel (מכה אדם במסה) from one who strikes with a stone or fist (ולהכות באבן או באגרוף, Numbers 35:21): the former is imprisoned if the victim lingers and then dies, while the latter is executed outright because the implement itself proves lethal intent. Numbers 35:21 calls the blow ולהכות באגרוף and the perpetrator רשע — 'the wicked' — whom the avenger of blood may kill. The rare word במסה occurs only at Exodus 21:22 and Numbers 35:21, tying the two legal passages together.", :sources ["Mishnah Sanhedrin 9:1" "Numbers 35:21" "Exodus 21:22"]}}], :arithmetic [{:kind :other, :note "Rare phrase במסה appears only twice; the other instance is Numbers 35:21 ולהכות באגרוף", :by :selah, :ran? false} {:kind :other, :note "Context of באגרוף רשע links to imprisonment pending outcome, per Mishnah Sanhedrin 9:1", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:06.115527433Z", :model "glm-5.2"}