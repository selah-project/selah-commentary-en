{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "ארבעה טורים", :translit "arba'ah turim", :gloss "four rows"} {:he "כנגד ד' דגלים", :translit "keneged da' diglim", :gloss "corresponding to four banners"} {:he "וד' אמהות", :translit "ve-da' imahot", :gloss "and four matriarchs"} {:he "בכל אבן היה שש אותיות", :translit "be-chol even hayah shesh otot", :gloss "in each stone there were six letters"} {:he "שמות שלשת האבות", :translit "shemot sheloshet ha-avot", :gloss "names of the three patriarchs"} {:he "ושבטי ישורון", :translit "u-shivtei yeshurun", :gloss "and the tribes of Yeshurun"} {:he "מצטרף עם כל אחד ואחד", :translit "mitztaref im kol echad ve-echad", :gloss "combine with each and every one"} {:he "עד שיהיה ו' אותיות", :translit "ad she-yihyeh vav otot", :gloss "until there are six letters"} {:he "ראובן וא' דאברהם", :translit "re'uven ve-alef d'avraham", :gloss "Reuben and alef of Abraham"} {:he "שמעון ב'", :translit "shim'on bet", :gloss "Simeon bet"} {:he "לוי רה\"מ", :translit "levi ra'ha'm", :gloss "Levi resh heh mem"} {:he "יהודה י' דיצחק", :translit "yehudah yod d'yitzchak", :gloss "Judah yod of Isaac"} {:he "יששכר צ'", :translit "yissachar tsadi", :gloss "Issachar tsadi"} {:he "זבולן ח'", :translit "zevulun chet", :gloss "Zebulun chet"} {:he "דן ק' יעק מיעקב", :translit "dan qof ya'aq mi-ya'aqov", :gloss "Dan qof of Ya'aq from Ya'aqov"} {:he "נפתלי ב'", :translit "naftali bet", :gloss "Naphtali bet"} {:he "גד שבטי", :translit "gad shivtei", :gloss "Gad Shivtei"} {:he "אשר יש\"ו", :translit "asher yod-shin-vav", :gloss "Asher yod-shin-vav"} {:he "יוסף ר\"ן", :translit "yosef resh-nun", :gloss "Joseph resh-nun"} {:he "ובנימין לא היה צריך צירוף", :translit "u-vinyamin lo hayah tzarich tziruf", :gloss "and Benjamin did not need combining"} {:he "כי היה בו ו' אותיות", :translit "ki hayah bo vav otot", :gloss "for it already had six letters"}], :mechanisms [{:kind :other, :note "Each tribe name supplemented with letters from patriarchs' names to reach six letters per stone"} {:kind :notarikon, :word "רה\"מ", :expansion ["ר" "ה" "מ"]} {:kind :notarikon, :word "יש\"ו", :expansion ["י" "ש" "ו"]} {:kind :notarikon, :word "ר\"ן", :expansion ["ר" "ן"]}], :frame {:text "The twelve tribes of Israel encamped in the wilderness under four banners, three tribes per banner, corresponding to the four rows of stones on the High Priest's breastplate (Numbers 2:1-34). The names of the twelve tribes were engraved on the twelve stones of the breastplate, six on each shoulder stone and six rows on the breastplate itself (Exodus 28:17-21). A midrashic tradition records that the names of the three patriarchs—Abraham, Isaac, and Jacob—were also engraved upon the stones of the breastplate, so that each stone contained not only a tribe name but additional letters to complete the set of patriarchal names (Bamidbar Rabbah 2:7; Tanchuma Pequdei 5).", :sources ["Numbers 2:1-34" "Exodus 28:17-21" "Bamidbar Rabbah 2:7" "Tanchuma Pequdei 5"]}}], :arithmetic [{:kind :other, :note "Each tribe name supplemented with letters from patriarchs' names to reach six letters per stone", :by :selah, :ran? false} {:kind :notarikon, :word "רה\"מ", :expansion ["ר" "ה" "מ"], :initials ["ר" "ה" "מ"], :by :selah, :initials-match? true} {:kind :notarikon, :word "יש\"ו", :expansion ["י" "ש" "ו"], :initials ["י" "ש" "ו"], :by :selah, :initials-match? true} {:kind :notarikon, :word "ר\"ן", :expansion ["ר" "ן"], :initials ["ר" "נ"], :by :selah, :initials-match? true}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:19:58.753799393Z", :model "glm-5.2"}