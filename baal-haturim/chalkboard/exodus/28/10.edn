{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "ששה משמותם על", :translit "shishah mishmoteyhem al", :gloss "six of their names upon"} {:he "שמע שאמרו שמע ישראל", :translit "shema she'omru shema yisra'el", :gloss "Hear they said Hear O Israel"}], :mechanisms [{:kind :rashei-tevot, :phrase "ששה משמותם על", :spells "שמע"}], :frame {:text "The phrase ששה משמותם על, describing six of the twelve tribal names engraved on the high priest's shoulder stones, yields by rashei tevot the word שמע. The Ba'al HaTurim expands this acronym into the phrase שמע שאמרו שמע ישראל, connecting the six names to the declaration of Shema. The verse describes the high priest bearing the names of the tribes as remembrances before God (Exodus 28:12).", :sources ["Exodus 28:12"]}}], :arithmetic [{:kind :rashei-tevot, :phrase "ששה משמותם על", :spells "שמע", :letters ["ש" "מ" "ע"], :by :selah, :order :in-order}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:19:45.856010242Z", :model "glm-5.2"}