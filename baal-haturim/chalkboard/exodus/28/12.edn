{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "שמותם", :translit "shemotam", :gloss "their names"} {:he "ואלה שמותם במרגלים", :translit "ve'eleh shemotam bameragelim", :gloss "and these are their names among the spies"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["שמותם" "ואלה שמותם במרגלים"]} {:kind :other, :note "Gezeirah shavah of shemotam links the stones of the breastplate to the listing of the spies."}], :frame {:text "The twelve tribal names inscribed on the stones of the High Priest's shoulder-pieces correspond to the twelve men sent by Moses to scout the Land in Numbers 13. Since both groups carry the full set of tribal names, Ba'al HaTurim links them: the two occurrences of שמותם teach that just as the tribal names on the stones were set in place by divine command (Exodus 28:9–12), so the spies were selected with divine approval. The tradition that Moses chose the spies by divine counsel is stated explicitly in the verse itself: God tells Moses to send men (Numbers 13:1–2), and the Midrash notes that at the moment of selection they were all righteous (Tanchuma, Shelach 4).", :sources ["Numbers 13:1–2" "Tanchuma Shelach 4" "Exodus 28:9–12"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["שמותם" "ואלה שמותם במרגלים"], :by :selah, :located [{:phrase "שמותם", :refs ["Exodus 28:12" "Numbers 13:4" "1 Kings 4:8" "Psalms 16:4" "Ezra 8:13" "1 Chronicles 8:38" "1 Chronicles 9:44"], :n 7, :lens :exact} {:phrase "ואלה שמותם במרגלים", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Gezeirah shavah of shemotam links the stones of the breastplate to the listing of the spies.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:19:50.408550022Z", :model "glm-5.2"}