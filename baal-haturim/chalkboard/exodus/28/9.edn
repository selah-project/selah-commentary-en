{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "שתי אבני שהם", :translit "shtei avnei shoham", :gloss "two shoham stones"} {:he "שהם", :translit "shoham", :gloss "shoham"} {:he "הלוחות", :translit "ha-luchot", :gloss "the tablets"}], :mechanisms [{:kind :gematria, :a "שי\"ן ה\"י מ\"ם", :b "הלוחות"}], :frame {:text "The twelve stones of the high priest's breastplate and shoulder-pieces correspond symbolically to the twelve tribes of Israel (Exodus 28:9–12, 28:15–21). The Ba'al HaTurim here identifies a further correspondence: the two shoham stones on the shoulders point to the two tablets of the covenant given at Sinai (Exodus 31:18).", :sources ["Exodus 28:9–12" "Exodus 28:15–21" "Exodus 31:18"]}}], :arithmetic [{:kind :gematria, :a "שי\"ן ה\"י מ\"ם", :a-value 455, :b "הלוחות", :b-value 455, :lens :standard, :by :selah, :equal? true}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:19:42.800864618Z", :model "glm-5.2"}