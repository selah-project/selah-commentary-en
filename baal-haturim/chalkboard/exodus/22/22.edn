{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "תענה", :translit "te'aneh", :gloss "you [masc. sg.] afflict"} {:he "אם ענה תענה", :translit "im aneh te'aneh", :gloss "if you afflict"} {:he "אם תענה את בנותי", :translit "im te'aneh et benotai", :gloss "if you afflict my daughters"} {:he "אם תענה", :translit "im te'aneh", :gloss "if you afflict"} {:he "אלמנה ויתום לא תענון", :translit "almanah v'yetom lo te'anun", :gloss "widow and orphan you shall not afflict"} {:he "אם ענה תענה", :translit "im aneh te'aneh", :gloss "if you afflict"} {:he "לא תענון", :translit "lo te'anun", :gloss "you [pl.] shall not afflict"} {:he "אם ענה תענה", :translit "im aneh te'aneh", :gloss "if you afflict"} {:he "ענה תענה", :translit "aneh te'aneh", :gloss "afflicting you shall afflict"} {:he "צעק יצעק", :translit "tza'ok yitz'ok", :gloss "cry out he will cry out"} {:he "שמע אשמע", :translit "shamo'a eshma", :gloss "hearing I will hear"}], :mechanisms [{:kind :other, :note "Word תענה appears twice in close proximity: Exodus 22:21 (אם ענה תענה) and Exodus 22:22 (אם תענה את בנותי)"} {:kind :other, :note "Gezerah shavah: verbal analogy links לא תענון (Exodus 22:21) with אם ענה תענה (Exodus 22:21) to derive laws of afflicting widows"} {:kind :other, :note "Grammatical contrast: לא תענון has plural nun, אם ענה תענה is singular form"} {:kind :other, :note "Pattern of doubled verb forms: ענה תענה, צעק יצעק, שמע אשמע — all in Exodus 22:22–23"} {:kind :other, :note "Midah ke-neged midah: measure-for-measure — the doubled language teaches that God repays affliction measure for measure"}], :frame {:text "The verbal root ע-נ-ה carries the meaning of affliction or oppression. The phrase כאלמנות חיות, 'living widows,' refers to a woman whose husband has not actually died but who is deprived of marital relations; this usage appears in Bava Batra 13b in the context of a man who refrains from relations with his wife. The concept that all Israel are guarantors for one another (כל ישראל ערבין זה בזה) is stated in Shavuot 39a. The principle of measure-for-measure punishment (מדה כנגד מדה) is articulated in Sotah 8b–9a and applied to the affliction of widows and orphans in Mekhilta de-Rabbi Yishmael, Nezikin, Mesechta de-Kaspa, parasha 20.", :sources ["Bava Batra 13b" "Shavuot 39a" "Sotah 8b" "Sotah 9a" "Mekhilta de-Rabbi Yishmael, Nezikin, Mesechta de-Kaspa 20"]}}], :arithmetic [{:kind :other, :note "Word תענה appears twice in close proximity: Exodus 22:21 (אם ענה תענה) and Exodus 22:22 (אם תענה את בנותי)", :by :selah, :ran? false} {:kind :other, :note "Gezerah shavah: verbal analogy links לא תענון (Exodus 22:21) with אם ענה תענה (Exodus 22:21) to derive laws of afflicting widows", :by :selah, :ran? false} {:kind :other, :note "Grammatical contrast: לא תענון has plural nun, אם ענה תענה is singular form", :by :selah, :ran? false} {:kind :other, :note "Pattern of doubled verb forms: ענה תענה, צעק יצעק, שמע אשמע — all in Exodus 22:22–23", :by :selah, :ran? false} {:kind :other, :note "Midah ke-neged midah: measure-for-measure — the doubled language teaches that God repays affliction measure for measure", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:36.246872921Z", :model "glm-5.2"}