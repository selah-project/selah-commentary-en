{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "וכל בהמה", :translit "v'chol b'hemah", :gloss "and every beast"} {:he "החיה וכל בהמה", :translit "hachayah v'chol b'hemah", :gloss "the living thing and every beast"} {:he "וכל בהמה", :translit "v'chol b'hemah", :gloss "and every beast"} {:he "וכל בהמה מפרסת פרסה", :translit "v'chol b'hemah mafreset parsah", :gloss "and every beast that splits the hoof"} {:he "החיה", :translit "hachayah", :gloss "the wild animal"} {:he "בהמה", :translit "b'hemah", :gloss "beast"} {:he "החיה וכל בהמה", :translit "hachayah v'chol b'hemah", :gloss "the living thing and every beast"} {:he "וכל בהמה מפרסת וגו'", :translit "v'chol b'hemah mafreset v'gomer", :gloss "and every beast that splits the hoof, etc."} {:he "בבהמה אותה תאכלו", :translit "b'b'hemah otah tochelu", :gloss "of the beasts you may eat"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["החיה וכל בהמה" "וכל בהמה" "וכל בהמה מפרסת פרסה"]} {:kind :other, :note "Gezeirah shavah on וכל בהמה to include חיה and עובר"} {:kind :other, :note "Linguistic inclusion: חיה subsumed under category בהמה based on verse juxtaposition"}], :frame {:text "Rabbinic law requires ritual slaughter (shechitah) for both domesticated beasts (בהמה) and wild animals (חיה), as stated at Chullin 28a. The fetus is permitted without its own slaughter, absorbed in the mother's slaughter — the verse 'וכל בהמה מפרסת פרסה... בבהמה אותה תאכלו' (Leviticus 11:2-3, Deuteronomy 14:4-6) is read as 'in whichever beast you eat,' i.e., while in the beast you eat, the fetus is permitted. The phrase 'החיה וכל בהמה' (Genesis 8:1) demonstrates that Scripture itself places חיה alongside בהמה.", :sources ["Chullin 28a" "Leviticus 11:2-3" "Genesis 8:1"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["החיה וכל בהמה" "וכל בהמה" "וכל בהמה מפרסת פרסה"], :by :selah, :located [{:phrase "החיה וכל בהמה", :refs ["Psalms 148:10"], :n 1, :lens :exact} {:phrase "וכל בהמה", :refs ["Exodus 22:9" "Deuteronomy 14:6" "Psalms 148:10"], :n 3, :lens :exact} {:phrase "וכל בהמה מפרסת פרסה", :refs ["Deuteronomy 14:6"], :n 1, :lens :exact}]} {:kind :other, :note "Gezeirah shavah on וכל בהמה to include חיה and עובר", :by :selah, :ran? false} {:kind :other, :note "Linguistic inclusion: חיה subsumed under category בהמה based on verse juxtaposition", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:30.044797866Z", :model "glm-5.2"}