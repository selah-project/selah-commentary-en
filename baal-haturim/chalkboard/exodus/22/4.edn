{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "ובער", :translit "uvi'er", :gloss "and it consumed/destroyed"} {:he "ובער עליה הכהן", :translit "uvi'er aleiha ha-kohen", :gloss "and the priest shall burn it upon it"} {:he "שן ורגל", :translit "shen v'regel", :gloss "tooth and foot"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ובער" "ובער עליה הכהן"]}], :frame {:text "The word ובער appears exactly twice in the Masoretic corpus. The phrase שן ורגל ('tooth and foot') refers to the Talmudic categories of animal damage: tooth means an animal consuming produce, foot means an animal trampling produce. These categories are derived from the verse 'and it shall consume (ובער) in another field' (Exodus 22:4), which the Sages expound as referring specifically to animal damage (Bava Kamma 2b). Ba'al HaTurim notes that despite this specialized rabbinic reading, the plain scope of the word covers any destructive loss.", :sources ["Exodus 22:4" "Leviticus 9:10" "Bava Kamma 2b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ובער" "ובער עליה הכהן"], :by :selah, :located [{:phrase "ובער", :refs ["Exodus 22:4" "Leviticus 6:5" "Psalms 49:11"], :n 3, :lens :exact} {:phrase "ובער עליה הכהן", :refs ["Leviticus 6:5"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:21.690140235Z", :model "glm-5.2"}