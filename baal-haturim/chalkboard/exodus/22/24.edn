{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "לא תשימון עליו נשך", :translit "lo tasimun alav neshekh", :gloss "you shall not impose upon him interest"} {:he "נשך", :translit "neshekh", :gloss "interest"}], :mechanisms [{:kind :gematria, :a "נשך", :b "אחד הלוה והמלוה ואחד העדים והסופר ואחד הערב עוברים בהלאו"}], :frame {:text "The prohibition of interest involves multiple parties. The lender transgresses by exacting interest, the borrower by offering or agreeing to it, the scribe who writes the interest-bearing document, the witnesses who sign it, and the guarantor who backs it—all violate this prohibition (Bava Metzia 75b for lender and borrower; Shulchan Arukh, Yoreh De'ah 160:1 for scribe and witnesses).", :sources ["Bava Metzia 75b" "Shulchan Arukh Yoreh De'ah 160:1"]}}], :arithmetic [{:kind :gematria, :a "נשך", :a-value 370, :b "אחד הלוה והמלוה ואחד העדים והסופר ואחד הערב עוברים בהלאו", :b-value 1324, :lens :standard, :by :selah, :equal? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:32.966547864Z", :model "glm-5.2"}