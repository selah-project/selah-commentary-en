{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "ובניכם יתומים", :translit "u'veneichem yetomim", :gloss "and your children orphans"} {:he "אם כסף תלוה", :translit "im kesef talveh", :gloss "if money you lend"} {:he "וחי לא יחיה", :translit "ve'chai lo yichyeh", :gloss "and he shall live, he shall not live"}], :mechanisms [{:kind :other, :note "semikhut parshiyot: the adjacency of the orphan verse to the lending verse teaches cause and effect"}], :frame {:text "Ezekiel 18:13 states that one who engages in interest — וחי לא יחיה, 'he shall not live.' The Ba'al HaTurim links this to the sequence in Exodus 22: the verse about lending (v. 24) immediately follows the warning that oppressors' children become orphans (v. 23), implying that the lender who takes interest dies, leaving his own children orphaned.", :sources ["Ezekiel 18:13" "Exodus 22:23-24"]}}], :arithmetic [{:kind :other, :note "semikhut parshiyot: the adjacency of the orphan verse to the lending verse teaches cause and effect", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:18:31.833871372Z", :model "glm-5.2"}