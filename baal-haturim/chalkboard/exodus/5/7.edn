{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "הלבנים", :translit "ha-l'vanim", :gloss "the bricks"} {:he "ללבון הלבנים", :translit "l'lavon ha-l'vanim", :gloss "for the white of the bricks"} {:he "מתכונת הלבנים", :translit "mat'khunat ha-l'vanim", :gloss "the measure of the bricks"} {:he "ומקטרים על הלבנים", :translit "u-mak't'rim al ha-l'vanim", :gloss "and they burn incense on the bricks"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ללבון הלבנים" "מתכונת הלבנים" "ומקטרים על הלבנים"]}], :frame {:text "Micah (Judges 17–18) made a graven image and ephod for his house of idolatry in the hill country of Ephraim. Sanhedrin 103b discusses Micah's idol and relates that during the Israelites' servitude in Egypt, when infants were placed into the brickwork, the angel Michael rescued Micah from beneath the bricks. This explains why he later built an idol — he had emerged alive from there. Ba'al HaTurim connects the three Masorah occurrences of the phrase with bricks to this tradition that Micah exited from under the bricks.", :sources ["Judges 17–18" "Sanhedrin 103b"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ללבון הלבנים" "מתכונת הלבנים" "ומקטרים על הלבנים"], :by :selah, :located [{:phrase "ללבון הלבנים", :refs ["Exodus 5:7"], :n 1, :lens :plene-insensitive} {:phrase "מתכונת הלבנים", :refs ["Exodus 5:8"], :n 1, :lens :plene-insensitive} {:phrase "ומקטרים על הלבנים", :refs ["Isaiah 65:3"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 5, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:13:46.868195059Z", :model "glm-5.2"}