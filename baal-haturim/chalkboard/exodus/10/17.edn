{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "ויסר", :translit "vayesar", :gloss "and he removed"} {:he "ויסר הצפרדעים", :translit "vayesar hatzfarde'im", :gloss "and he removed the frogs"} {:he "ייסר מעלינו את הנחש", :translit "yiser mei'aleinu et hanachash", :gloss "remove from us the snake"} {:he "ויסר מעלי רק את המות הזה", :translit "vayesar mei'alai rak et hamavet hazeh", :gloss "remove from me only this death"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ויסר הצפרדעים" "ייסר מעלינו את הנחש" "ויסר"]}], :frame {:text "A Midrashic tradition holds that harmful creatures were intermingled within the plague of frogs and the plague of locusts, so that snakes were present among them and caused death. Pharaoh's plea in Exodus 10:17, 'remove from me only this death,' is read as an allusion to these lethal snakes. A related tradition interprets the identical phrasing 'remove from me only this death' (Exodus 10:17) as spoken against the experiential bitterness of death.", :sources ["Midrash Tanchuma, Va'era 14" "Targum Yonatan ben Uziel on Exodus 8:8" "Exodus Rabbah 13:7"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ויסר הצפרדעים" "ייסר מעלינו את הנחש" "ויסר"], :by :selah, :located [{:phrase "ויסר הצפרדעים", :refs ["Exodus 8:4"], :n 1, :lens :exact} {:phrase "ייסר מעלינו את הנחש", :refs ["Numbers 21:7"], :n 1, :lens :plene-insensitive} {:phrase "ויסר", :refs ["Genesis 8:13" "Genesis 30:35" "Genesis 41:42" "Exodus 8:4" "Exodus 8:27" "Exodus 10:17" "Exodus 14:25" "Numbers 21:7"], :n 25, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:49.304739279Z", :model "glm-5.2"}