{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "לא אוסיף עוד", :translit "lo osif od", :gloss "I will not add again"} {:he "ולא אוסיף עוד להכות", :translit "v'lo osif od lachot", :gloss "and I will not add again to strike"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לא אוסיף עוד" "ולא אוסיף עוד להכות"]}], :frame {:text "The final plague — the killing of the firstborn — is distinguished from all other plagues in that God carried it out directly: 'I will pass through the land of Egypt' (Exodus 12:12), understood by the midrash to mean God Himself and no agent (Mekhilta de-Rabbi Yishmael, Bo, Masechta de-Pischa 7). Moses therefore hints to Pharaoh that no further plague mediated by a messenger remains — only this one.", :sources ["Exodus 12:12" "Mekhilta de-Rabbi Yishmael, Bo 7"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לא אוסיף עוד" "ולא אוסיף עוד להכות"], :by :selah, :located [{:phrase "לא אוסיף עוד", :refs ["Hosea 1:6" "Amos 7:8" "Amos 8:2"], :n 3, :lens :exact} {:phrase "ולא אוסיף עוד להכות", :refs ["Genesis 8:21"], :n 1, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:55.526171823Z", :model "glm-5.2"}