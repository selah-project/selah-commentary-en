{:tier :glm-5.2, :verse 13, :comments [{:quotes [{:he "זכור לאברהם ליצחק ולישראל עבדיך", :translit "z'chor l'avraham l'yitzchak u-l'yisra'el avadekha", :gloss "Remember for Abraham, for Isaac, and for Israel Your servants"} {:he "זכור לעבדיך לאברהם וגו'", :translit "z'chor l'avadekha l'avraham v'gomer", :gloss "Remember for Your servants, for Abraham etc."} {:he "דוד עבדי", :translit "david avdi", :gloss "David My servant"} {:he "עבדי דוד", :translit "avdi david", :gloss "My servant David"}], :mechanisms [{:kind :other, :note "Word-order reversal between Exodus 32:13 and Deuteronomy 9:27 to demonstrate consistent servant-status"} {:kind :other, :note "Parallel word-order reversal in Ezekiel 34:23–24 and Ezekiel 37:24–25"}], :frame {:text "Exodus 32:13 places 'Your servants' after the patriarchs' names, while Deuteronomy 9:27 places 'Your servants' before them. Ba'al HaTurim reads this reversal as signaling that the patriarchs were God's servants from beginning to end. He draws a parallel to Ezekiel, where 'David My servant' (Ezekiel 34:23–24) and 'My servant David' (Ezekiel 37:24–25) exhibit the same word-order variation.", :sources ["Exodus 32:13" "Deuteronomy 9:27" "Ezekiel 34:23-24" "Ezekiel 37:24-25"]}}], :arithmetic [{:kind :other, :note "Word-order reversal between Exodus 32:13 and Deuteronomy 9:27 to demonstrate consistent servant-status", :by :selah, :ran? false} {:kind :other, :note "Parallel word-order reversal in Ezekiel 34:23–24 and Ezekiel 37:24–25", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:34.347605175Z", :model "glm-5.2"}