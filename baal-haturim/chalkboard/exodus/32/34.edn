{:tier :glm-5.2, :verse 34, :comments [{:quotes [{:he "הנה מלאכי ילך לפניך", :translit "hineh mal'akhi yeilekh lefanekha", :gloss "Behold, My angel shall go before you"} {:he "מלאכי", :translit "mal'akhi", :gloss "My angel"} {:he "ילך", :translit "yeilekh", :gloss "shall go"} {:he "הלכה", :translit "halakhah", :gloss "halakhah / law"} {:he "גם הנה", :translit "gam hineh", :gloss "also behold"} {:he "ישקני מנשיקות פיהו", :translit "yishakeni mineshikot piv", :gloss "May he kiss me with the kisses of his mouth"} {:he "הנה מלאכי", :translit "hineh mal'akhi", :gloss "Behold, My angel"} {:he "מיכאל", :translit "mikha'el", :gloss "Michael"} {:he "מלאכי המיוחד לי", :translit "mal'akhi ha-meyukhad li", :gloss "My designated angel"}], :mechanisms [{:kind :gematria, :a "מלאכי", :b "פיהו"} {:kind :gematria, :a "ילך", :b "הלכה"} {:kind :gematria, :a "גם הנה", :b "הלכה"} {:kind :other, :note "הנה מלאכי rearranges to מיכאל"} {:kind :other, :note "101 reviews vs 100: the number of times Ben Hei Hei reviewed; the gematria equates review-count with the verses"}], :frame {:text "The Sages state that one who reviews his chapter one hundred times is not like one who reviews it one hundred and one times, because the students of Ben Hei Hei were called by that number and one who reaches it retains the halakhah (Chagigah 9b). The verse 'ישקני מנשיקות פיהו' (Song of Songs 1:2) is read as the kiss of Torah study, and the word פיהו in that phrase equals מלאכי, linking God's angel to the Torah transmitted by that kiss. The identity of Michael as the designated angel appointed over Israel is established in rabbinic sources (e.g., Daniel 12:1 with Rashi ad loc.).", :sources ["Chagigah 9b" "Song of Songs 1:2" "Daniel 12:1"]}}], :arithmetic [{:kind :gematria, :a "מלאכי", :a-value 101, :b "פיהו", :b-value 101, :lens :standard, :by :selah, :equal? true} {:kind :gematria, :a "ילך", :a-value 60, :b "הלכה", :b-value 60, :lens :standard, :by :selah, :equal? true} {:kind :gematria, :a "גם הנה", :a-value