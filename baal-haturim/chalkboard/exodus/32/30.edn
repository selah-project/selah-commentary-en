{:tier :glm-5.2, :verse 30, :comments [{:quotes [{:he "אכפרה", :translit "akhparah", :gloss "I will atone / I will appease"} {:he "אכפרה פניו במנחה", :translit "akhparah panav b'minchah", :gloss "I will appease His face at the afternoon offering"} {:he "אכפרה בעד חטאתכם", :translit "akhparah b'ad chatat'chem", :gloss "I will atone on behalf of your sin"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["אכפרה" "אכפרה פניו במנחה"]}], :frame {:text "The phrase אכפרה פניו במנחה (I will appease His face at the afternoon offering) appears in Proverbs 21:14, where Solomon describes a gift in secret as appeasing anger. The Talmud (Berakhot 6b) cites this verse as the scriptural anchor for the special import of the afternoon prayer, minhah: Elijah's prayer at the afternoon offering on Mount Carmel (I Kings 18:36) is taken as the paradigm, yielding the dictum 'a person should always be careful with the afternoon prayer.' Ba'al HaTurim reads Moses' אכפרה in Exodus 32:30 as pointing to that same hour.", :sources ["Proverbs 21:14" "Berakhot 6b" "I Kings 18:36"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["אכפרה" "אכפרה פניו במנחה"], :by :selah, :located [{:phrase "אכפרה", :refs ["Genesis 32:21" "Exodus 32:30"], :n 2, :lens :exact} {:phrase "אכפרה פניו במנחה", :refs ["Genesis 32:21"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:42.026924332Z", :model "glm-5.2"}