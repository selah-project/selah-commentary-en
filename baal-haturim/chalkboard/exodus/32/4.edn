{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "אלה אלהיך", :translit "eleh elohekha", :gloss "these are your God"} {:he "שאיוו לאלהות הרבה", :translit "she'ivu le'elohut harbeh", :gloss "they wanted a plurality of divinities"}], :mechanisms [{:kind :other, :note "Grammar: plural noun אלהים taken literally as multiple gods rather than as a majestic plural."}], :frame {:text "The Israelites at Sinai sought to replace Moses with physical intermediaries. The word אלהים, though commonly a plural of majesty for the one God, can be read as a strict plural, and here the people explicitly demand multiple divine powers, as reflected in their declaration 'These are your Elohim' (Exodus 32:4) and its parallel at Exodus 32:8.", :sources ["Exodus 32:4" "Exodus 32:8"]}}], :arithmetic [{:kind :other, :note "Grammar: plural noun אלהים taken literally as multiple gods rather than as a majestic plural.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:27.314170793Z", :model "glm-5.2"}