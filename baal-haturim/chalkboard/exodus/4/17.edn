{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "המטה", :translit "ha-matteh", :gloss "the staff"} {:he "תגין על הה\"א", :translit "tagin al ha-heh", :gloss "tags on the heh"} {:he "על הטי\"ת", :translit "al ha-tet", :gloss "on the tet"} {:he "צדיק תשיעי", :translit "tzaddik tish'i", :gloss "ninth righteous man"} {:he "אדם חנוך נח שם אברהם יצחק יעקב יוסף", :translit "adam chanokh noach shem avraham yitzchak ya'akov yosef", :gloss "Adam Enoch Noah Shem Abraham Isaac Jacob Joseph"}], :mechanisms [{:kind :other, :note "Five tagin (crownlets) on the heh of המטה; variant tradition places them on the tet"} {:kind :other, :note "Moses is the ninth righteous man to hold the staff, counting: Adam, Enoch, Noah, Shem, Abraham, Isaac, Jacob, Joseph"}], :frame {:text "A tradition records that the staff was created at twilight of the sixth day of creation and passed down through a chain of righteous men. Adam received it first; it then passed to Enoch, Noah, Shem, Abraham, Isaac, Jacob, Joseph, Jethro, and finally Moses (Pirkei DeRabbi Eliezer 40). Jethro planted the staff in his garden after Joseph's death, and none could remove it until Moses arrived. The Midrash identifies this staff as the one God showed Moses as the sign that he was sent (Shemot Rabbah 8:3 on Exodus 4:17). The Ba'al HaTurim counts Moses as ninth in this sequence.", :sources ["Pirkei DeRabbi Eliezer 40" "Shemot Rabbah 8:3"]}}], :arithmetic [{:kind :other, :note "Five tagin (crownlets) on the heh of המטה; variant tradition places them on the tet", :by :selah, :ran? false} {:kind :other, :note "Moses is the ninth righteous man to hold the staff, counting: Adam, Enoch, Noah, Shem, Abraham, Isaac, Jacob, Joseph", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 4, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:13:37.542993304Z", :model "glm-5.2"}