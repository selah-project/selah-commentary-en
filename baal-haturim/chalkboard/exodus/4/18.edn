{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "אל יתר", :translit "el yiter", :gloss "to Yiter"} {:he "אל יתר חותנו", :translit "el yiter choteno", :gloss "to Yiter his father-in-law"} {:he "אל יתר חותנו", :translit "el yiter choteno", :gloss "to Yiter his father-in-law"} {:he "אל יתר זקני הגולה", :translit "el yiter ziknei ha-golah", :gloss "to Yiter, elders of the exile"} {:he "יתר", :translit "yiter", :gloss "Yiter"} {:he "לשכת הגזית", :translit "lishkat ha-gazit", :gloss "Chamber of Hewn Stone"} {:he "הסנהדרין", :translit "ha-sanhedrin", :gloss "the Sanhedrin"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["אל יתר חותנו" "אל יתר חותנו"]} {:kind :other, :note "Phrase 'El Yiter' read as 'to Yiter, elders of the exile,' linking Moses's father-in-law to the Sanhedrin"}], :frame {:text "Moses's father-in-law is identified as Yitro, also called Yiter (Exodus 4:18). The Chamber of Hewn Stone (lishkat ha-gazit) was the meeting place of the Sanhedrin on the Temple Mount (Midot 5:4). A tradition recorded in Sifrei Zuta 1:1 and Yalkut Shimoni on Exodus 18:1 traces the members of the Sanhedrin to descendants of Yitro. Mekhilta de-Rabbi Yishmael, Yitro 1 (Bahodesh 1) states that Yitro's descendants sat in the Chamber of Hewn Stone; Sanhedrin 106a records Amoraim stating 'the descendants of our father Abraham's house were worthy to sit in the Chamber of Hewn Stone.' The reading plays on the name יתר as one who 'added' (הותיר) merit through distinguished descendants.", :sources ["Exodus 4:18" "Mishnah Midot 5:4" "Mekhilta de-Rabbi Yishmael Yitro 1" "Sifrei Zuta 1:1" "Yalkut Shimoni Exodus 18:1" "Sanhedrin 106a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["אל יתר חותנו" "אל יתר חותנו"], :by :selah, :located [{:phrase "אל יתר חותנו", :refs ["Exodus 4:18"], :n 1, :lens :plene-insensitive} {:phrase "אל יתר חותנו", :refs ["Exodus 4:18"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Phrase 'El Yiter' read as 'to Yiter, elders of the exile,' linking Moses's father-in-law to the Sanhedrin", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 4, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:13:40.639314568Z", :model "glm-5.2"}