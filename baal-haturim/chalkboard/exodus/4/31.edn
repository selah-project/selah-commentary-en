{:tier :glm-5.2, :verse 31, :comments [{:quotes [{:he "ויאמן העם", :translit "vaya'amin ha'am", :gloss "and the people believed"} {:he "ויאמן אכיש בדוד", :translit "vaya'amin akhish b'david", :gloss "Achish believed in David"} {:he "מחני נא", :translit "macheni na", :gloss "erase me please"} {:he "תהי נא ידך בי ואלה הצאן", :translit "tehi na yadkha bi v'eleh hatzon", :gloss "let your hand be upon me and these sheep"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויאמן העם" "ויאמן אכיש בדוד"]} {:kind :other, :note "Gezerah shavah linking the two occurrences of ויאמן: both subjects trusted their leader because the leader was faithful."}], :frame {:text "Moses asked God to erase him from His book rather than punish Israel after the sin of the Golden Calf (Exodus 32:32). David declared to Saul that he considered his own life and his father's sheep of no account compared to sparing Saul's life (1 Samuel 26:24). The verse 1 Samuel 21:13 (in many editions) or 1 Samuel 29:6–9 records Achish's trust in David, which is the masoretic partner of Exodus 4:31.", :sources ["Exodus 32:32" "1 Samuel 26:24" "1 Samuel 29:6"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויאמן העם" "ויאמן אכיש בדוד"], :by :selah, :located [{:phrase "ויאמן העם", :refs ["Exodus 4:31"], :n 1, :lens :exact} {:phrase "ויאמן אכיש בדוד", :refs ["1 Samuel 27:12"], :n 1, :lens :exact}]} {:kind :other, :note "Gezerah shavah linking the two occurrences of ויאמן: both subjects trusted their leader because the leader was faithful.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 4, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:13:42.033213804Z", :model "glm-5.2"}