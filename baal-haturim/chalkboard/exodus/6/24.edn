{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "אסיר", :translit "asir", :gloss "imprisoned"} {:he "אסיר ואלקנה", :translit "asir ve'elkanah", :gloss "imprisoned and Elkanah"} {:he "להוציא ממסגר אסיר", :translit "lehotzi mimsgar asir", :gloss "to bring out from the enclosure, imprisoned"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["אסיר ואלקנה" "להוציא ממסגר אסיר"]} {:kind :other, :note "Phrase להוציא ממסגר אסיר from Jeremiah 37:15 read midrashically as 'taken out from the enclosure, imprisoned' — i.e., spared from full confinement"}], :frame {:text "The sons of Korah are said to have been spared from the fate of their father's rebellion: though Korah's followers were swallowed (Numbers 16:32–33), his sons did not die (Numbers 26:11). R. Shimon ben Menasia teaches that a place was set apart (נתבצר) for them in Gehinnom so they would not be consumed with the wicked — they were in Gehinnom yet distinct from it (Sanhedrin 110a). The Ba'al HaTurim links this to the phrase להוציא ממסגר אסיר (Jeremiah 37:15): they were 'taken out from the enclosure' — confined, yet separated from the surrounding destruction.", :sources ["Numbers 16:32–33" "Numbers 26:11" "Jeremiah 37:15" "Sanhedrin 110a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["אסיר ואלקנה" "להוציא ממסגר אסיר"], :by :selah, :located [{:phrase "אסיר ואלקנה", :refs ["Exodus 6:24"], :n 1, :lens :exact} {:phrase "להוציא ממסגר אסיר", :refs ["Isaiah 42:7"], :n 1, :lens :exact}]} {:kind :other, :note "Phrase להוציא ממסגר אסיר from Jeremiah 37:15 read midrashically as 'taken out from the enclosure, imprisoned' — i.e., spared from full confinement", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 6, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:07.749324432Z", :model "glm-5.2"}