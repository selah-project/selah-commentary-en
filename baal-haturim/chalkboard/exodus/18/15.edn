{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "לדרוש אלהים", :translit "lidrosh elohim", :gloss "to inquire of Elohim"} {:he "ד' במסו' הכא", :translit "dalet b'masora haka", :gloss "four in the Masorah here"} {:he "בלכתו לדרוש אלהים", :translit "belechto lidrosh elohim", :gloss "in his going to inquire of Elohim"} {:he "לא יכול דוד ללכת לפניו לדרוש אלהים", :translit "lo yachol david lalechet lifanav lidrosh elohim", :gloss "David could not go before him to inquire of Elohim"} {:he "ויהי לדרוש אלהים", :translit "vayehi lidrosh elohim", :gloss "and it was to inquire of Elohim"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["לדרוש אלהים" "בלכתו לדרוש אלהים" "לא יכול דוד ללכת לפניו לדרוש אלהים" "ויהי לדרוש אלהים"]}], :frame {:text "The phrase לדרוש אלהים appears in contexts of seeking divine guidance. Saul inquired of Elohim when he went to seek the lost donkeys (1 Samuel 9:9, referred to as בלכתו לדרוש אלהים in 1 Samuel 10:2). David could not go before the ephod to inquire of Elohim during the plague when he saw the angel striking the people (1 Chronicles 21:30). Uzziah inquired of Elohim in the matter of war (2 Chronicles 26:5, referred to as ויהי לדרוש אלהים). The pattern illustrates that Israel's leaders turned to divine inquiry for every category of need.", :sources ["1 Samuel 9:9" "1 Samuel 10:2" "1 Chronicles 21:30" "2 Chronicles 26:5"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["לדרוש אלהים" "בלכתו לדרוש אלהים" "לא יכול דוד ללכת לפניו לדרוש אלהים" "ויהי לדרוש אלהים"], :by :selah, :located [{:phrase "לדרוש אלהים", :refs ["1 Samuel 9:9"], :n 1, :lens :exact} {:phrase "בלכתו לדרוש אלהים", :refs ["1 Samuel 9:9"], :n 1, :lens :exact} {:phrase "לא יכול דוד ללכת לפניו לדרוש אלהים", :refs ["1 Chronicles 21:30"], :n 1, :lens :plene-insensitive} {:phrase "ויהי לדרוש אלהים", :refs ["2 Chronicles 26:5"], :n 1, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestam