{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "וצוך", :translit "v'tzavkha", :gloss "and He commands you"} {:he "וצוך לנגיד", :translit "v'tzavkha l'nagid", :gloss "and He commands you to be a leader"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וצוך" "וצוך לנגיד"]}], :frame {:text "The word וצוך appears exactly twice in Scripture: once in Exodus 18:23 and once in 1 Kings 11:34 (וצוך לנגיד). The Midrash Hagadol on Exodus 18:23 links the two occurrences homiletically: just as in 1 Kings 11:34 divine command is the basis for kingship, so here Jethro tells Moses that only if God commands this judicial arrangement can Moses endure as leader.", :sources ["Midrash Hagadol Exodus 18:23" "1 Kings 11:34"]}} {:quotes [{:he "על מקומו", :translit "al m'komo", :gloss "on his place"} {:he "והתבוננת על מקומו ואיננו", :translit "v'hitbonanta al m'komo v'einenu", :gloss "and you considered his place and he is not"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["על מקומו" "והתבוננת על מקומו ואיננו"]}], :frame {:text "The phrase על מקומו appears twice in Scripture: in Exodus 18:23 and in Psalms 37:10 (והתבוננת על מקומו ואיננו). The Talmud (Sanhedrin 7a) teaches that a judge who renders a true verdict brings peace to the world, as it says, 'Execute the judgment of truth and peace in your gates' (Zechariah 8:16). The Ba'al HaTurim reads Psalms 37:10 as the consequence: if justice is not done below, the accused is removed from his place by heavenly judgment.", :sources ["Sanhedrin 7a" "Zechariah 8:16" "Psalms 37:10"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וצוך" "וצוך לנגיד"], :by :selah, :located [{:phrase "וצוך", :refs ["Exodus 18:23" "1 Samuel 25:30"], :n 2, :lens :exact} {:phrase "וצוך לנגיד", :refs ["1 Samuel 25:30"], :n 1, :lens :exact}]} {:kind :masorah, :count 2, :occurrences ["על מקומו" "והתבוננת על מקומו ואיננו"], :by :selah, :located [{:phrase "על מקומו", :refs ["Psalms 37:10"], :n 1, :lens :exact} {:phrase "והתבוננת על מקומו ו