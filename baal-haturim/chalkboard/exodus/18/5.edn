{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "חונה", :translit "choneh", :gloss "he encamps"} {:he "חונה מלאך ה' סביב לידאיו", :translit "choneh mal'akh Hashem saviv liydeihu", :gloss "the angel of the LORD encamps around him"} {:he "אהל משה", :translit "ohel mosheh", :gloss "the tent of Moses"} {:he "ענן קשור עליו", :translit "anan kasur alav", :gloss "a cloud bound upon it"} {:he "חונה מלאך ה' סביב ליראיו", :translit "choneh mal'akh Hashem saviv liyerei'av", :gloss "the angel of the LORD encamps around those who fear Him"} {:he "אל המדבר אשר הוא חונה שם", :translit "el ha-midbar asher hu choneh sham", :gloss "to the wilderness where he encamped there"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["חונה" "חונה מלאך ה' סביב לידאיו"]}], :frame {:text "The cloud of glory resting on the tent of Moses is described at Exodus 33:9–10, where the pillar of cloud would descend and stand at the entrance of the Tent of Meeting while all the people rose and worshipped. Psalm 34:8 reads 'חונה מלאך ה׳ סביב ליראיו ויחלצם' (the angel of the LORD encamps around those who fear Him). Ba'al HaTurim links the rare word חונה in this verse to that verse to read Jethro's recognition of Moses through the visible sign of the divine cloud as a fulfillment of that psalm.", :sources ["Exodus 33:9–10" "Psalm 34:8"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["חונה" "חונה מלאך ה' סביב לידאיו"], :by :selah, :located [{:phrase "חונה", :refs ["Exodus 18:5" "1 Samuel 1:2" "1 Samuel 1:5" "1 Samuel 1:8" "1 Samuel 1:9" "1 Samuel 1:13" "1 Samuel 1:15" "1 Samuel 1:19"], :n 19, :lens :plene-insensitive} {:phrase "חונה מלאך ה' סביב לידאיו", :refs [], :n 0, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:17:03.152168662Z", :model "glm-5.2"}