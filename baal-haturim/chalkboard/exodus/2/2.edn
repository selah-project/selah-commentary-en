{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "כי טוב הוא", :translit "ki tov hu", :gloss "for he was good"} {:he "ה' תגין ב' בטי\"ת ואחד בוא\"ו וב' בב'", :translit "h' tagin b' b'teit v'echad b'vav v'b' b'beit", :gloss "five tagin: two on the tet, one on the vav, two on the bet"} {:he "כי לקח טוב נתתי לכם", :translit "ki lekach tov natati lakhem", :gloss "for a good teaching I have given you"}], :mechanisms [{:kind :other, :note "The five tagin distributed across the enlarged letters טוב (tet=2, vav=1, bet=2) correspond to the five books of Torah Moses is destined to receive."}], :frame {:text "The verse Proverbs 4:2 states כי לקח טוב נתתי לכם, 'for a good teaching I have given you,' which the tradition reads as a reference to the Torah. Ba'al HaTurim links this to כי טוב הוא in Exodus 2:2 — the word טוב is written with special tagin, and the five tagin correspond to the five books of the Torah (חמשה חומשי תורה) that Moses would receive.", :sources ["Proverbs 4:2" "Exodus 2:2"]}} {:quotes [{:he "ירחים", :translit "yarkhim", :gloss "months"} {:he "גרש ירחים", :translit "geresh yarkhim", :gloss "divorce of months"} {:he "במספר ירחים אל יבוא", :translit "b'mispar yarkhim al yavo", :gloss "by the count of months he shall not come"} {:he "תספור ירח", :translit "tespor yareach", :gloss "you shall count the month"} {:he "תספור ירחים תמלאנה", :translit "tespor yarkhim t'mal'ena", :gloss "you shall count the months she fills"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["ירחים" "גרש ירחים" "במספר ירחים אל יבוא" "תספור ירח תמלאנה"]}], :frame {:text "The Mishnah in Sotah 1:9 lists humiliations inflicted on the suspected sotah: if she was divorced and remarried, or if her husband died and she was widowed, she receives no ketubah. The Gemara in Sotah 11a-d discusses the Egyptian episode of Moshe's birth — the Egyptians counted for Moshe's mother nine months of pregnancy from the day Pharaoh returned her, but she had already conceived three months earlier before he divorced her. Ba'al HaTurim uses the four Masoretic occurrences of ירחים to encode this timeline: גרש ירחים refers to the divorce while she already had months of pregnancy, במספר ירחים אל יבוא means the Egyptians could not determine the correct month count for her delivery, תספור ירחים תמלאנה means they counted the months to ascertain the birth-time, and the word ירחים in Exodus 2:2 is the instance that anchors the reading.", :sources ["Sotah 11a" "Sotah 1:9" "Exodus 2:2"]}}], :arithmetic [{:kind :other, :note "The five tagin distributed across the enlarged letters טוב (tet=2, vav=1, bet=2) correspond to the five books of Torah Moses is destined to receive.", :by :selah, :ran? false} {:kind :masorah, :count 4, :occurrences ["ירחים" "גרש ירחים" "במספר ירחים אל יבוא" "תספור ירח תמלאנה"], :by :selah, :located [{:phrase "ירחים", :refs ["Exodus 2:2" "Deuteronomy 33:14" "Job 3:6" "Job 39:2"], :n 4, :lens :exact} {:phrase "גרש ירחים", :refs ["Deuteronomy 33:14"], :n 1, :lens :exact} {:phrase "במספר ירחים אל יבוא", :refs ["Job 3:6"], :n 1, :lens :plene-insensitive} {:phrase "תספור ירח תמלאנה", :refs [], :n 0, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 2, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:13:13.303014743Z", :model "glm-5.2"}