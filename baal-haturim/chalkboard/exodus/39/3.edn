{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "וקצץ", :translit "v'katatz", :gloss "and he cut"} {:he "וקצץ פתילים", :translit "v'katatz p'tilim", :gloss "and he cut threads"} {:he "וקצץ חנית", :translit "v'katatz chanit", :gloss "and he cut a spear"} {:he "וחד קצץ עבות רשעים", :translit "v'chad katatz avot resha'im", :gloss "and one cuts the thick cords of the wicked"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["וקצץ פתילים" "וקצץ חנית" "וחד קצץ עבות רשעים"]}], :frame {:text "Ba'al HaTurim notes a masoretic listing of three occurrences of the root קצץ (to cut). He links the physical cutting of threads for the Tabernacle's construction to a symbolic military triumph: through the merit of the Tabernacle, Israel cuts down the weapons of their enemies. The image of cutting weapons in defeat recalls Psalm 46:9, 'He breaks the bow and cuts the spear in pieces' (שבר קשת וכתת חנית).", :sources ["Psalms 46:9"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["וקצץ פתילים" "וקצץ חנית" "וחד קצץ עבות רשעים"], :by :selah, :located [{:phrase "וקצץ פתילים", :refs ["Exodus 39:3"], :n 1, :lens :plene-insensitive} {:phrase "וקצץ חנית", :refs ["Psalms 46:10"], :n 1, :lens :exact} {:phrase "וחד קצץ עבות רשעים", :refs [], :n 0, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 39, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:27.901679217Z", :model "glm-5.2"}