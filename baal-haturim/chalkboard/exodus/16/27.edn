{:tier :glm-5.2, :verse 27, :comments [{:quotes [{:he "לקוט", :translit "l'kot", :gloss "to glean"} {:he "ואירך ללקוט בשדה אחר", :translit "v'iro l'loket b'sadeh acher", :gloss "and he would glean in another field"} {:he "ב' לקט ג' אינו לקט", :translit "bet lokeg gimel eino lokeg", :gloss "two is glean three is not glean"} {:he "במסורה", :translit "b'masorah", :gloss "in the Masorah"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לקוט" "ואירך ללקוט בשדה אחר"]} {:kind :other, :note "Gezerah shavah between the two occurrences of לקוט: what holds for two in Ruth applies here."}], :frame {:text "The word לקט appears in Ruth 2:3 in the context of Boaz's field, and the phrase 'ואירך ללקוט בשדה אחר' appears in Ruth 2:8. The midrashic tradition (Ruth Rabbah 4:7) establishes that proper לקט consists of two fallen stalks, but three fallen stalks constitute a bundle (omer) and are not considered לקט. By means of a gezerah shavah on the word לקוט, the Ba'al HaTurim applies this definition to Exodus 16:27: the Israelites gathered successfully for two days (the sixth day yielding a double portion), but a third gathering on the seventh day found nothing, since a third portion would have exceeded the category of לקט.", :sources ["Ruth 2:3" "Ruth 2:8" "Ruth Rabbah 4:7" "Exodus 16:5" "Exodus 16:27"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לקוט" "ואירך ללקוט בשדה אחר"], :by :selah, :located [{:phrase "לקוט", :refs ["Genesis 31:46" "Genesis 47:14" "Exodus 16:4" "Exodus 16:5" "Exodus 16:16" "Exodus 16:17" "Exodus 16:18" "Exodus 16:21"], :n 14, :lens :plene-insensitive} {:phrase "ואירך ללקוט בשדה אחר", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Gezerah shavah between the two occurrences of לקוט: what holds for two in Ruth applies here.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:43.250128406Z", :model "glm-5.2"}