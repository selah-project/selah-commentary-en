{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "אנסנו הילך בתורתי", :translit "an'senu halech b'torati", :gloss "I will test them, whether they walk in My Torah"} {:he "שלא ניתנה התורה אלא לאוכלי המן", :translit "sh'lo nitt'nah ha-torah ela l'och'lei ha-man", :gloss "for the Torah was not given except to eaters of the manna"}], :mechanisms [{:kind :other, :note "Logical inference: 'walk in My Torah' links Torah reception to the manna condition."}], :frame {:text "The Mechilta on Exodus 16:4 derives from 'whether they walk in My Torah' that the Torah was given only to eaters of the manna, i.e., those sustained by the manna. Yoma 52b and Kiddushin 30b state that the commandments were given to be studied by those who eat manna, understood as a generation free from material worry. The phrase 'eaters of the manna' thus describes the ideal condition for Torah engagement.", :sources ["Mechilta d'Rabbi Yishmael Vayassa 16:4" "Yoma 52b" "Kiddushin 30b"]}}], :arithmetic [{:kind :other, :note "Logical inference: 'walk in My Torah' links Torah reception to the manna condition.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:29.068128060Z", :model "glm-5.2"}