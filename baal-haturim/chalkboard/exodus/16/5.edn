{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "והיה משנה", :translit "vehayah mishneh", :gloss "and it shall be a double portion"} {:he "כל מעשה השבת כפול", :translit "kol ma'aseh ha-shabbat kaful", :gloss "every act of the Sabbath is doubled"} {:he "שני כבשים", :translit "shnei chavasim", :gloss "two lambs"} {:he "שתי ככרות", :translit "shtei chalot", :gloss "two loaves"} {:he "שתי נרות", :translit "shtei nerot", :gloss "two lamps"} {:he "זכור", :translit "zachor", :gloss "Remember"} {:he "שמור", :translit "shamor", :gloss "Observe"}], :mechanisms [{:kind :other, :note "Pattern: every element of Sabbath observance is thematically doubled."} {:kind :other, :note "Two lambs: the additional Sabbath offering (Numbers 28:9)."} {:kind :other, :note "Two loaves: the showbread arranged in two rows (Leviticus 24:6)."} {:kind :other, :note "Two lamps: Sabbath candles lit in pairs."} {:kind :other, :note "Remember and Observe: the two versions of the Decalogue (Exodus 20:8, Deuteronomy 5:12)."}], :frame {:text "The word משנה in Exodus 16:5, literally meaning a double portion, is read as encoding a principle: every dimension of Sabbath observance is structurally doubled. The Sabbath additional offering consists of two lambs (Numbers 28:9). The showbread on the Sabbath is arranged in two rows (Leviticus 24:6). Rabbinic practice mandates lighting two lamps for Sabbath (Shabbat 25b). The Decalogue presents the Sabbath command in two versions — זכור in Exodus 20:8 and שמור in Deuteronomy 5:12 — which tradition hears as spoken in a single divine utterance (Rosh Hashanah 27a, Shevuot 20b).", :sources ["Numbers 28:9" "Leviticus 24:6" "Shabbat 25b" "Exodus 20:8" "Deuteronomy 5:12" "Rosh Hashanah 27a" "Shevuot 20b"]}}], :arithmetic [{:kind :other, :note "Pattern: every element of Sabbath observance is thematically doubled.", :by :selah, :ran? false} {:kind :other, :note "Two lambs: the additional Sabbath offering (Numbers 28:9).", :by :selah, :ran? false} {:kind :other, :note "Two loaves: the showbread arranged in two rows (Leviticus 24:6).", :by :selah, :ran? false} {:kind :other, :note "Two lamps: Sabbath candles lit in pairs.", :by :selah, :ran? false} {:kind :other, :note "Remember and Observe: the two versions of the Decalogue (Exodus 20:8, Deuteronomy 5:12).", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:32.216263564Z", :model "glm-5.2"}