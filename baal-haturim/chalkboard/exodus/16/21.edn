{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "וחם השמש ונמס", :translit "ve-cham ha-shemesh va-namas", :gloss "and the sun grew hot and it melted"} {:he "וחם הוא אבי כנען", :translit "ve-cham hu avi kena'an", :gloss "and Ham he is the father of Canaan"} {:he "וחם לאדני המלך", :translit "ve-cham la-adonei ha-melech", :gloss "and it grew hot for the king's master"} {:he "אם ישכבו שנים וחם להם", :translit "im yishkevu shnayim ve-cham lahem", :gloss "if two lie and it grows hot for them"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["וחם השמש ונמס" "וחם הוא אבי כנען" "וחם לאדני המלך" "אם ישכבו שנים וחם להם"]} {:kind :other, :note "Wordplay linking four cases of וחם to four scenarios of legal clarification through manna."}], :frame {:text "Yoma 75a states that the manna would clarify doubts about lineage: if a woman married within three months and gave birth, if an omer of manna was found in the house of one man, he was confirmed as the father. Ba'al HaTurim extends this principle to three cases: paternity (Exodus 16:21 ↔ אם ישכבו שנים וחם להם, Proverbs 25:22 which is read as 'if two men lie with her'), levirate bond disputes (קדושין discussed in Sanhedrin, linked to וחם לאדני המלך, Jeremiah 38:6), and Canaanite slave ownership (linked to וחם הוא אבי כנען, Genesis 9:22).", :sources ["Yoma 75a" "Sanhedrin 19b" "Proverbs 25:22" "Jeremiah 38:6" "Genesis 9:22"]}} {:quotes [{:he "ונמס", :translit "va-namas", :gloss "and it melted"} {:he "שניו יחרוק ונמס", :translit "shinav yecharok ve-namas", :gloss "his teeth he gnashes and melts"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ונמס" "שניו יחרוק ונמס"]} {:kind :other, :note "Wordplay: leftover manna melted, was consumed by animals, hunted by gentiles, who then gnashed teeth and melted with envy."}], :frame {:text "Yoma 75a states that the manna would melt and flow into the great sea, from which the nations of the world and the beasts would drink and taste the flavor of manna. The phrase שניו יחרוק ונמס (Proverbs 25:19) is applied to the nations who gnash their teeth and melt away in envy over Israel's good fortune of receiving the manna.", :sources ["Yoma 75a" "Proverbs 25:19"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["וחם השמש ונמס" "וחם הוא אבי כנען" "וחם לאדני המלך" "אם ישכבו שנים וחם להם"], :by :selah, :located [{:phrase "וחם השמש ונמס", :refs ["Exodus 16:21"], :n 1, :lens :exact} {:phrase "וחם הוא אבי כנען", :refs ["Genesis 9:18"], :n 1, :lens :exact} {:phrase "וחם לאדני המלך", :refs ["1 Kings 1:2"], :n 1, :lens :exact} {:phrase "אם ישכבו שנים וחם להם", :refs ["Ecclesiastes 4:11"], :n 1, :lens :exact}]} {:kind :other, :note "Wordplay linking four cases of וחם to four scenarios of legal clarification through manna.", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["ונמס" "שניו יחרוק ונמס"], :by :selah, :located [{:phrase "ונמס", :refs ["Exodus 16:21" "1 Samuel 15:9" "Ezekiel 21:12" "Psalms 112:10"], :n 4, :lens :exact} {:phrase "שניו יחרוק ונמס", :refs ["Psalms 112:10"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Wordplay: leftover manna melted, was consumed by animals, hunted by gentiles, who then gnashed teeth and melted with envy.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:46.115469599Z", :model "glm-5.2"}