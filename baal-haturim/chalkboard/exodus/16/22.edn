{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "לאחד", :translit "l'echad", :gloss "for one"} {:he "ככה תעשו לאחד כמספרם", :translit "kach ta'asu l'echad k'misparam", :gloss "thus you shall do for one according to their number"} {:he "להקב\"ה", :translit "laKadosh Baruch Hu", :gloss "for the Holy One, blessed be He"} {:he "להקכ\"ה", :translit "laKadosh K'chal Yisrael Baruch Hu", :gloss "for the Holy One, Who is the congregation of Israel, blessed be He"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לאחד" "ככה תעשו לאחד כמספרם"]} {:kind :other, :note "Rabbinic arithmetic: omer offering uses 2 tenths for one lamb; 1 tenth covers the lamb, 1 extra tenth goes to God Who is One — so every offering of 'one' carries a hidden second portion for the One."} {:kind :gematria, :a "להקכ\"ה", :b "קל"}], :frame {:text "The omer meal-offering on the second day of Passover consists of two tenths of an ephah of fine flour accompanied by a single lamb (Leviticus 23:13). Ba'al HaTurim cites a midrashic reading that splits the two tenths: one tenth corresponds to the single lamb, and the remaining tenth is designated for the Holy One, blessed be He, because He is One. The phrase לאחד ('for one') appears twice in Scripture — here in Exodus 16:22 and again in Numbers 28:14 — and the midrash applies the same logic to both: just as the lamb's offering doubles the measure for the sake of the One, so every numbering 'according to their number' alludes to Him.", :sources ["Leviticus 23:13" "Numbers 28:14"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לאחד" "ככה תעשו לאחד כמספרם"], :by :selah, :located [{:phrase "לאחד", :refs ["Exodus 16:22" "Numbers 7:3" "Numbers 15:12" "Numbers 36:3" "Numbers 36:8" "Deuteronomy 28:55" "2 Samuel 1:15" "2 Kings 9:1"], :n 15, :lens :exact} {:phrase "ככה תעשו לאחד כמספרם", :refs ["Numbers 15:12"], :n 1, :lens :exact}]} {:kind :other, :note "Rabbinic arithmetic: omer offering uses 2 tenths for one lamb; 1 tenth covers the lamb, 1 extra tenth goes to God Who is One — so every offering of 'one' carries a hidden second portion for the One.", :by :selah, :ran? false} {:kind :gematria, :a "להקכ\"ה", :a-value 160, :b "קל", :b-value 130, :lens :standard, :by :selah, :equal? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:16:41.219566052Z", :model "glm-5.2"}