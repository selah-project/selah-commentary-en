{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "בשמעו", :translit "bishmo'o", :gloss "in his hearing"} {:he "ג' במס' הכא", :translit "g' b'masa chka", :gloss "three in the Masorah here"} {:he "וירא בצר להם", :translit "vayyar betzar lahem", :gloss "and He saw in the distress to them"} {:he "בשמעיו את רנתם", :translit "bishmo'o et rinatam", :gloss "in His hearing their song"} {:he "בשמעו את דברי האלה הזאת", :translit "bishmo'o et divrei ha'alah hazot", :gloss "in hearing the words of the curse this"} {:he "שמע תלונותם", :translit "shma tilnotam", :gloss "hear their complaints"} {:he "שלום יהיה לי", :translit "shalom yihyeh li", :gloss "peace will be to me"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["בשמעו" "בשמעיו את רנתם" "בשמעו את דברי האלה הזאת"]} {:kind :other, :note "Midrashic contrast: the three occurrences are split — two involve distress (justified complaint, God listens), one involves smug complacency (God does not listen)."}], :frame {:text "The phrase וירא בצר להם בשמעיו את רנתם appears at Exodus 2:24–25 where God sees Israel's affliction and hears their cry. The Ba'al HaTurim cites it as a parallel occurrence of the root שמע. The phrase בשמעו את דברי האלה הזאת appears at Deuteronomy 29:18(19) in the context of one who hears the words of the covenant's curse yet blesses himself in his heart saying שלום יהיה לי, against whom Scripture says the Lord will not be willing to forgive him (Deuteronomy 29:19(20)).", :sources ["Exodus 2:24-25" "Deuteronomy 29:18-19"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["בשמעו" "בשמעיו את רנתם" "בשמעו את דברי האלה הזאת"], :by :selah, :located [{:phrase "בשמעו", :refs ["Exodus 16:7" "Deuteronomy 29:18" "1 Samuel 11:6" "Psalms 106:44"], :n 4, :lens :exact} {:phrase "בשמעיו את רנתם", :refs ["Psalms 106:44"], :n 1, :lens :plene-insensitive} {:phrase "בשמעו את דברי האלה הזאת", :refs ["Deuteronomy 29:18"], :n 1, :lens :exact}]} {:kind :other, :note "Midrashic contrast: the three occurrences are sp