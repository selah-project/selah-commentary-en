{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "ובכה", :translit "uv'kha", :gloss "and in you"} {:he "ובכה ובעמך", :translit "uv'kha uv'amkha", :gloss "and in you and in your people"} {:he "כי בכה ארוץ גדוד", :translit "ki v'kha arutz gadud", :gloss "for in you I will run a troop"} {:he "בכה חסיתי", :translit "b'kha chasiti", :gloss "in you I have taken refuge"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ובכה" "ובעמך" "כי בכה ארוץ גדוד"]}], :frame {:text "Psalm 142:6 (בכה חסיתי) speaks of taking refuge in God amid trouble. The Talmud addresses whether plagues afflicted Israel in Egypt, stating that the plague of wild beasts (arov) distinguished Goshen where Israel dwelt, per Exodus 8:18, establishing the principle of selective divine protection. Rashi on Exodus 7:29 cites a midrash that the frogs entered even bodies and ovens, intensifying the plague's severity; and on Psalm 78:45 notes variants reading the plague as consuming rather than merely swarming, reflecting its devastating extent.", :sources ["Psalm 142:6" "Exodus 8:18" "Rashi on Exodus 7:29" "Rashi on Psalm 78:45"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ובכה" "ובעמך" "כי בכה ארוץ גדוד"], :by :selah, :located [{:phrase "ובכה", :refs ["Exodus 7:29" "1 Samuel 1:10" "2 Samuel 3:16" "2 Samuel 15:30" "Jeremiah 41:6" "Psalms 126:6"], :n 6, :lens :exact} {:phrase "ובעמך", :refs ["Exodus 7:28" "Exodus 7:29" "Exodus 8:17" "Exodus 9:14" "1 Chronicles 21:17"], :n 5, :lens :exact} {:phrase "כי בכה ארוץ גדוד", :refs ["2 Samuel 22:30"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 7, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:23.425995539Z", :model "glm-5.2"}