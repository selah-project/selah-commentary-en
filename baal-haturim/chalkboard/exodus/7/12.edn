{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "מטתם", :translit "matoteihem", :gloss "their staffs"} {:he "ומטה אהרן בתוך מטותם", :translit "u-matteh aharon be-tokh matotam", :gloss "and the staff of Aaron among their staffs"} {:he "ויוצא משה את כל המטת", :translit "va-yotzei moshe et kol ha-matot", :gloss "and Moses brought out all the staffs"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["מטתם"]} {:kind :other, :note "ויוצא משה את כל המטת written defective (missing ו), indicating the staffs were swallowed"}], :frame {:text "The staff of Aaron swallowed the Egyptian magicians' staffs (Exodus 7:12). The Ba'al HaTurim cites a midrashic tradition that the same phenomenon recurred during Korah's rebellion (Numbers 17:23-24), when Aaron's staff swallowed the other tribal staffs and then vomited them back, which is why those other staffs did not blossom. The defective spelling of המטת in Numbers 17:23 (lacking the expected ו) alludes to this swallowing.", :sources ["Exodus 7:12" "Numbers 17:23" "Numbers 17:24"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["מטתם"], :by :selah, :located [{:phrase "מטתם", :refs ["Exodus 7:12"], :n 1, :lens :exact}]} {:kind :other, :note "ויוצא משה את כל המטת written defective (missing ו), indicating the staffs were swallowed", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 7, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:14.305717826Z", :model "glm-5.2"}