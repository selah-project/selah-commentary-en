{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "והשלך לפני פרעה יהי לתנין", :translit "v'hashlech lifnei par'oh yehi ltanin", :gloss "and cast it before Pharaoh — it shall become a tanin"} {:he "ויהי", :translit "vayehi", :gloss "and it became"} {:he "יהי לתנין", :translit "yehi ltanin", :gloss "it shall become a tanin"} {:he "התנים הגדול הרובץ בתוך יאוריו", :translit "hatanim haggadol haroveitz b'toch ye'orav", :gloss "the great tanin that lies in the midst of his rivers"}], :mechanisms [{:kind :other, :note "Contrast between יהי (future, 'it shall become') and ויהי (past, 'and it became') to show the staff transforms at Moses' spoken command"}], :frame {:text "Ezekiel 29:3 records Pharaoh's self-declaration: 'the great tanin that lies in the midst of his rivers, whose streams are mine; I made it for myself.' The verse announces judgment on Pharaoh, and Ezekiel 29:4-5 continues that God will put hooks in his jaws and cast him onto the open field. Isaiah 41:25 and other prophetic passages speak of the wicked ultimately returning to dust and worms.", :sources ["Ezekiel 29:3-5" "Isaiah 41:25"]}}], :arithmetic [{:kind :other, :note "Contrast between יהי (future, 'it shall become') and ויהי (past, 'and it became') to show the staff transforms at Moses' spoken command", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 7, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:12.008449408Z", :model "glm-5.2"}