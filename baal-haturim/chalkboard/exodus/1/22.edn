{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "הילוד", :translit "ha-yilud", :gloss "the one born"} {:he "ב' במסורה", :translit "bet ba-masorah", :gloss "two in the Masorah"} {:he "גם הבן הילוד לך מות ימות", :translit "gam ha-ben ha-yilud lekha mot yumat", :gloss "also the son born to you shall surely die"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הילוד" "גם הבן הילוד לך מות ימות"]}], :frame {:text "The rare word הילוד occurs exactly twice in Scripture. The other instance, גם הבן הילוד לך מות ימות, is spoken by Nathan to David at 2 Samuel 12:14. There, David is told the child born to him will die; the broader context of 2 Samuel 12:10–12 establishes that evil will rise against David from his own house. Absalom's rebellion against David is recounted at 2 Samuel 15–18. The Ba'al HaTurim links these two rare-occurrence passages typologically: just as David suffered ruin from one raised in his own house, so Pharaoh suffered ruin from Moses, who was raised in Pharaoh's house (Exodus 2:10) and who brought the plagues upon Egypt (Exodus 7–12).", :sources ["2 Samuel 12:14" "2 Samuel 12:10–12" "2 Samuel 15–18" "Exodus 2:10" "Exodus 7–12"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["הילוד" "גם הבן הילוד לך מות ימות"], :by :selah, :located [{:phrase "הילוד", :refs ["Exodus 1:22" "2 Samuel 12:14" "1 Kings 3:26" "1 Kings 3:27"], :n 4, :lens :exact} {:phrase "גם הבן הילוד לך מות ימות", :refs ["2 Samuel 12:14"], :n 1, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:13:11.565494650Z", :model "glm-5.2"}