{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "בראשן", :translit "ba-rishon", :gloss "on the first"} {:he "חסר וי\"ו", :translit "chaser vav", :gloss "deficient [of the letter] vav"} {:he "עד ו' שעות", :translit "ad v' sha'ot", :gloss "until six hours"} {:he "מותר להשהות חמץ", :translit "mutar le-ha'shot chametz", :gloss "permitted to retain leaven"}], :mechanisms [{:kind :other, :note "Deficient spelling of בראשון (missing vav) signals the time boundary for leaven"}], :frame {:text "The word בראשון is written defectively (missing the letter vav). This missing vav is read as a numerical marker: the single missing vav (=6) hints that until the sixth hour of the day it remains permitted to retain leaven in one's possession. This aligns with the halakhic rule that the time for removing leaven is at the end of the sixth hour (Pesachim 11b–12a).", :sources ["Pesachim 11b" "Pesachim 12a"]}} {:quotes [{:he "בערב תאכלו מצת", :translit "ba-erev tokhlu matzot", :gloss "in the evening you shall eat unleavened bread"} {:he "חסר וי\"ו", :translit "chaser vav", :gloss "deficient [of the letter] vav"} {:he "ו' ימים", :translit "v' yamim", :gloss "six days"} {:he "רשות לאכול מצה", :translit "reshut le'ekhol matzah", :gloss "optional to eat matzah"}], :mechanisms [{:kind :other, :note "Deficient spelling of מצות (missing vav) signals the duration of optional matzah eating"}], :frame {:text "The word מצות is written defectively (missing the letter vav). The missing vav (=6) hints that for six days eating matzah is optional, as opposed to the first night when it is obligatory (Pesachim 120a). The broader framework distinguishes between the obligation of matzah on the first night and the permissive status of matzah throughout the remaining days of the festival (Pesachim 120a).", :sources ["Pesachim 120a"]}}], :arithmetic [{:kind :other, :note "Deficient spelling of בראשון (missing vav) signals the time boundary for leaven", :by :selah, :ran? false} {:kind :other, :note "Deficient spelling of מצות (missing vav) signals the duration of optional matzah eating", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:13.597859575Z", :model "glm-5.2"}