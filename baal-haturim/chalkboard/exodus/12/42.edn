{:tier :glm-5.2, :verse 42, :comments [{:quotes [{:he "שמורים", :translit "shemurim", :gloss "observed/guarded"} {:he "ליל שמורים", :translit "leil shemurim", :gloss "a night of observances"} {:he "שמורים לכל בני ישראל", :translit "shemurim l'chol b'nei yisrael", :gloss "observed for all the children of Israel"} {:he "ליל ט\"ו לשנים", :translit "leil t\"u lashanim", :gloss "a night of fifteen for the years"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ליל שמורים" "שמורים לכל בני ישראל"]} {:kind :other, :note "Gematria of ט\"ו = 15, indicating that this night encompasses 15 landmark events across the arc of Israelite history."}], :frame {:text "R. Eliezer identifies fifteen passages of kingship beginning from Exodus 12:2 through the Song of the Sea that trace Israel's path from servitude to redemption; R. Akiva counts the matching fifteenth in the parallel sequence (Mekhilta de-Rabbi Yishmael, Bo, ch. 14). Each of the fifteen is tied to the night of the Exodus and its enduring character (Exodus 12:42). Berakhot 9a records the dispute over whether Israel was redeemed in the night or by day; Exodus 12:41 locates the climax at the precise moment. Numbers Rabbah 13:5 aligns this night of observances with the future redemption, pairing the two halves.", :sources ["Mekhilta de-Rabbi Yishmael, Bo, ch. 14" "Berakhot 9a" "Exodus 12:41" "Exodus 12:42" "Numbers Rabbah 13:5"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ליל שמורים" "שמורים לכל בני ישראל"], :by :selah, :located [{:phrase "ליל שמורים", :refs ["Exodus 12:42"], :n 1, :lens :plene-insensitive} {:phrase "שמורים לכל בני ישראל", :refs ["Exodus 12:42"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Gematria of ט\"ו = 15, indicating that this night encompasses 15 landmark events across the arc of Israelite history.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:28.489544293Z", :mode