{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "מבושל", :translit "m'vushal", :gloss "cooked"} {:he "ובשל", :translit "u'vashal", :gloss "and cooked"} {:he "ולא אקח ממך בשר מבושל", :translit "v'lo ekach mim'cha basar m'vushal", :gloss "and I will not accept from you cooked meat"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["מבושל" "ובשל מבושל"]}], :frame {:text "In 1 Samuel 2:13–17 the sons of Eli, Hophni and Phinehas, are described as taking raw meat from the sacrificial pot by force before the fat was burned, treating the offerings of the Lord with contempt (1 Samuel 2:17). The phrase ולא אקח ממך בשר מבושל, 'I will not accept from you cooked meat,' is not a direct biblical quotation; Ba'al HaTurim reads the Masoretic pairing of the word מבושל as pointing back to the sons of Eli, whose contempt for sacrificial order is attested in 1 Samuel 2:17.", :sources ["1 Samuel 2:13–17"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["מבושל" "ובשל מבושל"], :by :selah, :located [{:phrase "מבושל", :refs ["Exodus 12:9" "1 Samuel 2:15"], :n 2, :lens :plene-insensitive} {:phrase "ובשל מבושל", :refs ["Exodus 12:9"], :n 1, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:03.406142976Z", :model "glm-5.2"}