{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "ולא יתן", :translit "v'lo yiten", :gloss "and He will not give / and it shall not be placed"} {:he "ולא יתן עליה לבונה", :translit "v'lo yiten aleiha levonah", :gloss "and he shall not place on it frankincense"} {:he "ולא יתן עליה לבונה", :translit "v'lo yiten aleiha levonah", :gloss "and he shall not place on it frankincense"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ולא יתן" "ולא יתן עליה לבונה גבי חטאת" "ולא יתן עליה לבונה גבי סוטה"]}], :frame {:text "The phrase ולא יתן עליה לבונה appears in the Torah in two contexts: Leviticus 5:11, regarding the flour offering of one too poor to afford an animal for a sin-offering, and Numbers 5:15, regarding the grain offering of a suspected wife (sotah). For the latter, Sotah 11b explains that the Israelite women in Egypt were saved through the merit of righteous women (שכשר נשים צדקניות), while the sotah offering deliberately lacks frankincense because she did not follow the deeds of those righteous women. Exodus 12:23, the third occurrence of ולא יתן, is read as linking to both: Israel was saved in Egypt by the merit of sacrificial worship and by the merit of righteous women.", :sources ["Leviticus 5:11" "Numbers 5:15" "Sotah 11b"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ולא יתן" "ולא יתן עליה לבונה גבי חטאת" "ולא יתן עליה לבונה גבי סוטה"], :by :selah, :located [{:phrase "ולא יתן", :refs ["Exodus 12:23" "Leviticus 5:11" "Numbers 5:15" "2 Kings 5:17"], :n 4, :lens :exact} {:phrase "ולא יתן עליה לבונה גבי חטאת", :refs [], :n 0, :lens :plene-insensitive} {:phrase "ולא יתן עליה לבונה גבי סוטה", :refs [], :n 0, :lens :plene-insensitive}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:14.442019437Z", :model "glm-5.2"}