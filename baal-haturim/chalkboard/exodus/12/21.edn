{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "משכו וקחו לכם צאן", :translit "meshkhu u-k'khu lakhem tzo'n", :gloss "Draw out and take for yourselves a flock"} {:he "משכו", :translit "meshkhu", :gloss "Draw out"} {:he "מן עברה", :translit "min ivrah", :gloss "from anger"}], :mechanisms [{:kind :gematria, :a "משכו", :b "מן עברה"}], :frame {:text "The Torah states that small cattle (בהמה דקה) are acquired through drawing (משיכה), as codified in the laws of acquisition (Kiddushin 25b). Ba'al HaTurim reads the word משכו at Exodus 12:21 as an allusion to this halakhic mechanism of משיכה. The gematria linking משכו to מן עברה, from anger, conveys that one must not bring a offering from stolen property — theft being an act rooted in anger.", :sources ["Kiddushin 25b" "Exodus 12:21"]}}], :arithmetic [{:a-value 366, :b-value 367, :lens :standard, :equal? false, :kind :gematria, :b "מן עברה", :by :selah, :colel? true, :a "משכו"}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:10.091148813Z", :model "glm-5.2"}