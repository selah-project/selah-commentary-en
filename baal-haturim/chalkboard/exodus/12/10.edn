{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "ולא תותירו ממנו עד בוקר", :translit "v'lo totiru mimenu ad boker", :gloss "and you shall not leave of it until morning"} {:he "עד בוקר", :translit "ad boker", :gloss "until morning"} {:he "הוא השני ליתן בוקר שני לשריפתו", :translit "hu ha-sheni layiten boker sheni lis'rifato", :gloss "it is the second, to give a second morning for its burning"}], :mechanisms [{:kind :gematria, :a "עד בוקר", :b "הוא השני ליתן בוקר שני"}], :frame {:text "The verse (Exodus 12:10) obligates consuming the Paschal lamb by morning, and anything left must be burned. Rabbinic law specifies this means the morning of the sixteenth of Nisan, the day after the sacrifice, when the Temple opened for the offering of the festive Chagigah (Pesachim 95b–96a). The phrase עד בוקר thus points to the second morning — the morning after the night of the fourteenth when the lamb was eaten — as the deadline for burning the leftovers.", :sources ["Exodus 12:10" "Pesachim 95b–96a"]}}], :arithmetic [{:kind :gematria, :a "עד בוקר", :a-value 382, :b "הוא השני ליתן בוקר שני", :b-value 1535, :lens :standard, :by :selah, :equal? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:15:03.654336408Z", :model "glm-5.2"}