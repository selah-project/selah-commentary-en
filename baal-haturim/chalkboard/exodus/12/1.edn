{:tier :glm-5.2, :verse 1, :comments [{:quotes [{:he "אל משה ואל אהרן בארץ מצרים לאמר", :translit "el moshe ve'el aharon be'eretz mitzrayim leimor", :gloss "to Moses and to Aaron in the land of Egypt, saying"} {:he "החודש", :translit "hachodesh", :gloss "the month"} {:he "מקודש", :translit "mekudash", :gloss "[it is] sanctified"} {:he "אל משה ואל אהרן החודש", :translit "el moshe ve'el aharon hachodesh", :gloss "to Moses and to Aaron, the month"}], :mechanisms [{:kind :other, :note "Juxtaposition (סמוך) of adjacent phrases: the verse 'to Moses and to Aaron' is immediately followed by 'this month is to you,' linking the addressees to the declaration of sanctification."} {:kind :other, :note "Reading the sequence of words 'אל משה ואל אהרן החודש' as a continuous phrase rather than split across verse boundaries, to derive that close relatives may testify together for Kiddush HaChodesh."}], :frame {:text "Mishnah Rosh HaShanah 2:7 records the case where a father and son — or any relatives — who together witnessed the new moon must still appear in court together, since all are qualified witnesses; Rabbi Akiva states explicitly that relatives are acceptable for this testimony. The phrase 'the head of the father's house declares מקודש' refers to the court's formal declaration of the new month, described in Mishnah Rosh HaShanah 2:7 and Mishnah Rosh HaShanah 3:1.", :sources ["Mishnah Rosh HaShanah 2:7" "Mishnah Rosh HaShanah 3:1"]}}], :arithmetic [{:kind :other, :note "Juxtaposition (סמוך) of adjacent phrases: the verse 'to Moses and to Aaron' is immediately followed by 'this month is to you,' linking the addressees to the declaration of sanctification.", :by :selah, :ran? false} {:kind :other, :note "Reading the sequence of words 'אל משה ואל אהרן החודש' as a continuous phrase rather than split across verse boundaries, to derive that close relatives may testify together for Kiddush HaChodesh.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:14:59.723135141Z", :model "glm-5.2"}