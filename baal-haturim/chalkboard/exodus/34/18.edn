{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "חג המצות", :translit "chag ha-matzot", :gloss "the Festival of Matzot"} {:he "אלהי מסכה", :translit "elohei masakhah", :gloss "god of a molten image"} {:he "ע\"ג", :translit "avodah zarah", :gloss "idolatry"} {:he "אסורה בהנאה", :translit "asurah be-hana'ah", :gloss "forbidden in benefit"} {:he "כחמץ בפסח", :translit "ke-chametz be-Pesach", :gloss "like leaven on Pesach"}], :mechanisms [{:kind :other, :note "Smikhut of adjacent verses: Festival of Matzot in v.18 placed next to prohibition of molten gods in v.17"}], :frame {:text "The principle of smikhut parshiyot (juxtaposition of passages) is used to derive law from the placement of adjacent verses. Avodah zarah is forbidden in benefit by verse (Deuteronomy 13:18), and leaven is forbidden in benefit on Pesach by verse (Exodus 13:3). The Ba'al HaTurim links the two via the juxtaposition of 'god of a molten image' (Exodus 34:17) and 'Festival of Matzot' (Exodus 34:18).", :sources ["Deuteronomy 13:18" "Exodus 13:3" "Exodus 34:17" "Exodus 34:18"]}}], :arithmetic [{:kind :other, :note "Smikhut of adjacent verses: Festival of Matzot in v.18 placed next to prohibition of molten gods in v.17", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 34, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:04.624148329Z", :model "glm-5.2"}