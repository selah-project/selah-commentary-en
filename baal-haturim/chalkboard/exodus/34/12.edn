{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "פן תכרות ברית ליושב הארץ", :translit "pen tikhrat berit le-yoshev ha-aretz", :gloss "lest you cut a covenant to the inhabitant of the land"} {:he "ליושב", :translit "le-yoshev", :gloss "to inhabitant"} {:he "מלא וי\"ו", :translit "male vav", :gloss "plene with vav"}], :mechanisms [{:kind :masorah, :count 6, :occurrences ["ליושב"]} {:kind :other, :note "Plene spelling of ליושב signals that only six of seven Canaanite nations remain; the seventh, Girgashite, voluntarily emigrated."}], :frame {:text "Moses is bidden in Exodus 34:11 to dispossess seven Canaanite nations. Earlier in Exodus 23:28 and Deuteronomy 7:1 the Girgashite is included among the seven. The midrashic tradition holds that the Girgashite nation, seeing what happened to the others, chose to leave Canaan voluntarily. Joshua 24:11 lists the nations Israel encountered and omits the Girgashite, supporting the tradition that they had already departed.", :sources ["Exodus 34:11" "Exodus 23:28" "Deuteronomy 7:1" "Joshua 24:11" "Jerusalem Talmud Shevi'it 6:1"]}}], :arithmetic [{:kind :masorah, :count 6, :occurrences ["ליושב"], :by :selah, :located [{:phrase "ליושב", :refs ["Exodus 34:12" "Exodus 34:15" "Isaiah 8:14" "Isaiah 22:21" "Isaiah 28:6"], :n 5, :lens :exact}]} {:kind :other, :note "Plene spelling of ליושב signals that only six of seven Canaanite nations remain; the seventh, Girgashite, voluntarily emigrated.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 34, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:55.023630769Z", :model "glm-5.2"}