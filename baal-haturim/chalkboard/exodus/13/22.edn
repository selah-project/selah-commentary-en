{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "לא ימיש עמוד הענן יומם ועמוד האש וגו׳", :translit "lo yamish amud he'anan yomam ve-amud ha-esh vegomer", :gloss "He did not remove the pillar of cloud by day and the pillar of fire etc."} {:he "לפני העם", :translit "lifnei ha-am", :gloss "before the people"} {:he "מלפני העם", :translit "milifnei ha-am", :gloss "from before the people"}], :mechanisms [{:kind :other, :note "Lexical inference from absence of mem prefix: לפני העם instead of מלפני העם implies both pillars were simultaneously before the people."}], :frame {:text "Exodus 13:21–22 describes the pillar of cloud by day and the pillar of fire by night going before Israel. By reading לפני העם rather than מלפני העם, the Ba'al HaTurim infers both pillars could be present simultaneously.", :sources ["Exodus 13:21–22"]}} {:quotes [{:he "לא ימיש", :translit "lo yamish", :gloss "He did not remove / did not depart"} {:he "לא ימיש מתוך האהל", :translit "lo yamish mitoch ha-ohel", :gloss "he did not depart from inside the Tent"} {:he "מתוך האהל", :translit "mitoch ha-ohel", :gloss "from inside the Tent"} {:he "לפני העם", :translit "lifnei ha-am", :gloss "before the people"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לא ימיש"]} {:kind :other, :note "Gezerah shavah linking the two occurrences of לא ימיש: Joshua's diligence mirrors the pillars' constancy."}], :frame {:text "Joshua is described as not departing from the Tent in Exodus 33:11. The Ba'al HaTurim connects this to the pillars of cloud and fire through the shared phrase לא ימיש. Joshua's reward for his diligence is that he later leads the people, going לפני העם, described in Joshua 3:6 where he instructs the people to advance.", :sources ["Exodus 33:11" "Exodus 13:22" "Joshua 1:8" "Joshua 3:6"]}}], :arithmetic [{:kind :other, :note "Lexical inference from absence of mem prefix: לפני העם instead of מלפני העם implies both pillars were simultaneously before the people.", :by :selah, :ran? false} {: