{:tier :glm-5.2, :verse 27, :comments [{:quotes [{:he "מאת אדנים", :translit "me'at adanim", :gloss "a hundred sockets"} {:he "מיוסדים על אדני פז", :translit "meyusadim al adnei paz", :gloss "founded upon sockets of fine gold"} {:he "ק' ברכות", :translit "k' berachot", :gloss "a hundred blessings"}], :mechanisms [{:kind :other, :note "Wordplay linking אדנים (sockets) to אדני פז (sockets of gold) in Song of Songs 5:15"} {:kind :masorah, :count 100, :occurrences ["ברכות"]}], :frame {:text "King David instituted one hundred blessings daily to be recited by every Jew, as stated in Tractate Menahot 43b. The verse in Song of Songs 5:15 reads 'his hands are rods of gold set with beryl' (מיוסדים על אדני פז), which rabbinic tradition links to the sockets (אדנים) of the Tabernacle. The Ba'al HaTurim draws a three-way correspondence: the 100 silver sockets of the Tabernacle correspond to those described in Song of Songs and to the 100 daily blessings.", :sources ["Menahot 43b" "Song of Songs 5:15"]}}], :arithmetic [{:kind :other, :note "Wordplay linking אדנים (sockets) to אדני פז (sockets of gold) in Song of Songs 5:15", :by :selah, :ran? false} {:kind :masorah, :count 100, :occurrences ["ברכות"], :by :selah, :located [{:phrase "ברכות", :refs ["Psalms 21:4" "Psalms 21:7" "Psalms 84:7" "Proverbs 10:6" "Proverbs 28:20" "Song of Songs 7:5" "Ecclesiastes 2:6"], :n 7, :lens :exact}]}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 38, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:25.351849193Z", :model "glm-5.2"}