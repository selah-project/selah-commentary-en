{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "כל הזהב", :translit "kol ha-zahav", :gloss "all the gold"} {:he "ה' מיני זהב", :translit "hamishah minei zahav", :gloss "five types of gold"} {:he "חח", :translit "chach", :gloss "armlet"} {:he "נזם", :translit "nezem", :gloss "nose-ring"} {:he "טבעת", :translit "taba'at", :gloss "ring"} {:he "כומז", :translit "kumaz", :gloss "pendant"} {:he "וכל כלי זהב", :translit "v'chol k'lei zahav", :gloss "and all gold vessels"} {:he "כנגד העשוי להם", :translit "k'neged ha'asuy lahem", :gloss "corresponding to what was done to them"} {:he "ה' ענוין", :translit "hamishah inuyin", :gloss "five afflictions"} {:he "פרך", :translit "parech", :gloss "crushing"} {:he "מרר", :translit "marar", :gloss "bitterness"} {:he "ענוי", :translit "inui", :gloss "affliction"} {:he "לחץ", :translit "lachatz", :gloss "oppression"} {:he "עבודה קשה", :translit "avodah kashah", :gloss "hard labor"}], :mechanisms [{:kind :other, :note "One-to-one correspondence: five gold donations parallel five categories of Egyptian suffering."}], :frame {:text "The donation of gold at the Tabernacle's construction is understood as compensation for Israel's suffering in Egypt. Four of the five terms for affliction appear together in Exodus 1:13–14, where Pharaoh enslaves Israel with hard labor and crushing oppression. The Midrash Tanchuma (Terumah 4) counts these as the five redemptions corresponding to the five expressions of deliverance in Exodus 6:6–7.", :sources ["Exodus 1:13-14" "Exodus 6:6-7" "Midrash Tanchuma Terumah 4"]}}], :arithmetic [{:kind :other, :note "One-to-one correspondence: five gold donations parallel five categories of Egyptian suffering.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 38, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:22.487894651Z", :model "glm-5.2"}