{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "אלה פקודי", :translit "eleh pekudei", :gloss "these are the reckonings"} {:he "מלא וי\"ו", :translit "malei vav", :gloss "plene with vav"} {:he "שפקד לכל ו' מאות אלף", :translit "she-pakad le-chol vav me'ot elef", :gloss "because he reckoned for every six hundred thousand"} {:he "שלא יחשדוהו שלקח מן הכסף", :translit "she-lo yachshodu-hu she-lakach min ha-kesef", :gloss "so they would not suspect him of taking from the silver"} {:he "המשכן משכן", :translit "ha-mishkan mishkan", :gloss "the Mishkan of the Mishkan"} {:he "שנתמשכן ב\"פ בשביל עונות ישראל", :translit "she-nitmashkan be-fa'am be-shavil onot yisra'el", :gloss "read twice on account of Israel's sins"} {:he "וזהו שאמרו אנשי כנה\"ג", :translit "ve-zehu she-amru anshei kennesset ha-gedolah", :gloss "and this is what the Men of the Great Assembly said"} {:he "חבול חבלנו", :translit "chavul chalalnu", :gloss "we have taken a pledge"} {:he "משכן", :translit "mishkan", :gloss "Mishkan"} {:he "ת\"י", :translit "tav yod", :gloss "410"}], :mechanisms [{:kind :other, :note "Word אלה written plene with a vav signals Moses reckoned accounts for every 600,000 Israelites"} {:kind :masorah, :count 2, :occurrences ["המשכן משכן"]} {:kind :gematria, :a "משכן", :b "ת\"י"} {:kind :other, :note "First Temple stood 410 years, twice the numerical value of משכן"}], :frame {:text "Moses rendered a full public accounting of the Sanctuary's silver so the people would not suspect him of misappropriation (see Shabbat 119b and Midrash Tanchuma, Pekudei 5, where Moses said: 'I know that Israel grumbles — I will render an account'). The phrase 'חבול חבלנו' comes from Nehemiah 5:4, where the returnees from exile lament that they had to pledge their sons and daughters — read by Nehemiah 10:35 among the pledges of the covenant. The Men of the Great Assembly are those who led Israel in the early Second Temple period, as referenced in Pirkei Avot 1:1.", :sources ["Shabbat 119b" "Midrash Tanchuma Pekudei 5" "Nehemiah 5:4" "Nehemiah 10:35" "Pirkei Avot 1:1"]}}], :arithmetic [{:kind :other, :note "Word אלה written plene with a vav signals Moses reckoned accounts for every 600,000 Israelites", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["המשכן משכן"], :by :selah, :located [{:phrase "המשכן משכן", :refs ["Exodus 38:21"], :n 1, :lens :exact}]} {:kind :gematria, :a "משכן", :a-value 410, :b "ת\"י", :b-value 410, :lens :standard, :by :selah, :equal? true} {:kind :other, :note "First Temple stood 410 years, twice the numerical value of משכן", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 38, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:23.549079705Z", :model "glm-5.2"}