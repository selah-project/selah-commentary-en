{:tier :glm-5.2, :verse 27, :comments [{:quotes [{:he "והנשאם", :translit "ve-ha-nesi'im", :gloss "and the leaders"} {:he "ב' הכא", :translit "bat khan", :gloss "twice here"} {:he "חסר", :translit "chaser", :gloss "defective"} {:he "וישב פנחס", :translit "ve-yashev pinchas", :gloss "and Pinchas sat"} {:he "והנשיאים", :translit "ve-ha-nesi'im", :gloss "and the leaders"} {:he "מלא", :translit "malei", :gloss "plene"} {:he "אלו שנתעצלו", :translit "elu she-nit'atzelu", :gloss "these are the ones who held back"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והנשאם" "והנשיאים"]} {:kind :other, :note "Defective spelling והנשאם without yod marks the leaders' laziness; plene והנשיאים is the standard form."}], :frame {:text "The spelling והנשאם is written defectively (without the expected yod) at Exodus 35:27 and Judges 20:28. Rashi on Exodus 35:27, citing Midrash Tanchuma, explains that the princes (nesi'im) were punished for delaying their offering — they said 'let the community bring what they bring, and whatever is lacking we will complete' — and so a letter was dropped from their title. The Ba'al HaTurim applies this specifically to the leaders at the dedication of the Tabernacle.", :sources ["Rashi on Exodus 35:27" "Midrash Tanchuma Vayakhel 5" "Exodus 35:27" "Judges 20:28"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והנשאם" "והנשיאים"], :by :selah, :located [{:phrase "והנשאם", :refs ["Exodus 35:27"], :n 1, :lens :exact} {:phrase "והנשיאים", :refs ["Joshua 22:32"], :n 1, :lens :exact}]} {:kind :other, :note "Defective spelling והנשאם without yod marks the leaders' laziness; plene והנשיאים is the standard form.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 35, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:11.029843256Z", :model "glm-5.2"}