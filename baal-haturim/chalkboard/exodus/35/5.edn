{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "יביאה את תרומת ה'", :translit "y'vi'ah et t'rumat Hashem", :gloss "he shall bring it, the contribution of HaShem"} {:he "יביא", :translit "yavi", :gloss "he shall bring"} {:he "יביאה", :translit "y'vi'ah", :gloss "he shall bring it"}], :mechanisms [{:kind :other, :note "Feminine suffix -ה on יביאה marks the object (her ornament) being brought, signaling voluntary consent for women's jewelry donations."}], :frame {:text "The verse describes the Tabernacle donation. The appended feminine object-suffix on יביאה (as opposed to the simpler יביא) signals that when the donated items are women's gold and silver ornaments, the items may only be given with the woman's own willingness. Exodus 35:5 itself specifies that the donation must be 'whoever's heart motivates him' (אשר ידבנו לבו), the voluntary spirit the grammatical form reflects.", :sources ["Exodus 35:5"]}}], :arithmetic [{:kind :other, :note "Feminine suffix -ה on יביאה marks the object (her ornament) being brought, signaling voluntary consent for women's jewelry donations.", :by :selah, :ran? false}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 35, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:21:04.267647366Z", :model "glm-5.2"}