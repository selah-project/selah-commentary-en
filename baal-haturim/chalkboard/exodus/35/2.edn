{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "ששת", :translit "sheshet", :gloss "six"}], :mechanisms [{:kind :gematria, :a "ששת", :b "ארבעים חסר אחת"}], :frame {:text "The phrase 'forty lacking one' (ארבעים חסר אחת) is a known Rabbinic idiom for the number thirty-nine. It is used in the Mishnah to enumerate the thirty-nine categories of primary labor (melakhot) forbidden on Shabbat, which are derived as 'forty minus one.' By equating ששת to this number through gematria, the comment links the six days of work in this verse to the thirty-nine labors prohibited on the seventh.", :sources ["Mishnah Shabbat 7:2"]}}], :arithmetic [{:kind :gematria, :a "ששת", :a-value 1000, :b "ארבעים חסר אחת", :b-value 1000, :lens :standard, :by :selah, :equal? true}], :book :exodus, :voice :baal-haturim, :lang :en, :chapter 35, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:20:59.354641168Z", :model "glm-5.2"}