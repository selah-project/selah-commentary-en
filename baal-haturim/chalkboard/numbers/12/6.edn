{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "במראה", :translit "b'mar'eh", :gloss "in a vision"} {:he "במראה אליו אתוודע", :translit "b'mar'eh eilaiv etvada", :gloss "in a vision I make myself known to him"} {:he "במראה נהפכו צירי עלי", :translit "b'mar'eh nehafkhu tzirei alai", :gloss "in a vision the tzerei were turned upon me"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["במראה" "במראה"]} {:kind :other, :note "wordplay on צירי as both a vowel-name and 'angels/messengers' from ציר"}], :frame {:text "Ba'al HaTurim cites a rabbinic tradition distinguishing Moses's prophecy from that of all other prophets. Numbers 12:6-8 establishes this contrast: other prophets receive revelation through dreams and visions (במראה), while Moses speaks with God 'mouth to mouth' and sees the divine form clearly, not in riddles. The Talmud states that all prophets prophesied through an angel; the word ציר means 'angel' or 'messenger' (cf. Isaiah 43:27 where ציריך means 'your interpreters/messengers'). Moses alone prophesied without an intermediary angel, sitting directly before the divine presence like a disciple before his master, as the Sifrei on this verse teaches.", :sources ["Numbers 12:6-8" "Sifrei Zuta 12:6" "Shabbat 92a" "Isaiah 43:27"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["במראה" "במראה"], :by :selah, :located [{:phrase "במראה", :refs ["Numbers 12:6" "Ezekiel 11:24" "Daniel 9:23" "Daniel 10:1" "Daniel 10:16"], :n 5, :lens :exact} {:phrase "במראה", :refs ["Numbers 12:6" "Ezekiel 11:24" "Daniel 9:23" "Daniel 10:1" "Daniel 10:16"], :n 5, :lens :exact}]} {:kind :other, :note "wordplay on צירי as both a vowel-name and 'angels/messengers' from ציר", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:35.461629280Z", :model "glm-5.2"}