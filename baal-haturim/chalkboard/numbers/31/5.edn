{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "וימסרו מאלפי ישראל", :translit "vayimasru me'alefei yisra'el", :gloss "and they were delivered from the thousands of Israel"} {:he "שמסרו עצמן על קדושת השם", :translit "she-masru atzman al kedushat ha-shem", :gloss "that they delivered themselves for the sanctification of the Name"} {:he "להצלת ישראל", :translit "le-hatzalat yisra'el", :gloss "for the salvation of Israel"}], :mechanisms [{:kind :other, :note "Reads the root מסר (deliver) as reflexive: the soldiers delivered themselves over, i.e., risked their lives for kiddush ha-Shem"}], :frame {:text "The verb וימסרו normally means 'they were delivered' or 'were handed over' (Numbers 31:5). Ba'al HaTurim reads it reflexively: the soldiers willingly surrendered themselves to danger. The willingness of Israel's warriors to risk their lives in battle against Midian is presented as an act of self-consecration.", :sources ["Numbers 31:5"]}}], :arithmetic [{:kind :other, :note "Reads the root מסר (deliver) as reflexive: the soldiers delivered themselves over, i.e., risked their lives for kiddush ha-Shem", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 31, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:09.143879486Z", :model "glm-5.2"}