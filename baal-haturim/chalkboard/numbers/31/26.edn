{:tier :glm-5.2, :verse 26, :comments [{:quotes [{:he "מלקוח", :translit "malkoach", :gloss "spoil"} {:he "שא את ראש מלקוח", :translit "sa et rosh malkoach", :gloss "take up the head of the spoil"} {:he "היוקח מגבור מלקוח", :translit "hayyucham migibor malkoach", :gloss "that which is taken from the mighty is spoil"} {:he "ואתם לקחתם מגבור מלקוח", :translit "ve'atem lakachtem migibor malkoach", :gloss "and you took from the mighty spoil"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["שא את ראש מלקוח" "היוקח מגבור מלקוח"]}], :frame {:text "The word מלקוח appears twice in this verse: once in the phrase שא את ראש מלקוח and once in the phrase היוקח מגבור מלקוח. Ba'al HaTurim reads the second occurrence as a definition: spoil is 'that which is taken from the mighty.' He then reasons that since Israel took spoil from the mighty, the phrase שא את ראש מלקוח means to take a portion (ראש, head) from that spoil as a levy for God, as the verse continues ונתת ממנו מכס לה' (Numbers 31:28).", :sources ["Numbers 31:26" "Numbers 31:28"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["שא את ראש מלקוח" "היוקח מגבור מלקוח"], :by :selah, :located [{:phrase "שא את ראש מלקוח", :refs ["Numbers 31:26"], :n 1, :lens :exact} {:phrase "היוקח מגבור מלקוח", :refs ["Isaiah 49:24"], :n 1, :lens :plene-insensitive}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 31, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:18.064081929Z", :model "glm-5.2"}