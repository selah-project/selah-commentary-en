{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "הדפו", :translit "hedafu", :gloss "pushed him"} {:he "בלא איבה הדפו", :translit "b'lo eivah hedafu", :gloss "without enmity pushed him"} {:he "כי ה' הרפו", :translit "ki Hashem herpo", :gloss "for YHWH let him fall"} {:he "והאלהים אנה לידו", :translit "vehaElohim inah leyado", :gloss "and Elohim caused it to come to his hand"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הדפו" "כי ה' הרפו"]}], :frame {:text "The phrase 'והאלהים אנה לידו' (Exodus 21:13) is interpreted via a parable of two men at one inn, where the unintentional killer falls from a ladder onto the intentional killer, so that the latter's death occurs through the former's unintentional act, making him liable to exile. This parable appears in Makkot 10b in the name of R. Yoshiya, who derives from Exodus 21:13 that God orchestrates the circumstance so that the one liable to exile arrives at the fate decreed for him.", :sources ["Exodus 21:13" "Makkot 10b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["הדפו" "כי ה' הרפו"], :by :selah, :located [{:phrase "הדפו", :refs ["Numbers 35:22" "Jeremiah 46:15"], :n 2, :lens :exact} {:phrase "כי ה' הרפו", :refs [], :n 0, :lens :plene-insensitive}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 35, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:56.313747804Z", :model "glm-5.2"}