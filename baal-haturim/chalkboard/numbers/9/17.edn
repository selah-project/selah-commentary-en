{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "העלות הענן", :translit "be-he'alot ha'anan", :gloss "when the cloud set out"} {:he "העלות הגולה", :translit "be-he'alot ha-golah", :gloss "when the exile set out"} {:he "ראוין היו שיעשה להם נם בימי עזרא כדרך שנעשה להם בימי משה אלא שגרם החטא", :translit "ra'uyn hayu she-ye'useh lahem nom ba-yamim Ezra ke-derekh she-na'aseh lahem ba-yamim Moshe ela she-garam ha-chet", :gloss "they were worthy that a נם should be made for them in the days of Ezra in the manner that was made for them in the days of Moses but sin caused"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["העלות הענן" "העלות הגולה"]} {:kind :other, :note "Wordplay linking the cloud setting out in the wilderness with the exile setting out; the one occurrence in Numbers 9:17 invites contrast with the other."}], :frame {:text "The phrase העלות הענן echoes the phrase העלות הגולה in Numbers 10:34, suggesting a link between the journeys of Israel guided by the cloud and the journeys of Israel in exile. According to the Talmud, the returned exiles in the days of Ezra were worthy of having the same divine signs restored that Israel had experienced in the days of Moses, but sin prevented it (Shabbat 147a).", :sources ["Numbers 10:34" "Shabbat 147a"]}} {:quotes [{:he "ובמקום", :translit "u-vi-mekom", :gloss "and at the place"} {:he "ובמקום גדולים אל תעמוד", :translit "u-vi-mekom gedolim al ta'amod", :gloss "and at the place of great ones do not stand"} {:he "ובמקום אשר ישכון שם הענן", :translit "u-vi-mekom asher yishkon sham ha'anan", :gloss "and at the place where the cloud dwells there"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ובמקום"]} {:kind :other, :note "The phrase ובמקום appears twice; the other verse is read as a hyponymic expression for improper conduct near the divine presence."}], :frame {:text "The Talmud derives from Deuteronomy 23:13–15, which requires Israel to maintain a clean camp because God walks in their midst, that one must not relieve oneself in front of or to the sides of the divine presence but only behind it (Yoma 75b). Ba'al HaTurim reads the phrase ובמקום in Numbers 9:17 as a masoretic link to Proverbs 24:21, 'and at the place of great ones do not stand,' which he interprets as a warning not to make 'great ones,' i.e., relieve oneself, in front of or beside the cloud.", :sources ["Deuteronomy 23:13-15" "Yoma 75b" "Proverbs 24:21"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["העלות הענן" "העלות הגולה"], :by :selah, :located [{:phrase "העלות הענן", :refs ["Numbers 9:17"], :n 1, :lens :plene-insensitive} {:phrase "העלות הגולה", :refs ["Ezra 1:11"], :n 1, :lens :exact}]} {:kind :other, :note "Wordplay linking the cloud setting out in the wilderness with the exile setting out; the one occurrence in Numbers 9:17 invites contrast with the other.", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["ובמקום"], :by :selah, :located [{:phrase "ובמקום", :refs ["Numbers 9:17" "Haggai 2:9" "Proverbs 25:6"], :n 3, :lens :exact}]} {:kind :other, :note "The phrase ובמקום appears twice; the other verse is read as a hyponymic expression for improper conduct near the divine presence.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 9, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:03.365590148Z", :model "glm-5.2"}