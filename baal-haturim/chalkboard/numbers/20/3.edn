{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "וירב", :translit "va'yirav", :gloss "and quarreled"} {:he "וירב העם", :translit "va'yirav ha-am", :gloss "and the people quarreled"} {:he "וירב בנחל", :translit "va'yirav ba'nachal", :gloss "and quarreled at the stream"} {:he "מריבה", :translit "merivah", :gloss "quarrel"} {:he "נחל", :translit "nachal", :gloss "stream"} {:he "הבאר", :translit "ha-be'er", :gloss "the well"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וירב העם" "וירב בנחל"]}], :frame {:text "The well that supplied Israel in the wilderness is identified with the rock that Moses struck; it traveled with the camp and provided water throughout the forty years (Tosefta Sukkah 3:11–13, Baba Kamma 82a). When Miriam died, this well ceased, and its disappearance is understood as the cause of the congregation's quarrel in Numbers 20:2–5 (Taanit 9a).", :sources ["Tosefta Sukkah 3:11–13" "Baba Kamma 82a" "Taanit 9a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וירב העם" "וירב בנחל"], :by :selah, :located [{:phrase "וירב העם", :refs ["Exodus 1:20" "Exodus 17:2" "Numbers 20:3"], :n 3, :lens :exact} {:phrase "וירב בנחל", :refs ["1 Samuel 15:5"], :n 1, :lens :exact}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:03.576312883Z", :model "glm-5.2"}