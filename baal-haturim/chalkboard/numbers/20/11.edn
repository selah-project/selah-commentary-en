{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "ויך את הסלע", :translit "vayakh et ha-sela", :gloss "and he struck the rock"} {:he "יִבְקַע צֻרִים בַּמִּדְבָּר", :translit "yivka tzurim ba-midbar", :gloss "rocks will split in the wilderness"}], :mechanisms [{:kind :other, :note "Gezeirah shavah: links 'sela' (rock) here to 'tzurim' (rocks) in Judges, extending the miracle to all rocks"}], :frame {:text "The link between our verse and Judges 5:5 rests on verbal similarity: both describe rock-splitting in the wilderness context. By reading 'הסלע' against 'יִבְקַע צֻרִים בַּמִּדְבָּר' (Judges 5:5), Ba'al HaTurim expands the scope of the miracle so that Moses' single strike fractures rocks throughout the entire wilderness, not merely the one he hit.", :sources ["Judges 5:5"]}}], :arithmetic [{:kind :other, :note "Gezeirah shavah: links 'sela' (rock) here to 'tzurim' (rocks) in Judges, extending the miracle to all rocks", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:09.757342542Z", :model "glm-5.2"}