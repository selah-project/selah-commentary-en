{:tier :glm-5.2, :verse 26, :comments [{:quotes [{:he "והלבשתם", :translit "u-vilbashta", :gloss "and you shall clothe"} {:he "והלבשתם את אלעזר", :translit "u-vilbashta et el'azar", :gloss "and you shall clothe Elazar"} {:he "והלבשתם כתנות", :translit "u-vilbashta kutnot", :gloss "and you shall clothe [with] tunics"} {:he "כהן גדול בן כהן גדול", :translit "kohen gadol ben kohen gadol", :gloss "a High Priest son of a High Priest"} {:he "טעון משיחה", :translit "ta'un meshicha", :gloss "requires anointing"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והלבשתם את אלעזר" "והלבשתם כתנות"]} {:kind :other, :note "Gezeirah shavah between the two occurrences of והלבשתם: clothing of Aaron's successors at Numbers 20:26 learned from clothing of priests at Exodus 29 / 28."}], :frame {:text "The Talmud debates whether a Kohen Gadol who succeeds his father as High Priest requires anointing with oil. One view holds he does require anointing just like any new High Priest, while another holds he does not, since he already served under his father (Horayot 12a; Keritot 5b; Zevachim 18a). The Ba'al HaTurim uses the rare doubled form והלבשתם to link Numbers 20:26, where Elazar is invested as successor to Aaron, with the priestly investiture of Exodus 28:41, where the Torah explicitly states the garments are worn 'with anointing' — thereby showing Elazar's investiture likewise involved anointing.", :sources ["Horayot 12a" "Keritot 5b" "Zevachim 18a" "Exodus 28:41"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והלבשתם את אלעזר" "והלבשתם כתנות"], :by :selah, :located [{:phrase "והלבשתם את אלעזר", :refs ["Numbers 20:26"], :n 1, :lens :exact} {:phrase "והלבשתם כתנות", :refs ["Exodus 29:8"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Gezeirah shavah between the two occurrences of והלבשתם: clothing of Aaron's successors at Numbers 20:26 learned from clothing of priests at Exodus 29 / 28.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:23.909285451Z", :model "glm-5.2"}