{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "ולא תסוב נחלה", :translit "v'lo tasuv nachalah", :gloss "and the inheritance shall not pass"} {:he "הסבת בעל", :translit "hasavat ba'al", :gloss "the transferring of a husband"}], :mechanisms [{:kind :gematria, :a "ולא תסוב נחלה", :b "הסבת בעל"}], :frame {:text "Numbers 36:9 warns that inheritance of the tribes shall not pass from one to another. The chapter addresses the daughters of Tzelophehad, whose inheritance could transfer to another tribe if they marry outside their own tribe (Numbers 36:3, 36:8). The phrase 'hasavat ba'al' refers to this transfer of tribal land through marriage to a husband from a different tribe, which the verse comes to prevent.", :sources ["Numbers 36:3" "Numbers 36:8" "Numbers 36:9"]}}], :arithmetic [{:kind :gematria, :a "ולא תסוב נחלה", :a-value 598, :b "הסבת בעל", :b-value 569, :lens :standard, :by :selah, :equal? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 36, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:33:01.511466407Z", :model "glm-5.2"}