{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "תסב נחלה", :translit "tisav nachalah", :gloss "an inheritance shall transfer"}], :mechanisms [{:kind :gematria, :a "תסב נחלה", :b "זו היא בהסבת הבן"}], :frame {:text "Numbers 36:7 states 'an inheritance shall not transfer (לא תסב) from one tribe to another,' in the context of the daughters of Tzelophehad. Ba'al HaTurim reads the phrase positively: the word תסב itself hints that inheritance does transfer — to the son, establishing that a son inherits his father. The Torah's laws of inheritance are elaborated in the rabbinic tradition (Bava Batra 108a).", :sources ["Numbers 36:7" "Bava Batra 108a"]}}], :arithmetic [{:kind :gematria, :a "תסב נחלה", :a-value 555, :b "זו היא בהסבת הבן", :b-value 555, :lens :standard, :by :selah, :equal? true}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 36, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:59.586307827Z", :model "glm-5.2"}