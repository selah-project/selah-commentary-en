{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "אלידד בן כסלון", :translit "elidad ben kislon", :gloss "Elidad son of Chislon"} {:he "הוא אלדד", :translit "hu eldad", :gloss "he is Eldad"} {:he "הוסיף לו יו\"ד", :translit "hosif lo yud", :gloss "a yod was added to him"} {:he "ע\"ש הנבואה", :translit "al shem ha-nevu'ah", :gloss "on account of prophecy"} {:he "שנקראת כי' לשונות", :translit "she-nikra'at kiy lashonot", :gloss "which is called seventy tongues"} {:he "חזון", :translit "chazon", :gloss "vision"} {:he "הטפה", :translit "hatafah", :gloss "exhortation"} {:he "דיבור", :translit "dibur", :gloss "speech"} {:he "אמירה", :translit "amirah", :gloss "saying"} {:he "צווי", :translit "tzivui", :gloss "command"} {:he "משא", :translit "masa", :gloss "burden"} {:he "משל", :translit "mashal", :gloss "parable"} {:he "מליצה", :translit "melitzah", :gloss "allegory"} {:he "חידה", :translit "chidah", :gloss "riddle"} {:he "נבואה", :translit "nevu'ah", :gloss "prophecy"}], :mechanisms [{:kind :other, :note "Extra yod added to the name Eldad (אלדד) yielding Elidad (אלידד), on account of prophecy called seventy tongues"}], :frame {:text "Eldad and Medad prophesied in the camp (Numbers 11:26–27). The yod inserted into the name אלדד → אלידד carries the numerical value seventy, linking to the tradition that divine prophetic spirit rests through seventy facets or tongues. The ten terms listed enumerate distinct modes of prophetic expression, paralleling the ten terms through which prophecy is transmitted, as enumerated in Midrash Shir HaShirim Rabbah 1:2 (the Song is spoken in ten expressions: chazon, hatafah, dibbur, amirah, tzivui, masa, mashal, melitzah, chidah, nevu'ah).", :sources ["Numbers 11:26" "Numbers 11:27" "Shir HaShirim Rabbah 1:2"]}}], :arithmetic [{:kind :other, :note "Extra yod added to the name Eldad (אלדד) yielding Elidad (אלידד), on account of prophecy called seventy tongues", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 34, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:53.426225335Z", :model "glm-5.2"}