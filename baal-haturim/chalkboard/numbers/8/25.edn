{:tier :glm-5.2, :verse 25, :comments [{:quotes [{:he "ומבן", :translit "u'mi'ven", :gloss "and from"} {:he "ומבן חמשים שנה ישוב מצבא העבודה", :translit "u'mi'ven chamishim shanah yashuv mi'tzava ha'avodah", :gloss "and from fifty years he shall return from the army of the service"} {:he "ומבן אדם חציר ינתן", :translit "u'mi'ven adam chatzeir yinaten", :gloss "and from a man grass is given"}], :mechanisms [{:kind :other, :note "Word ומבן appears exactly twice in Scripture, once for Levites' retirement from service (Numbers 8:25) and once for man's lifespan likened to grass."}], :frame {:text "Isaiah 40:6-7 states that all flesh is grass and grass withers; the rabbis connect advanced age to diminishing vitality, as in Shabbat 152a which describes the elderly as increasing in years but decreasing in strength. The Ba'al HaTurim observes that the identical phrase ומבן appears both at Numbers 8:25 for Levites retiring at fifty and at Isaiah 40:6 (ומבן אדם חציר ינתן), linking the two: at fifty one's strength fades like grass.", :sources ["Isaiah 40:6" "Shabbat 152a"]}}], :arithmetic [{:kind :other, :note "Word ומבן appears exactly twice in Scripture, once for Levites' retirement from service (Numbers 8:25) and once for man's lifespan likened to grass.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 8, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:27:41.103477240Z", :model "glm-5.2"}