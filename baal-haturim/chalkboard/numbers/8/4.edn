{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "וזה מעשה המנורה", :translit "v'zeh ma'aseh ha-menorah", :gloss "And this is the work of the Menorah"} {:he "וזה", :translit "v'zeh", :gloss "and this"} {:he "י\"ח", :translit "yud chet", :gloss "18"} {:he "י\"ח טפחים", :translit "yud chet tefachim", :gloss "18 handbreadths"}], :mechanisms [{:kind :gematria, :a "וזה", :b "י\"ח"}], :frame {:text "The Mishnah states that the height of the Menorah was eighteen handbreadths (Menachot 28b). Ba'al HaTurim links this physical measurement to the gematria of the word וזה at the beginning of the phrase.", :sources ["Menachot 28b"]}} {:quotes [{:he "כמראה", :translit "k'mar'eh", :gloss "like the vision / appearance"} {:he "כגבריאל", :translit "k'gavri'el", :gloss "like Gabriel"} {:he "גבריאל", :translit "gavri'el", :gloss "Gabriel"}], :mechanisms [{:kind :gematria, :a "כמראה", :b "כגבריאל"}], :frame {:text "Rashi on Numbers 8:4, citing the Tanchuma, records that Moses had difficulty understanding the construction of the Menorah until the Holy One showed him a fiery vision of it. A parallel tradition identifies Gabriel as the angel who showed Moses the form of the Menorah, as preserved in Midrash Aggadah and Yalkut Shim'oni on this verse.", :sources ["Rashi on Numbers 8:4" "Tanchuma Beha'alotkha 5" "Midrash Aggadah Numbers 8:4" "Yalkut Shim'oni Numbers 725"]}} {:quotes [{:he "כן עשה", :translit "ken asah", :gloss "so he made"} {:he "כ\"ן", :translit "ken", :gloss "so / thus"} {:he "עשה", :translit "asah", :gloss "he made"} {:he "שלמה", :translit "sh'lomo", :gloss "Solomon"} {:he "מנורה", :translit "menorah", :gloss "Menorah"} {:he "מנחות דף כ\"ח", :translit "menachot daf kaf chet", :gloss "Menachot folio 28"}], :mechanisms [{:kind :gematria, :a "עשה", :b "שלמה"} {:kind :masorah, :count 4, :occurrences ["מנורה"]} {:kind :other, :note "כן read as 'thus' = 10 menorot Solomon made, matching the ten menorot of I Kings 7:49"} {:kind :other, :note "Four menorot of Simchat Beit HaSho'eivah, per Sukkah 51a-b and 53a"}], :frame {:text "I Kings 7:49 records that Solomon made ten golden Menorot for the Temple. The Mishnah at Menachot 28b discusses that the Menorah is valid whether fashioned from various metals. The Mishnah at Sukkah 51a-b and 53a describes four enormous golden menorot illuminated during the Simchat Beit HaSho'eivah water-drawing celebration in the Temple.", :sources ["I Kings 7:49" "Menachot 28b" "Sukkah 51a" "Sukkah 53a"]}}], :arithmetic [{:kind :gematria, :a "וזה", :a-value 18, :b "י\"ח", :b-value 18, :lens :standard, :by :selah, :equal? true} {:kind :gematria, :a "כמראה", :a-value 266, :b "כגבריאל", :b-value 266, :lens :standard, :by :selah, :equal? true} {:kind :gematria, :a "עשה", :a-value 375, :b "שלמה", :b-value 375, :lens :standard, :by :selah, :equal? true} {:kind :masorah, :count 4, :occurrences ["מנורה"], :by :selah, :located [{:phrase "מנורה", :refs ["1 Chronicles 28:15"], :n 1, :lens :exact}]} {:kind :other, :note "כן read as 'thus' = 10 menorot Solomon made, matching the ten menorot of I Kings 7:49", :by :selah, :ran? false} {:kind :other, :note "Four menorot of Simchat Beit HaSho'eivah, per Sukkah 51a-b and 53a", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 8, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:27:42.904830314Z", :model "glm-5.2"}