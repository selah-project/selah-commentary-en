{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "נתנים נתנים המה", :translit "netunim netunim hemah", :gloss "Given, given they are"} {:he "שאלה לא עשו עגל של זהב", :translit "she'elah lo asu egl shel zahav", :gloss "they were given [as] a pledge, they did not make a golden calf"}], :mechanisms [{:kind :gematria, :a "נתנים נתנים המה", :b "שאלה לא עשו עגל של זהב"}], :frame {:text "The Levites are distinguished from the rest of Israel by their loyalty at the sin of the golden calf: when the people demanded 'Make us a god' (Exodus 32:1), the tribe of Levi did not participate and instead rallied to Moses (Exodus 32:26). Because they did not worship the calf, they were set apart for divine service (Numbers 8:14). Ba'al HaTurim reads the doubled language of 'given, given' (Numbers 8:16) as encoding this history through gematria, reading שאלה in the sense of 'given as a pledge.'", :sources ["Exodus 32:1" "Exodus 32:26" "Numbers 8:14" "Numbers 8:16"]}}], :arithmetic [{:kind :gematria, :a "נתנים נתנים המה", :a-value 1150, :b "שאלה לא עשו עגל של זהב", :b-value 1190, :lens :standard, :by :selah, :equal? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 8, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:27:40.237758505Z", :model "glm-5.2"}