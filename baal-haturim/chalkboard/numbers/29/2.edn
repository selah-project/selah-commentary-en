{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "ועשיתם עולה לריח ניחח לה'", :translit "va'asitem olah l'reiach nichoach la'", :gloss "and you shall make a burnt-offering, a sweet savor to YHWH"} {:he "ועשיתם עולה לריח ניחח לה'", :translit "va'asitem olah l'reiach nichoach la'", :gloss "and you shall make a burnt-offering, a sweet savor to YHWH"}], :mechanisms [{:kind :other, :note "Gezeirah shavah: the phrase ועשיתם עולה לריח ניחח לה' links Numbers 29:2 to Leviticus 23:24-25, the Rosh HaShanah passage."}], :frame {:text "Leviticus 23:24–25 prescribes the Rosh HaShanah service and uses the identical phrase ועשיתם עולה לריח ניחח לה'. The Pesikta, as cited here, teaches that on Rosh HaShanah it is as if a new creation were made (Pesikta Rabbati / Pesikta deRav Kahana, Rosh HaShanah passages).", :sources ["Leviticus 23:24-25" "Pesikta Rabbati" "Pesikta deRav Kahana"]}}], :arithmetic [{:kind :other, :note "Gezeirah shavah: the phrase ועשיתם עולה לריח ניחח לה' links Numbers 29:2 to Leviticus 23:24-25, the Rosh HaShanah passage.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:59.456087583Z", :model "glm-5.2"}