{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "ויפלו ע ל פניהם", :translit "va'yiplu 'a'l p'neihem", :gloss "and they fell before them"} {:he "כי יצא הקצף", :translit "ki yatza ha-ketzev", :gloss "for the wrath has gone forth"} {:he "ר\"ח בן דוסא", :translit "r. chanina ben dosa", :gloss "R. Chanina ben Dosa"}], :mechanisms [{:kind :other, :note "Contrast with earlier verse where Israel prays; here they do not, because prayer is not fluent in their mouths."}], :frame {:text "Rabbi Chanina ben Dosa taught: when he would pray over a sick person, if his prayer came fluently from his lips he knew the person would live; if not, he knew the person would die, as stated in Berakhot 34b. Ba'al HaTurim applies this principle to Numbers 17:11–12, where Moses tells Aaron to make atonement and Aaron stands between the dead and the living — yet the people themselves do not pray, unlike earlier occasions such as Numbers 11:2 where the people prayed. The plague is described as 'wrath' that has 'gone forth' because their lack of fluent prayer rendered them vulnerable.", :sources ["Berakhot 34b" "Numbers 11:2" "Numbers 17:11-12"]}}], :arithmetic [{:kind :other, :note "Contrast with earlier verse where Israel prays; here they do not, because prayer is not fluent in their mouths.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 17, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:36.460081617Z", :model "glm-5.2"}