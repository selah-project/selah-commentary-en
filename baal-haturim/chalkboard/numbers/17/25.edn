{:tier :glm-5.2, :verse 25, :comments [{:quotes [{:he "לבני מרי", :translit "livnei meri", :gloss "of the sons of Meri"}], :mechanisms [{:kind :other, :note "Wordplay: the name מרי (Meri) is read as the adjective מרי (rebellious), from the root מרה (to rebel)."}], :frame {:text "The word מרי can be read not only as a proper name but as the adjective 'rebellious,' from the root מרה. Deuteronomy 9:7 and 9:24 call Israel ממרים ('rebellious') using this same root. Moses, in Deuteronomy 31:27, directly charges Israel with being a 'stiff-necked' people. Ba'al HaTurim reads the phrase לבני מרי in Numbers 17:25 as itself encoding that characterization.", :sources ["Deuteronomy 9:7" "Deuteronomy 9:24" "Deuteronomy 31:27" "Numbers 17:25"]}}], :arithmetic [{:kind :other, :note "Wordplay: the name מרי (Meri) is read as the adjective מרי (rebellious), from the root מרה (to rebel).", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 17, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:42.822857124Z", :model "glm-5.2"}