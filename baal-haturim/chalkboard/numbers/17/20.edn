{:tier :glm-5.2, :verse 20, :comments [{:quotes [{:he "יִפְרָח", :translit "yifrach", :gloss "he/it shall blossom"} {:he "צַדִּיק כַּתָּמָר יִפְרָח", :translit "tzaddik katamar yifrach", :gloss "a righteous man like a palm tree shall blossom"} {:he "יִפְרַחְתָּ כַּשׁוֹשַׁנָּה", :translit "yiphrachta kashoshannah", :gloss "you shall blossom like a rose"} {:he "יִפְרַחַ בְּיָמָיו צַדִּיק", :translit "yiphrach biyamav tzaddik", :gloss "in his days a righteous man shall blossom"} {:he "מַטֵּהוּ יִפְרָח", :translit "mattehu yifrach", :gloss "his staff shall blossom"} {:he "כַּשׁוֹשַׁנָּה", :translit "kashoshannah", :gloss "like a rose"} {:he "כְּזִית הוֹדוֹ", :translit "kezayit hodo", :gloss "like an olive tree flourishing"} {:he "כַּשֶּׁמֶן הַטּוֹב עַל הָרֹאשׁ יוֹרֵד עַל הַזָּקָן זְקַן אַהֲרֹן", :translit "kashemen hatov al harosh yored al hazakan zakan aharon", :gloss "like the good oil upon the head descending upon the beard, the beard of Aaron"} {:he "עַל הַמֶּלֶךְ הַמָּשִׁיחַ", :translit "al hamelech hamashiach", :gloss "concerning King Messiah"} {:he "מַטֵּה אַהֲרֹן", :translit "matteh aharon", :gloss "the staff of Aaron"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["יִפְרָח" "צַדִּיק כַּתָּמָר יִפְרָח" "יִפְרַחְתָּ כַּשׁוֹשַׁנָּה" "יִפְרַחַ בְּיָמָיו צַדִּיק"]} {:kind :other, :note "Each of the four Masorah occurrences of yifrach is mapped to a stage in the blossoming of Aaron's staff and its messianic echo."}], :frame {:text "The blossoming of Aaron's staff vindicates him as the rightful priest (Numbers 17:23). Psalm 92:13 declares 'a righteous man like a palm tree shall blossom,' applied here to Aaron's vindication. Hosea 14:6 says 'his shoots shall blossom like a rose' and verse 7 'his beauty shall be like an olive tree,' while Psalm 133:2 describes the good oil descending upon 'the beard of Aaron,' linking the almond blossoms and the priestly anointing. Psalm 72:16 says 'in his days the righteous shall blossom,' taken in Bereshit Rabbah 98:9 as a messianic prophecy; the return of the priesthood in messianic days recalls the staff of Aaron.", :sources ["Numbers 17:23" "Psalms 92:13" "Hosea 14:6-7" "Psalms 133:2" "Psalms 72:16" "Bereshit Rabbah 98:9"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["יִפְרָח" "צַדִּיק כַּתָּמָר יִפְרָח" "יִפְרַחְתָּ כַּשׁוֹשַׁנָּה" "יִפְרַחַ בְּיָמָיו צַדִּיק"], :by :selah, :located [{:phrase "יִפְרָח", :refs [], :n 0, :lens :plene-insensitive} {:phrase "צַדִּיק כַּתָּמָר יִפְרָח", :refs [], :n 0, :lens :plene-insensitive} {:phrase "יִפְרַחְתָּ כַּשׁוֹשַׁנָּה", :refs [], :n 0, :lens :plene-insensitive} {:phrase "יִפְרַחַ בְּיָמָיו צַדִּיק", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Each of the four Masorah occurrences of yifrach is mapped to a stage in the blossoming of Aaron's staff and its messianic echo.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 17, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:48.547544818Z", :model "glm-5.2"}