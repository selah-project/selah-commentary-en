{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "העיני", :translit "ha'einei", :gloss "the eyes of"} {:he "העיני האנשים ההם", :translit "ha'einei ha'anashim hahem", :gloss "the eyes of those men"} {:he "העיני בשר לך", :translit "ha'einei bassar lach", :gloss "the eyes of flesh for you"} {:he "שדתן ואבירם הטיחו דברים כלפי מעלה", :translit "she'datan va'aviram hitichu devarim kelapei ma'alah", :gloss "that Dathan and Abiram hurled words upward"} {:he "שכינה הכ' עליהם", :translit "shechinah hak' aleihem", :gloss "the Shechinah the abbreviation upon them"} {:he "העיני האנשים ההם תנקר", :translit "ha'einei ha'anashim hahem tinakor", :gloss "the eyes of those men you will gouge out"} {:he "ארץ זבת חלב ודבש", :translit "eretz zavat chalav u'devash", :gloss "land flowing milk and honey"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["העיני האנשים ההם" "העיני בשר לך"]} {:kind :other, :note "The root נקר means to gouge out eyes (Numbers 16:14); the shared word העיני links rebellion to the gouging-out idiom."}], :frame {:text "The phrase הטיח דברים כלפי מעלה, 'hurled words upward,' is the idiom the Talmud uses for defiant speech against Heaven, applied to the generation's complaints (Eruvin 13a). The Shechinah's presence despite their rebellion echoes the motif of divine restraint in the face of challenge (Exodus 24:10; Numbers 16:3). The land flowing with milk and honey is the promise first given at the burning bush (Exodus 3:8) and repeated at the edge of Canaan (Numbers 14:8).", :sources ["Eruvin 13a" "Exodus 3:8" "Exodus 24:10" "Numbers 14:8" "Numbers 16:3"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["העיני האנשים ההם" "העיני בשר לך"], :by :selah, :located [{:phrase "העיני האנשים ההם", :refs ["Numbers 16:14"], :n 1, :lens :exact} {:phrase "העיני בשר לך", :refs ["Job 10:4"], :n 1, :lens :exact}]} {:kind :other, :note "The root נקר means to gouge out eyes (Numbers 16:14); the shared word העיני links rebellion to the gouging-out idiom.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:24.189008745Z", :model "glm-5.2"}