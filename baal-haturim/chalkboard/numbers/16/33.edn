{:tier :glm-5.2, :verse 33, :comments [{:quotes [{:he "ויאבדו", :translit "va'yovdu", :gloss "and they perished"} {:he "ויאבדו כלי מלחמה", :translit "va'yovdu k'lei milchamah", :gloss "and the weapons of war perished"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויאבדו" "ויאבדו כלי מלחמה"]}], :frame {:text "The Masorah notes that the exact form ויאבדו occurs two times in Scripture. The second occurrence is in 2 Samuel 2:27, where it describes weapons of war perishing. The Ba'al HaTurim links the two verbally: just as Korah's faction perished from the earth (Numbers 16:33), so their implements of strife are counted as perished alongside them.", :sources ["2 Samuel 2:27"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויאבדו" "ויאבדו כלי מלחמה"], :by :selah, :located [{:phrase "ויאבדו", :refs ["Numbers 16:33" "2 Samuel 1:27" "Isaiah 41:11" "Psalms 9:4" "Psalms 83:18" "Job 6:18"], :n 6, :lens :exact} {:phrase "ויאבדו כלי מלחמה", :refs ["2 Samuel 1:27"], :n 1, :lens :exact}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:30.879809774Z", :model "glm-5.2"}