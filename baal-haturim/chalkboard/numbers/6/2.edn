{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "יפלא", :translit "yifla", :gloss "he shall separate"} {:he "ב' במס' חסרים", :translit "b' v' b'mas' chaserim", :gloss "twice in the Masorah, both defective"} {:he "בערכין", :translit "b'arakhin", :gloss "in Arakhin"} {:he "נדרים מערכין", :translit "n'darim m'arakhin", :gloss "vows from valuations"} {:he "כערכך הכהן כן יהיה", :translit "k'arkh'kha ha-kohen ken yihyeh", :gloss "as your valuation, O priest, so shall it be"} {:he "הכל תלוי בחכם", :translit "hakol taluy b'khakham", :gloss "everything depends on the sage"} {:he "אם נראה לו יתיר ואם לאו לא יתיר", :translit "im nir'eh lo yatir v'im lo lo yatir", :gloss "if it seems right to him he permits, and if not he does not permit"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יפלא"]} {:kind :other, :note "Gezeirah shavah linking vows to valuations based on shared word pattern."}], :frame {:text "The word יפלא appears twice in Scripture, both written defectively (without a vav): here in Numbers 6:2 and in Leviticus 27:8 (Arakhin). The Talmud derives laws of vow-annulment from the laws of valuations through a verbal analogy: just as Leviticus 27:8 states 'as your valuation, O priest, so shall it be,' giving the priest authority over the assessment, so too a sage has authority to permit or not permit a vow.", :sources ["Leviticus 27:8" "Numbers 6:2"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["יפלא"], :by :selah, :located [{:phrase "יפלא", :refs ["Leviticus 27:2" "Numbers 6:2" "Deuteronomy 17:8" "Jeremiah 32:17" "Jeremiah 32:27" "Zechariah 8:6"], :n 6, :lens :exact}]} {:kind :other, :note "Gezeirah shavah linking vows to valuations based on shared word pattern.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 6, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:27:15.044850844Z", :model "glm-5.2"}