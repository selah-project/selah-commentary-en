{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "על נפש מת לא יבא", :translit "al nefesh met lo yavo", :gloss "upon a dead soul he shall not come"} {:he "נדר", :translit "neder", :gloss "vow"} {:he "יהיה עולה שלשים", :translit "yihyeh oloh sheloshim", :gloss "it shall be thirty"}], :mechanisms [{:kind :masorah, :count 30, :occurrences ["נדר"]} {:kind :other, :note "The 30 occurrences of nazirite-vow terminology correspond to the 30-day minimum period of standard naziriteship"}], :frame {:text "The verse forbids the nazirite from contact with the dead (Numbers 6:6–7). Ba'al HaTurim reasons that the nazirite's sanctity is such that the Shekhinah may rest upon him because of his nazirite crown; the prohibition prevents onlookers from suspecting he engages in necromancy. The minimum duration of a standard nazirite vow is thirty days; when one says 'I will be a nazirite' without specifying a period, thirty days is assumed.", :sources ["Numbers 6:6" "Numbers 6:7" "Nazir 5a"]}}], :arithmetic [{:kind :masorah, :count 30, :occurrences ["נדר"], :by :selah, :located [{:phrase "נדר", :refs ["Genesis 28:20" "Genesis 31:13" "Leviticus 7:16" "Leviticus 22:21" "Leviticus 27:2" "Numbers 6:2" "Numbers 6:5" "Numbers 15:3"], :n 23, :lens :exact}]} {:kind :other, :note "The 30 occurrences of nazirite-vow terminology correspond to the 30-day minimum period of standard naziriteship", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 6, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:27:13.943946895Z", :model "glm-5.2"}