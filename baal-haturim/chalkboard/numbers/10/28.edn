{:tier :glm-5.2, :verse 28, :comments [{:quotes [{:he "ויסעו", :translit "vayis'u", :gloss "and they journeyed"} {:he "ויסעו ויהי חתת אלהים", :translit "vayis'u vay'hi chatat elohim", :gloss "and they journeyed and the fear of Elohim was"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויסעו" "ויסעו ויהי חתת אלהים"]}], :frame {:text "Genesis 35:2–4 records that Jacob commanded his household to remove the foreign gods and purify themselves, and they gave him all their idols which he buried. Genesis 35:5 then states they journeyed and the terror of Elohim was upon the surrounding cities. The tribe of Dan is called back in Deuteronomy 33:22. The rear-guard position of the tribe of Dan and the attacks of Amalek are described in Numbers 10:25. Amalek's attack on the stragglers at the rear is recorded in Deuteronomy 25:17–18.", :sources ["Genesis 35:2–5" "Numbers 10:25" "Deuteronomy 25:17–18" "Deuteronomy 33:22"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויסעו" "ויסעו ויהי חתת אלהים"], :by :selah, :located [{:phrase "ויסעו", :refs ["Genesis 35:5" "Genesis 35:16" "Exodus 12:37" "Exodus 13:20" "Exodus 14:15" "Exodus 16:1" "Exodus 17:1" "Exodus 19:2"], :n 64, :lens :exact} {:phrase "ויסעו ויהי חתת אלהים", :refs ["Genesis 35:5"], :n 1, :lens :exact}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:08.117100064Z", :model "glm-5.2"}