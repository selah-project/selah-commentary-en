{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "ויסע דגל מחנה בני יהודה", :translit "vayisa degel machaneh b'nei yehudah", :gloss "and set forward the banner of the camp of the children of Judah"} {:he "ונסע", :translit "v'anasa", :gloss "and it set forward"} {:he "ויסע", :translit "vayisa", :gloss "and he/it set forward"}], :mechanisms [{:kind :other, :note "Orthographic contrast: ונסע (full spelling with nun) for other tribes vs. ויסע (different root/spelling) for Judah"} {:kind :notarikon, :word "מ'", :expansion ["מ'" "שנה"]}], :frame {:text "Joseph's bones were carried up from Egypt by Moses (Exodus 13:19) and transported through the wilderness wanderings. Joseph is identified with Judah's camp through the tribal order of encampment, since Ephraim and Manasseh, Joseph's sons, camped alongside Judah under the same banner. The imagery of Joseph's remains resting in the ark during the forty years in the wilderness is developed in Sotah 13a.", :sources ["Exodus 13:19" "Sotah 13a"]}}], :arithmetic [{:kind :other, :note "Orthographic contrast: ונסע (full spelling with nun) for other tribes vs. ויסע (different root/spelling) for Judah", :by :selah, :ran? false} {:kind :notarikon, :word "מ'", :expansion ["מ'" "שנה"], :initials ["מ" "ש"], :by :selah, :initials-match? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:02.947805625Z", :model "glm-5.2"}