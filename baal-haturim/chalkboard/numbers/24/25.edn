{:tier :glm-5.2, :verse 25, :comments [{:quotes [{:he "וישב למקומו", :translit "va-yashav le-mekomoh", :gloss "and he returned to his place"} {:he "הלך לדרכו", :translit "halach le-darko", :gloss "went on his way"}], :mechanisms [{:kind :other, :note "Contrast between למקומו and the more usual לדרכו formula implies Bilaam did not depart peacefully but was condemned."}], :frame {:text "The Torah normally uses the phrase הלך לדרכו when someone departs on a journey, as in Judges 19:9 and 1 Samuel 1:18. The substitution of למקומו here signals a negative outcome. Bilaam's counsel to the Midianites to entice Israel into sin at Peor is recorded in Numbers 31:16, leading to his death by the sword in Numbers 31:8.", :sources ["Numbers 31:8" "Numbers 31:16" "Judges 19:9" "1 Samuel 1:18"]}}], :arithmetic [{:kind :other, :note "Contrast between למקומו and the more usual לדרכו formula implies Bilaam did not depart peacefully but was condemned.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:23.955455257Z", :model "glm-5.2"}