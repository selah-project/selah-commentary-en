{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "ומחץ פאתי מואב וקרקר כל בני שת", :translit "u'machatz p'atei moav v'karkar kol bnei shet", :gloss "and he shall crush the temples of Moab and destroy all the children of Seth"} {:he "קרקר", :translit "karkar", :gloss "he shall crush/destroy"} {:he "דג דג", :translit "dag dag", :gloss "fish fish"} {:he "דוד", :translit "david", :gloss "David"}], :mechanisms [{:kind :other, :note "Atbash cipher: ק→ד, ר→ג, yielding דגדג from קרקר"} {:kind :gematria, :a "דג דג", :b "דוד"}], :frame {:text "Balaam's prophecy in Numbers 24:17 is understood as foretelling the Davidic Messiah. The Targum of Onkelos renders this verse with explicit messianic reference, and Rabbinic sources read 'a star out of Jacob' as pointing to David. By transforming קרקר via Atbash into דגדג and equating it by gematria to דוד, the comment identifies the destroyer of Moab in this verse as King David, who subdued Moab as recorded in 2 Samuel 8:2.", :sources ["Numbers 24:17" "Onkelos Numbers 24:17" "2 Samuel 8:2"]}}], :arithmetic [{:kind :other, :note "Atbash cipher: ק→ד, ר→ג, yielding דגדג from קרקר", :by :selah, :ran? false} {:kind :gematria, :a "דג דג", :a-value 14, :b "דוד", :b-value 14, :lens :standard, :by :selah, :equal? true}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:19.826900497Z", :model "glm-5.2"}