{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "עד מה", :translit "ad mah", :gloss "until when / how long"} {:he "עד מה ה' תאנף לנצח", :translit "ad mah Hashem ta'nof lanetzach", :gloss "how long, O Lord, will You be angry forever"} {:he "עד מה ה' תסתר לנצח", :translit "ad mah Hashem taster lanetzach", :gloss "how long, O Lord, will You hide forever"} {:he "ולא אתנו יודע עד מה", :translit "ve'lo itanu yodei'a ad mah", :gloss "and we do not know until when"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["עד מה" "עד מה ה' תאנף לנצח" "עד מה ה' תסתר לנצח" "ולא אתנו יודע עד מה"]}], :frame {:text "The phrase עד מה ה' תאנף לנצח appears in Psalms 79:5, and עד מה ה' תסתר לנצח in Psalms 13:2, where the psalmist cries out to God over the destruction and asks how long the concealment will last. The Ten Tribes of Israel were exiled by Assyria (II Kings 17:6), and when the tribes of Judah and Benjamin returned from the Babylonian exile, the Ten Tribes did not return (Ezra 1:5 lists only those from Judah and Benjamin).", :sources ["Psalms 79:5" "Psalms 13:2" "II Kings 17:6" "Ezra 1:5"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["עד מה" "עד מה ה' תאנף לנצח" "עד מה ה' תסתר לנצח" "ולא אתנו יודע עד מה"], :by :selah, :located [{:phrase "עד מה", :refs ["Numbers 24:22" "Psalms 4:3" "Psalms 74:9" "Psalms 79:5" "Psalms 89:47"], :n 5, :lens :exact} {:phrase "עד מה ה' תאנף לנצח", :refs [], :n 0, :lens :plene-insensitive} {:phrase "עד מה ה' תסתר לנצח", :refs [], :n 0, :lens :plene-insensitive} {:phrase "ולא אתנו יודע עד מה", :refs ["Psalms 74:9"], :n 1, :lens :plene-insensitive}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:25.851048880Z", :model "glm-5.2"}