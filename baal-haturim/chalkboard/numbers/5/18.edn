{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "המאררים", :translit "ha-me'ararim", :gloss "the curses"} {:he "רמ\"ח", :translit "ramach", :gloss "248"} {:he "מנחת קנאות הוא", :translit "minchat kena'ot hu", :gloss "the meal-offering of jealousy, it (masc.)"} {:he "היא", :translit "hi", :gloss "it (fem.)"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["המאררים"]} {:kind :gematria, :a "המאררים", :b "רמ\"ח"}], :frame {:text "The word המאררים has a numerical value of 248, corresponding to the 248 limbs of the human body. This links to the verse's masculine pronoun 'הוא' in the phrase 'מנחת קנאות הוא' (Numbers 5:15), which is read as feminine 'היא' (Numbers 5:18). The word קנאות can thus be read as containing both masculine and feminine forms, indicating that the jealousy and its examination apply to both the man and the woman. The number 248 is established as the count of limbs in the body by the Mishnah in Oholot 1:8.", :sources ["Numbers 5:15" "Numbers 5:18" "Oholot 1:8"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["המאררים"], :by :selah, :located [{:phrase "המאררים", :refs ["Numbers 5:18" "Numbers 5:19" "Numbers 5:22" "Numbers 5:24" "Numbers 5:27"], :n 5, :lens :exact}]} {:kind :gematria, :a "המאררים", :a-value 496, :b "רמ\"ח", :b-value 248, :lens :standard, :by :selah, :equal? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 5, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:57.378054276Z", :model "glm-5.2"}