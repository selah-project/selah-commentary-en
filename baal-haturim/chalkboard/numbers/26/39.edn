{:tier :glm-5.2, :verse 39, :comments [{:quotes [{:he "לשפופם משפחת השופמי", :translit "lishpofam mishpachat hashufami", :gloss "Of Shupham, the family of the Shuphamite"} {:he "השפופמי", :translit "hashopfomi", :gloss "the Shuphamite (expected form)"} {:he "הוא ישופך ראש", :translit "hu yeshufkha rosh", :gloss "he will strike your head"}], :mechanisms [{:kind :other, :note "The expected form השפופמי is shortened to השופמי, hinting at ישופך 'he will strike' — linking the name to a snake's bite."} {:kind :other, :note "The verse contains the letter peh (פ) in every word, signaling that Benjamin had a mouth yet remained silent."}], :frame {:text "Genesis 37—38 records that Benjamin was the only one of Jacob's sons not involved in the sale of Joseph, as he had not yet been born (Genesis 35:18, 37:3). Genesis 3:15 states הוא ישופך ראש, of the snake bruising. The Ba'al HaTurim links Benjamin's death to a snakebite through the contraction of his family name, and the letter peh in each word of Numbers 26:39 signals that Benjamin possessed a mouth yet refrained from speaking.", :sources ["Genesis 37:28" "Genesis 35:18" "Genesis 3:15" "Numbers 26:39"]}}], :arithmetic [{:kind :other, :note "The expected form השפופמי is shortened to השופמי, hinting at ישופך 'he will strike' — linking the name to a snake's bite.", :by :selah, :ran? false} {:kind :other, :note "The verse contains the letter peh (פ) in every word, signaling that Benjamin had a mouth yet remained silent.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:49.690312045Z", :model "glm-5.2"}