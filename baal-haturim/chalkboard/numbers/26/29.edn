{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "מנשה", :translit "menashe", :gloss "Menasheh"} {:he "בני יוסף עד כ\"ה ברכני ה'", :translit "b'nei yosef ad k\"h barcheni hashem", :gloss "descendants of Joseph — up to 25 — bless me, HaShem"}], :mechanisms [{:kind :sofei-tevot, :phrase "בני יוסף עד כ\"ה ברכני ה'", :spells "ברכני"}], :frame {:text "Between the first and second wilderness censuses the tribe of Menasheh grew from 32,200 to 52,700 (Numbers 26:34 compared to Numbers 1:35). A tradition cited by Rashi at Psalm 115:12 forms an acrostic from the initial letters of the phrase ברכני ה', attributing the verse to each tribe; the expansion בני יוסף עד כ\"ה ברכני ה' marks the word ברכני as corresponding to tribe number 25 in the sequential list.", :sources ["Numbers 1:35" "Numbers 26:34" "Psalm 115:12" "Rashi on Psalm 115:12"]}}], :arithmetic [{:kind :sofei-tevot, :phrase "בני יוסף עד כ\"ה ברכני ה'", :spells "ברכני", :letters ["י" "ף" "ד" "ה" "י" "ה"], :by :selah, :order :mismatch}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:43.059449097Z", :model "glm-5.2"}