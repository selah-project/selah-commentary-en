{:tier :glm-5.2, :verse 13, :comments [{:quotes [{:he "מאן", :translit "ma'an", :gloss "what/that"} {:he "מאן ה' לתתי", :translit "ma'an Hashem latet", :gloss "what the LORD has given me"} {:he "מאן בלעם", :translit "ma'an Bil'am", :gloss "what Balaam"} {:he "אשר מאן לתת לך בכסף", :translit "asher ma'an latet lecha bakesef", :gloss "whatever is to be given to you in money"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["מאן ה' לתתי" "מאן בלעם" "אשר מאן לתת לך בכסף"]}], :frame {:text "The Masorah counts three instances of the word מאן in Scripture where it carries the sense of 'what/that which is given.' Ba'al HaTurim reads Balaam's repeated use of the word as revealing his mercenary intent: by emphasizing 'whatever is to be given to you in money' (Numbers 22:17–18), Balaam sought to negotiate greater compensation. This aligns with the characterization of Balaam in rabbinic tradition as greedy for reward, contrasted with the righteous who serve without thought of gain, as articulated in Avot 5:22 ('the disciples of Balaam inherit Gehenna').", :sources ["Numbers 22:17" "Numbers 22:18" "Avot 5:22"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["מאן ה' לתתי" "מאן בלעם" "אשר מאן לתת לך בכסף"], :by :selah, :located [{:phrase "מאן ה' לתתי", :refs [], :n 0, :lens :plene-insensitive} {:phrase "מאן בלעם", :refs ["Numbers 22:14"], :n 1, :lens :exact} {:phrase "אשר מאן לתת לך בכסף", :refs ["1 Kings 21:15"], :n 1, :lens :exact}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:44.774419008Z", :model "glm-5.2"}