{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "ילחכו", :translit "yelachekhu", :gloss "they will lick"} {:he "ילחכו הקהל", :translit "yelachekhu haqahal", :gloss "[they will lick] the assembly"} {:he "ילחכו עפר כנחש", :translit "yelachekhu afar kannachash", :gloss "[they will lick] dust like the serpent"} {:he "רעה עמך בשבטך", :translit "reh eh amekha b'shivtekha", :gloss "shepherd your people with your staff"} {:he "כאשר שמע למצרים יחילו כשמע צור", :translit "ka'asher shama lemitzrayim yachelu kishmo'a tzur", :gloss "as when it was heard concerning Egypt they trembled, when they heard Tzur"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ילחכו הקהל" "ילחכו עפר כנחש"]}], :frame {:text "The phrase ילחכו עפר כנחש appears in Micah 7:17 (רעה עמך בשבטך תרעם... ילחכו עפר כנחש), a passage cast as a prayer for redemption. Ba'al HaTurim links the fear Moab felt (Numbers 22:4) to the fear Egypt inspired among the nations after the Exodus, as described in Exodus 15:14–16 (שמעו עמים ירגזון... כאשר עברת), reading both as prototypes for the future redemption when nations will again tremble before Israel.", :sources ["Micah 7:14–17" "Exodus 15:14–16" "Numbers 22:4"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ילחכו הקהל" "ילחכו עפר כנחש"], :by :selah, :located [{:phrase "ילחכו הקהל", :refs ["Numbers 22:4"], :n 1, :lens :exact} {:phrase "ילחכו עפר כנחש", :refs ["Micah 7:17"], :n 1, :lens :exact}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:40.915286662Z", :model "glm-5.2"}