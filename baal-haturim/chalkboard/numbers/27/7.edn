{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "דברת", :translit "dibarta", :gloss "you spoke"} {:he "ואני אשימם דוברות בים", :translit "va'ani asimem dovrot bayam", :gloss "and I will set them sailing ships [on] the sea"} {:he "דוברות שהיו מלאות רוח אלהים וחכמות כים שהוא מלא", :translit "dovrot shehayu mele'ot ruach elohim ve'chokhmot kayam shehu malei", :gloss "sailing ships [i.e., dovrot] that they were full of the spirit of Elohim and wisdom like the sea, which is full"} {:he "חכמניות היו דרשניות היו", :translit "chachmaniyot hayu darshaniyot hayu", :gloss "wise women they were, exegetes they were"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["דברת" "דברות"]} {:kind :other, :note "Reinterprets דוברות (ships) in 1 Kings 9:27 as דברות (speaking women) linked to דברת (you spoke) via the Masorah pair."}], :frame {:text "The root ד-ב-ר yields two Masorah-paired forms: דברת in Numbers 27:7 and דוברות in 1 Kings 9:27. The plain sense of דוברות in 1 Kings 9:27 is 'ships' (cf. 1 Kings 9:26–27, where Solomon builds a fleet at Ezion-Geber). The derash reads דוברות instead as connected to דיבור (speech), yielding 'speaking women.' This produces the reading that the women referenced were endowed with ruach elohim and wisdom, described as חכמניות היו דרשניות היו.", :sources ["1 Kings 9:27" "1 Kings 9:26"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["דברת" "דברות"], :by :selah, :located [{:phrase "דברת", :refs ["Genesis 18:5" "Genesis 19:21" "Genesis 27:19" "Exodus 10:29" "Exodus 33:17" "Numbers 14:17" "Numbers 27:7" "Deuteronomy 1:14"], :n 45, :lens :exact} {:phrase "דברות", :refs ["1 Kings 5:23"], :n 1, :lens :exact}]} {:kind :other, :note "Reinterprets דוברות (ships) in 1 Kings 9:27 as דברות (speaking women) linked to דברת (you spoke) via the Masorah pair.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:53.961020165Z", :model "glm-5.2"}