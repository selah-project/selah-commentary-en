{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "יפקד ה' אלהי הרוחות לכל בשר איש על העדה", :translit "yifkod Hashem Elokei haruchot lechol basar ish al ha'edah", :gloss "May YHWH, Elohim of the spirits of all flesh, appoint a man over the congregation"}], :mechanisms [{:kind :other, :note "No derash mechanism invoked; the verse itself is presented for explication in subsequent comments."}], :frame {:text "Moses, told he will not enter the land (Numbers 27:12–14), asks God to appoint a successor so Israel not be 'as sheep without a shepherd' (Numbers 27:17). The title 'Elohim of the spirits of all flesh' acknowledges that God, who knows the distinct spirit of every person, can choose a leader suited to each (Targum Yonatan ben Uziel on Numbers 27:16).", :sources ["Numbers 27:12-14" "Numbers 27:17" "Targum Yonatan ben Uziel on Numbers 27:16"]}}], :arithmetic [{:kind :other, :note "No derash mechanism invoked; the verse itself is presented for explication in subsequent comments.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:50.478686399Z", :model "glm-5.2"}