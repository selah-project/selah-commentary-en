{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "נחלתו לשארו", :translit "nachalato lis'ero", :gloss "his inheritance to his kinsman"} {:he "נחלת שארו לו", :translit "nachalat is'ero lo", :gloss "inheritance of his kinsman to him"} {:he "נחלתו", :translit "nachalato", :gloss "his inheritance"} {:he "שארו", :translit "s'ero", :gloss "his kinsman"} {:he "לשארו", :translit "lis'ero", :gloss "to his kinsman"} {:he "לו", :translit "lo", :gloss "to him"} {:he "גורעין ומוסיפין ודורשין", :translit "gor'in umosifin v'dorashin", :gloss "they subtract and add and expound"}], :mechanisms [{:kind :other, :note "Otiyot rearrangement: remove ו from נחלתו and attach it to ל of לשארו, yielding לו and thus נחלת שארו לו"}], :frame {:text "The hermeneutical method of gor'in umosifin v'dorashin — subtracting, adding, and expounding letters — is described in Shabbat 63a and 116a as a rabbinic interpretive technique. The principle that שארו denotes a wife derives from the usage in Genesis 2:23. The halakhah that a husband inherits his wife is established in the Mishnah at Kesuvot 77b.", :sources ["Shabbat 63a" "Shabbat 116a" "Genesis 2:23" "Kesuvot 77b"]}}], :arithmetic [{:kind :other, :note "Otiyot rearrangement: remove ו from נחלתו and attach it to ל of לשארו, yielding לו and thus נחלת שארו לו", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:52.819412292Z", :model "glm-5.2"}