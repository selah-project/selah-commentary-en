{:tier :glm-5.2, :verse 1, :comments [{:quotes [{:he "שבעה פרים ושבעה אילים", :translit "shiv'ah parim v'shiv'ah eilim", :gloss "seven bulls and seven rams"}], :mechanisms [{:kind :other, :note "Pattern of seven-plus-seven offerings parallels Job's sacrifices and Noahide practice"}], :frame {:text "Job offered seven burnt offerings and seven rams (Job 42:8). The children of Noah are bound by seven commandments (Sanhedrin 56a). Balaam's instruction to Balak to offer seven bulls and seven rams (Numbers 23:1, 23:14, 23:29) is thus understood as following a universal Noahide custom of bringing offerings in sevens corresponding to the seven Noahide commandments.", :sources ["Job 42:8" "Sanhedrin 56a" "Numbers 23:1"]}}], :arithmetic [{:kind :other, :note "Pattern of seven-plus-seven offerings parallels Job's sacrifices and Noahide practice", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:50.532273626Z", :model "glm-5.2"}