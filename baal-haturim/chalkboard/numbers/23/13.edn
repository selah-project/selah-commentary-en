{:tier :glm-5.2, :verse 13, :comments [{:quotes [{:he "וכלו", :translit "v'chalo", :gloss "and its end / and all of it"} {:he "וכלו מחמדים", :translit "v'chalo machamadim", :gloss "and all of it is desirable"} {:he "וכלו לא תראה", :translit "v'chalo lo tir'eh", :gloss "and its end you shall not see"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וכלו" "וכלו מחמדים"]} {:kind :other, :note "Wordplay pivoting on the dual sense of וכלו as 'and its end' and 'you shall not see' (לא תראה)."}], :frame {:text "The phrase וכלו מחמדים ('and all of it is desirable') is applied to God Himself in Song of Songs 5:16 and its rabbinic reading. Ba'al HaTurim cites Niddah 64b, where the verse 'the wholeness of the upright shall guide them' (Proverbs 11:3, with תמים rendered as 'complete/whole') is taken as a warning: one who is himself blemished is punished by being barred from beholding holiness. The pun וכלו = לא תראה fuses the rare Masorah form with that blinding so that Balaam's physical loss of sight answers his verbal misuse of 'wholesome' language.", :sources ["Niddah 64b" "Song of Songs 5:16" "Proverbs 11:3"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וכלו" "וכלו מחמדים"], :by :selah, :located [{:phrase "וכלו", :refs ["Numbers 23:13" "Song of Songs 5:16"], :n 2, :lens :exact} {:phrase "וכלו מחמדים", :refs ["Song of Songs 5:16"], :n 1, :lens :exact}]} {:kind :other, :note "Wordplay pivoting on the dual sense of וכלו as 'and its end' and 'you shall not see' (לא תראה).", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:31:06.653960265Z", :model "glm-5.2"}