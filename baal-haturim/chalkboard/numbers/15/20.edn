{:tier :glm-5.2, :verse 20, :comments [{:quotes [{:he "חלה", :translit "challah", :gloss "dough-portion"}], :mechanisms [{:kind :other, :note "Tagin (crownlets) on the letter heh of חלה signal the number five"}], :frame {:text "The obligation of challah applies to five species of produce: wheat, barley, spelt, rye, and oats, as derived from the repetition of the term עריסות in Numbers 15:20–21 (see Mishnah Challah 1:1). The minimum volume of flour that obligates the separation of challah is five quarter-kav, a measure taught in the Mishnah (Eduyot 1:2; Challah 2:6).", :sources ["Numbers 15:20" "Mishnah Challah 1:1" "Mishnah Eduyot 1:2" "Mishnah Challah 2:6"]}}], :arithmetic [{:kind :other, :note "Tagin (crownlets) on the letter heh of חלה signal the number five", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:07.253274442Z", :model "glm-5.2"}