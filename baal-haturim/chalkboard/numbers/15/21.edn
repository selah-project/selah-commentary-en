{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "מראשית עריסותיכם", :translit "me-reishit arisoteichem", :gloss "from the first of your doughs"}], :mechanisms [{:kind :other, :note "Parashah (section of the dough-offering passage) begins and ends with the letter mem."} {:kind :gematria, :a "עין יפה", :b "ממ"}], :frame {:text "The phrase 'me-reishit arisoteichem' in Numbers 15:20 begins with the letter mem. The Ba'al HaTurim reads the doubled mem as alluding to the phrase 'ayin tovah' (a good eye), which is a idiom for generosity found in Avot 5:13, where one who says 'what is mine is yours and what is yours is yours' is called a disciple of Abraham and described as possessing an 'ayin tovah.' The numeric equivalence of ממ and עין יפה links the letter-play to the concept.", :sources ["Numbers 15:20" "Mishnah Avot 5:13"]}}], :arithmetic [{:kind :other, :note "Parashah (section of the dough-offering passage) begins and ends with the letter mem.", :by :selah, :ran? false} {:kind :gematria, :a "עין יפה", :a-value 225, :b "ממ", :b-value 80, :lens :standard, :by :selah, :equal? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:15.434509364Z", :model "glm-5.2"}