{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "חושים", :translit "chushim", :gloss "haste / reed-shoots"} {:he "ובני דן חושים", :translit "uvnei dan chushim", :gloss "and the sons of Dan: Chushim"} {:he "חושים של קנה", :translit "chushim shel kaneh", :gloss "shoots of a reed"} {:he "נחלץ כמו חושים של קנה", :translit "nechaltz kemo chushim shel kaneh", :gloss "we shall array ourselves like shoots of a reed"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["חושים" "ובני דן חושים"]} {:kind :other, :note "Metaphor: reed shoots from one root separate above yet cling at base — model for battle formation"}], :frame {:text "The term חושים appears for the clan of Dan in Genesis 46:23 (ובני דן חושים) and again in Numbers 32:17 where the tribes of Gad and Reuben say נחלץ וכן כמו חושים, a phrase read in light of the botanical sense of חושים as reed-shoots. The phrase כי כן דרך הנלחמים להתקרב reflects the military tactic described in Judges 7:21 where each man stood in place surrounding the camp, and in Numbers 2 the tribes are arranged in tight formation around the Tabernacle. Ba'al HaTurim draws on the root imagery of clustered reed shoots to explain why warriors must close ranks.", :sources ["Genesis 46:23" "Numbers 32:17" "Judges 7:21"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["חושים" "ובני דן חושים"], :by :selah, :located [{:phrase "חושים", :refs ["1 Chronicles 8:8"], :n 1, :lens :exact} {:phrase "ובני דן חושים", :refs ["Genesis 46:23"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Metaphor: reed shoots from one root separate above yet cling at base — model for battle formation", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:26.213383220Z", :model "glm-5.2"}