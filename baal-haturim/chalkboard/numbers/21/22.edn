{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "אעברה בארצך", :translit "e'evrah b'artzecha", :gloss "I will pass through your land"} {:he "נא", :translit "na", :gloss "pray / please"}], :mechanisms [{:kind :other, :note "Contrastive reading: the word נא present in the message to Edom is absent here, signaling less diplomatic effort toward Sichon."}], :frame {:text "Numbers 20:17 records Israel's request to Edom beginning 'נא נעברה בארצך' (pray let us pass through your land), whereas Numbers 21:22 to Sichon reads simply 'אעברה בארצך' (let me pass through your land), omitting נא. Edom's response is recorded in Numbers 20:18-21, while Sichon's immediate mobilization for war appears in Numbers 21:23. Deuteronomy 2:26-30 retrospectively describes the overtures to Sichon as words of peace. The Ba'al HaTurim infers the difference in diplomatic tone from the textual omission.", :sources ["Numbers 20:17" "Numbers 20:18" "Numbers 21:22" "Numbers 21:23" "Deuteronomy 2:26"]}}], :arithmetic [{:kind :other, :note "Contrastive reading: the word נא present in the message to Edom is absent here, signaling less diplomatic effort toward Sichon.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:29.791769255Z", :model "glm-5.2"}