{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "את והב בסופה", :translit "et vahev b'sufah", :gloss "the Vahev at the Suphah"} {:he "יהב", :translit "yahav", :gloss "he gave"} {:he "הוה גביר", :translit "havah gavir", :gloss "he was a lord"} {:he "היה גביר", :translit "hayah gavir", :gloss "he was a lord"} {:he "בסופה", :translit "b'sufah", :gloss "in the storm"} {:he "כעבור סופה", :translit "ka'avor sufah", :gloss "like the passing of a storm"} {:he "במלחמות ה'", :translit "b'milchamot hashem", :gloss "in the wars of the LORD"} {:he "רק הבהמה ושלל הערים בזזנו לנו", :translit "rak habehemah ushalal he'arim bazaznu lanu", :gloss "only the livestock and the spoil of the cities we took as plunder for ourselves"}], :mechanisms [{:kind :other, :note "Aramaic form יהב reads like Hebrew יהב (to give); הוה glosses as היה"}], :frame {:text "The verse Numbers 31:53 records that after the war against Midian the Israelites took the livestock and spoil as plunder. Ba'al HaTurim links this wealth to what Israel acquired from Sihon's wars, reading 'the wars of the LORD' in Numbers 21:14 as the source of abundant spoils. Nahum 1:3 uses the phrase 'the storm (סופה) is driven' to describe swift divine action.", :sources ["Numbers 31:53" "Nahum 1:3"]}} {:quotes [{:he "בסופה", :translit "b'sufah", :gloss "in the Suphah"} {:he "ואת והב בסופה", :translit "v'et vahev b'sufah", :gloss "and the Vahev at the Suphah"} {:he "ובשערה דרכו", :translit "uvish'arah darcho", :gloss "and at her settlement his road"} {:he "בסופה כשיזכירו נסים של ים סוף", :translit "b'sufah k'sheyazkiru nisim shel yam suf", :gloss "b'sufah when they recall the miracles of the Sea of Reeds"} {:he "ה' בסופה וגו'", :translit "hashem b'sufah v'gomer", :gloss "the LORD in the storm etc."} {:he "גוער בים סוף ויבשהו", :translit "go'ar b'yam suf v'yavshahu", :gloss "rebukes the Sea of Reeds and dries it"} {:he "ים סוף", :translit "yam suf", :gloss "Sea of Reeds"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ואת והב בסופה" "ובשערה דרכו"]} {:kind :other, :note "Onkelos reads בסופה as a reference to the miracles of ים סוף"}], :frame {:text "Onkelos on Numbers 21:14 translates בסופה with reference to the miracles of the Sea of Reeds. Psalms 77:19 reads 'Your way was in the sea (בים) and Your path in the mighty waters,' and the continuation of that psalm describes the deep waters (Psalms 77:17–20) in language understood as the Reed Sea splitting. Ba'al HaTurim connects the מסורה of two בסופה occurrences to this reading.", :sources ["Psalms 77:17–20"]}}], :arithmetic [{:kind :other, :note "Aramaic form יהב reads like Hebrew יהב (to give); הוה glosses as היה", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["ואת והב בסופה" "ובשערה דרכו"], :by :selah, :located [{:phrase "ואת והב בסופה", :refs ["Numbers 21:14"], :n 1, :lens :plene-insensitive} {:phrase "ובשערה דרכו", :refs ["Nahum 1:3"], :n 1, :lens :exact}]} {:kind :other, :note "Onkelos reads בסופה as a reference to the miracles of ים סוף", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:30:36.782837361Z", :model "glm-5.2"}