{:tier :glm-5.2, :verse 32, :comments [{:quotes [{:he "ופגריכם אתם", :translit "u'f'garchem atem", :gloss "and your carcasses, you"}], :mechanisms [{:kind :other, :note "Interprets the added word 'atem' as emphasis that they die in full bodily health, as they are now."}], :frame {:text "The phrase 'uf'garchem atem' in Numbers 14:32 decrees that the generation of the wilderness shall fall in the desert. Ba'al HaTurim reads the apparently redundant word 'atem' ('you') as stressing that they die whole-bodied — as healthy as they stand now — so that their bodies are called 'peger' not because of wasting illness but because life departs from intact forms.", :sources ["Numbers 14:32"]}}], :arithmetic [{:kind :other, :note "Interprets the added word 'atem' as emphasis that they die in full bodily health, as they are now.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:01.306477291Z", :model "glm-5.2"}