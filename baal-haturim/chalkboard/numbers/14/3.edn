{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "לנפול", :translit "lanpol", :gloss "to fall"} {:he "לנפול בחרב", :translit "lanpol ba-cherev", :gloss "to fall by the sword"} {:he "דחה דחיתני", :translit "dachah dachitani", :gloss "pushing You have pushed me"} {:he "לנפול אשר החילות", :translit "lanpol asher hechilota", :gloss "to fall which You began"} {:he "לנפול לפניו", :translit "lanpol lefanav", :gloss "to fall before Him"} {:he "גם בבל לנפול חללי ישראל", :translit "gam bavel lanpol chalelei yisra'el", :gloss "also Babylon to fall slain of Israel"} {:he "שבעון זאת הנפילה", :translit "she'avon zot ha-nefilah", :gloss "because of the sin of this falling"} {:he "דחוני", :translit "dachoni", :gloss "they pushed me"} {:he "שגרמו לי עתה נפילה", :translit "she-garmu li atah nefilah", :gloss "that they caused me now a fall"} {:he "ופגריכם אתם יפלו במדבר", :translit "u-vegarchem atem yiplu bamidbar", :gloss "and your carcasses you shall fall in the wilderness"} {:he "ודחיתני לנפול לדורות", :translit "u-dchitani lanpol le-dorot", :gloss "and You pushed me to fall for generations"} {:he "שגרמו שחרב הבית", :translit "she-garmu she-charav ha-bayit", :gloss "that they caused that the Temple was destroyed"} {:he "ונפלו ביד בבל", :translit "ve-nafalu be-yad bavel", :gloss "and they fell by the hand of Babylon"} {:he "והיינו גם בבל לנפול חללי ישראל", :translit "ve-hayinu gam bavel lanpol chalelei yisra'el", :gloss "and that is the same as 'also Babylon to fall slain of Israel'"} {:he "בימי המן", :translit "bi-yemei haman", :gloss "in the days of Haman"} {:he "שכתבו שטנה על בוני הבית", :translit "she-khatvu sitnah al bonei ha-bayit", :gloss "that they wrote a slander against the builders of the Temple"} {:he "ולא הניחו לבנותו", :translit "ve-lo henichu livnoto", :gloss "and they did not allow them to build it"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["לנפול בחרב" "דחה דחיתני" "לנפול אשר החילות" "לנפול לפניו"]}], :frame {:text "The phrase 'your carcasses, you shall fall in this wilderness' (Numbers 14:29) decrees that the wilderness generation dies over forty years. The word 'falling' resonates with Psalm 118:13 ('pushing you have pushed me to fall') read as Israel's voice. Haman's accusation against the Jews in Esther 3:8 is identified in rabbinic tradition as a 'satan' (slander), and the Jewish enemies' letter against the Temple builders in Ezra 4 is read in rabbinic tradition (e.g., Megillat Antiochus / midrashic treatments) as continuous with Haman-type opposition.", :sources ["Numbers 14:29" "Psalms 118:13" "Ezra 4" "Esther 3:8"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["לנפול בחרב" "דחה דחיתני" "לנפול אשר החילות" "לנפול לפניו"], :by :selah, :located [{:phrase "לנפול בחרב", :refs ["Numbers 14:3"], :n 1, :lens :plene-insensitive} {:phrase "דחה דחיתני", :refs ["Psalms 118:13"], :n 1, :lens :exact} {:phrase "לנפול אשר החילות", :refs [], :n 0, :lens :plene-insensitive} {:phrase "לנפול לפניו", :refs ["Esther 6:13"], :n 1, :lens :plene-insensitive}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:01.139395395Z", :model "glm-5.2"}