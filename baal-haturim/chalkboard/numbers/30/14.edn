{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "לענת", :translit "la'anot", :gloss "to afflict"} {:he "לענות נפש", :translit "la'anot nefesh", :gloss "to afflict the soul"} {:he "לענות", :translit "la'anot", :gloss "to afflict"} {:he "כלי שיר", :translit "klei shir", :gloss "musical instruments"} {:he "נדרי ענוי נפש", :translit "nidrei inui nefesh", :gloss "vows of afflicting the soul"} {:he "בת שתין כבת שית לקל טבלא ריהטא", :translit "bat shetin ke-vat shet la-kal tavla reihta", :gloss "a sixty-year-old like a six-year-old from a light, clear-sounding table"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לענות נפש" "לענות"]}], :frame {:text "The husband's annulment of a wife's vow applies to vows of ענוי נפש per Numbers 30:14. The phrase לענות נפש is read alongside לענות at Leviticus 16:29 ('you shall afflict your souls'), linking the concept. Mo'ed Katan 9a records that elderly women still derive pleasure from musical instruments, illustrating that abstaining from music is a genuine ענוי נפש.", :sources ["Numbers 30:14" "Leviticus 16:29" "Mo'ed Katan 9a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לענות נפש" "לענות"], :by :selah, :located [{:phrase "לענות נפש", :refs ["Numbers 30:14"], :n 1, :lens :plene-insensitive} {:phrase "לענות", :refs ["Genesis 45:3" "Deuteronomy 19:16" "1 Samuel 9:8" "Psalms 88:1" "Proverbs 15:28" "Ecclesiastes 1:13" "Ecclesiastes 3:10"], :n 7, :lens :exact}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 30, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:04.999610794Z", :model "glm-5.2"}