{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "בנעריה", :translit "b'na'areha", :gloss "in her youth"} {:he "נערה", :translit "na'arah", :gloss "young woman"} {:he "נדריה נבדקין", :translit "nidreha nivdakin", :gloss "her vows are examined"}], :mechanisms [{:kind :gematria, :a "נערה", :b "י\"ב"}], :frame {:text "A girl who is eleven years and one day old is at the stage where her vows are examined: if she understands that her vow is made before God, her vow stands; if not, it is annulled. At twelve years and one day she is subject to vows without examination. These halakhot appear in the Mishnah at Niddah 5:6–7 and are elaborated in the Talmud at Niddah 45a.", :sources ["Niddah 5:6" "Niddah 5:7" "Niddah 45a"]}}], :arithmetic [{:kind :gematria, :a "נערה", :a-value 325, :b "י\"ב", :b-value 12, :lens :standard, :by :selah, :equal? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 30, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:04.856105010Z", :model "glm-5.2"}