{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "בסכות", :translit "b'sukkot", :gloss "in Sukkot"} {:he "ששם נסתככו בענני כבוד", :translit "she'sham nistachchu b'annanei kavod", :gloss "for there they were sheltered by clouds of glory"}], :mechanisms [{:kind :other, :note "Place-name Sukkot read as related to the sheltering (sukkah) provided by clouds of glory"}], :frame {:text "The clouds of glory protected Israel throughout their wilderness journeys. The Targum renders Numbers 33:5's departure from Sukkot as their being sheltered under the clouds of glory. Midrashic sources derive the festival of Sukkot from these clouds, identifying them as the 'sukkot' in which God settled Israel.", :sources ["Targum Yonatan Numbers 33:5" "Targum Onkelos Exodus 13:20" "Pesikta Zutarta Numbers 33:5" "Vayikra Rabbah 30:3"]}}], :arithmetic [{:kind :other, :note "Place-name Sukkot read as related to the sheltering (sukkah) provided by clouds of glory", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:31.501259566Z", :model "glm-5.2"}