{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "מדבר סין", :translit "midbar sin", :gloss "wilderness of Sin"} {:he "מדבר סין", :translit "midbar sin", :gloss "wilderness of Sin"} {:he "סיני", :translit "sinai", :gloss "Sinai"} {:he "יו\"ד", :translit "yud", :gloss "Yud (letter)"} {:he "יו\"ד דברות", :translit "yud dibrot", :gloss "Yud of the Decalogue"} {:he "סי\"ן", :translit "sin", :gloss "Sin (= Samekh-Yud-Nun)"}], :mechanisms [{:kind :other, :note "The letter yud added to 'סין' to form 'סיני' corresponds to the yud in 'Anokhi' opening the Ten Commandments"} {:kind :gematria, :a "סי\"ן", :b "days Moses was on the mountain"}], :frame {:text "The name change from סין to סיני is linked to the giving of the Torah at Sinai. The gematria of סין (= 120) corresponds to the days Moses spent on Mount Sinai: forty days for the first tablets (Exodus 24:18), forty days for the second tablets after the golden calf (Exodus 34:28), and forty days from the first of Elul to Yom Kippur, established as the day of the second tablets (Ta'anit 30b).", :sources ["Exodus 24:18" "Exodus 34:28" "Ta'anit 30b"]}}], :arithmetic [{:kind :other, :note "The letter yud added to 'סין' to form 'סיני' corresponds to the yud in 'Anokhi' opening the Ten Commandments", :by :selah, :ran? false} {:kind :gematria, :a "סי\"ן", :a-value 120, :b "days Moses was on the mountain", :b-value 0, :lens :standard, :by :selah, :equal? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:39.626563299Z", :model "glm-5.2"}