{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "ומצרים", :translit "u'mitzrayim", :gloss "and the Egyptians"} {:he "ומצרים מקברים", :translit "u'mitzrayim mekabrim", :gloss "and the Egyptians bury"} {:he "ומצרים ילד את לודים", :translit "u'mitzrayim yalad et ludim", :gloss "and the Egyptians bore Ludim"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ומצרים מקברים" "ומצרים ילד את לודים"]}], :frame {:text "The word ומצרים appears at the beginning of a parashah exactly twice: once at Numbers 33:4 ('ומצרים מקברים') and once at Genesis 10:6 ('ומצרים ילד את לודים'). Ba'al HaTurim links these two occurrences: since our verse speaks of Egyptians burying their firstborn, theMasoretic counterpart at Genesis 10:6 implies that even the long-dead Egyptians — those born generations earlier — were dug up during the plague of the firstborn.", :sources ["Numbers 33:4" "Genesis 10:6"]}} {:quotes [{:he "מקברים", :translit "mekabrim", :gloss "burying"} {:he "ומצרים מקכרים מקברים", :translit "u'mitzrayim mekachrim mekabrim", :gloss "and the Egyptians — burying"} {:he "מקברים את העוברים", :translit "mekabrim et ha'ovrim", :gloss "burying those who pass through"} {:he "בפ' גוג", :translit "b'parashat gog", :gloss "in the parashah of Gog"} {:he "כאשר שמע למצרים יחילו", :translit "ka'asher yishma la'mitzrayim yachilu", :gloss "as when one hears of Egypt, they tremble"} {:he "כשמע צוד", :translit "k'shma tzud", :gloss "like the hearing of Tzor"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["מקברים" "ומצרים מקכרים מקברים"]} {:kind :other, :note "Phrase כאשר שמע למצרים יחילו read as כשמע צוד, alluding to Ezekiel's prophecy about Gog"}], :frame {:text "Ezekiel 32 describes Egypt's future punishment in language echoing their burial of firstborn: the Egyptians are said to bury those slain by the sword among the nations, a passage placed in the prophetic section concerning Gog (Ezekiel 32:22–26, within the parashah read as Gog). Ezekiel 32:10 states 'כאשר שמע למצרים יחילו' — the nations tremble when they hear of Egypt's downfall — which Ba'al HaTurim reads as 'כשמע צוד', connecting the report of Egypt's destruction to Ezekiel's broader prophecy.", :sources ["Ezekiel 32:22" "Ezekiel 32:10"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ומצרים מקברים" "ומצרים ילד את לודים"], :by :selah, :located [{:phrase "ומצרים מקברים", :refs ["Numbers 33:4"], :n 1, :lens :exact} {:phrase "ומצרים ילד את לודים", :refs ["Genesis 10:13"], :n 1, :lens :exact}]} {:kind :masorah, :count 2, :occurrences ["מקברים" "ומצרים מקכרים מקברים"], :by :selah, :located [{:phrase "מקברים", :refs ["Numbers 33:4" "Ezekiel 39:14"], :n 2, :lens :exact} {:phrase "ומצרים מקכרים מקברים", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Phrase כאשר שמע למצרים יחילו read as כשמע צוד, alluding to Ezekiel's prophecy about Gog", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:32:39.297447039Z", :model "glm-5.2"}