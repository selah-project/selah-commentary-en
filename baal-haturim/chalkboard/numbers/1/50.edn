{:tier :glm-5.2, :verse 50, :comments [{:quotes [{:he "הפקד", :translit "hafked", :gloss "appoint"} {:he "הפקד עליו רשע", :translit "hafked alav rasha", :gloss "appoint a wicked man over him"} {:he "אין אדם נעשה שוטר מלמטה אלא אם כן נעשה רשע מלמעלה", :translit "ein adam na'aseh shoter milmatah ela im ken na'aseh rasha milma'lah", :gloss "a man is not made an officer below unless he has been made a wicked man above"} {:he "הפקד את הלוים", :translit "hafked et ha-leviyyim", :gloss "appoint the Levites"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הפקד" "הפקד עליו רשע"]} {:kind :other, :note "Gezarah shavah linking two forms of הפקד via shared rare verbal form"}], :frame {:text "The phrase הפקד עליו רשע appears in Job 34:18, where Elihu describes God's power to appoint the wicked as instruments of governance. The Rabbinic dictum that a man is not appointed as an officer below unless he has been designated a wicked man above appears in Shabbat 139a and Yalkut Shimoni on Numbers 1:50, explaining that administrative appointments on earth are decreed in heaven through the designation הפקד עליו רשע.", :sources ["Job 34:18" "Shabbat 139a" "Yalkut Shimoni Numbers §684"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["הפקד" "הפקד עליו רשע"], :by :selah, :located [{:phrase "הפקד", :refs ["Leviticus 5:23" "Numbers 1:50" "1 Kings 20:39" "Jeremiah 6:6" "Psalms 109:6"], :n 5, :lens :exact} {:phrase "הפקד עליו רשע", :refs ["Psalms 109:6"], :n 1, :lens :exact}]} {:kind :other, :note "Gezarah shavah linking two forms of הפקד via shared rare verbal form", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:50.481981565Z", :model "glm-5.2"}