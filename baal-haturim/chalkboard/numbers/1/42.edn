{:tier :glm-5.2, :verse 42, :comments [{:quotes [{:he "בני נפתלי", :translit "bnei naftali", :gloss "descendants of Naphtali"} {:he "לבני", :translit "livnei", :gloss "to the descendants of"} {:he "בני", :translit "bnei", :gloss "descendants of"} {:he "אשה אילה שלוחה הנותן", :translit "ayalah shlucha hanoten", :gloss "a sent-forth doe giving"} {:he "אשה", :translit "ayalah", :gloss "doe"} {:he "לבני", :translit "livnei", :gloss "to the descendants of"} {:he "בני", :translit "bnei", :gloss "descendants of"}], :mechanisms [{:kind :rashei-tevot, :phrase "אשה אילה שלוחה הנותן", :spells "אשה"}], :frame {:text "The blessing of Naphtali by Jacob reads נפתלי אילה שלחה אוטרנה שפיק (Genesis 49:21); Moses' blessing reads ולנפתלי אמר יי רצון וגו' (Deuteronomy 33:23). Ba'al HaTurim reads the phrase אשה אילה שלוחה הנותן as a re-ordered acrostic of the blessings over the daughters of Zelophehad in Numbers 36, a reading he connects to the demographic imbalance between males and females in the tribe of Naphtali. The census lists in Numbers 1 and Numbers 26 show a dramatic drop in Naphtali's population from 53,400 to 45,400, which Ba'al HaTurim attributes to the death of the men in the plague following the sin at Shittim (Numbers 25).", :sources ["Genesis 49:21" "Deuteronomy 33:23" "Numbers 1:42" "Numbers 25:1-9" "Numbers 26:48-50"]}}], :arithmetic [{:kind :rashei-tevot, :phrase "אשה אילה שלוחה הנותן", :spells "אשה", :letters ["א" "א" "ש" "ה"], :by :selah, :order :mismatch}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:49.615680044Z", :model "glm-5.2"}