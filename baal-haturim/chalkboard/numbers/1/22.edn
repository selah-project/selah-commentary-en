{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "לבני שמעון לגלגלתם", :translit "livnei shim'on ligelgelotam", :gloss "for the sons of Simeon, by their count"} {:he "שמעון", :translit "shim'on", :gloss "Simeon"} {:he "זמרי בן סלוא", :translit "zimri ben salu", :gloss "Zimri son of Salu"} {:he "גלגלותם", :translit "gelgelotam", :gloss "their count (spelled with vav)"}], :mechanisms [{:kind :other, :note "Orthographic/morphological observation: the lamed in גלגלתם (num 1:22) is written bent downward; the lamed in גלגלותם is written without a cap"}], :frame {:text "Zimri son of Salu, prince of a Simeonite father's house, sinned with a Midianite woman at Shittim (Numbers 25:14). The tribe of Simeon is not listed as producing any judge or king in the enumerations of Judges (Judges 1–21) or the monarchy narratives (1 Samuel–1 Kings). The Ba'al HaTurim reads the unusual letter shapes in the Torah scroll's sole plene spelling of גלגלותם at Numbers 1:22 — a lamed bent downward and a second lamed lacking its cap — as visual allusions to the tribal consequences of Zimri's act.", :sources ["Numbers 25:14" "Numbers 1:22"]}}], :arithmetic [{:kind :other, :note "Orthographic/morphological observation: the lamed in גלגלתם (num 1:22) is written bent downward; the lamed in גלגלותם is written without a cap", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:41.655254636Z", :model "glm-5.2"}