{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "קריאי העדה", :translit "kri'ei ha'edah", :gloss "those summoned of the assembly"} {:he "וי\"ו קטיעא", :translit "vav keti'a", :gloss "the vav is cut"} {:he "קרואי", :translit "kru'ei", :gloss "summoned (alternate spelling)"} {:he "שלומיאל בן צורישדי", :translit "shelumiel ben tzurishaddai", :gloss "Shelumiel son of Zurishaddai"} {:he "זמרי בן סלוא", :translit "zimri ben salu", :gloss "Zimri son of Salu"} {:he "בעדת קרח", :translit "b'adat korach", :gloss "in the assembly of Korah"} {:he "קראי", :translit "kri'ei", :gloss "summoned (defective spelling)"}], :mechanisms [{:kind :other, :note "Defective spelling: kri'ei (קריאי) written without a vav that the full form kri'ei (קרואי) would have."} {:kind :other, :note "In Numbers 1:16 the vav is partially present (keti'a = cut); in the Korah reference it is entirely absent, reflecting degrees of wickedness."} {:kind :other, :note "Shelumiel son of Zurishaddai (Numbers 1:6, tribe of Simeon) is identified as the same person as Zimri son of Salu."} {:kind :other, :note "Masoretic distinction: in Korah's assembly all were wicked so the vav is entirely missing; here only Shelumiel was wicked so the vav is only cut."}], :frame {:text "Zimri son of Salu, prince of the tribe of Simeon, is killed by Phinehas for relations with a Midianite woman (Numbers 25:14). The Sages identify him with Shelumiel son of Zurishaddai, the prince of Simeon listed in the tribal encampment (Numbers 1:6, 2:12, 7:36, 10:19) — his name is read as an acronym for 'shelumi el' or understood as a name-change reflecting his sin (Sanhedrin 82b; Bamidbar Rabbah 15:18). Korah's assembly is described as fully wicked (Numbers 16). The term kri'ei mo'ed, 'those summoned to the assembly,' is the standard designation for the tribal princes (Numbers 1:16).", :sources ["Numbers 25:14" "Numbers 1:6" "Sanhedrin 82b" "Bamidbar Rabbah 15:18" "Numbers 16"]}}], :arithmetic [{:kind :other, :note "Defective spelling: kri'ei (קריאי) written without a vav that the full form kri'ei (קרואי) would have.", :by :selah, :ran? false} {:kind :other, :note "In Numbers 1:16 the vav is partially present (keti'a = cut); in the Korah reference it is entirely absent, reflecting degrees of wickedness.", :by :selah, :ran? false} {:kind :other, :note "Shelumiel son of Zurishaddai (Numbers 1:6, tribe of Simeon) is identified as the same person as Zimri son of Salu.", :by :selah, :ran? false} {:kind :other, :note "Masoretic distinction: in Korah's assembly all were wicked so the vav is entirely missing; here only Shelumiel was wicked so the vav is only cut.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:26:48.089381287Z", :model "glm-5.2"}