{:tier :glm-5.2, :verse 26, :comments [{:quotes [{:he "והרמותם ממנו", :translit "v'harimotem mimenu", :gloss "and you shall lift up from it"} {:he "ממינו", :translit "mimino", :gloss "from its species"}], :mechanisms [{:kind :other, :note "Qere reading switches nun to nun-yod, yielding 'from its species,' embedding the halakhic requirement."}], :frame {:text "The Qere is read ממינו, 'from its species,' encoding the halakhic rule that terumah must be taken from the same species, not from one species on behalf of another, and not from new produce on old produce. These requirements are developed in the Tannaitic halakhic tradition (Sifrei Zuta 18:26; cf. Mishnah Terumot 2:4, Tosefta Terumot 3:2).", :sources ["Sifrei Zuta 18:26" "Mishnah Terumot 2:4" "Tosefta Terumot 3:2"]}}], :arithmetic [{:kind :other, :note "Qere reading switches nun to nun-yod, yielding 'from its species,' embedding the halakhic requirement.", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:55.305016807Z", :model "glm-5.2"}