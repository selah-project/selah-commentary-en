{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "פדה", :translit "pidah", :gloss "redeem"} {:he "אך פדה תפדה", :translit "ach pidah tifdeh", :gloss "only you shall redeem"} {:he "אח לא פדה יפדה", :translit "ach lo pidah yipadeh", :gloss "only it shall not be redeemed"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["אך פדה תפדה" "אח לא פדה יפדה"]} {:kind :other, :note "Connects the second Masorah occurrence to R. Yehoshua's ruling that twin males from a non-firstling ewe both go to the priest"}], :frame {:text "Rabbi Yehoshua holds that a ewe that has not previously given birth and then bears twin males — both belong to the priest, and one does not exempt the other (Bekhorot 11a). This applies the law of bechor behemiah (firstling of a clean animal, Numbers 18:15) to the case of twins from a first birth. The phrase אח לא פדה יפדה in Numbers 18:15 is read as signaling that each animal stands independently for redemption.", :sources ["Bekhorot 11a" "Numbers 18:15"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["אך פדה תפדה" "אח לא פדה יפדה"], :by :selah, :located [{:phrase "אך פדה תפדה", :refs ["Numbers 18:15"], :n 1, :lens :exact} {:phrase "אח לא פדה יפדה", :refs ["Psalms 49:8"], :n 1, :lens :exact}]} {:kind :other, :note "Connects the second Masorah occurrence to R. Yehoshua's ruling that twin males from a non-firstling ewe both go to the priest", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:29:53.230401029Z", :model "glm-5.2"}