{:tier :glm-5.2, :verse 33, :comments [{:quotes [{:he "ונהי", :translit "v'nahi", :gloss "and we were"} {:he "ונהי בעינינו כחגבים", :translit "v'nahi b'eineinu k'chagavim", :gloss "and we were in our eyes like grasshoppers"} {:he "ונהי כטמא כלנו", :translit "v'nahi k'tamei kulanu", :gloss "and we were like unclean, all of us"} {:he "וכן היינו בעיניהם", :translit "v'chein hayinu b'eineihem", :gloss "and so we were in their eyes"} {:he "קן נמלים", :translit "ken nemalim", :gloss "a nest of ants"} {:he "כ\"ן", :translit "k\"n", :gloss "so too (abbreviated)"} {:he "וכמו נמלים", :translit "u'ch'mo nemalim", :gloss "and like ants"} {:he "נמלים בכרם", :translit "nemalim b'cherem", :gloss "ants in the vineyard"} {:he "סורו טמא", :translit "suru tamei", :gloss "turn aside unclean"} {:he "ככה יאכלו לחמם טמא", :translit "kacha yoch'lu lachmam tamei", :gloss "thus they shall eat their bread unclean"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ונהי בעינינו כחגבים" "ונהי כטמא כלנו"]} {:kind :gematria, :a "וכן היינו בעיניהם", :b "קן נמלים"} {:kind :notarikon, :word "כ\"ן", :expansion ["וכמו נמלים"]}], :frame {:text "Rashi on Numbers 13:33, citing the Tanchuma, records that the spies said: 'we heard them say — ants in the vineyard.' Ba'al HaTurim uses his gematria to justify Rashi's reference to ants despite the verse stating 'like grasshoppers.' The phrase סורו טמא alludes to the decree of ritual impurity decreed upon the generation of the wilderness (Ezekiel 4:13: ככה יאכלו לחמם טמא).", :sources ["Rashi on Numbers 13:33" "Ezekiel 4:13"]}} {:quotes [{:he "כחגבים", :translit "k'chagavim", :gloss "like grasshoppers"} {:he "ויושביה כחגבים", :translit "v'yoshveha k'chagavim", :gloss "and its inhabitants like grasshoppers"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["כחגבים" "ויושביה כחגבים"]}], :frame {:text "The Midrash Tanchuma (Shelach 16) describes the giants' land so excessively fruitful that a single grasshopper ate a pomegranate, discarded the rind, and all twelve spies sat inside it for shade. This explains the phrase ויושביה כחגבים in Numbers 13:33: they literally sat inside a grasshopper's rind as though they themselves were grasshoppers.", :sources ["Midrash Tanchuma Shelach 16" "Numbers 13:33"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ונהי בעינינו כחגבים" "ונהי כטמא כלנו"], :by :selah, :located [{:phrase "ונהי בעינינו כחגבים", :refs ["Numbers 13:33"], :n 1, :lens :exact} {:phrase "ונהי כטמא כלנו", :refs ["Isaiah 64:5"], :n 1, :lens :exact}]} {:kind :gematria, :a "וכן היינו בעיניהם", :a-value 344, :b "קן נמלים", :b-value 320, :lens :standard, :by :selah, :equal? false} {:kind :notarikon, :word "כ\"ן", :expansion ["וכמו נמלים"], :initials ["ו"], :by :selah, :initials-match? false} {:kind :masorah, :count 2, :occurrences ["כחגבים" "ויושביה כחגבים"], :by :selah, :located [{:phrase "כחגבים", :refs ["Numbers 13:33" "Isaiah 40:22"], :n 2, :lens :exact} {:phrase "ויושביה כחגבים", :refs ["Isaiah 40:22"], :n 1, :lens :plene-insensitive}]}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 13, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:56.793717767Z", :model "glm-5.2"}