{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "גדיאל בן סודי", :translit "gadi'el ben sodi", :gloss "Gadiel son of Sodi"} {:he "תעבוני כל מתי סודי", :translit "ta'avuni kol matei sodi", :gloss "they caused me abhorrence, all men of my council"} {:he "מתי סודי", :translit "matei sodi", :gloss "men of my council"} {:he "תעבוני", :translit "ta'avuni", :gloss "they caused abhorrence"}], :mechanisms [{:kind :other, :note "Wordplay on the name סודי linked to מתי סודי in Proverbs 25:10 and to the spies' secret-bearing mission"}], :frame {:text "The phrase מתי סודי occurs in Proverbs 25:10 in the context of divulging a secret. Ba'al HaTurim applies it to the spies, who were entrusted with the secret counsel of scouting the land. The Talmud records that the night the spies returned their evil report, the 9th of Av, was decreed as a day of weeping for generations (Taanit 29a).", :sources ["Proverbs 25:10" "Taanit 29a"]}}], :arithmetic [{:kind :other, :note "Wordplay on the name סודי linked to מתי סודי in Proverbs 25:10 and to the spies' secret-bearing mission", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 13, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:40.973787779Z", :model "glm-5.2"}