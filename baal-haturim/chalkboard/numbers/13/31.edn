{:tier :glm-5.2, :verse 31, :comments [{:quotes [{:he "כי חזק הוא ממנו", :translit "ki chazak hu mimmennu", :gloss "for stronger is he than us"} {:he "אל תקרי ממנו אלא ממנו", :translit "al tikri mimmennu ella mimmennu", :gloss "do not read 'from us' but rather 'from Him'"} {:he "מנא", :translit "mana", :gloss "vessel"} {:he "מ\"ם נו\"ן וי\"ו", :translit "mem nun vav", :gloss "mem nun vav"}], :mechanisms [{:kind :other, :note "al tikri: read ממנו (from us) as ממנו (from Him) — different vocalization of identical consonants"} {:kind :other, :note "all three letters of ממנו (מ-מ-נ-ו) are doubled within the word: two mems and two nuns (with vav)"} {:kind :other, :note "some interpret ממנו as related to מנא meaning vessel"}], :frame {:text "The Sages interpret the word ממנו via al tikri: instead of reading it as 'from us' (the spies' plain meaning), read it as 'from Him' — indicating that even in the World to Come, God cannot remove His vessels (the righteous) from there. This tradition is recorded in Sotah 35a, and the concept of the righteous as God's vessels appears in Shabbat 92a.", :sources ["Sotah 35a" "Shabbat 92a"]}}], :arithmetic [{:kind :other, :note "al tikri: read ממנו (from us) as ממנו (from Him) — different vocalization of identical consonants", :by :selah, :ran? false} {:kind :other, :note "all three letters of ממנו (מ-מ-נ-ו) are doubled within the word: two mems and two nuns (with vav)", :by :selah, :ran? false} {:kind :other, :note "some interpret ממנו as related to מנא meaning vessel", :by :selah, :ran? false}], :book :numbers, :voice :baal-haturim, :lang :en, :chapter 13, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:28:50.035284182Z", :model "glm-5.2"}