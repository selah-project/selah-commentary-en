{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "ובערת הרע מקרבך וכל ישראל", :translit "uvi'arta ha'ra mi'kirbecha chol yisrael", :gloss "and you shall remove the evil from your midst, and all Israel"} {:he "וסמיך ליה", :translit "u'smich lai", :gloss "and adjacent to it"} {:he "וכי יהיה באיש חטא", :translit "v'chi yihyeh v'ish chata", :gloss "and if there be in a man a sin"} {:he "לומר לך שכל ישראל ערבים זה לזה", :translit "lomar l'cha shechol yisrael aravim zeh la'zeh", :gloss "to tell you that all Israel are guarantors for one another"} {:he "לבער ולהוכיח החוטאים", :translit "l'va'er ul'ho'chi'ach ha'chot'im", :gloss "to remove and to rebuke the sinners"} {:he "ורגמוהו", :translit "v'rag'muhu", :gloss "and they shall stone him"} {:he "וסמך לו פרשת נתלין", :translit "v'samach lo parshat nith'lin", :gloss "and adjacent to it the section of hanging"} {:he "לומר שכל הנסקלין נתלין", :translit "lomar shechol ha'nis'k'lin nith'lin", :gloss "to say that all who are stoned are hanged"}], :mechanisms [{:kind :other, :note "Semikhut parshiyot: the phrase 'and all Israel' is immediately followed in the scroll by 'and if there be in a man a sin,' teaching mutual responsibility to rebuke sinners."} {:kind :other, :note "Semikhut parshiyot: the phrase 'and they shall stone him' is immediately followed by the section of hanging, teaching that all who are stoned are hanged."}], :frame {:text "The principle that all Israel are guarantors for one another is stated in b'Shevu'ot 39a. The broader obligation to rebuke a sinner derives from Leviticus 19:17, 'you shall surely rebuke your fellow.' The law that all who are stoned are hanged is taught in m'Sanhedrin 6:4 and codified in b'Sanhedrin 45b, which states that all who are stoned are hanged.", :sources ["b'Shevu'ot 39a" "Leviticus 19:17" "m'Sanhedrin 6:4" "b'Sanhedrin 45b"]}}], :arithmetic [{:kind :other, :note "Semikhut parshiyot: the phrase 'and all Israel' is immediately followed in the scroll by 'and if there be in a man a sin,' teaching mutual responsibility to rebuke sinners.", :by :selah, :ran? false} {:kind :other, :note "Semikhut parshiyot: the phrase 'and they shall stone him' is immediately followed by the section of hanging, teaching that all who are stoned are hanged.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:07.667957336Z", :model "glm-5.2"}