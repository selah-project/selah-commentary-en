{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "לא יעבד ולא יזרע", :translit "lo ye'aved velo yizarei'a", :gloss "it shall not be worked and it shall not be sown"} {:he "חלל", :translit "chalal", :gloss "unworked/stream-bed"} {:he "עגלה", :translit "eglah", :gloss "heifer"}], :mechanisms [{:kind :masorah, :count 4, :occurrences ["חלל"]} {:kind :masorah, :count 4, :occurrences ["עגלה"]} {:kind :other, :note "Four commandments derived from the verse correspond to the four winds of the world"}], :frame {:text "The ritual of the eglah arufah (broken-necked heifer) is described in Deuteronomy 21:1-9, where the elders break the heifer's neck in a wadi that is not worked or sown. The Talmud derives four distinct prohibitions from the phrase 'לא יעבד ולא יזרע': one may not work the land, one may not sow it, and each prohibition applies both before and after the heifer's neck is broken (Sotah 45b). These four prohibitions correspond to the four winds of the world, reflecting the comprehensive atonement the ritual provides.", :sources ["Deuteronomy 21:1-9" "Sotah 45b"]}}], :arithmetic [{:kind :masorah, :count 4, :occurrences ["חלל"], :by :selah, :located [{:phrase "חלל", :refs ["Leviticus 19:8" "Deuteronomy 21:1" "Deuteronomy 32:42" "2 Samuel 1:19" "2 Samuel 1:25" "2 Samuel 23:8" "2 Samuel 23:18" "Jeremiah 51:52"], :n 27, :lens :exact}]} {:kind :masorah, :count 4, :occurrences ["עגלה"], :by :selah, :located [{:phrase "עגלה", :refs ["Genesis 15:9" "Numbers 7:3" "1 Samuel 6:7" "2 Samuel 6:3" "Isaiah 28:27" "Jeremiah 46:20" "Hosea 10:11" "1 Chronicles 13:7"], :n 8, :lens :exact}]} {:kind :other, :note "Four commandments derived from the verse correspond to the four winds of the world", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:37:36.233841898Z", :model "glm-5.2"}