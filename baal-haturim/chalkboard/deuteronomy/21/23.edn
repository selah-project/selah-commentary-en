{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "על העץ", :translit "al ha-etz", :gloss "on the tree"} {:he "כי קבור תקברנו", :translit "ki kavor tikbirennu", :gloss "for you shall surely bury him"}], :mechanisms [{:kind :other, :note "Semikhah parshanut: the word עץ in the phrase על העץ is read together with the adjacent phrase כי קבור תקברנו to derive that the wooden stake is buried with the executed person."}], :frame {:text "The phrase כי קבור תקברנו immediately follows על העץ in Deuteronomy 21:23. The Sifrei derives from the doubling קבור תקברנו that one must not leave the corpse hanging overnight but must bury it promptly, and Rashi (Deuteronomy 21:23) cites this reading.", :sources ["Sifrei Devarim 221" "Rashi on Deuteronomy 21:23"]}}], :arithmetic [{:kind :other, :note "Semikhah parshanut: the word עץ in the phrase על העץ is read together with the adjacent phrase כי קבור תקברנו to derive that the wooden stake is buried with the executed person.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 21, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:02.745415758Z", :model "glm-5.2"}