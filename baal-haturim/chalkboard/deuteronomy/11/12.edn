{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "מרשית השנה", :translit "me-reshit ha-shanah", :gloss "from the beginning of the year"} {:he "מתשרי", :translit "mi-tishrei", :gloss "from Tishrei"} {:he "עיני ה' אלהיך בה", :translit "einei Hashem Elokecha bah", :gloss "the eyes of YHWH your Elohim are upon it"} {:he "לוהיה", :translit "la-Hashem", :gloss "to YHWH"} {:he "אם שמוע תשמע", :translit "im shamo'a tishma", :gloss "if you will indeed hearken"} {:he "עיני ה' אלהיך בה", :translit "einei Hashem Elokecha bah", :gloss "the eyes of YHWH your Elohim are upon it"} {:he "כי כמים הפנים לפנים", :translit "ki ka-mayim ha-panim la-panim", :gloss "for as the face answers to face in water"}], :mechanisms [{:kind :other, :note "Reads מרשית as two words מתשרי — 'from Tishrei,' the month marking the new year."}], :frame {:text "Tishrei is identified as the beginning of the year in the calendar of months (Rosh HaShanah 2a, based on Exodus 12:2 and Deuteronomy 11:12). The phrase לוהיה ('to YHWH') appears immediately after the words עיני ה' אלהיך בה ('the eyes of YHWH your Elohim are upon it') in Deuteronomy 11:12, so the Ba'al HaTurim cites nearby verse-text as a hermeneutic 'neighbor' to reinforce his reading of מרשית as מתשרי. The condition 'if you will indeed hearken' echoes the covenantal formula found in passages such as Deuteronomy 11:13 and 28:1. The comparison 'as the face to face in water' is drawn from Proverbs 27:19.", :sources ["Rosh HaShanah 2a" "Exodus 12:2" "Deuteronomy 11:12" "Deuteronomy 11:13" "Deuteronomy 28:1" "Proverbs 27:19"]}} {:quotes [{:he "ועד אחרית שנה", :translit "ve-ad acharit shanah", :gloss "and until the end of the year"}], :mechanisms [], :frame nil}], :arithmetic [{:kind :other, :note "Reads מרשית as two words מתשרי — 'from Tishrei,' the month marking the new year.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 11, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:35:52.674815364Z", :model "glm-5.2"}