{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "ויבאנו אל המקום הזה", :translit "vayvi'enu el ha-makom ha-zeh", :gloss "and He brought us to this place"} {:he "ויבאנו", :translit "vayvi'enu", :gloss "and He brought us"} {:he "ויבאנו חסר יו\"ד", :translit "vayvi'enu chaser yud", :gloss "vayvi'enu is defective (missing) yod"} {:he "שנסינו אותו עשר נסיונות", :translit "she-nasinu oto eser nisyonot", :gloss "that we tested Him ten trials"} {:he "והביאנו לארץ", :translit "ve-hevi'enu la-aretz", :gloss "and He brought us to the land"}], :mechanisms [{:kind :other, :note "Missing letter: ויבאנו written without יו\"ד, alluding to עשר (ten) trials"}], :frame {:text "The tradition that Israel tested God ten times in the wilderness is stated at Numbers 14:22. Pirkei de-Rabbi Eliezer 44 enumerates ten trials, citing as the tenth the incident at Shittim (Numbers 25). The specific count of ten trials also appears in Mishnah Avot 5:4.", :sources ["Numbers 14:22" "Pirkei de-Rabbi Eliezer 44" "Mishnah Avot 5:4"]}}], :arithmetic [{:kind :other, :note "Missing letter: ויבאנו written without יו\"ד, alluding to עשר (ten) trials", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:39:26.822685823Z", :model "glm-5.2"}