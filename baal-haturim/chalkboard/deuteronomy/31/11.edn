{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "בבוא כל ישראל", :translit "b'vo chol yisra'el", :gloss "when all Israel comes"} {:he "מלא וי\"ו", :translit "malei vav", :gloss "plene with vav"} {:he "ו' היו באים", :translit "vav hayu ba'im", :gloss "six were coming"} {:he "כהנים", :translit "kohanim", :gloss "priests"} {:he "וזקנים", :translit "v'zekenim", :gloss "and elders"} {:he "אנשים", :translit "anashim", :gloss "men"} {:he "ונשים", :translit "v'nashim", :gloss "and women"} {:he "וטף", :translit "v'taf", :gloss "and children"} {:he "וגרך", :translit "v'gercha", :gloss "and your convert"}], :mechanisms [{:kind :other, :note "The word כל written plene with a vav signals six groups coming to the public Torah reading."}], :frame {:text "Deuteronomy 31:10–12 commands that all Israel assemble at the close of the Sabbatical year to hear the Torah read, and the verse explicitly lists men, women, children, and the stranger (Deuteronomy 31:12). Chagigah 3a explains that men come to learn, women to hear, and children to give reward to those who bring them; the verse is read in the Temple by the king.", :sources ["Deuteronomy 31:10–12" "Chagigah 3a"]}}], :arithmetic [{:kind :other, :note "The word כל written plene with a vav signals six groups coming to the public Torah reading.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 31, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:33.650143029Z", :model "glm-5.2"}