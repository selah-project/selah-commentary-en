{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "או כי ימות האיש האחרון", :translit "o ki yamut ha-ish ha-acharon", :gloss "or if the latter husband dies"} {:he "השני", :translit "ha-sheni", :gloss "the second"} {:he "האחרון", :translit "ha-acharon", :gloss "the latter"} {:he "בתרי זימני הוי חזקה", :translit "betrei zimnei havya chazakah", :gloss "after two times it becomes a presumption"}], :mechanisms [{:kind :other, :note "Word-choice contrast: Scripture uses 'the latter' (ha-acharon) instead of 'the second' (ha-sheni) to signal she may not marry a third time."}], :frame {:text "The principle that after two occurrences a presumption (chazakah) is established appears in the Mishnah in the context of a woman's established pattern (Yevamot 11:1). The specific Aramaise formulation 'after two times it becomes a presumption' (בתרי זימני הוי חזקה) is a Talmudic idiom found in Baba Kama 46b and Baba Batra 92a.", :sources ["Mishnah Yevamot 11:1" "Bava Kamma 46b" "Bava Batra 92a"]}}], :arithmetic [{:kind :other, :note "Word-choice contrast: Scripture uses 'the latter' (ha-acharon) instead of 'the second' (ha-sheni) to signal she may not marry a third time.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:49.705998708Z", :model "glm-5.2"}