{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "כל זכורך", :translit "kol zekharkha", :gloss "all your males"} {:he "גדלים וקטנים", :translit "gedolim u-ketanim", :gloss "grown-ups and minors"}], :mechanisms [{:kind :gematria, :a "כל זכורך", :b "גדלים וקטנים"}], :frame nil} {:quotes [{:he "את פני", :translit "et penai", :gloss "the face of"} {:he "פנים בפנים", :translit "panim be-fanim", :gloss "face to face"} {:he "כשם שבא לראות כך בא ליראות", :translit "ke-sheim she-ba lirot kakh ba le-ra'ot", :gloss "just as he comes to see, so he comes to be seen"}], :mechanisms [{:kind :other, :note "Peh of את פני written with dagesh (doubled), signaling face-to-face encounter."}], :frame {:text "The obligation of the festival pilgrimage is expressed as seeing the Divine presence: Exodus 23:17 and Exodus 34:23 use the phrase 'יראה את פני' ('appear before the face of'), while Deuteronomy 16:16 uses 'יראה ... את פני' with peh bearing a dagesh. Chagigah 2a records that the obligation is to appear (le-ra'ot) in the Temple; Hagigah 3b clarifies that just as one comes to see, so one comes to be seen. Berakhot 7a describes the encounter of worship as 'פנים בפנים' (face to face). The doubled peh thus hints at this reciprocal seeing.", :sources ["Exodus 23:17" "Exodus 34:23" "Deuteronomy 16:16" "Hagigah 2a" "Hagigah 3b" "Berakhot 7a"]}}], :arithmetic [{:a-value 303, :b-value 302, :lens :standard, :equal? false, :kind :gematria, :b "גדלים וקטנים", :by :selah, :colel? true, :a "כל זכורך"} {:kind :other, :note "Peh of את פני written with dagesh (doubled), signaling face-to-face encounter.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:59.600872513Z", :model "glm-5.2"}