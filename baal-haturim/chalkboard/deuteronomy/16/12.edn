{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "החקים האלה", :translit "ha-chukim ha-eleh", :gloss "these statutes"}], :mechanisms [{:kind :other, :note "Plene spelling of האלה (with vav) in Deut 16:12 versus defective spelling (without vav) in the parallel verse Deut 16:10"}], :frame {:text "The festival of Shavuot (עצרת) is identified as the time of the giving of the Torah (Shabbat 86b). Deuteronomy 16:10 uses the defective spelling האלה while Deuteronomy 16:12 uses the plene spelling האלה, and Ba'al HaTurim reads the extra letter as a pointer to the giving of the Torah at Shavuot.", :sources ["Shabbat 86b" "Deuteronomy 16:10" "Deuteronomy 16:12"]}}], :arithmetic [{:kind :other, :note "Plene spelling of האלה (with vav) in Deut 16:12 versus defective spelling (without vav) in the parallel verse Deut 16:10", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:53.314673795Z", :model "glm-5.2"}