{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "ואצוה אתכם", :translit "v'etzaveh etchem", :gloss "and I charged you"} {:he "אזהרה לצבור שתהא אימת הדיין עליהם", :translit "azharah latzibur sheh-tehei eimat hadayin aleihem", :gloss "a warning to the community that the awe of the judge be upon them"}], :mechanisms [{:kind :other, :note "Reads the phrase 'and I charged you' as establishing judicial authority over the public."}], :frame {:text "The phrase 'ואצוה אתכם' ('and I charged you') occurs in Deuteronomy 1:18, where Moses recounts instructing the people at Horeb. Ba'al HaTurim understands the root יצה ('charge') here in its legal sense of אזהרה, a formal warning or admonition. The requirement that the community maintain reverence for the judiciary is anchored in Deuteronomy 17:11–13, where the Torah mandates compliance with the court's rulings so that fear of judicial authority prevails.", :sources ["Deuteronomy 1:18" "Deuteronomy 17:11–13"]}}], :arithmetic [{:kind :other, :note "Reads the phrase 'and I charged you' as establishing judicial authority over the public.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:33:32.004393205Z", :model "glm-5.2"}