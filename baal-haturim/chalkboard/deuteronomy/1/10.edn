{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "והנכם", :translit "v'hin'chem", :gloss "and here you are"} {:he "והנכם הולכים איש אחרי שרירות לבו", :translit "v'hin'chem hol'chim ish acharai sh'rirut l'vo", :gloss "and you walk each man after the stubbornness of his heart"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והנכם" "והנכם הולכים איש אחרי שרירות לבו"]}], :frame {:text "The word והנכם appears exactly twice in the Torah: once at Deuteronomy 1:10 and once at Numbers 15:39, which falls in the passage about tzitzit. The Ba'al HaTurim links the two occurrences so that thenumerousness promised at Deuteronomy 1:10 is read as a statement of divine grace: even though (אע\"פ) Israel goes astray after the stubbornness of its heart, as warned in the tzitzit passage (Numbers 15:39), nevertheless \"you are today as numerous as the stars of the heavens\" — the blessing stands despite the sin.", :sources ["Deuteronomy 1:10" "Numbers 15:39"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והנכם" "והנכם הולכים איש אחרי שרירות לבו"], :by :selah, :located [{:phrase "והנכם", :refs ["Deuteronomy 1:10" "Jeremiah 16:12"], :n 2, :lens :exact} {:phrase "והנכם הולכים איש אחרי שרירות לבו", :refs ["Jeremiah 16:12"], :n 1, :lens :plene-insensitive}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:33:17.062981472Z", :model "glm-5.2"}