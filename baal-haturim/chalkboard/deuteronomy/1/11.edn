{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "ויברך", :translit "viyvarkh", :gloss "and He will bless"} {:he "ויברך כל בשר שם קדשו", :translit "viyvarkh kol basar shem kodsho", :gloss "and all flesh blessed His holy name"} {:he "כשיברך אתכם", :translit "k'sheyivarkh etkhem", :gloss "when He blesses you"} {:he "יברך כל בשר שם קדשו", :translit "yivarkh kol basar shem kodsho", :gloss "all flesh will bless His holy name"} {:he "ברוך שקיים הבטחתו", :translit "barukh shekyam hakhato", :gloss "Blessed be He who fulfilled His promise"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויברך" "ויברך כל בשר שם קדשו"]} {:kind :other, :note "Links two occurrences of ויברך to draw a thematic lesson: Israel's blessing cascades to universal praise."}], :frame {:text "Moses's blessing in Deuteronomy 1:11 reiterates the promise God made to the patriarchs. Genesis 28:14 records God's word to Jacob: 'Your seed shall be as the dust of the earth… and in you and in your seed shall all the families of the earth be blessed.' The Ba'al HaTurim reads the Masorah's pairing of the two ויברך forms as an echo of that verse: the blessing upon Israel becomes the occasion for universal recognition of God.", :sources ["Deuteronomy 1:11" "Genesis 28:14"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויברך" "ויברך כל בשר שם קדשו"], :by :selah, :located [{:phrase "ויברך", :refs ["Genesis 1:22" "Genesis 1:28" "Genesis 2:3" "Genesis 5:2" "Genesis 9:1" "Genesis 24:11" "Genesis 25:11" "Genesis 28:1"], :n 33, :lens :exact} {:phrase "ויברך כל בשר שם קדשו", :refs ["Psalms 145:21"], :n 1, :lens :exact}]} {:kind :other, :note "Links two occurrences of ויברך to draw a thematic lesson: Israel's blessing cascades to universal praise.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 1, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:33:21.831204279Z", :model "glm-5.2"}