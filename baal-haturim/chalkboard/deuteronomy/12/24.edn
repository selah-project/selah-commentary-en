{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "תשפכנו", :translit "tishpekhenu", :gloss "you shall pour it out"} {:he "פטור מלכסותו", :translit "patur milchastoto", :gloss "exempt from covering it"}], :mechanisms [{:kind :gematria, :a "תשפכנו", :b "פטור מלכסותו"}], :frame {:text "Leviticus 17:13 requires one who hunts an animal or bird to pour out its blood and cover it with earth (ושפך את דמו וכסהו בעפר). Deuteronomy 12:24, addressing slaughter for ordinary consumption, commands pouring the blood out but does not mention the covering requirement. The Ba'al HaTurim resolves this omission through gematria: the word 'you shall pour it out' itself encodes 'exempt from covering it.'", :sources ["Leviticus 17:13" "Deuteronomy 12:24"]}}], :arithmetic [{:a-value 856, :b-value 857, :lens :standard, :equal? false, :kind :gematria, :b "פטור מלכסותו", :by :selah, :colel? true, :a "תשפכנו"}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:18.118770669Z", :model "glm-5.2"}