{:tier :glm-5.2, :verse 20, :comments [{:quotes [{:he "תאכל בשר", :translit "to'ekhal basar", :gloss "you shall eat meat"} {:he "כי ירחק", :translit "ki yirchak", :gloss "when He enlarges / distances"}], :mechanisms [{:kind :other, :note "Semikhut: the verse places 'you shall eat meat' immediately before 'when He enlarges your territory,' reading the juxtaposition as a warning."}], :frame {:text "Rav Yehudah taught in the name of Rav that a person should distance himself from eating meat, as stated in Chullin 84a. The word 'יִרְחַק' (He enlarges) literally means 'He distances,' supporting the reading that one should hold back from meat consumption. Ba'al HaTurim reads the phrase-adjacency of 'you shall eat meat' next to 'when He distances' as encoding this teaching; he locates it in the chapter of Chullin dealing with covering the blood (Chullin 84a).", :sources ["Chullin 84a"]}}], :arithmetic [{:kind :other, :note "Semikhut: the verse places 'you shall eat meat' immediately before 'when He enlarges your territory,' reading the juxtaposition as a warning.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:13.068454383Z", :model "glm-5.2"}