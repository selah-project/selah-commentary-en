{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "לרשת אותם", :translit "lareshet otam", :gloss "to dispossess them"}], :mechanisms [{:kind :other, :note "Limitation: לרשת implies full conquest, not reducing to tributary status"}], :frame {:text "Deuteronomy 20:10–11 permits offering terms of peace to a distant city, and if it surrenders, the people become tributary and serve. However, the seven Canaanite nations are excluded from this option: Deuteronomy 20:15–17 commands that the cities of these nations must be utterly destroyed, leaving nothing alive, precisely so Israel does not learn their abominations (Deuteronomy 20:18).", :sources ["Deuteronomy 20:10-11" "Deuteronomy 20:15-17" "Deuteronomy 20:18"]}} {:quotes [{:he "אותם", :translit "otam", :gloss "them"}], :mechanisms [{:kind :other, :note "Limitation: the pronoun אותם restricts the object to the specified nations only"}], :frame {:text "Deuteronomy 20:15 restricts the command to annihilate to 'the cities of these peoples' — the Hittite, Amorite, Canaanite, Perizzite, Hivite, and Jebusite — while Deuteronomy 20:10–15 establishes that cities 'very far away' may instead be offered peace terms.", :sources ["Deuteronomy 20:10-15" "Deuteronomy 20:16-17"]}}], :arithmetic [{:kind :other, :note "Limitation: לרשת implies full conquest, not reducing to tributary status", :by :selah, :ran? false} {:kind :other, :note "Limitation: the pronoun אותם restricts the object to the specified nations only", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:21.169232626Z", :model "glm-5.2"}