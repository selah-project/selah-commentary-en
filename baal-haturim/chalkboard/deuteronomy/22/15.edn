{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "אבי הנער", :translit "avi ha-na'ar", :gloss "the girl's father"} {:he "כתיב חסר ה\"א", :translit "katuv chaser ha-he", :gloss "written defective without heh"} {:he "שהלכה כנער", :translit "she-halakhah kena'ar", :gloss "for the halakhah follows the girl"} {:he "ש\"ר", :translit "shin resh", :gloss "shem reshut (writ of separation)"}], :mechanisms [{:kind :other, :note "אבי הנער written without final heh in the word נער rather than נערה, indicating the feminine noun but stripped of its feminine marker."} {:kind :rashei-tevot, :phrase "שם רשות", :spells "ש\"ר"}], :frame {:text "Deuteronomy 22:13–21 describes the scenario of a husband who accuses his bride of premarital infidelity. If the parents produce the 'tokens of virginity' (בתולים) and the husband's claim is false, he is fined one hundred silver shekels and may never divorce her (Deut 22:19). Ba'al HaTurim reads the defective spelling אבי הנער — lacking the heh of נערה — as encoding the halakhic outcome: although the husband was barred from divorcing her as punishment, once the matter is adjudicated and the wife is publicly cleared, he may issue a writ of separation (שם רשות). The phrase הלכה כנער is a compressed way of saying the disposition follows the girl's legal status — she is vindicated, and the forced restraint on divorce lifts.", :sources ["Deuteronomy 22:13–19"]}}], :arithmetic [{:kind :other, :note "אבי הנער written without final heh in the word נער rather than נערה, indicating the feminine noun but stripped of its feminine marker.", :by :selah, :ran? false} {:kind :rashei-tevot, :phrase "שם רשות", :spells "ש\"ר", :letters ["ש" "ר"], :by :selah, :order :in-order}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:26.002840684Z", :model "glm-5.2"}