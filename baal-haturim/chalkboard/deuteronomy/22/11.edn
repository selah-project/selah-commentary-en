{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "לא תלבש", :translit "lo tilbash", :gloss "you shall not wear"} {:he "אסורה להנות", :translit "asurah lehanot", :gloss "forbidden to derive benefit"}], :mechanisms [{:kind :gematria, :a "לא תלבש", :b "אסורה להנות"}], :frame {:text "A garment containing kilayim (mixed species of wool and linen) is forbidden, and the prohibition extends to deriving any benefit (hanahah) from it. This is rooted in the verse itself: Deuteronomy 22:11 prohibits wearing sha'atnez. The broader principle that one may not derive benefit from a prohibited mixture of kilayim is addressed in tractate Kilayim and codified in Mishneh Torah, Hilkhot Kilayim 10:2, which states that any kilayim mixture forbidden by Torah law is forbidden for all benefit.", :sources ["Deuteronomy 22:11" "Mishneh Torah, Hilkhot Kilayim 10:2"]}}], :arithmetic [{:kind :gematria, :a "לא תלבש", :a-value 763, :b "אסורה להנות", :b-value 763, :lens :standard, :by :selah, :equal? true}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:19.682602744Z", :model "glm-5.2"}