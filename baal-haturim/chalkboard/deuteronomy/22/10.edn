{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "לא תחרוש בשור ובחמור", :translit "lo tacharosh b'shor uv'chamor", :gloss "you shall not plow with an ox and with a donkey"} {:he "טהור וטמא", :translit "tahor v'tamei", :gloss "clean and unclean"} {:he "שלא ישתתף צדיק עם רשע", :translit "she'lo yishtatef tzadik im rasha", :gloss "that a righteous person should not partner with a wicked person"}], :mechanisms [{:kind :other, :note "Reads ox (clean animal) and donkey (unclean animal) as allegory for righteous and wicked persons."}], :frame {:text "Deuteronomy 22:10 prohibits plowing with an ox and a donkey together. Leviticus 22:27–28 and Deuteronomy 25:4 establish the broader framework of laws concerning animals. Psalms 1:1 warns against standing in the path of sinners, which supports the allegorical reading of not joining a righteous person with a wicked one.", :sources ["Deuteronomy 22:10" "Psalms 1:1"]}} {:quotes [{:he "תחרוש", :translit "tacharosh", :gloss "you shall plow"} {:he "לא תחרוש על רעך רעה", :translit "lo tacharosh al re'echa ra'ah", :gloss "do not plot evil against your fellow"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["תחרוש" "תחרוש"]}], :frame {:text "Leviticus 11:3–4 designates the ox as clean because it chews the cud, while the donkey is unclean because it does not. Ba'al HaTurim links the two occurrences of the word תחרוש — one in Deuteronomy 22:10 and one in Psalms 101:5 (לא תחרוש על רעך רעה) — to derive the reason for the plowing prohibition: the donkey sees the ox chewing its cud and wrongly thinks the ox is being fed while it goes hungry, causing the donkey suffering.", :sources ["Leviticus 11:3" "Leviticus 11:4" "Psalms 101:5"]}}], :arithmetic [{:kind :other, :note "Reads ox (clean animal) and donkey (unclean animal) as allegory for righteous and wicked persons.", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["תחרוש" "תחרוש"], :by :selah, :located [{:phrase "תחרוש", :refs ["Deuteronomy 22:10" "Judges 16:2" "1 Samuel 7:8" "Jeremiah 26:18" "Micah 3:12" "Habakkuk 1:13" "Psalms 28:1" "Psalms 35:22"], :n 13, :lens :plene-insensitive} {:phrase "תחרוש", :refs ["Deuteronomy 22:10" "Judges 16:2" "1 Samuel 7:8" "Jeremiah 26:18" "Micah 3:12" "Habakkuk 1:13" "Psalms 28:1" "Psalms 35:22"], :n 13, :lens :plene-insensitive}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 22, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:20.335679681Z", :model "glm-5.2"}