{:tier :glm-5.2, :verse 25, :comments [{:quotes [{:he "וישתחוו", :translit "v'yishtachavu", :gloss "and they bowed down"} {:he "מלא וי\"ו", :translit "malei vav", :gloss "plene with vav"} {:he "שאר עבודה שהיא כעין פנים", :translit "she'avodah she-hi ke'ein panim", :gloss "the rest of worship that is like its kind"}], :mechanisms [{:kind :other, :note "Plene spelling with three vavs signals all bowing-type worship, not just literal prostration"}], :frame {:text "The word וישתחוו is written plene — with an unusual concentration of three vavs — signaling that the scope of the prohibition extends beyond literal prostration to all acts of worship performed in the same posture. The principle that a biblical action-word covers its entire category appears in hermeneutical discussion at Shabbat 70a and is applied to idolatry at Sanhedrin 63a.", :sources ["Shabbat 70a" "Sanhedrin 63a"]}}], :arithmetic [{:kind :other, :note "Plene spelling with three vavs signals all bowing-type worship, not just literal prostration", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:17.902935084Z", :model "glm-5.2"}