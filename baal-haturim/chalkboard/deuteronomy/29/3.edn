{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "ולא נתן ה' לכם לב לדעת", :translit "v'lo natan Hashem lachem leiv l'da'at", :gloss "and YHWH has not given you a heart to know"} {:he "ואולך אתכם ארבעים שנה", :translit "v'olach etchem arba'im shanah", :gloss "and I led you forty years"}], :mechanisms [{:kind :other, :note "semikhut parshiyot: juxtaposition of adjacent verses to infer that full understanding comes only at age forty"}], :frame {:text "Rabbi Abbahu in the name of Rabbi Yohanan states that a person does not attain full understanding of his teacher's learning until forty years have passed (Avodah Zarah 19b). The Ba'al HaTurim derives this timeline from the juxtaposition of 'a heart to know' with 'forty years' in Deuteronomy 29:3–4.", :sources ["Avodah Zarah 19b" "Deuteronomy 29:3–4"]}}], :arithmetic [{:kind :other, :note "semikhut parshiyot: juxtaposition of adjacent verses to infer that full understanding comes only at age forty", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 29, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:10.482566792Z", :model "glm-5.2"}