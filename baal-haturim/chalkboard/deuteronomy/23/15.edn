{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "ערות דבר", :translit "ervat davar", :gloss "an exposed thing"} {:he "לא תסגיר עבד", :translit "lo tasgir eved", :gloss "you shall not deliver up a slave"} {:he "ערוה סגורה", :translit "ervah sgurah", :gloss "an ervah enclosed"} {:he "בעששית", :translit "be'ashashit", :gloss "in a lantern"} {:he "קריאת שמע", :translit "keri'at shema", :gloss "recitation of Shema"}], :mechanisms [{:kind :other, :note "Semikhah: verbal root ס-ג-ר (enclose/shut) shared between adjacent verses links them conceptually"} {:kind :other, :note "Gezeirah shavah: root ס-ג-ר in 'lo tasgir' informs the law of 'ervah sgurah' — enclosed ervah in a lantern still prohibits Shema"}], :frame {:text "The law that one may not recite Shema opposite an exposed ervah is stated at Berakhot 24a and derived from the phrase 'ervat davar' in Deuteronomy 23:15. Rav Huna there raises the specific case of an ervah enclosed in a glass lantern, and Rav Kahana and Rav Ashi debate whether the enclosure prevents the prohibition from applying; the conclusion holds that even enclosed, it remains forbidden if visible.", :sources ["Berakhot 24a" "Deuteronomy 23:15"]}}], :arithmetic [{:kind :other, :note "Semikhah: verbal root ס-ג-ר (enclose/shut) shared between adjacent verses links them conceptually", :by :selah, :ran? false} {:kind :other, :note "Gezeirah shavah: root ס-ג-ר in 'lo tasgir' informs the law of 'ervah sgurah' — enclosed ervah in a lantern still prohibits Shema", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:38:40.110040537Z", :model "glm-5.2"}