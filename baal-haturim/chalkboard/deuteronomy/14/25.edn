{:tier :glm-5.2, :verse 25, :comments [{:quotes [{:he "וצרת", :translit "v'tzarta", :gloss "and you shall bind"} {:he "וצרת הכסף בידך", :translit "v'tzarta ha'kesef b'yadekha", :gloss "and you shall bind the silver in your hand"} {:he "וצרת אותם בכנפיך", :translit "v'tzarta otam b'ch'nafekha", :gloss "and you shall bind them in your wings"} {:he "המפקיד מעות אצל חבירו וצררן והפשילן לאחוריו חייב", :translit "ha'mafqid ma'ot etzel chaveiro v'tzaran v'hef'shilan l'achorav chayav", :gloss "one who deposits coins with his fellow and bound them and slung them behind him is liable"} {:he "וצרת הכסף בידך", :translit "v'tzarta ha'kesef b'yadekha", :gloss "and you shall bind the silver in your hand"} {:he "וצרת אותם בכנפיך", :translit "v'tzarta otam b'ch'nafekha", :gloss "and you shall bind them in your wings"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וצרת הכסף בידך" "וצרת אותם בכנפיך"]} {:kind :other, :note "Gezeirah shavah linking two occurrences of וצרת to derive that a depositary who ties up coins is liable for their loss."}], :frame {:text "The Mishnah in Bava Metzi'a 3:8 states that one who deposits coins with another, and the depositary bound them and slung them behind him, is liable. The Gemara at Bava Metzi'a 42b expounds this from the phrase 'וְצַרְתָּ הַכֶּסֶף בְּיָדֶךָ' (Deuteronomy 14:25): the word 'בְּיָדֶךָ' teaches that even when the coins are bound up, they must remain 'in your hand,' i.e., in the depositary's personal custody. The Ba'al HaTurim links the second Masoretic occurrence of 'וצרת' ('וצרת אותם בכנפיך,' Malachi 3:20) to this same derivation.", :sources ["Bava Metzi'a 3:8" "Bava Metzi'a 42b" "Deuteronomy 14:25" "Malachi 3:20"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וצרת הכסף בידך" "וצרת אותם בכנפיך"], :by :selah, :located [{:phrase "וצרת הכסף בידך", :refs ["Deuteronomy 14:25"], :n 1, :lens :exact} {:phrase "וצרת אותם בכנפיך", :refs ["Ezekiel 5:3"], :n 1, :lens :exact}]} {:kind :other, :note "Gezeirah shavah linking two occurrences of וצרת to derive that a depositary who ties up coins is liable for their loss.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:46.944155412Z", :model "glm-5.2"}