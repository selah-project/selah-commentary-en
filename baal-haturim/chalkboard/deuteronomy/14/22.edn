{:tier :glm-5.2, :verse 22, :comments [{:quotes [{:he "עשר תעשר", :translit "aser ta'aser", :gloss "you shall surely tithe"} {:he "היוצא השדה שנה שנה", :translit "ha-yotze ha-sadeh shanah shanah", :gloss "the produce of the field, year by year"} {:he "בחלב", :translit "ba-chalav", :gloss "in milk"} {:he "בשר בחלב", :translit "basar ba-chalav", :gloss "meat in milk"} {:he "כלאים בשדה", :translit "kil'ayim ba-sadeh", :gloss "diverse kinds in the field"} {:he "אבשל פירותיך בזמנן", :translit "aveshal peirotecha bizmanan", :gloss "I will ripen your fruits in their season"} {:he "ותתעשר", :translit "vetita'aser", :gloss "and you will be tithed"} {:he "בחלב אמו", :translit "ba-chalev imo", :gloss "in its mother's milk"} {:he "לשנה שנה", :translit "le-shanah shanah", :gloss "year by year"} {:he "מינקת חברו לא תנשא תוך ב' שנים", :translit "meyaneqet chaveirah lo titnase toch shenatayim", :gloss "a nursing woman's friend may not marry within two years"} {:he "הולד בחלב אמו ב' שנים", :translit "ha-velad ba-chalev imo shenatayim", :gloss "the child in its mother's milk two years"}], :mechanisms [{:kind :other, :note "Semikhut ha-parshiyot: juxtaposition of adjacent passages to derive law"} {:kind :other, :note "Gezeirah shavah linking 'ba-chalav' across two contexts"}], :frame {:text "The prohibition of meat and milk appears three times in the Torah (Exodus 23:19, Exodus 34:26, Deuteronomy 14:21), each concluding with the phrase 'you shall not boil a kid in its mother's milk.' The midrash halakhah derives from these three repetitions that the prohibition applies to cooking, eating, and deriving benefit (Mekhilta de-Rabbi Yishmael, Kaspa 20; Hullin 115b). Nursing practices of the first two years are discussed in the Talmud: a mother who nurses is given leeway regarding certain obligations during that period (Ketubot 60a; Yevamot 80a).", :sources ["Exodus 23:19" "Exodus 34:26" "Deuteronomy 14:21" "Mekhilta de-Rabbi Yishmael Kaspa 20" "Hullin 115b" "Ketubot 60a" "Yevamot 80a"]}}], :arithmetic [{:kind :other, :note "Semikhut ha-parshiyot: juxtaposition of adjacent passages to derive law", :by :selah, :ran? false} {:kind :other, :note "Gezeirah shavah linking 'ba-chalav' across two contexts", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:47.089906011Z", :model "glm-5.2"}