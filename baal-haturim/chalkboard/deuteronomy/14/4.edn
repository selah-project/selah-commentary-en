{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "עזים", :translit "izzim", :gloss "goats"} {:he "איל", :translit "ayil", :gloss "ram"} {:he "עיזא דכרכוז", :translit "izza d'karkuz", :gloss "the karkuz goat"}], :mechanisms [{:kind :other, :note "Semikh ha-katuv: the word 'עזים' is immediately followed by 'איל' in the verse, and this adjacency serves as the allusion."}], :frame {:text "The Talmud discusses whether a creature called 'עיזא דכרכוז' (a type of goat) is classified as a 'חיה' (wild animal) rather than a 'בהמה' (domesticated animal), which would affect the blessing recited over it. The Ba'al HaTurim reads the juxtaposition of 'עזים' and 'איל' in Deuteronomy 14:4 as a scriptural hint supporting this classification.", :sources ["Ḥullin 59b"]}}], :arithmetic [{:kind :other, :note "Semikh ha-katuv: the word 'עזים' is immediately followed by 'איל' in the verse, and this adjacency serves as the allusion.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 14, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:28.709404668Z", :model "glm-5.2"}