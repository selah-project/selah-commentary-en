{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "כחלק", :translit "k'chelek", :gloss "as a portion"} {:he "חלק כחלק", :translit "chelek k'chelek", :gloss "a portion as a portion"} {:he "יאכלו כחלק", :translit "yokhlu k'chelek", :gloss "they shall eat as a portion"} {:he "היושב על הכלים", :translit "hayoshev al hakelim", :gloss "who sits over the vessels"} {:he "כהן בעל מום", :translit "kohen ba'al mum", :gloss "a priest with a blemish"} {:he "חולק בקדשים", :translit "kholek bikdashim", :gloss "receives a portion in the holy offerings"} {:he "פסול בעבורה", :translit "pasul ba'avodah", :gloss "disqualified for the service"} {:he "יושב על הכלים", :translit "yoshev al hakelim", :gloss "sits over the vessels"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["חלק כחלק" "יאכלו כחלק"]} {:kind :other, :note "Interpretive inference from the phrase היושב על הכלים: a blemished priest who guards the vessels eats of the offerings."}], :frame {:text "The phrase היושב על הכלים in its sole biblical occurrence (1 Samuel 21:8) refers to Doeg the Edomite, but is read here as a descriptive category: a priest whose role is limited to sitting over the vessels. The Bavli rules that a priest with a blemish is disqualified from sacrificial service yet is permitted to eat of the most holy offerings (Zevachim 102a). A baraitha cited there distinguishes priests who serve at the altar from those who merely attend to the vessels, and Tosefta Zevachim elaborates that a blemished priest may perform tasks involving the vessels of the sanctuary (Tosefta Zevachim 2:7). Ba'al HaTurim reads the verse's word כחלק — 'as a portion' — as teaching that such a priest eats of the offerings because he occupies the role of one who sits over the vessels.", :sources ["1 Samuel 21:8" "Zevachim 102a" "Tosefta Zevachim 2:7"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["חלק כחלק" "יאכלו כחלק"], :by :selah, :located [{:phrase "חלק כחלק", :refs ["Deuteronomy 18:8"], :n 1, :lens :exact} {:phrase "יאכלו כחלק", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Interpretive inference from the phrase היושב על הכלים: a blemished priest who guards the vessels eats of the offerings.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:37:19.767763923Z", :model "glm-5.2"}