{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "הירא", :translit "ha-yare", :gloss "the fearful"} {:he "הירא ורך הלבב", :translit "ha-yare ve-rakh ha-levav", :gloss "the fearful and faint of heart"} {:he "הירא את דבר ה'", :translit "ha-yare et devar Hashem", :gloss "one who fears the word of the Lord"} {:he "הירא", :translit "ha-yare", :gloss "the fearful"} {:he "הירא את דבר ה'", :translit "ha-yare et devar Hashem", :gloss "one who fears the word of the Lord"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הירא ורך הלבב" "הירא את דבר ה'"]}], :frame {:text "The Sages identify the 'fearful and faint of heart' sent home from war (Deuteronomy 20:8) as one who fears because of transgressions in his hand — i.e., his conscience is burdened by sin, causing him to lose courage. This interpretation is recorded in Sotah 44a and in the Tosefta at Sotah 7:14. Ba'al HaTurim links the phrase הירא in our verse to the phrase הירא את דבר ה' (Isaiah 66:2, referring to one who trembles at God's word), reading the military context as alluding to a person whose fear of sin defines him.", :sources ["Sotah 44a" "Tosefta Sotah 7:14" "Isaiah 66:2" "Deuteronomy 20:8"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["הירא ורך הלבב" "הירא את דבר ה'"], :by :selah, :located [{:phrase "הירא ורך הלבב", :refs ["Deuteronomy 20:8"], :n 1, :lens :exact} {:phrase "הירא את דבר ה'", :refs [], :n 0, :lens :plene-insensitive}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:37:33.595198311Z", :model "glm-5.2"}