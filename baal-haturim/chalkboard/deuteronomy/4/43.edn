{:tier :glm-5.2, :verse 43, :comments [{:quotes [{:he "ואת גולן בבשן", :translit "v'et golan babashan", :gloss "and Golan in Bashan"} {:he "וזאת התורה", :translit "v'zot hatorah", :gloss "and this is the Torah"} {:he "הוי גולה למקום תורה", :translit "havei golah limkom torah", :gloss "be exiled to a place of Torah"}], :mechanisms [{:kind :other, :note "Semikhah: the word 'Torah' follows immediately after Golan, hinting one should exile oneself to a place of Torah."}], :frame {:text "Exile to a place of Torah is itself a form of atonement, paralleling how the accidental killer finds refuge in a city of refuge. One should always live where Torah is studied, and exile oneself to such a place (Talmud Bavli Makkot 10a).", :sources ["Makkot 10a"]}} {:quotes [{:he "גלן", :translit "golan", :gloss "Golan"} {:he "שששה אינן גולין", :translit "sheishisha einan golim", :gloss "for six do not go into exile"} {:he "אב המכה לבנו", :translit "av hamakah l'ivno", :gloss "the father of the one who strikes his son"} {:he "הרב לתלמידו", :translit "harav l'talmido", :gloss "the teacher to his student"}], :mechanisms [{:kind :other, :note "Defective spelling of גלן (missing vav) hints that certain categories of unintentional killers do not go into exile."}], :frame {:text "Six categories of unintentional killers do not go into exile to a city of refuge, including a father who unintentionally kills his son, a son who kills his father, a teacher who kills his student, a student who kills his teacher, and others (Talmud Bavli Makkot 9a–10a).", :sources ["Makkot 9a" "Makkot 10a"]}}], :arithmetic [{:kind :other, :note "Semikhah: the word 'Torah' follows immediately after Golan, hinting one should exile oneself to a place of Torah.", :by :selah, :ran? false} {:kind :other, :note "Defective spelling of גלן (missing vav) hints that certain categories of unintentional killers do not go into exile.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 4, :disci