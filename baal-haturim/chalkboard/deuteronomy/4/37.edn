{:tier :glm-5.2, :verse 37, :comments [{:quotes [{:he "ותחת", :translit "u'tachat", :gloss "and beneath"} {:he "ותחת רגליו", :translit "u'tachat raglav", :gloss "and beneath His feet"} {:he "האבות הן הן המרכבה", :translit "ha-avot hen hen ha-merkavah", :gloss "the Patriarchs they themselves are the Chariot"} {:he "מתוך האש ותחת", :translit "mi-tokh ha-esh u'tachat", :gloss "from the midst of the fire and beneath"} {:he "שכינה", :translit "shekhinah", :gloss "Divine Presence"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ותחת" "ותחת רגליו"]}], :frame {:text "The phrase ותחת רגליו appears in the vision of the divine chariot in Ezekiel 1:26, describing what is beneath the divine figure. The statement האבות הן הן המרכבה is found in Bereshit Rabbah 47:8 and Genesis Rabbah 68:10, applied specifically to the Patriarchs. The parallel usage of ותחת in Ezekiel 1:26 and in Deuteronomy 4:37 links the Patriarchs to the divine chariot imagery, placing them within the fire of the Shechinah described at Deuteronomy 4:36 and Ezekiel 1:27.", :sources ["Ezekiel 1:26" "Ezekiel 1:27" "Bereshit Rabbah 47:8" "Bereshit Rabbah 68:10" "Deuteronomy 4:36"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ותחת" "ותחת רגליו"], :by :selah, :located [{:phrase "ותחת", :refs ["Exodus 24:10" "Deuteronomy 4:37" "Deuteronomy 12:2" "1 Kings 5:5" "1 Kings 14:23" "2 Kings 16:4" "2 Kings 17:10" "Isaiah 3:24"], :n 23, :lens :exact} {:phrase "ותחת רגליו", :refs ["Exodus 24:10"], :n 1, :lens :exact}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 4, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:34:05.895889957Z", :model "glm-5.2"}