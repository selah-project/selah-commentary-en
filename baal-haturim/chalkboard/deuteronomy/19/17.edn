{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "הריב", :translit "ha-riv", :gloss "the quarrel"} {:he "אשר להם הריב", :translit "asher lahem ha-riv", :gloss "who have the quarrel"} {:he "לפני התגלע הריב", :translit "lifnei hitgalea ha-riv", :gloss "before the quarrel breaks out"} {:he "נטוש", :translit "natash", :gloss "cast down"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["אשר להם הריב" "התגלע הריב"]}], :frame {:text "The procedure for a case that has already come before a court is addressed at Sanhedrin 7b, which states that once litigants stand before judges, the judges may not withdraw from judging them. The prohibition on a judge who recognizes a litigant as liable from withdrawing is stated at Sanhedrin 7b as well. The scenario of facilitating compromise before formal proceedings is addressed at Sanhedrin 6b. The Ba'al HaTurim reads the phrase 'before the quarrel breaks out' as marking the threshold: before that point withdrawal is permitted, but once litigants stand for judgment it is prohibited.", :sources ["Sanhedrin 6b" "Sanhedrin 7b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["אשר להם הריב" "התגלע הריב"], :by :selah, :located [{:phrase "אשר להם הריב", :refs ["Deuteronomy 19:17"], :n 1, :lens :exact} {:phrase "התגלע הריב", :refs ["Proverbs 17:14"], :n 1, :lens :exact}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:37:29.760109179Z", :model "glm-5.2"}