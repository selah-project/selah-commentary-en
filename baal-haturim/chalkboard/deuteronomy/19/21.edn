{:tier :glm-5.2, :verse 21, :comments [{:quotes [{:he "יד ביד רגל ברגל", :translit "yad b'yad regel b'ragel", :gloss "hand for hand foot for foot"} {:he "כי תצא למלחמה", :translit "ki tetze l'milchamah", :gloss "when you go out to war"}], :mechanisms [{:kind :other, :note "semikh: inference drawn from the adjacency of two passages in the Torah text"}], :frame {:text "The rule that those missing a limb do not go out to war derives from Mishnah Sotah 8:2, which lists those who are sent back from the battlefront, including one who is missing a limb. The hermeneutic of semikhut — drawing inference from the thematic or textual adjacency of two passages — is applied here because Deut. 19:21 ('hand for hand, foot for foot') is immediately followed by Deut. 20:1 ('When you go out to war').", :sources ["Mishnah Sotah 8:2" "Deut. 19:21" "Deut. 20:1"]}}], :arithmetic [{:kind :other, :note "semikh: inference drawn from the adjacency of two passages in the Torah text", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:37:29.598671887Z", :model "glm-5.2"}