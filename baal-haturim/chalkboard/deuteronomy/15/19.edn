{:tier :glm-5.2, :verse 19, :comments [{:quotes [{:he "כל הבכור", :translit "kol ha-b'chor", :gloss "every firstborn"} {:he "עבד לו", :translit "eved lo", :gloss "a slave to him / his slave"} {:he "עבד עברי", :translit "eved ivri", :gloss "Hebrew slave"} {:he "עבודת עבד", :translit "avodat eved", :gloss "labor of a slave"}], :mechanisms [{:kind :other, :note "Juxtaposition (סמיכות): the topic of firstborn animals placed adjacent to the section about the Hebrew slave to invite legal comparison."}], :frame {:text "Deuteronomy 15:19 begins the section on firstborn animals ('כל הבכור'), immediately following the section on the Hebrew slave (Deuteronomy 15:12–18). The halakhah that a firstborn animal is given to the priest and not worked is stated at Numbers 18:17. The comparison to a blemish disqualifying applies to firstborn animals per Leviticus 22:21–22 and Deuteronomy 15:21; the Ba'al HaTurim extends this disqualification by analogy to the strap used for a Hebrew slave, connecting to Deuteronomy 15:14 which mentions giving the slave a gift upon release.", :sources ["Numbers 18:17" "Leviticus 22:21-22" "Deuteronomy 15:12-18" "Deuteronomy 15:14" "Deuteronomy 15:19" "Deuteronomy 15:21"]}}], :arithmetic [{:kind :other, :note "Juxtaposition (סמיכות): the topic of firstborn animals placed adjacent to the section about the Hebrew slave to invite legal comparison.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:50.810868155Z", :model "glm-5.2"}