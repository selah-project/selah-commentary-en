{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "פתח", :translit "patach", :gloss "you shall open"} {:he "פתח תפתח", :translit "patoach tiftach", :gloss "opening you shall open"} {:he "נתון תתן לו", :translit "naton titen lo", :gloss "giving you shall give him"} {:he "העניק תעניק לו", :translit "ha'anik ta'anik lo", :gloss "you shall surely give him"}], :mechanisms [{:kind :other, :note "Doubled verb form (infinitive absolute) teaches intensity or repeated action"}], :frame {:text "The phrase פתח תפתח appears in Deuteronomy 15:8 in the context of the obligation to give a poor person according to his need. The Midrash reads the doubled language as instructing the giver to match the recipient's prior standard of living (Devarim Rabbah 5:12). The Talmud applies the same principle to the laws of the Sabbath day gift, deriving that one must supply a poor person's full deficiency (Ketubot 67b).", :sources ["Devarim Rabbah 5:12" "Ketubot 67b"]}} {:quotes [{:he "פתח", :translit "patach", :gloss "you shall open"}], :mechanisms [{:kind :other, :note "Defective spelling of פתח written without vav connects to the sixth day"}], :frame {:text "Ezera enacted that peddlers of food should distribute to the poor on Fridays so that they would have food for the Sabbath, as recorded in the Talmud (Ketubot 67a). The Ba'al HaTurim links the defective spelling of פתח to this practice by reading the missing vav as alluding to יום ו', the sixth day.", :sources ["Ketubot 67a"]}} {:quotes [{:he "פתח", :translit "patach", :gloss "you shall open"} {:he "פתוח", :translit "patsuach", :gloss "opened"} {:he "נפתחו שערי ארצך", :translit "niftachu shearai artzecha", :gloss "the gates of your land will be opened"} {:he "אוטם אזנו מזעקת דל וגו'", :translit "otem oznzo mize'akat dal vegomer", :gloss "who stops his ear from the cry of the poor etc."}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["פתח תפתח" "פתוח תפתח" "נפתחו שערי ארצך"]}], :frame {:text "Proverbs 21:13 warns that one who shuts his ear to the cry of the poor will himself cry out and not be answered. The Midrash connects the commandment to open one's hand to the poor with the opening of the gates of heaven, reading the Masoretic linkage between the occurrences of פתח as a measure-for-measure principle (Devarim Rabbah 5:13).", :sources ["Proverbs 21:13" "Devarim Rabbah 5:13"]}} {:quotes [{:he "די מחסרו אשר יחסר", :translit "dei machsoro asher yechsar", :gloss "sufficient for his lack that he lacks"} {:he "דמאי", :translit "demai", :gloss "doubtfully tithed produce"}], :mechanisms [{:kind :rashei-tevot, :phrase "די מחסרו אשר יחסר", :spells "דמאי"}], :frame {:text "The Talmud rules that the poor may be fed דמאי, produce from which doubtfully-titled tithes have not been removed, based on a leniency in the obligations toward the poor (Gittin 12a; see also Demai chapters 3-4 for the broader halakhic framework of feeding demai to the poor).", :sources ["Gittin 12a"]}}], :arithmetic [{:kind :other, :note "Doubled verb form (infinitive absolute) teaches intensity or repeated action", :by :selah, :ran? false} {:kind :other, :note "Defective spelling of פתח written without vav connects to the sixth day", :by :selah, :ran? false} {:kind :masorah, :count 3, :occurrences ["פתח תפתח" "פתוח תפתח" "נפתחו שערי ארצך"], :by :selah, :located [{:phrase "פתח תפתח", :refs ["Deuteronomy 15:8" "Deuteronomy 15:11"], :n 2, :lens :exact} {:phrase "פתוח תפתח", :refs ["Deuteronomy 15:8" "Deuteronomy 15:11"], :n 2, :lens :plene-insensitive} {:phrase "נפתחו שערי ארצך", :refs ["Nahum 3:13"], :n 1, :lens :exact}]} {:kind :rashei-tevot, :phrase "די מחסרו אשר יחסר", :spells "דמאי", :letters ["ד" "מ" "א" "י"], :by :selah, :order :in-order}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 15, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:36:54.467023628Z", :model "glm-5.2"}