{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "הוצאת ממצרים", :translit "hotzati mimitzrayim", :gloss "You brought out from Egypt"} {:he "מהעיר צוען", :translit "me'ir tzo'an", :gloss "from the city of Zoan"} {:he "מארץ מצרים", :translit "me'eretz mitzrayim", :gloss "from the land of Egypt"}], :mechanisms [{:kind :other, :note "Reads ממצרים as מן-מצר צוען, 'from Metzar-Zoan,' distinguishing it from מארץ מצרים"}], :frame {:text "Zoan (Tanis) is identified as a major city of Egypt. Isaiah 19:11, 13 refers to the princes of Zoan as Egypt's counselors, and Ezekiel 30:14 prophesies destruction there. Psalms 78:12, 43 notes that God performed wonders 'in the field of Zoan,' locating the Exodus narrative there.", :sources ["Isaiah 19:11" "Isaiah 19:13" "Ezekiel 30:14" "Psalms 78:12" "Psalms 78:43"]}}], :arithmetic [{:kind :other, :note "Reads ממצרים as מן-מצר צוען, 'from Metzar-Zoan,' distinguishing it from מארץ מצרים", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 9, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:35:26.929836399Z", :model "glm-5.2"}