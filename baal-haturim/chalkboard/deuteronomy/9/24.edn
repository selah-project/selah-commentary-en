{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "ממרים הייתם", :translit "mmerim hayitem", :gloss "rebellious you were"} {:he "ממרים", :translit "mmerim", :gloss "rebellious"}], :mechanisms [{:kind :other, :note "Verse phrase begins and ends with the letter mem (מ...ם), framing all forty years of wilderness rebellion."}], :frame {:text "The Israelites' forty-year wilderness journey is traced to their rebellion at Sinai; Moses recalls this prolonged stubbornness in Deuteronomy 9:24, and earlier rabbinic tradition counts exactly forty years from the Exodus to the plains of Moab (Seder Olam Rabbah 9).", :sources ["Deuteronomy 9:24" "Seder Olam Rabbah 9"]}}], :arithmetic [{:kind :other, :note "Verse phrase begins and ends with the letter mem (מ...ם), framing all forty years of wilderness rebellion.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 9, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:35:29.780915427Z", :model "glm-5.2"}