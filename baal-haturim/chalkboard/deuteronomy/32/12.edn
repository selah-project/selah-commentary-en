{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "ינחנו", :translit "yenachenu", :gloss "He guides him"} {:he "בדד ינחנו", :translit "badad yenachenu", :gloss "alone He guides him"} {:he "מתן אדם ירחיב לו ולפני גדולים ינחנו", :translit "matan adam yarchiv lo u'lifnei gedolim yenachenu", :gloss "a man's gift enlarges for him, and before great ones He guides him"} {:he "בדד", :translit "badad", :gloss "alone"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["בדד ינחנו" "מתן אדם ירחיב לו ולפני גדולים ינחנו"]} {:kind :other, :note "Merits of charity: a person's gift makes room for him and gains him access before great ones."}], :frame {:text "The verse מתן אדם ירחיב לו ולפני גדולים ינחנו (Proverbs 18:16) describes how a gift gains a person entry before great ones. The Sages apply this principle to charity (tzedakah), teaching that giving charity delivers a person from death, as stated in Proverbs 10:2 and expounded in Bava Batra 10a. By linking the two occurrences of ינחנו, Ba'al HaTurim reads the Proverbs verse as a promise: one who gives charity is personally guided by HaShem.", :sources ["Proverbs 18:16" "Proverbs 10:2" "Bava Batra 10a"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["בדד ינחנו" "מתן אדם ירחיב לו ולפני גדולים ינחנו"], :by :selah, :located [{:phrase "בדד ינחנו", :refs ["Deuteronomy 32:12"], :n 1, :lens :exact} {:phrase "מתן אדם ירחיב לו ולפני גדולים ינחנו", :refs ["Proverbs 18:16"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Merits of charity: a person's gift makes room for him and gains him access before great ones.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:52.444000390Z", :model "glm-5.2"}