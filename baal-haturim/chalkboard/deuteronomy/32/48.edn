{:tier :glm-5.2, :verse 48, :comments [{:quotes [{:he "וידבר ה' אל משה בעצם", :translit "va-yedabber Hashem el Moshe be-etzem", :gloss "And YHWH spoke to Moses on that very day"} {:he "עשרה דסמיכי בלא לאמר", :translit "asarah de-samikhei bela leimor", :gloss "ten cases of juxtaposition without saying"} {:he "כנגד י' דברות", :translit "keneged y' dibrot", :gloss "corresponding to the Ten Commandments"}], :mechanisms [{:kind :masorah, :count 10, :occurrences ["סמיכי בלא לאמר"]} {:kind :other, :note "Ten instances of divine speech introduced by juxtaposition without לאמר correspond to the Ten Commandments."}], :frame {:text "The phrase בעצם היום הזה, 'on that very day,' appears in ten contexts where God commands or acts with unmistakable immediacy; these are enumerated in a baraita at Megillah 10b. The tradition of counting ten occasions where divine speech uses וידבר in juxtaposition without the word לאמר reflects a broader rabbinic method of finding structural correspondences to the Ten Commandments given at Sinai (Exodus 20:2–14).", :sources ["Megillah 10b" "Exodus 20:2–14"]}}], :arithmetic [{:kind :masorah, :count 10, :occurrences ["סמיכי בלא לאמר"], :by :selah, :located [{:phrase "סמיכי בלא לאמר", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Ten instances of divine speech introduced by juxtaposition without לאמר correspond to the Ten Commandments.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:41:07.092475855Z", :model "glm-5.2"}