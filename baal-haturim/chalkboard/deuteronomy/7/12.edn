{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "והיה עקב", :translit "vehayah ekev", :gloss "and it shall be, because"} {:he "היום לעשותם", :translit "hayom la'asotam", :gloss "today to do them"} {:he "עקב", :translit "ekev", :gloss "because / heel / end"} {:he "בעקב", :translit "ba'ekev", :gloss "at the end"} {:he "בשמרם עקב רב", :translit "b'shomram ekev rav", :gloss "if you keep them, great is the reward"} {:he "רב טובך אשר צפנת", :translit "rav tuvcha asher tzafanta", :gloss "great is Your good that You have stored"} {:he "עקב עשה תורתך קבע", :translit "ekev aseh toratecha keva", :gloss "because: make your Torah fixed"}], :mechanisms [{:kind :notarikon, :word "עקב", :expansion ["עקב עשה תורתך קבע"]} {:kind :other, :note "Word-count link between Deut 7:12 and the Ten Commandments on the principle that adjacent verses interpret each other"}], :frame {:text "The preceding verse (Deut 7:11) ends with היום לעשותם, and Deut 7:12 opens with והיה עקב, signaling that observance is for today while reward comes afterward (Sifrei Devarim 41; Rashi on Deut 7:12). The phrase בשמרם עקב רב derives from Deuteronomy 7:12 itself. The exhortation to make Torah study קבע reflects the idiom established in Shabbat 31a.", :sources ["Deut 7:11" "Deut 7:12" "Sifrei Devarim 41" "Rashi on Deut 7:12" "Shabbat 31a"]}} {:quotes [{:he "המשפטים", :translit "hamishpatim", :gloss "the laws"} {:he "תשמעון ושמרתם ועשיתם", :translit "tishme'un ush'martem va'asitem", :gloss "you shall hear and keep and do"} {:he "מקרא משנה תלמוד", :translit "mikra mishnah talmud", :gloss "Scripture, Mishnah, Talmud"} {:he "ושמר ה' אלהיך לך", :translit "veshamar Hashem Elokecha lach", :gloss "and the Lord your God will keep for you"} {:he "עקב אשר שמע אברהם בקולי וישמור", :translit "ekev asher shama Avraham bekoli veyishmor", :gloss "because Abraham listened to My voice and kept"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["תשמעון" "ושמרתם" "ועשיתם"]} {:kind :other, :note "Peh-alef doubled spelling