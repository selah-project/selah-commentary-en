{:tier :glm-5.2, :verse 26, :comments [{:quotes [{:he "כי חרם הוא", :translit "ki cherem hu", :gloss "for it is a ban"} {:he "כל המצוה", :translit "kol ha-mitzvah", :gloss "the whole commandment"} {:he "חרם", :translit "cherem", :gloss "ban"} {:he "רמ״ח", :translit "ramach", :gloss "248"} {:he "רמ״ח איבריו", :translit "ramach eivarav", :gloss "his 248 limbs"} {:he "רחם", :translit "racham", :gloss "womb / compassion"} {:he "ברוגז רחם תזכור", :translit "be-rogaz racham tizkor", :gloss "In wrath, remember mercy"}], :mechanisms [{:kind :gematria, :a "חרם", :b "רמ״ח"} {:kind :other, :note "Transposition of letters חרם → רחם symbolizes transformation from punishment to mercy through repentance."}], :frame {:text "The phrase ברוגז רחם תזכור is from Habakkuk 3:2. The idea that retribution is exacted measure-for-measure through the offender's own limbs draws on the principle articulated at Mishnah Makkot 3:15 and developed in Shabbat 105b, where the body that sinned receives the punishment. The larger rabbinic principle that one who violates a single prohibition is regarded as if he violated the entire Torah appears at Kiddushin 39b and is linked to the concept of an עדות, a comprehensive testimony, at Shavuot 29a.", :sources ["Habakkuk 3:2" "Mishnah Makkot 3:15" "Shabbat 105b" "Kiddushin 39b" "Shavuot 29a"]}}], :arithmetic [{:kind :gematria, :a "חרם", :a-value 248, :b "רמ״ח", :b-value 248, :lens :standard, :by :selah, :equal? true} {:kind :other, :note "Transposition of letters חרם → רחם symbolizes transformation from punishment to mercy through repentance.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 7, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:35:10.409255396Z", :model "glm-5.2"}