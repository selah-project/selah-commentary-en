{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "ובקומך", :translit "u-v'komekha", :gloss "and when you rise up"} {:he "תגין על הקו\"ף", :translit "tagin al ha-qof", :gloss "tagin on the qof"} {:he "ק' ברכות", :translit "k' berakhot", :gloss "100 blessings"} {:he "צ\"ח קללות", :translit "tza\"ch klalot", :gloss "98 curses"} {:he "כל חלי וכל מכה", :translit "kol chali v'chol makkah", :gloss "every illness and every plague"}], :mechanisms [{:kind :other, :note "Tagin drawn above the letter qof mark it for special interpretation."} {:kind :gematria, :a "ק", :b "ק' ברכות"} {:kind :gematria, :a "ק", :b "צ\"ח קללות"} {:kind :sofei-tevot, :phrase "כל חלי וכל מכה", :spells "כחך"}], :frame {:text "The duty to recite 100 blessings daily is anchored in Deuteronomy 10:12 — \"What does Hashem ask of you\" (מה יהוה אלהיך שואל מעמך), where שואל is read as שואל = 100 (Menahot 43b). The 98 curses are those in the admonition of Deuteronomy 28 (Deuteronomy 28:15–68). The Talmud states that if one answers Amen to a blessing, it is as though he said the blessing himself, enabling completion of the daily quota (Berakhot 53a).", :sources ["Deuteronomy 10:12" "Menahot 43b" "Deuteronomy 28:15-68" "Berakhot 53a"]}}], :arithmetic [{:kind :other, :note "Tagin drawn above the letter qof mark it for special interpretation.", :by :selah, :ran? false} {:kind :gematria, :a "ק", :a-value 100, :b "ק' ברכות", :b-value 728, :lens :standard, :by :selah, :equal? false} {:kind :gematria, :a "ק", :a-value 100, :b "צ\"ח קללות", :b-value 664, :lens :standard, :by :selah, :equal? false} {:kind :sofei-tevot, :phrase "כל חלי וכל מכה", :spells "כחך", :letters ["ל" "י" "ל" "ה"], :by :selah, :order :mismatch}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 6, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:34:50.133397888Z", :model "glm-5.2"}