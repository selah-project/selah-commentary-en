{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "שמח", :translit "simach", :gloss "rejoice"} {:he "שמח זבולון", :translit "simach zevulun", :gloss "rejoice, Zebulun"} {:he "שמח בחור", :translit "simach bachur", :gloss "rejoice, young man"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["שמח זבולון" "שמח בחור"]}], :frame {:text "Zebulun engaged in maritime commerce while Issachar studied Torah, and the two tribes maintained a partnership: Zebulun supported Issachar financially and shared in the reward of Torah study (Genesis Rabbah 99:9; Genesis 49:13, Deuteronomy 33:18–19). Because Zebulun's merchants traveled trade routes, their young men developed strength and vigor.", :sources ["Genesis Rabbah 99:9" "Genesis 49:13" "Deuteronomy 33:18-19"]}} {:quotes [{:he "באהליך", :translit "b'ohalecha", :gloss "in your tents"} {:he "אל תשכן באהליך עולה", :translit "al tishkon b'ohalecha avlah", :gloss "let not wrongdoing dwell in your tents"} {:he "תשכן", :translit "tishkon", :gloss "it shall dwell"} {:he "תורה", :translit "torah", :gloss "Torah"} {:he "שטר", :translit "shetar", :gloss "document"} {:he "כתובים", :translit "ktuvim", :gloss "Writings"} {:he "נביאים", :translit "nevi'im", :gloss "Prophets"} {:he "שטר פרוע", :translit "shetar parua", :gloss "a defaulted document"} {:he "בני יששכר היו יושבי אוהלים ועוסקים בתורה", :translit "bnei yissachar hayu yoshvei ohlim v'oskim b'torah", :gloss "the children of Issachar were dwellers in tents and engaged in Torah"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["דין" "ואידך אל תשכן באהליך עולה"]} {:kind :notarikon, :word "תשכן", :expansion ["תורה" "שטר" "כתובים" "נביאים"]}], :frame {:text "The second occurrence of באהליך is אל תשכן באהליך עולה (Psalms 101:7... actually Job 11:14). The notarikon תשכן expands to תורה שטר כתובים נביאים, warning that anyone who neglects these four in his home brings wrongdoing to dwell there. The phrase שטר פרוע recalls the Talmudic dictum that one who lingers at home is compared to a defaulted document and an uncorrected scroll (Shabbat 31a). The tribe of Issachar were known as dwellers in tents engaged in Torah study (Genesis 49:14–15; 1 Chronicles 12:32), so Moses warns them not to let wrongdoing dwell in their tents.", :sources ["Job 11:14" "Shabbat 31a" "Genesis 49:14-15" "1 Chronicles 12:32"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["שמח זבולון" "שמח בחור"], :by :selah, :located [{:phrase "שמח זבולון", :refs ["Deuteronomy 33:18"], :n 1, :lens :plene-insensitive} {:phrase "שמח בחור", :refs ["Ecclesiastes 11:9"], :n 1, :lens :exact}]} {:kind :masorah, :count 2, :occurrences ["דין" "ואידך אל תשכן באהליך עולה"], :by :selah, :located [{:phrase "דין", :refs ["Deuteronomy 17:8" "Jeremiah 5:28" "Jeremiah 22:16" "Psalms 76:9" "Psalms 140:13" "Proverbs 20:8" "Proverbs 22:10" "Proverbs 29:7"], :n 13, :lens :exact} {:phrase "ואידך אל תשכן באהליך עולה", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :notarikon, :word "תשכן", :expansion ["תורה" "שטר" "כתובים" "נביאים"], :initials ["ת" "ש" "כ" "נ"], :by :selah, :initials-match? true}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:41:29.862639753Z", :model "glm-5.2"}