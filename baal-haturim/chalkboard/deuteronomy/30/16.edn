{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "וברכך", :translit "u-verachekha", :gloss "and He will bless you"} {:he "לא יקשה בעיניך", :translit "lo yiksheh be-einekha", :gloss "let it not seem hard in your eyes"} {:he "וברכך ה' אלהיך", :translit "u-verachekha Hashem Elokeikha", :gloss "and YHWH your Elohim will bless you"} {:he "וברכך בארץ", :translit "u-verachekha ba-aretz", :gloss "and He will bless you in the land"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וברכך"]} {:kind :other, :note "Gezeirah shavah linking the two occurrences of וברכך: here in Deut 30:16 and in the Hebrew servant passage."}], :frame {:text "The law that a Hebrew servant is not acquired for servitude outside the Land is stated in Kiddushin 69a. The other occurrence of וברכך is at Deuteronomy 15:18, in the passage regarding the freed Hebrew servant, where the verse says וברכך ה׳ אלהיך. By linking that occurrence to this one, which explicitly says 'in the land,' Ba'al HaTurim derives that the blessing of the Hebrew servant applies specifically in the Land.", :sources ["Kiddushin 69a" "Deuteronomy 15:18" "Deuteronomy 30:16"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וברכך"], :by :selah, :located [{:phrase "וברכך", :refs ["Deuteronomy 7:13" "Deuteronomy 15:18" "Deuteronomy 24:13" "Deuteronomy 28:8" "Deuteronomy 30:16"], :n 5, :lens :exact}]} {:kind :other, :note "Gezeirah shavah linking the two occurrences of וברכך: here in Deut 30:16 and in the Hebrew servant passage.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 30, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:30.550520881Z", :model "glm-5.2"}