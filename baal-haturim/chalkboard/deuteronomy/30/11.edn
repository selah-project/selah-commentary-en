{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "כי המצוה הזאת", :translit "ki hamitzvah hazot", :gloss "For this commandment"}], :mechanisms [{:kind :other, :note "Reads 'this commandment' as referring to repentance (teshuvah), the subject of the surrounding verses."}], :frame {:text "The phrase 'this commandment' in Deuteronomy 30:11 is read as referring to repentance, based on the preceding verses Deuteronomy 30:2 and 30:10 which speak of returning to God. Repentance is said to be equivalent to all the commandments, a tradition found at Yerushalmi Pe'ah 1:1 and Makkot 3:16.", :sources ["Deuteronomy 30:2" "Deuteronomy 30:10" "Yerushalmi Pe'ah 1:1" "Makkot 3:16"]}}], :arithmetic [{:kind :other, :note "Reads 'this commandment' as referring to repentance (teshuvah), the subject of the surrounding verses.", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 30, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:23.322638748Z", :model "glm-5.2"}