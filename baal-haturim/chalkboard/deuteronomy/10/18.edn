{:tier :glm-5.2, :verse 18, :comments [{:quotes [{:he "ואוהב", :translit "v'ohav", :gloss "and He loves / and loves"} {:he "ואוהב גר", :translit "v'ohav ger", :gloss "and loves a stranger"} {:he "ואוהב חמס", :translit "v'ohav chamas", :gloss "and loves violence"} {:he "שנאה נפשו אוהב את הגר אבל האוהב חמס שנאה נפשו", :translit "s'neih nafsho oheiv et ha-ger aval ha-oheiv chamas s'neih nafsho", :gloss "his soul hates — loves the stranger, but the one who loves violence, his soul hates"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ואוהב גר" "ואוהב חמס"]}], :frame {:text "The phrase ואוהב גר appears in Deuteronomy 10:18, describing God who loves the stranger. The phrase ואוהב חמס is read as describing the wicked person who loves violence (Proverbs 13:2, אוהב חמס נפשו שונא). The Ba'al HaTurim plays on the identical opening to create a contrast: God's love is directed toward the vulnerable stranger, while the lover of violence brings hatred upon his own soul.", :sources ["Deuteronomy 10:18" "Proverbs 13:2"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ואוהב גר" "ואוהב חמס"], :by :selah, :located [{:phrase "ואוהב גר", :refs ["Deuteronomy 10:18"], :n 1, :lens :plene-insensitive} {:phrase "ואוהב חמס", :refs ["Psalms 11:5"], :n 1, :lens :plene-insensitive}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 10, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:35:42.848290507Z", :model "glm-5.2"}