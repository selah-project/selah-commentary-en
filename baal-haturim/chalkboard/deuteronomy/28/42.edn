{:tier :glm-5.2, :verse 42, :comments [{:quotes [{:he "יירש הצלצל", :translit "yirash ha'tsal'tsel", :gloss "shall inherit the cricket"} {:he "וסמיך ליה", :translit "u'smikh leih", :gloss "and adjacent to it"}], :mechanisms [{:kind :other, :note "flags adjacency of this verse to the next for interpretive purposes"}], :frame {:text "The phrase 'shall the cricket inherit' (Deuteronomy 28:42) describes locusts or crickets consuming the produce of the cursed nation. The Ba'al HaTurim's mark 'and adjacent to it' signals he will draw an interpretive connection from the immediately following verse (Deuteronomy 28:43), 'the stranger that is in your midst shall rise above you higher and higher,' reading the agricultural devastation of v. 42 as continuous with the social subjugation of v. 43.", :sources ["Deuteronomy 28:42" "Deuteronomy 28:43"]}}], :arithmetic [{:kind :other, :note "flags adjacency of this verse to the next for interpretive purposes", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:40:03.221946117Z", :model "glm-5.2"}