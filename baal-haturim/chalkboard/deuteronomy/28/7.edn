{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "ינוסו לפניך", :translit "yenusu lefanekha", :gloss "they shall flee before you"} {:he "יצו ה' אתך", :translit "yetzav HaShem etkha", :gloss "YHWH will charge you"} {:he "את הברכה באסמיך", :translit "et ha-berakhah be'asamekha", :gloss "the blessing in your barns"}], :mechanisms [{:kind :other, :note "smikhut ha-parashiyot: juxtaposition of adjacent verses to derive blessing of full storehouses from enemy flight"}], :frame {:text "The principle of smikhut ha-parashiyot (juxtaposition of adjacent passages) is a standard rabbinic method of derash found throughout Talmud and midrashic literature. In Deuteronomy 28:7 the enemy's flight is immediately followed in Deuteronomy 28:8 by the blessing upon barns and stores; Ba'al HaTurim links these adjacent verses to derive that military victory leads to material abundance. Cf. Sifrei Devarim 283 for similar juxtaposition-based readings of the blessings in Deuteronomy 28.", :sources ["Sifrei Devarim 283" "Deuteronomy 28:7" "Deuteronomy 28:8"]}}], :arithmetic [{:kind :other, :note "smikhut ha-parashiyot: juxtaposition of adjacent verses to derive blessing of full storehouses from enemy flight", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-13T00:34:05.049725949Z", :model "glm-5.2"}