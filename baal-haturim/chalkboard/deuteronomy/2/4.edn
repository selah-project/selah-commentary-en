{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "וייראו מכם", :translit "v'yira'u mikhem", :gloss "and they will fear you"} {:he "בשני יודי״ן", :translit "bishnei yudin", :gloss "with two yods"} {:he "בשביל י״ ברכות", :translit "b'shivil y' berakhot", :gloss "on account of ten blessings"} {:he "שנתברך יעקב", :translit "shenitbarakh Ya'akov", :gloss "with which Jacob was blessed"}], :mechanisms [{:kind :other, :note "Word וייראו written with two yods instead of one; extra yod alludes to ten blessings of Jacob"}], :frame {:text "The Ba'al HaTurim notes that the word וייראו is written with two yods (וייראו) rather than the single yod expected in standard spelling (ויראו). He links this orthographic feature to the ten blessings Jacob received. The number ten corresponds to the numerical value of the letter yod (י = 10), so the extra yod alludes to those ten blessings.", :sources ["Deuteronomy 2:4"]}}], :arithmetic [{:kind :other, :note "Word וייראו written with two yods instead of one; extra yod alludes to ten blessings of Jacob", :by :selah, :ran? false}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 2, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:33:30.316202714Z", :model "glm-5.2"}