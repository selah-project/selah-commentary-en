{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "תקימו", :translit "takimu", :gloss "you shall set up"} {:he "תקימו את האבנים", :translit "takimu et ha-avanim", :gloss "you shall set up the stones"} {:he "ופסל ומצבה לא תקימו", :translit "u-pesel u-matzeivah lo takimu", :gloss "and a sculptured stone and a pillar you shall not set up"} {:he "לא תקימו", :translit "lo takimu", :gloss "you shall not set up"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["תקימו את האבנים" "ופסל ומצבה לא תקימו"]}], :frame {:text "The word תקימו appears in the Torah exactly twice: once as a positive command at Deuteronomy 27:4 — תקימו את האבנים, 'you shall set up the stones' — and once as a negative command at Leviticus 26:1 — ופסל ומצבה לא תקימו, 'a sculptured stone and a pillar you shall not set up.' Ba'al HaTurim reads this verbal correspondence as a divine juxtaposition: the very root used to prohibit pagan monuments is repurposed to command the setting up of the stones at Mount Ebal, creating a literary antithesis between forbidden and obligatory erection of stones.", :sources ["Deuteronomy 27:4" "Leviticus 26:1"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["תקימו את האבנים" "ופסל ומצבה לא תקימו"], :by :selah, :located [{:phrase "תקימו את האבנים", :refs ["Deuteronomy 27:4"], :n 1, :lens :exact} {:phrase "ופסל ומצבה לא תקימו", :refs ["Leviticus 26:1"], :n 1, :lens :exact}]}], :book :deuteronomy, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:39:38.062029134Z", :model "glm-5.2"}