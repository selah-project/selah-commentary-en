{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "ויעמדהו", :translit "v'ya'amideihu", :gloss "and he stood him"} {:he "ויעמדהו לפני אלעזר הכהן", :translit "v'ya'amideihu lifnei el'azar ha-kohen", :gloss "and he stood him before Eleazar the priest"} {:he "חסרים", :translit "chaserim", :gloss "defective"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויעמדהו" "ויעמדהו לפני אלעזר הכהן"]} {:kind :other, :note "Both occurrences spelled defective (חסרים) without vav; incompleteness of physical standing mirrored in defective spelling."}], :frame {:text "In Numbers 27:23, Moses stands Joshua before Eleazar and the congregation to commission him as leader. Midrash Tanchuma records that Joshua was distressed at being appointed leader during Moses' lifetime, and Moses had to encourage and support him (Midrash Tanchuma, Pinchas 11). Jacob's old age when brought before Pharaoh is established at Genesis 47:9, where Jacob states he is 130 years old. Ba'al HaTurim reads the defective spelling of 'stood him' in both verses as reflecting that in each case the person's standing was physically or emotionally incomplete.", :sources ["Numbers 27:23" "Genesis 47:9" "Midrash Tanchuma Pinchas 11"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויעמדהו" "ויעמדהו לפני אלעזר הכהן"], :by :selah, :located [{:phrase "ויעמדהו", :refs ["Genesis 47:7" "Numbers 27:22"], :n 2, :lens :exact} {:phrase "ויעמדהו לפני אלעזר הכהן", :refs ["Numbers 27:22"], :n 1, :lens :exact}]} {:kind :other, :note "Both occurrences spelled defective (חסרים) without vav; incompleteness of physical standing mirrored in defective spelling.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 47, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:51.425938663Z", :model "glm-5.2"}