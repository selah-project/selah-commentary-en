{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "הא", :translit "h-alef", :gloss "behold (with definite article prefix)"} {:he "הא לכם זרע", :translit "ha lakhem zera", :gloss "Behold, seed for you"} {:he "ונתתם חמישית לפרעה", :translit "u-netatem chamishit le-far'oh", :gloss "and you shall give a fifth to Pharaoh"} {:he "הא דרכך בראש נתתי", :translit "ha darkhekh ba-rosh natati", :gloss "Behold, I have set you for a head"} {:he "ואל תחמול על זקן ובחור ובתולה וטף ונשים", :translit "ve-al techmol al zaken u-vachur u-vetulah ve-taf ve-nashim", :gloss "and do not spare old man, young man, virgin, child, and women"} {:he "הא כדי פרזלא דהבא כספא חספא ונחשא", :translit "ha kadei barzela de-hava kespa haspa ve-nachasha", :gloss "behold, an iron cauldron; gold, silver, clay, and bronze"} {:he "הרי חמשה", :translit "harei chamishah", :gloss "behold, five"} {:he "הרי חמשה דברים", :translit "harei chamishah devarim", :gloss "behold, five things"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["הא לכם זרע"]} {:kind :other, :note "הא לכם זרע parallels ונתתם חמישית לפרעה — the word זרע ('seed') corresponds to חמישית ('a fifth'): the numerical value of זרע equals a fifth of the value of ונתתם לפרעה."} {:kind :other, :note "הא דרכך בראש נתתי parallels ואל תחמול על זקן ובחור ובתולה וטף ונשים — the numerical value of the letters הא equals that of the five items listed (זקן ובחור ובתולה וטף ונשים), hence 'behold, five.'"} {:kind :other, :note "הא כדי פרזלא דהבא כספא חספא ונחשא parallels the four materials listed (gold, silver, clay, bronze) — the numerical value of הא equals that of the word כדי, yielding 'five things' total."}], :frame {:text "The particle הא (with the definite-article prefix) occurs exactly three times in the Torah. The verse הא לכם זרע (Genesis 47:23) is one of these three.", :sources ["Genesis 47:23"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["הא לכם זרע"], :by :selah, :located [{:phrase "הא לכם זרע", :refs ["Genesis 47:23"], :n 1, :