{:tier :glm-5.2, :verse 14, :comments [{:quotes [{:he "ביתה פרעה", :translit "beita par'o", :gloss "to the house of Pharaoh"} {:he "ב' במסורה הכא ואידך ערוב כבד ביתה פרעה", :translit "b' b'masora hacha v'eidch arbeh kaved beita par'o", :gloss "two in the Masorah here and the other locusts heavy to the house of Pharaoh"} {:he "הכא", :translit "hacha", :gloss "here"} {:he "ואידך", :translit "v'eidch", :gloss "and the other"} {:he "ערוב כבד ביתה פרעה", :translit "arbeh kaved beita par'o", :gloss "locusts heavy to the house of Pharaoh"} {:he "בשביל שלא זכר הטובות שעשה לו יוסף", :translit "b'shevil shelo zachar ha'tovot she'asa lo yosef", :gloss "because he did not remember the good things that Joseph did for him"} {:he "והביא כל הכסף לביתו", :translit "v'heivi kol ha'kesef l'veito", :gloss "and he brought all the money to his house"} {:he "על זה בא העדוב תחילה ביתה פרעה", :translit "al zeh ba ha'arbeh techila beita par'o", :gloss "on this came the locusts first to the house of Pharaoh"} {:he "ד\"א", :translit "da'amar", :gloss "another interpretation"} {:he "לומר כמו שמכניסין הכסף חדר בחדר", :translit "l'omar kmo she'machnisin ha'kesef cheder b'cheder", :gloss "to say just as money is brought room within room"} {:he "כך בא הערוב בחדר פרעה שהיה לפנים חדר בחדר", :translit "kach ba ha'arbeh b'cheder par'o she'haya lifnim cheder b'cheder", :gloss "so the locusts came into Pharaoh's chamber which was inside room within room"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ביתה פרעה" "ערוב כבד ביתה פרעה"]}], :frame {:text "The phrase ביתה פרעה occurs twice in Scripture: at Genesis 47:14 (Joseph gathering money) and at Exodus 10:6 (ערוב כבד ביתה פרעה, the locusts filling Pharaoh's house). Ba'al HaTurim links the two via measure-for-measure: since Pharaoh failed to acknowledge Joseph's goodness and benefited from all the money brought into his house (Genesis 47:14), the locusts invaded that very house first (Exodus 10:6). The spatial midrash reads Pharaoh's chamber as a חדר בחדר, 'room within a room,' mirroring how money was stored in nested chambers.", :sources ["Genesis 47:14" "Exodus 10:6"]}} {:quotes [{:he "ביתה", :translit "beita", :gloss "to the house"} {:he "תרגום מלגו", :translit "targum m'ligo", :gloss "Targum m'ligo"}], :mechanisms [{:kind :other, :note "Targum Onkelos renders ביתה as לבית, 'to the house.'"}], :frame {:text "Targum Onkelos on Genesis 47:14 renders ביתה as לבית (to the house), reflecting the standard Aramaic translation of the locative heh suffix.", :sources ["Genesis 47:14"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ביתה פרעה" "ערוב כבד ביתה פרעה"], :by :selah, :located [{:phrase "ביתה פרעה", :refs ["Genesis 47:14" "Exodus 8:20"], :n 2, :lens :exact} {:phrase "ערוב כבד ביתה פרעה", :refs ["Exodus 8:20"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Targum Onkelos renders ביתה as לבית, 'to the house.'", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 47, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:59.343908638Z", :model "glm-5.2"}