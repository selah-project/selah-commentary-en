{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "לא ידעה", :translit "lo yeda'ah", :gloss "he did not know her"} {:he "והמלך לא ידעה", :translit "veha-melech lo yeda'ah", :gloss "and the king did not know her"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לא ידעה" "והמלך לא ידעה"]} {:kind :other, :note "Gezerah shavah: the repeated phrase לא ידעה links the two verses so legal categories transfer."}], :frame {:text "The phrase בין כדרכה בין שלא כדרכה — 'whether in the natural manner or not in the natural manner' — is the tannaitic definition of virginity used to determine the tort of defamation (tashlumei bogrut) in Ketubot 39a. By reading that legal framework onto Genesis 24:16 via the phrase לא ידעה, Rivkah is affirmed as a virgin in the full halakhic sense. The other occurrence, והמלך לא ידעה, is 1 Kings 1:4.", :sources ["Ketubot 39a" "1 Kings 1:4"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לא ידעה" "והמלך לא ידעה"], :by :selah, :located [{:phrase "לא ידעה", :refs ["Genesis 24:16" "Judges 11:39" "Judges 21:12" "1 Kings 1:4" "Hosea 2:10"], :n 5, :lens :exact} {:phrase "והמלך לא ידעה", :refs ["1 Kings 1:4"], :n 1, :lens :exact}]} {:kind :other, :note "Gezerah shavah: the repeated phrase לא ידעה links the two verses so legal categories transfer.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:07:38.409606909Z", :model "glm-5.2"}