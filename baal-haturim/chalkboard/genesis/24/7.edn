{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "ישלח מלאכו", :translit "yishlach mal'acho", :gloss "He will send His angel"} {:he "כי ילך מלאכי לפניך", :translit "ki yeilech mal'achi lefanecha", :gloss "For My angel shall go before you"} {:he "ושלחתי לפניך מלאך", :translit "veshalachti lefanecha mal'ach", :gloss "And I will send an angel before you"} {:he "ב\"פ כתיב מלאכו", :translit "b'pai katuv mal'acho", :gloss "Twice is written His angel"} {:he "בהליכה ואחד בחזרה", :translit "behilchah ve'echad b'chazrah", :gloss "for the going and one for the returning"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["מלאכו"]}], :frame {:text "Eliezer requested that a designated angel accompany him both on the journey to find a bride for Isaac and on the return, as indicated by the two occurrences of מלאכו. The phrase 'For My angel shall go before you' (Exodus 32:34) describes a specific angelic guide, while 'Behold, I send an angel before you' (Exodus 23:20) introduces the covenant angel. Abraham assures Eliezer that God sends His own appointed angel (Genesis 24:7).", :sources ["Genesis 24:7" "Exodus 32:34" "Exodus 23:20"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["מלאכו"], :by :selah, :located [{:phrase "מלאכו", :refs ["Genesis 24:7" "Genesis 24:40"], :n 2, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:07:34.587102830Z", :model "glm-5.2"}