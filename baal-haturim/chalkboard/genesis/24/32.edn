{:tier :glm-5.2, :verse 32, :comments [{:quotes [{:he "ויפתח", :translit "va'yiftach", :gloss "and he opened"} {:he "ויפתח על הלוחות ידותיה", :translit "va'yiftach al ha'luchot yedoteiha", :gloss "and he opened upon the tablets their handles"} {:he "בבנין הבית", :translit "b'vinyan ha'bayit", :gloss "in the building of the house"} {:he "לשון ציור", :translit "leshon tziyyur", :gloss "language of depiction"} {:he "הגמלים של אברהם מצוירין ומסומנין ונכרים לכל", :translit "ha'gemalim shel avraham m'tzuyarin u'm'sumanin v'nakrim la'kul", :gloss "Abraham's camels were depicted, marked, and recognizable to all"} {:he "שהגמלים לא היו רועים בשדות אחרים", :translit "she'ha'gemalim lo hayu ro'im b'sadot acharim", :gloss "for camels were not grazed in other fields"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויפתח" "ויפתח על הלוחות ידותיה"]}], :frame {:text "The phrase ויפתח (Exodus 26:17) describes openings upon the לוחות — the word לוחות normally means 'tablets,' as in the two tablets of the covenant (Exodus 31:18). Ba'al HaTurim reads the rare root ידות (Exodus 26:17) as related to the marked, distinctive form of the boards in the Tabernacle, and draws an analogy to Abraham's camels: they bore a recognizable mark of their master, so that none could confuse them with another's flock. The principle that Abraham's animals were uniquely identifiable by their feeding practices, since his camels would not graze in others' fields, reflects the tradition that Abraham's household observed strict standards that set his property apart.", :sources ["Exodus 26:17" "Exodus 31:18" "Genesis 24:32"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויפתח" "ויפתח על הלוחות ידותיה"], :by :selah, :located [{:phrase "ויפתח", :refs ["Genesis 8:6" "Genesis 24:32" "Genesis 29:31" "Genesis 30:22" "Genesis 41:56" "Genesis 42:27" "Numbers 22:28" "Joshua 15:43"], :n 17, :lens :exact} {:phrase "ויפתח על הלוחות ידותיה", :refs ["1 Kings 7:36"], :n 1, :lens :plene-insensitive}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:07:48.949184577Z", :model "glm-5.2"}