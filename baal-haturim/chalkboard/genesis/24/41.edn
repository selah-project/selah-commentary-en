{:tier :glm-5.2, :verse 41, :comments [{:quotes [{:he "אז תנקה מאלתי", :translit "az tinkah me'alati", :gloss "then you shall be cleared of my oath"} {:he "משבועתי", :translit "mish'vu'ati", :gloss "from my oath"} {:he "החמיר עליהם", :translit "hich'mir aleihem", :gloss "he was stringent upon them"} {:he "אלה", :translit "alah", :gloss "oath (imprecation)"}], :mechanisms [{:kind :other, :note "Abraham added an oath to compel the servant's compliance and encourage the family's consent"}], :frame {:text "Abraham's servant is sent to find a wife for Isaac. Abraham tells him he will be cleared of his oath if the woman does not consent to return (Genesis 24:41). The Ba'al HaTurim reads Abraham's wording as deliberately forceful: by framing the mission under an oath, he increases the pressure so that the prospective bride's family will agree.", :sources ["Genesis 24:41" "Genesis 24:8"]}} {:quotes [{:he "כי תבא אל משפחתי", :translit "ki tavo el mishpachti", :gloss "when you come to my family"} {:he "ולא אל בית אבי", :translit "v'lo el beit avi", :gloss "and not to my father's house"} {:he "מבית אב", :translit "mibeit av", :gloss "from the father's house"} {:he "מבית אם", :translit "mibeit em", :gloss "from the mother's house"}], :mechanisms [{:kind :other, :note "Contrast: 'my family' is broader than 'my father's house,' permitting a match from the maternal line as well"}], :frame nil}], :arithmetic [{:kind :other, :note "Abraham added an oath to compel the servant's compliance and encourage the family's consent", :by :selah, :ran? false} {:kind :other, :note "Contrast: 'my family' is broader than 'my father's house,' permitting a match from the maternal line as well", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 24, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:07:47.218030505Z", :model "glm-5.2"}