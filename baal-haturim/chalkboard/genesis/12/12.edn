{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "יחיו", :translit "yechyu", :gloss "they will keep alive"} {:he "ואידך יחיו דגן ויפרחו כגפן", :translit "ve'idch yechyu dagan v'yifrachu chagefen", :gloss "and the other 'they will keep alive grain and blossom like a vine'"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יחיו" "יחיו דגן ויפרחו כגפן"]}], :frame {:text "The Masorah notes that the word יחיו appears exactly twice in Scripture: here in Genesis 12:12 and once more in Joel 2:22 in the phrase יחיו דגן ויפרחו כגפן. Ba'al HaTurim links the two occurrences thematically: just as the second speaks of grain and vine flourishing, so when the Egyptians 'keep alive' Sarah (Genesis 12:12), Abram will receive gifts of fields and vineyards — the bounty associated with grain and vines.", :sources ["Genesis 12:12" "Joel 2:22"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["יחיו" "יחיו דגן ויפרחו כגפן"], :by :selah, :located [{:phrase "יחיו", :refs ["Genesis 12:12" "Joshua 9:21" "Isaiah 26:14" "Isaiah 26:19" "Isaiah 38:16" "Ezekiel 20:25" "Hosea 14:8" "Zechariah 1:5"], :n 9, :lens :exact} {:phrase "יחיו דגן ויפרחו כגפן", :refs ["Hosea 14:8"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 12, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:05:31.780120190Z", :model "glm-5.2"}