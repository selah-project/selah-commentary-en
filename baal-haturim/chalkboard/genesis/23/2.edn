{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "ולבכתה", :translit "ul'vokhtah", :gloss "and to weep for her"} {:he "כ\"ף קטנה", :translit "kaf ketanah", :gloss "small kaf"} {:he "שלא בכה אלא מעט", :translit "she'lo bakhah ela me'at", :gloss "that he did not weep except a little"} {:he "לפי שזקנה היתה", :translit "l'fi she-z'kenah hay'tah", :gloss "because she was elderly"} {:he "א\"נ", :translit "o d'var acher", :gloss "or alternatively"} {:he "שהיתה כמו גורמת מיתתה", :translit "she-hay'tah k'mo gormet mitatah", :gloss "that she was like one causing her own death"} {:he "שמסרה דין", :translit "she-mas'rah din", :gloss "for she reported the judgment"} {:he "ועל כן נענשה היא תחלה", :translit "v'al ken ne'anshah hi t'chilah", :gloss "and therefore she was punished first"} {:he "והמאבד עצמו לדעת", :translit "v'ha-m'abed atzmo l'da'at", :gloss "and one who destroys oneself knowingly"} {:he "אין מספידין אותו", :translit "ein m'sap'din oto", :gloss "they do not eulogize him"}], :mechanisms [{:kind :other, :note "Small letter kaf in ולבכתה signals diminished weeping"}], :frame {:text "The Talmud rules that a suicide is not accorded eulogies (Semachot 2:1–3). Rashi on Genesis 23:2 records that Sarah died when she heard that her son had been bound on the altar, linking her death to the Akeidah narrative in Genesis 22. The tradition that the small kaf diminishes Abraham's weeping rests on the scribal observation that the kaf in ולבכתה is written smaller than normal.", :sources ["Rashi on Genesis 23:2" "Genesis 22" "Semachot 2:1"]}}], :arithmetic [{:kind :other, :note "Small letter kaf in ולבכתה signals diminished weeping", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 23, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:07:24.310216519Z", :model "glm-5.2"}