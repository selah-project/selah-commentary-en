{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "ויסעו", :translit "vayis'u", :gloss "and they journeyed"} {:he "אלה מסעי בני ישראל ויסעו", :translit "eleh masei bnei yisra'el vayis'u", :gloss "These are the journeys of the children of Israel, and they journeyed"} {:he "מטתו של יעקב", :translit "mitato shel ya'akov", :gloss "his [Jacob's] traveling-bed"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויסעו"]} {:kind :other, :note "Gezerah shavah linking two identical words across verses"}], :frame {:text "The identical word ויסעו appears twice in Scripture: once at the start of Genesis 35:5 describing Jacob's camp's departure, and once at the close of Numbers 33:1–2 in the list of Israel's wilderness journeys (אלה מסעי בני ישראל). Genesis 35:5 records that the terror of God fell upon the surrounding cities so they did not pursue Jacob's household. The wilderness standards (דגלים) are described in Numbers 2 as the tribal camps' travel formation. Ba'al HaTurim links the two occurrences to show that just as divine terror protected Jacob's camp on the road, so too the nations feared Israel's camp when it traveled in standard-formation in the wilderness.", :sources ["Genesis 35:5" "Numbers 33:1–2" "Numbers 2"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויסעו"], :by :selah, :located [{:phrase "ויסעו", :refs ["Genesis 35:5" "Genesis 35:16" "Exodus 12:37" "Exodus 13:20" "Exodus 14:15" "Exodus 16:1" "Exodus 17:1" "Exodus 19:2"], :n 64, :lens :exact}]} {:kind :other, :note "Gezerah shavah linking two identical words across verses", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 35, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:10:02.358102927Z", :model "glm-5.2"}