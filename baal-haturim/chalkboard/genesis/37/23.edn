{:tier :glm-5.2, :verse 23, :comments [{:quotes [{:he "כתנתו", :translit "k'tono", :gloss "his tunic"} {:he "ואידך קרוע את כתנתו", :translit "v'idach k'ra et k'tono", :gloss "and the other: he rent his tunic"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["כתנתו" "קרוע את כתנתו"]}], :frame {:text "The Ba'al HaTurim notes that the word כתנתו (\"his tunic\") with this exact spelling appears twice in Scripture: here in Genesis 37:23, when the brothers strip Joseph's tunic from him, and in I Samuel 15:27, where Saul rends Samuel's tunic. He links these two occurrences typologically: just as Saul tore the tunic, so too the brothers tore Joseph's tunic off him in haste, rather than removing it normally. The verse at I Samuel 15:27-28 itself uses the tearing of the tunic as a sign that the kingdom is torn from Saul.", :sources ["Genesis 37:23" "I Samuel 15:27" "I Samuel 15:28"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["כתנתו" "קרוע את כתנתו"], :by :selah, :located [{:phrase "כתנתו", :refs ["Genesis 37:23" "2 Samuel 15:32"], :n 2, :lens :exact} {:phrase "קרוע את כתנתו", :refs [], :n 0, :lens :plene-insensitive}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 37, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:10:29.234235113Z", :model "glm-5.2"}