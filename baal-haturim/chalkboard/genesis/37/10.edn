{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "ויגער", :translit "va'yiga'ar", :gloss "and he rebuked"} {:he "ויגער בים סוף ויחרב", :translit "va'yiga'ar ba'yam suf va'yecharev", :gloss "and he rebuked the sea of reeds and it dried up"} {:he "וירא ישראל", :translit "va'yar yisra'el", :gloss "and Israel saw"} {:he "ישראל סבא", :translit "yisra'el sava", :gloss "Israel the elder"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויגער" "ויגער בים סוף ויחרב"]} {:kind :other, :note "Gezerah shavah linking two occurrences of ויגער to identify the subject of the rebuke at the sea as Jacob."}], :frame {:text "The word ויגער appears twice in Scripture: once where Jacob rebukes Joseph (Genesis 37:10) and once where the sea is rebuked and dries up (Psalms 106:9 — ויגער בים סוף ויחרב). The phrase וירא ישראל ישראל סבא is an exposition on Exodus 14:31 (וירא ישראל את היד הגדולה), reading ישראל as Jacob the elder, in whose merit the sea split. This tradition is found in Bereishit Rabbah 87:7 and Shocher Tov 114:1.", :sources ["Genesis 37:10" "Psalms 106:9" "Exodus 14:31" "Bereishit Rabbah 87:7" "Shocher Tov 114:1"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויגער" "ויגער בים סוף ויחרב"], :by :selah, :located [{:phrase "ויגער", :refs ["Genesis 37:10" "Zechariah 3:2" "Psalms 106:9"], :n 3, :lens :exact} {:phrase "ויגער בים סוף ויחרב", :refs ["Psalms 106:9"], :n 1, :lens :exact}]} {:kind :other, :note "Gezerah shavah linking two occurrences of ויגער to identify the subject of the rebuke at the sea as Jacob.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 37, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:10:20.268458858Z", :model "glm-5.2"}