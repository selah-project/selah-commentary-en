{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "שנתים אחר", :translit "shnatayim achar", :gloss "two years after"} {:he "ב' דסמיכי", :translit "beit dismikhei", :gloss "two of juxtapositions"} {:he "שנתים לפני הרעש", :translit "shnatayim lifnei hara'ash", :gloss "two years before the earthquake"} {:he "שגם במבול היה רעש גדול", :translit "shegam bamabul hayah ra'ash gadol", :gloss "for also in the Flood there was a great earthquake"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["שנתים אחר" "שנתים לפני הרעש"]}], :frame {:text "The Masorah notes rare juxtapositions of specific phrases. Ba'al HaTurim identifies that the phrase 'two years after' (Genesis 11:10) is one of only two occurrences of this type of temporal phrase in Scripture, the other being 'two years before the earthquake' (Amos 1:1). He then connects them thematically: just as the latter references an earthquake, the generation of the Flood also experienced a great earthquake, as the earth itself was shaken during the Flood (Genesis 7:11).", :sources ["Genesis 11:10" "Genesis 7:11" "Amos 1:1"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["שנתים אחר" "שנתים לפני הרעש"], :by :selah, :located [{:phrase "שנתים אחר", :refs ["Genesis 11:10"], :n 1, :lens :exact} {:phrase "שנתים לפני הרעש", :refs ["Amos 1:1"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 11, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:05:23.407794261Z", :model "glm-5.2"}