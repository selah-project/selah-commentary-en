{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "ויעבירם", :translit "va'ya'avirem", :gloss "and he brought them across"} {:he "ב' במסורה", :translit "bet be-masorah", :gloss "two in the Masorah"} {:he "ואידך ויעבירם ביבשה", :translit "ve-idch va'ya'avirem be-yabashah", :gloss "and the other, 'and he brought them across on dry land'"} {:he "מלמד שנבקע לו מעבר יבוק ועבר ביבשה", :translit "m'lamed she-nivka lo me'ever yabbok va'avar be-yabashah", :gloss "teaches that the Jabbok crossing split open for him and he crossed on dry ground"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויעבירם" "ויעבירם ביבשה"]} {:kind :other, :note "The rare double occurrence of ויעבירם drives the midrashic inference that Jacob crossed the Jabbok on dry ground, just as at the sea (Exodus 14:22) and the Jordan (Joshua 3:17)."}], :frame {:text "The Ba'al HaTurim reads the Masoretic pairing of two identical forms of ויעבירם as carrying narrative content: the word that appears here at the Jabbok also appears in a construction associated with dry-land crossing. This aligns with the pattern of miraculous crossings described at the Red Sea, where Israel went into the sea on dry ground (Exodus 14:22, וַיָּבֹאוּ בְנֵי־יִשְׂרָאֵל בְּתוֹךְ הַיָּם בַּיַּבָּשָׁה), and at the Jordan in Joshua 3:17.", :sources ["Exodus 14:22" "Joshua 3:17"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויעבירם" "ויעבירם ביבשה"], :by :selah, :located [{:phrase "ויעבירם", :refs ["Psalms 78:13"], :n 1, :lens :exact} {:phrase "ויעבירם ביבשה", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "The rare double occurrence of ויעבירם drives the midrashic inference that Jacob crossed the Jabbok on dry ground, just as at the sea (Exodus 14:22) and the Jordan (Joshua 3:17).", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 32, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:09:48.065197232Z", :model "glm-5.2"}