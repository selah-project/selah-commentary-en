{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "בהבראם", :translit "beh'ibaram", :gloss "when they were created"} {:he "באברהם", :translit "be'avraham", :gloss "in Abraham"}], :mechanisms [{:kind :other, :note "Letters of בהבראם rearranged to spell באברהם"}], :frame {:text "The rearrangement of the letters of בהבראם to spell באברהם conveys that the world was created in the merit of Abraham. Genesis Rabbah 12:9 states that the Holy One built worlds and destroyed them until He created this one, saying, 'This one pleases Me, those did not please Me.' The tradition that creation was in the merit of the patriarchs is developed in Genesis Rabbah 12:9 and further in Midrash Tanchuma, which associates the founding of the world with Abraham's merit.", :sources ["Genesis Rabbah 12:9" "Midrash Tanchuma Bereshit 1"]}} {:quotes [{:he "ארץ ושמים", :translit "eretz v'shamayim", :gloss "earth and heaven"} {:he "הודו על ארץ ושמים", :translit "hodu al eretz v'shamayim", :gloss "they acknowledged upon earth and heaven"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ארץ ושמים"]}], :frame {:text "The Masorah notes that the exact phrase ארץ ושמים with earth mentioned before heaven appears only twice in Scripture. The reversal of the standard order שמים וארץ (heaven and earth) as found throughout Genesis 1 draws interpretive attention. Psalms 148:7–12 calls upon creatures of the earth first and then of the heavens to praise God, a progression reflected in the verse הודו על ארץ ושמים.", :sources ["Psalms 148:7-12"]}}], :arithmetic [{:kind :other, :note "Letters of בהבראם rearranged to spell באברהם", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["ארץ ושמים"], :by :selah, :located [{:phrase "ארץ ושמים", :refs ["Genesis 2:4" "Psalms 148:13"], :n 2, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 2, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:03:55.812235850Z", :model "glm-5.2"}