{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "יפרד", :translit "yipared", :gloss "it parts"} {:he "ודל מרעהו יפרד", :translit "ve-dal me-re'ehu yipared", :gloss "and one poor from his neighbor departs"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יפרד" "יפרד"]}], :frame {:text "The rare word יפרד appears exactly twice in Scripture — here in Genesis 2:10 describing the river parting, and in Proverbs 19:4 describing a poor man departing from his neighbor. Ba'al HaTurim links the two occurrences typologically: just as Adam was separated from the Garden of Eden after his sin (Genesis 3:23-24), so the verse in Proverbs describes one who lacks (is poor in) commandments being separated, reading the Garden's river as an omen of Adam's eventual exile.", :sources ["Genesis 2:10" "Proverbs 19:4" "Genesis 3:23-24"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["יפרד" "יפרד"], :by :selah, :located [{:phrase "יפרד", :refs ["Genesis 2:10" "Proverbs 19:4"], :n 2, :lens :exact} {:phrase "יפרד", :refs ["Genesis 2:10" "Proverbs 19:4"], :n 2, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 2, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:03:58.071143643Z", :model "glm-5.2"}