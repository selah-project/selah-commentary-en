{:tier :glm-5.2, :verse 12, :comments [{:quotes [{:he "הרבו", :translit "harbu", :gloss "multiply greatly"} {:he "הרבו לפשוע", :translit "harbu lafshoa", :gloss "they multiplied to rebel"} {:he "בע\"א", :translit "b'avodah zarah", :gloss "in idolatry"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הרבו" "הרבו לפשוע"]} {:kind :other, :note "Gezarah shavah linking הרבו here to הרבו לפשוע at Gilgal"}], :frame {:text "Joshua 5 records that Israel camped at Gilgal after crossing the Jordan. Joshua 9:6 and 9:15 record that the Gibeonites secured a treaty with Israel, and the Targum on Hosea 9:15 and Hosea 12:12 interprets Gilgal as a site of ingratitude and covenant violation. Hosea 9:15 states 'all their wickedness is in Gilgal, for there I hated them.' The midrashic tradition reads הרבו לפשוע at Gilgal as describing intensified rebellion, which Ba'al HaTurim maps onto the rebellion of Dinah's brothers in Genesis 34.", :sources ["Joshua 5:9" "Joshua 9:6" "Joshua 9:15" "Hosea 9:15" "Hosea 12:12"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["הרבו" "הרבו לפשוע"], :by :selah, :located [{:phrase "הרבו", :refs ["Genesis 34:12" "Ezekiel 22:25" "Amos 4:4" "1 Chronicles 4:27" "1 Chronicles 7:4" "1 Chronicles 23:11" "2 Chronicles 31:5" "2 Chronicles 36:14"], :n 8, :lens :exact} {:phrase "הרבו לפשוע", :refs ["Amos 4:4"], :n 1, :lens :plene-insensitive}]} {:kind :other, :note "Gezarah shavah linking הרבו here to הרבו לפשוע at Gilgal", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 34, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:10:03.579929458Z", :model "glm-5.2"}