{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "ותלד עדה", :translit "ve-teled adah", :gloss "And Adah bore"} {:he "בני לאה", :translit "bnei le'ah", :gloss "sons of Leah"} {:he "בני רחל", :translit "bnei rachel", :gloss "sons of Rachel"} {:he "בניינו של עולם", :translit "binyano shel olam", :gloss "the building of the world"} {:he "בנים", :translit "banim", :gloss "sons"} {:he "בני עשו", :translit "bnei esav", :gloss "sons of Esau"} {:he "ולדות", :translit "valadot", :gloss "offspring"} {:he "ולד בהמה", :translit "valad behemah", :gloss "young of an animal"}], :mechanisms [{:kind :other, :note "Word-choice contrast: Jacob's line called בנים (sons), Esau's line called ולדות (offspring/young), a term applied to animals"}], :frame {:text "Rashi on Genesis 36:5, citing Bereshit Rabbah 82:12, notes that the children of Esau are listed with the term ולדות rather than בנים because they are compared to the young of animals. The phrase 'sons of Leah' appears at Genesis 35:23 and 'sons of Rachel' at Genesis 35:24, where the genealogy of Jacob's children is traced.", :sources ["Bereshit Rabbah 82:12" "Rashi on Genesis 36:5" "Genesis 35:23" "Genesis 35:24"]}}], :arithmetic [{:kind :other, :note "Word-choice contrast: Jacob's line called בנים (sons), Esau's line called ולדות (offspring/young), a term applied to animals", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 36, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:10:13.377170981Z", :model "glm-5.2"}