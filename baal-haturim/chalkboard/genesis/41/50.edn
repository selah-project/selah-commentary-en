{:tier :glm-5.2, :verse 50, :comments [{:quotes [{:he "וליוסף", :translit "u-l-yosef", :gloss "and to Joseph"} {:he "וליוסף יולד שני בנים בטרם", :translit "u-l-yosef yulad shnei banim beterem", :gloss "and to Joseph were born two sons before"} {:he "וליוסף אמר מבורכת ה' ארצו", :translit "u-l-yosef amar mevorachat Hashem artzo", :gloss "and of Joseph he said: blessed of the Lord be his land"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וליוסף יולד שני בנים בטרם" "וליוסף אמר מבורכת ה' ארצו"]} {:kind :other, :note "Linking two occurrences: Joseph shared the community's distress and later saw their consolation"}], :frame {:text "The Talmud states that whoever joins himself with the community in their distress merits to see the community's consolation (Ta'anit 11a). Ba'al HaTurim applies this to Joseph: the first occurrence of וליוסף describes Joseph enduring the famine alongside Egypt (Genesis 41:50), and the second (Deuteronomy 33:13) records Moses blessing Joseph's land, reflecting the consolation he merited.", :sources ["Ta'anit 11a" "Genesis 41:50" "Deuteronomy 33:13"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וליוסף יולד שני בנים בטרם" "וליוסף אמר מבורכת ה' ארצו"], :by :selah, :located [{:phrase "וליוסף יולד שני בנים בטרם", :refs ["Genesis 41:50"], :n 1, :lens :plene-insensitive} {:phrase "וליוסף אמר מבורכת ה' ארצו", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Linking two occurrences: Joseph shared the community's distress and later saw their consolation", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 41, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:11.444664558Z", :model "glm-5.2"}