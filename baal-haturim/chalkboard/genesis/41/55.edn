{:tier :glm-5.2, :verse 55, :comments [{:quotes [{:he "לכם תעשו", :translit "lakhem ta'asu", :gloss "for you, you shall do"} {:he "תעשו", :translit "ta'asu", :gloss "you shall do"}], :mechanisms [{:kind :gematria, :a "תעשו", :b "מול"}], :frame {:text "Joseph, during the years of famine in Egypt, required all who came to purchase grain to be circumcised. This understanding of Joseph's actions is found in rabbinic tradition (Genesis Rabbah 90:6; Pirkei de-Rabbi Eliezer 38), which reads his mandate that the people do as he decrees (Genesis 41:55) as a command to enter the covenant of circumcision.", :sources ["Genesis Rabbah 90:6" "Pirkei de-Rabbi Eliezer 38" "Genesis 41:55"]}}], :arithmetic [{:kind :gematria, :a "תעשו", :a-value 776, :b "מול", :b-value 76, :lens :standard, :by :selah, :equal? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 41, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:08.591223898Z", :model "glm-5.2"}