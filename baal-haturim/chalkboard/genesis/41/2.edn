{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "שבע פרות", :translit "sheva parot", :gloss "seven cows"} {:he "עגלה יפיפיה", :translit "eglah yafifyah", :gloss "fair heifer"} {:he "מצרים", :translit "mitsrayim", :gloss "Egypt"} {:he "לודים", :translit "ludim", :gloss "Ludim"} {:he "ענמים", :translit "anamim", :gloss "Anamim"} {:he "להבים", :translit "lahavim", :gloss "Lehabim"} {:he "נפתוחים", :translit "naftuchim", :gloss "Naphtuchim"} {:he "פתרוסים", :translit "patrosim", :gloss "Pathrusim"} {:he "כסלוחים", :translit "kasluchim", :gloss "Casluchim"}], :mechanisms [{:kind :other, :note "Allusion: seven cows correspond to seven nations descending from Mitzrayim plus seven nations of Canaan"}], :frame {:text "The phrase עגלה יפית is applied to Israel in Jeremiah 46:20, where Egypt is called a fair heifer. The nations listed — Ludim, Anamim, Lehabim, Naphtuchim, Pathrusim, Casluchim — are the six sons of Mitzrayim named in Genesis 10:13–14; together with their parent Mitzrayim they total seven. The seven nations of Canaan are enumerated in Deuteronomy 7:1. Isaac's blessing to Jacob in Genesis 27:28 grants plenty of grain and wine, and the famine that drives the sons of Israel to Egypt (Genesis 42:1–3) fulfills the pattern in which Canaan's descendants are sustained from Egypt's produce.", :sources ["Jeremiah 46:20" "Genesis 10:13-14" "Deuteronomy 7:1" "Genesis 27:28" "Genesis 42:1-3"]}}], :arithmetic [{:kind :other, :note "Allusion: seven cows correspond to seven nations descending from Mitzrayim plus seven nations of Canaan", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 41, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:02.280517582Z", :model "glm-5.2"}