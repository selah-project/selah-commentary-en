{:tier :glm-5.2, :verse 10, :comments [{:quotes [{:he "אחד העם", :translit "echad ha-am", :gloss "one of the people"} {:he "כי בא אחד העם", :translit "ki ba echad ha-am", :gloss "for one of the people came"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["אחד העם" "אחד העם"]}], :frame {:text "The phrase אחד העם occurs exactly twice in Scripture: here in Genesis 26:10 and in 1 Samuel 26:15, where David's interrogation of Abner references the spear taken from beside Saul's head (1 Samuel 26:12). Ba'al HaTurim applies the hermeneutic that paired phrases illuminate each other: since the Samuel passage involves a king (David, 1 Samuel 16:13), Avimelech's use of the same phrase in Genesis likewise carries royal connotations.", :sources ["Genesis 26:10" "1 Samuel 26:15" "1 Samuel 26:12" "1 Samuel 16:13"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["אחד העם" "אחד העם"], :by :selah, :located [{:phrase "אחד העם", :refs ["Genesis 26:10" "1 Samuel 26:15"], :n 2, :lens :exact} {:phrase "אחד העם", :refs ["Genesis 26:10" "1 Samuel 26:15"], :n 2, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:15.088014686Z", :model "glm-5.2"}