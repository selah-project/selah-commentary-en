{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "מצחק", :translit "m'tzachek", :gloss "laughing / sporting"} {:he "הנה יצחק מצחק", :translit "hinei yitzchak m'tzachek", :gloss "here is Isaac sporting"} {:he "אשר ילדה לאברהם מצחק", :translit "asher yaldah l'avraham m'tzachek", :gloss "whom she bore to Abraham, sport"} {:he "מצחק", :translit "m'tzachek", :gloss "sporting"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הנה יצחק מצחק" "אשר ילדה לאברהם מצחק"]} {:kind :other, :note "Gezerah shavah linking two appearances of מצחק to infer Ishmael's sin of adultery from the marital context in each verse"}], :frame {:text "The word מצחק in Genesis 21:9, in the clause אשר ילדה לאברהם מצחק, is read by the Sages as referring to illicit sexual conduct. Rashi on Genesis 21:9, citing the midrashic tradition preserved in Sanhedrin 89b, lists three sins attributed to Ishmael in his מצחק: adultery, idolatry, and murder. The term מצחק itself carries sexual connotations in Genesis 26:8, where Abimelech sees Isaac being intimate with Rebekah. By means of a gezerah shavah between the two occurrences of מצחק, Ba'al HaTurim compresses this tradition, connecting Ishmael's act specifically to the sin of relations with a married woman.", :sources ["Rashi on Genesis 21:9" "Sanhedrin 89b" "Genesis 26:8"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["הנה יצחק מצחק" "אשר ילדה לאברהם מצחק"], :by :selah, :located [{:phrase "הנה יצחק מצחק", :refs ["Genesis 26:8"], :n 1, :lens :plene-insensitive} {:phrase "אשר ילדה לאברהם מצחק", :refs ["Genesis 21:9"], :n 1, :lens :exact}]} {:kind :other, :note "Gezerah shavah linking two appearances of מצחק to infer Ishmael's sin of adultery from the marital context in each verse", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 26, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:17.680407710Z", :model "glm-5.2"}