{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "יקראו", :translit "yikra'u", :gloss "they shall be called"} {:he "בניו יקראו", :translit "banav yikra'u", :gloss "his sons shall be called"} {:he "על שבט הלוי", :translit "al shevet ha-levi", :gloss "upon the tribe of Levi"} {:he "בנחלתם", :translit "be-nachalatam", :gloss "in their inheritance"} {:he "על שם אחיהם", :translit "al shem acheihem", :gloss "by the name of their brothers"} {:he "ערי המגרש", :translit "arei ha-migrash", :gloss "cities of the open land"} {:he "מכל שבטי ישראל", :translit "mi-kol shivtei yisra'el", :gloss "from all the tribes of Israel"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יקראו"]}], :frame {:text "The Levites received forty-eight cities scattered among all the tribes of Israel rather than a contiguous territorial portion (Numbers 35:1–8; Joshua 21:1–42). These included the six cities of refuge designated for unintentional killers (Numbers 35:9–15; Deuteronomy 19:1–10). Jacob's statement in Genesis 48:6 that Ephraim and Manasseh's younger siblings 'shall be called by the name of their brothers' in their inheritance parallels the Levites, whose cities are said to be called upon their brothers' tribes.", :sources ["Genesis 48:6" "Numbers 35:1–8" "Numbers 35:9–15" "Deuteronomy 19:1–10" "Joshua 21:1–42"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["יקראו"], :by :selah, :located [{:phrase "יקראו", :refs ["Genesis 48:6" "Deuteronomy 2:11" "Deuteronomy 2:20" "Deuteronomy 3:9" "Deuteronomy 33:19" "Judges 10:4" "Isaiah 34:12" "Isaiah 47:1"], :n 17, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 48, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:57.174669075Z", :model "glm-5.2"}