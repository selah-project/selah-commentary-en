{:tier :glm-5.2, :verse 16, :comments [{:quotes [{:he "והבאים", :translit "ve-haba'im", :gloss "and those who came"} {:he "ב' במסודה", :translit "bet be-masudah", :gloss "two in the Masorah"} {:he "ואידך והבאים וגו' עם זרובבל", :translit "ve-idach ve-haba'im ve-gomer im zerubavel", :gloss "and the other 'and those who came…' with Zerubbabel"} {:he "באו מאליהם", :translit "ba'u me-aleihem", :gloss "they came of their own accord"} {:he "עלו מאליהם", :translit "alu me-aleihem", :gloss "they went up of their own accord"} {:he "כמאן דאמר עלו מאליהם", :translit "ke-man d-amar alu me-aleihem", :gloss "like the one who says they went up of their own accord"} {:he "ודלא כמאן דאמר שעזרא העלם", :translit "ve-dela ke-man d-amar she-ezra he'elam", :gloss "and not like the one who says Ezra brought them up"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והבאים" "והבאים וגו' עם זרובבל"]}], :frame {:text "The phrase והבאים עם זרובבל occurs in the list of returnees from Babylonian exile (Ezra 2 / Nehemiah 7). The Talmud records a dispute: Rav says they went up of their own accord (Ezra 2:1, understood as 'each one' came on his own), while Shmuel says Ezra brought them up coercively (Ezra 2:2, read as 'he brought up' referring to Ezra) (Sukkah 20a). Ba'al HaTurim links the two Masorah occurrences: the animals in Noah's ark came voluntarily (Genesis 7:16), so too the returnees with Zerubbabel came voluntarily.", :sources ["Sukkah 20a" "Ezra 2:1" "Ezra 2:2" "Nehemiah 7:6" "Genesis 7:16"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והבאים" "והבאים וגו' עם זרובבל"], :by :selah, :located [{:phrase "והבאים", :refs ["Genesis 7:16" "Nehemiah 5:17"], :n 2, :lens :exact} {:phrase "והבאים וגו' עם זרובבל", :refs [], :n 0, :lens :plene-insensitive}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 7, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:04:53.114176246Z", :model "glm-5.2"}