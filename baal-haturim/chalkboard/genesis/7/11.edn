{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "בשבעה עשר יום לחודש", :translit "b'shiv'ah asar yom la'chodesh", :gloss "on the seventeenth day of the month"} {:he "וזה יבלו בטוב ימיהם", :translit "v'zeh yavlu b'tov yameihem", :gloss "and this will consume the good of their days"} {:he "טוב", :translit "tov", :gloss "good"} {:he "לחודש", :translit "la'chodesh", :gloss "for the month / to the month"} {:he "ירד המבול", :translit "yarad ha'mabul", :gloss "the flood descended"} {:he "וארבות השמים", :translit "v'arubot ha'shamayim", :gloss "and the windows of heaven"} {:he "שלקח שני כוכבים מכימה", :translit "she'lakach shnei kochavim m'kimah", :gloss "that He took two stars from Kimah"}], :mechanisms [{:kind :gematria, :a "וזה יבלו בטוב ימיהם", :b "טוב לחודש"} {:kind :gematria, :a "וארבות השמים", :b "שלקח שני כוכבים מכימה"}], :frame {:text "The phrase 'this will consume the good of their days' appears in Job 36:11 as a consequence for those who do not obey. The Flood punished the generation for their sins. Regarding Kimah (Pleiades), Berakhot 58b identifies it as the tail of the constellation Aries, and Rashi ad loc. cites a tradition that the Holy One took two stars from Kimah and brought the Flood, linking it to the language of 'windows of heaven' (arubot) through which the waters came.", :sources ["Job 36:11" "Berakhot 58b" "Rashi on Berakhot 58b"]}}], :arithmetic [{:kind :gematria, :a "וזה יבלו בטוב ימיהם", :a-value 190, :b "טוב לחודש", :b-value 365, :lens :standard, :by :selah, :equal? false} {:a-value 1010, :b-value 1011, :lens :standard, :equal? false, :kind :gematria, :b "שלקח שני כוכבים מכימה", :by :selah, :colel? true, :a "וארבות השמים"}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 7, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:04:47.210346070Z", :model "glm-5.2"}