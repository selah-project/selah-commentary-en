{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "וישתחו ארצה ז' פעמים", :translit "vayishtachu artzah z' pa'amim", :gloss "and he bowed to the ground seven times"} {:he "כי שבע יפול צדיק וקם", :translit "ki shiv'a yipol tzadik v'kam", :gloss "for a righteous man falls seven times and rises"}], :mechanisms [{:kind :other, :note "Number seven in the verse linked to Proverbs 24:16 and to seven abominations"}], :frame {:text "Proverbs 24:16 states that a righteous man falls seven times and rises. Proverbs 26:25 speaks of seven abominations in the heart, using the phrase שבע תועבות. The Ba'al HaTurim connects Jacob's seven prostrations to both: each bowing corresponds to a fall-and-rise of the righteous, and simultaneously serves to purge the seven abominations from his heart.", :sources ["Proverbs 24:16" "Proverbs 26:25"]}}], :arithmetic [{:kind :other, :note "Number seven in the verse linked to Proverbs 24:16 and to seven abominations", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:09:50.510816038Z", :model "glm-5.2"}