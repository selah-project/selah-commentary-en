{:tier :glm-5.2, :verse 4, :comments [{:quotes [{:he "וישקהו", :translit "va-yishakehu", :gloss "and he kissed him"}], :mechanisms [{:kind :other, :note "Unusual placement of the dot above the letter indicates Esau's hostile intent."}], :frame {:text "The Masoretic text places the vowel dot above the shin rather than on or inside the letter. The Sifrei on Numbers comments that wherever the word 'וישקהו' has its dot above, the act was a genuine kiss, but here the dot is written over the letter to signal Esau's hostile intent. Midrash Rabbah on Genesis 33:4 records Rabbi Simeon ben Eleazar's statement that Esau came to bite Jacob, but Jacob's neck turned to marble and the wicked one's teeth were blunted.", :sources ["Genesis Rabbah 78:9" "Sifrei Numbers 69"]}} {:quotes [{:he "וישקהו", :translit "va-yishakehu", :gloss "and he kissed him"} {:he "לנושכיהו", :translit "le-noskheihu", :gloss "to bite him"} {:he "דור חרבות", :translit "dor charavot", :gloss "generation of swords"} {:he "שני\"ו", :translit "shinnav", :gloss "his teeth"} {:he "עשו", :translit "Esav", :gloss "Esau"}], :mechanisms [{:kind :gematria, :a "וישקהו", :b "לנושכיהו"} {:kind :gematria, :a "שני\"ו", :b "עשו"}], :frame {:text "Genesis 33:4 records that Esau fell on Jacob's neck and kissed him. Genesis Rabbah 78:9 cites Rabbi Simeon ben Eleazar: Esau came to bite Jacob, but Jacob's neck turned to marble and Esau's teeth were blunted. Psalm 17:4 says 'דור חרבות' ('a generation of the sword'), a phrase midrashically read as a generation marked by the sword's violence.", :sources ["Genesis 33:4" "Genesis Rabbah 78:9" "Psalm 17:4"]}}], :arithmetic [{:kind :other, :note "Unusual placement of the dot above the letter indicates Esau's hostile intent.", :by :selah, :ran? false} {:kind :gematria, :a "וישקהו", :a-value 427, :b "לנושכיהו", :b-value 427, :lens :standard, :by :selah, :equal? true} {:kind :gematria, :a "שני\"ו", :a-value 366, :b "עשו", :b-value 376, :lens :standard, :by :selah, :equal? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 33, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:09:56.408858721Z", :model "glm-5.2"}