{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "מעט צרי ומעט דבש", :translit "me'at tzori u-me'at devash", :gloss "a little balm and a little honey"} {:he "ו' מינים", :translit "v' minim", :gloss "six kinds"} {:he "ו' בני הגבירות", :translit "v' bnei ha-gevirot", :gloss "six sons of the handmaid-wives"}], :mechanisms [{:kind :other, :note "Six gift items correspond symbolically to the six sons of the handmaid-wives (Bilhah and Zilpah)."}], :frame {:text "Jacob instructs his sons to take of the land's finest products as a tribute to Egypt. The six sons of Bilhah and Zilpah are listed in Genesis 46:25 and elsewhere. The Ba'al HaTurim draws a structural parallel between the count of tribute items and the count of those sons.", :sources ["Genesis 43:11" "Genesis 46:25"]}}], :arithmetic [{:kind :other, :note "Six gift items correspond symbolically to the six sons of the handmaid-wives (Bilhah and Zilpah).", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 43, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:21.318063180Z", :model "glm-5.2"}