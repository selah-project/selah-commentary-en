{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "יחנך בני", :translit "yechun'cha beni", :gloss "may He grant you grace, my son"} {:he "חנון יחנך לקול זעקך", :translit "chanun yechun'cha lekol ze'akha", :gloss "gracious, may He grant you grace to the sound of your cry"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["יחנך בני" "חנון יחנך לקול זעקך"]} {:kind :other, :note "Midrash: each of Benjamin's ten sons was named after a trouble that befell Joseph; Binyamin named his son Bela because Joseph was swallowed up (Devarim Rabbah 1:16)"}], :frame {:text "Genesis 46:21 lists ten sons of Benjamin. A midrashic tradition holds that Benjamin named each son after a tribulation that befell his brother Joseph: for example, Bela because Joseph was swallowed (נבלע) among the nations, Becher because he was the firstborn (בכור), and Ashbel because he was taken captive (נשבה). When Joseph asked Benjamin about his sons and heard these names — each encoding grief over Joseph's disappearance — Joseph's compassion was stirred and he blessed Benjamin. The phrase לקול זעקך, 'to the sound of your cry,' ties to Benjamin's cry of grief over his lost brother.", :sources ["Genesis 46:21" "Devarim Rabbah 1:16"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["יחנך בני" "חנון יחנך לקול זעקך"], :by :selah, :located [{:phrase "יחנך בני", :refs ["Genesis 43:29"], :n 1, :lens :exact} {:phrase "חנון יחנך לקול זעקך", :refs ["Isaiah 30:19"], :n 1, :lens :exact}]} {:kind :other, :note "Midrash: each of Benjamin's ten sons was named after a trouble that befell Joseph; Binyamin named his son Bela because Joseph was swallowed up (Devarim Rabbah 1:16)", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 43, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:27.819409505Z", :model "glm-5.2"}