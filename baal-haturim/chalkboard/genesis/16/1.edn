ings of Daniel 7.", :sources ["Genesis 16:1" "Genesis 21:14" "Genesis 25:1" "Genesis Rabbah 45:1" "Genesis Rabbah 61:4" "Rashi on Genesis 21:14" "Rashi on Genesis 25:1" "Daniel 7:3"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ושרי אשת אברם" "ושרי ביששכר עם דבורה"], :by :selah, :located [{:phrase "ושרי אשת אברם", :refs ["Genesis 16:1"], :n 1, :lens :exact} {:phrase "ושרי ביששכר עם דבורה", :refs ["Judges 5:15"], :n 1, :lens :plene-insensitive}]} {:kind :masorah, :count 4, :occurrences ["ולה שפחה מצרית" "ולה שני פיות" "ולה אמר עלי לשלום" "ולה גפין ארבע בחיה"], :by :selah, :located [{:phrase "ולה שפחה מצרית", :refs ["Genesis 16:1"], :n 1, :lens :exact} {:phrase "ולה שני פיות", :refs ["Judges 3:16"], :n 1, :lens :exact} {:phrase "ולה אמר עלי לשלום", :refs ["1 Samuel 25:35"], :n 1, :lens :exact} {:phrase "ולה גפין ארבע בחיה", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Connects each Masorah occurrence to a stage in Hagar's life: idolatry, return, and Ishmael's kingdom.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 16, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:06:24.290547688Z", :model "glm-5.2"}