{:tier :glm-5.2, :verse 1, :comments [{:quotes [{:he "ותכהין עיניו מראות", :translit "v'tich'heina einaiv meir'ot", :gloss "And his eyes grew dim from seeing"} {:he "כי השוחד יעור", :translit "ki ha-shochad ya'aver", :gloss "for a bribe blinds"} {:he "והוא לקח שוחד מעשו", :translit "ve-hu lakach shochad me-eisav", :gloss "and he took a bribe from Esau"}], :mechanisms [{:kind :other, :note "Causal link: taking a bribe caused his blindness, per the verse about bribes blinding."}], :frame {:text "Exodus 23:8 states that a bribe blinds the clear-sighted. The midrashic tradition applies this principle to Isaac: on the day of Abraham's death, Jacob and Esau divided Abraham's possessions, and the food Esau prepared for Isaac from an animal he hunted is construed as a bribe that dimmed Isaac's eyes (Bereshit Rabbah 65:10; Tanhuma, Toldot 8).", :sources ["Exodus 23:8" "Bereshit Rabbah 65:10" "Tanhuma Toldot 8"]}} {:quotes [{:he "מראות", :translit "meir'ot", :gloss "from seeing"} {:he "בעשן הצלמים", :translit "be-ashan ha-tzalim", :gloss "in the smoke of the images"}], :mechanisms [{:kind :gematria, :a "מראות", :b "בעשן הצלמים"}], :frame nil}], :arithmetic [{:kind :other, :note "Causal link: taking a bribe caused his blindness, per the verse about bribes blinding.", :by :selah, :ran? false} {:kind :gematria, :a "מראות", :a-value 647, :b "בעשן הצלמים", :b-value 637, :lens :standard, :by :selah, :equal? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:28.092562017Z", :model "glm-5.2"}