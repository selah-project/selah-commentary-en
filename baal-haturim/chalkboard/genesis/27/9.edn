{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "לך נא אל הצאן", :translit "lekh na el ha-tzon", :gloss "Go now to the flock"} {:he "נאה לך", :translit "na'ah lakh", :gloss "Beautiful / fitting for you"} {:he "נאה לך ונאה לבניך", :translit "na'ah lakh ve-na'ah le-vanekha", :gloss "Beautiful for you and beautiful for your children"} {:he "פסח היה", :translit "pesach hayah", :gloss "It was Passover"} {:he "ב' אחד לפסח וא' לחגיגה", :translit "shnayim echad la-pesach ve-echad le-chagigah", :gloss "Two — one for Passover and one for festive offering"}], :mechanisms [{:kind :rashei-tevot, :phrase "לך נא אל הצאן", :spells "נאל"}], :frame {:text "The word na (נא) carries the connotation of something fitting or appropriate; see Rashi on Exodus 12:21 citing the phrase na'ah lakh. The requirement of two animals — one for the Paschal offering and one for the chagigah — when the Paschal lamb is insufficient for all those enrolled is found at Mishnah Pesachim 6:3 and discussed at Pesachim 70a. The tradition that the events of Genesis 27 occurred on Passover night is found at Pesachim 5a.", :sources ["Rashi on Exodus 12:21" "Mishnah Pesachim 6:3" "Pesachim 70a" "Pesachim 5a"]}} {:quotes [{:he "וקח לי משם שני", :translit "u-kekh li mi-sham shnayim", :gloss "And take me from there two"} {:he "משלו", :translit "mishlo", :gloss "From him / his own"} {:he "משם", :translit "mi-sham", :gloss "From there"} {:he "משלי", :translit "mishli", :gloss "From me / my own"} {:he "כתובתה", :translit "ketavtah", :gloss "Her ketubah / her marriage contract"}], :mechanisms [{:kind :rashei-tevot, :phrase "משם שני לך", :spells "משל"} {:kind :gematria, :a "משם", :b "משלי"}], :frame nil}], :arithmetic [{:kind :rashei-tevot, :phrase "לך נא אל הצאן", :spells "נאל", :letters ["ל" "נ" "א" "ה"], :by :selah, :order :mismatch} {:kind :rashei-tevot, :phrase "משם שני לך", :spells "משל", :letters ["מ" "ש" "ל"], :by :selah, :order :in-order} {:kind :gematria, :a "משם", :a-value 380, :b "משלי", :b-value 380, :le