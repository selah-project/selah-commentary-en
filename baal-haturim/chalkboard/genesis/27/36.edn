{:tier :glm-5.2, :verse 36, :comments [{:quotes [{:he "ברכתי", :translit "birchati", :gloss "my blessing"} {:he "לקח ברכתי", :translit "lakach birchati", :gloss "he took my blessing"} {:he "קח נא את ברכתי", :translit "kach na et birchati", :gloss "take please my blessing"} {:he "וצויתי את ברכתי", :translit "vetziviti et birchati", :gloss "and I have commanded my blessing"} {:he "ויבא יעקב שלם", :translit "vayavo ya'akov shaleim", :gloss "and Jacob came whole"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["לקח ברכתי" "קח נא את ברכתי" "וצויתי את ברכתי"]}], :frame {:text "Esau's lament 'he took my blessing' (Genesis 27:36) is one of three Masoretic occurrences of ברכתי. The other two are Isaac's 'take now my blessing' (Genesis 27:38) and God's 'I have commanded My blessing' (Genesis 27:28, rendered here as וצויתי את ברכתי). Genesis 27:28 records the divine blessing to Jacob, and Genesis 33:18 states 'Jacob came whole' (ויבא יעקב שלם), which the tradition reads as indicating Jacob lacked nothing.", :sources ["Genesis 27:28" "Genesis 27:36" "Genesis 27:38" "Genesis 33:18"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["לקח ברכתי" "קח נא את ברכתי" "וצויתי את ברכתי"], :by :selah, :located [{:phrase "לקח ברכתי", :refs ["Genesis 27:36"], :n 1, :lens :exact} {:phrase "קח נא את ברכתי", :refs ["Genesis 33:11"], :n 1, :lens :exact} {:phrase "וצויתי את ברכתי", :refs ["Leviticus 25:21"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:45.513911828Z", :model "glm-5.2"}