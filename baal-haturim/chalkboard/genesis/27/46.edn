{:tier :glm-5.2, :verse 46, :comments [{:quotes [{:he "קצתי בחיי", :translit "qatzati b'chayai", :gloss "I am disgusted with my life"} {:he "קו\"ף קטנה", :translit "qof q'tanah", :gloss "small qof"} {:he "ודרור", :translit "v'dror", :gloss "and Liberty [Leviticus 25:10]"} {:he "קו\"ף של ודרור קן לה גדולה", :translit "qof shel v'dror qan lah g'dolah", :gloss "the qof of v'dror is written large"}], :mechanisms [{:kind :other, :note "Small qof in קצתי foreshadows Temple destruction; large qof in ודרור (Lev 25:10) signals David's plea that the Sanctuary endure."} {:kind :other, :note "Both letters tied to 100-cubit height: the Temple that fell, the Sanctuary David sought to preserve."}], :frame {:text "The First Temple's height was one hundred cubits (Middot 4:6). David sought to build the Sanctuary but was told that task would fall to Solomon (2 Samuel 7:12–13). Leviticus 25:10 proclaims 'ודרור בארץ' ('liberty throughout the land') in the Jubilee passage. The Ba'al HaTurim links the small and large letter forms to the fate of these structures.", :sources ["Middot 4:6" "2 Samuel 7:12–13" "Leviticus 25:10"]}}], :arithmetic [{:kind :other, :note "Small qof in קצתי foreshadows Temple destruction; large qof in ודרור (Lev 25:10) signals David's plea that the Sanctuary endure.", :by :selah, :ran? false} {:kind :other, :note "Both letters tied to 100-cubit height: the Temple that fell, the Sanctuary David sought to preserve.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 27, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:44.565584178Z", :model "glm-5.2"}