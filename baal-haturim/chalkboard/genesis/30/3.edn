{:tier :glm-5.2, :verse 3, :comments [{:quotes [{:he "הנה אמתי בלהה", :translit "henah amati bilhah", :gloss "Behold my maid Bilhah"} {:he "שפחתי", :translit "shifchati", :gloss "my handmaid"}], :mechanisms [{:kind :other, :note "Lexical contrast: אמה vs. שפחה, applied to Bilhah vs. Hagar respectively."}], :frame {:text "Rachel refers to Bilhah with the term אמה rather than שפחה. The term שפחה is used for Hagar in Genesis 16:1–8. Ba'al HaTurim explains the difference in terminology by distinguishing Bilhah's lineage from Hagar's: Bilhah was Laban's daughter from a concubine, giving her a status that warranted the term אמה.", :sources ["Genesis 16:1" "Genesis 16:2" "Genesis 16:3" "Genesis 16:6" "Genesis 16:8"]}}], :arithmetic [{:kind :other, :note "Lexical contrast: אמה vs. שפחה, applied to Bilhah vs. Hagar respectively.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 30, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:09:12.278169189Z", :model "glm-5.2"}