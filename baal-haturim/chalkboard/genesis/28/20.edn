{:tier :glm-5.2, :verse 20, :comments [{:quotes [{:he "וידר", :translit "va-yidar", :gloss "and he vowed"} {:he "וידר יעקב", :translit "va-yidar ya'akov", :gloss "and Jacob vowed"} {:he "וידר ישראל", :translit "va-yidar yisra'el", :gloss "and Israel vowed"} {:he "וידר יפתח", :translit "va-yidar yiftach", :gloss "and Jephthah vowed"} {:he "אשר נשבע לה' נדר לאביר יעקב", :translit "asher nishba laHashem neder la'avir ya'akov", :gloss "that which he swore to YHWH, a vow to the Mighty One of Jacob"} {:he "אביר יעקב", :translit "avir ya'akov", :gloss "Mighty One of Jacob"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["וידר יעקב" "וידר ישראל" "וידר יפתח"]} {:kind :other, :note "Cross-reference to Isaiah 29:23 'נדר לאביר יעקב' read as identifying Jacob as originator of vows."}], :frame {:text "The verse Isaiah 29:23 contains the phrase 'נדר לאביר יעקב' ('a vow to the Mighty One of Jacob'), which Ba'al HaTurim reads as an allusion to Jacob as the first to institute the practice of vowing. The three Masorah occurrences of the root נדר in the vav-consecutive form span Jacob (Genesis 28:20), Israel/Jeroboam (2 Chronicles 15:12–15), and Jephthah (Judges 11:30).", :sources ["Isaiah 29:23" "Genesis 28:20" "2 Chronicles 15:12-15" "Judges 11:30"]}} {:quotes [{:he "ללבוש", :translit "le-lavush", :gloss "to wear"} {:he "ללבוש את הבגדים", :translit "le-lavush et ha-begadim", :gloss "to wear the garments"} {:he "ונתן לי לחם לאכול ובגד ללבוש", :translit "ve-natan li lechem le'echol u-veged le-lavush", :gloss "and gave me bread to eat and clothing to wear"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["הכא ללבוש" "ללבוש את הבגדים"]}], :frame {:text "Bereshit Rabbah 78:9 records that the Holy One said to Michael: 'You made My Jacob a blemished High Priest, limping on his thigh — by your life, you must be High Priest on high in his place,' in connection with Jacob's request for 'bread to eat and clothing to wear.' The midrashic premise is that the priestly service originally belonged to the firstborn; Jacob acquired it from Esau along with the birthright (Genesis 25:31–33). The two occurrences of ללבוש — here and in Leviticus 21:10 regarding the High Priest's garments (ללבוש את הבגדים) — link Jacob's request for clothing to priestly vestments.", :sources ["Bereshit Rabbah 78:9" "Genesis 25:31-33" "Leviticus 21:10"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["וידר יעקב" "וידר ישראל" "וידר יפתח"], :by :selah, :located [{:phrase "וידר יעקב", :refs ["Genesis 28:20"], :n 1, :lens :exact} {:phrase "וידר ישראל", :refs ["Numbers 21:2"], :n 1, :lens :exact} {:phrase "וידר יפתח", :refs ["Judges 11:30"], :n 1, :lens :exact}]} {:kind :other, :note "Cross-reference to Isaiah 29:23 'נדר לאביר יעקב' read as identifying Jacob as originator of vows.", :by :selah, :ran? false} {:kind :masorah, :count 2, :occurrences ["הכא ללבוש" "ללבוש את הבגדים"], :by :selah, :located [{:phrase "הכא ללבוש", :refs [], :n 0, :lens :plene-insensitive} {:phrase "ללבוש את הבגדים", :refs ["Leviticus 21:10"], :n 1, :lens :plene-insensitive}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:09:08.832677313Z", :model "glm-5.2"}