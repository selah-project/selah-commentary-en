{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "וזה שער השמים", :translit "ve-zeh sha'ar ha-shamayim", :gloss "and this is the gate of heaven"} {:he "ושכם", :translit "ve-yishchak", :gloss "and [he set out early / dawned"}], :mechanisms [{:kind :other, :note "wordplay linking 'Shechem' to 'shachar' (dawn) via dawn's opening of heaven's gate"}], :frame {:text "The verse records Jacob's discovery that the place is the gate of heaven (Genesis 28:17). The name Shechem can be read in connection with the root sh-ch-r, meaning dawn. Yerushalmi Berakhot 4:1 states that at dawn the gates of heaven open, making it a propitious time for prayer.", :sources ["Genesis 28:17" "Yerushalmi Berakhot 4:1"]}}], :arithmetic [{:kind :other, :note "wordplay linking 'Shechem' to 'shachar' (dawn) via dawn's opening of heaven's gate", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 28, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:53.308182064Z", :model "glm-5.2"}