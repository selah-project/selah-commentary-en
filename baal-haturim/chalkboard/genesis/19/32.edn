{:tier :glm-5.2, :verse 32, :comments [{:quotes [{:he "ונחיה", :translit "v'nichyeh", :gloss "and we may live"} {:he "ונחיה סוס ופרד ולא נכרית מהבהמה", :translit "v'nichyeh sus u'farad v'lo yikareit min ha'behemah", :gloss "let the horse and the mule live and not be cut off from the beast"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["ונחיה" "ונחיה" "ונחיה"]}], :frame {:text "The phrase 'ונחיה סוס ופרד ולא נכרית מהבהמה' appears in Isaiah's oracle against Moab at Isaiah 15:4, describing the panicked flight of horses and mules. The Ba'al HaTurim links the shared rare word ונחיה between Genesis 19:32, where Lot's daughters scheme to preserve offspring through their father, and the beast imagery of Isaiah 15:4, yielding the derisive reading that the daughters' conduct was bestial.", :sources ["Isaiah 15:4" "Genesis 19:32"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["ונחיה" "ונחיה" "ונחיה"], :by :selah, :located [{:phrase "ונחיה", :refs ["Genesis 19:32" "Genesis 19:34" "Genesis 42:2" "Genesis 43:8" "Genesis 47:19" "1 Kings 18:5" "Hosea 6:2" "Nehemiah 5:2"], :n 8, :lens :exact} {:phrase "ונחיה", :refs ["Genesis 19:32" "Genesis 19:34" "Genesis 42:2" "Genesis 43:8" "Genesis 47:19" "1 Kings 18:5" "Hosea 6:2" "Nehemiah 5:2"], :n 8, :lens :exact} {:phrase "ונחיה", :refs ["Genesis 19:32" "Genesis 19:34" "Genesis 42:2" "Genesis 43:8" "Genesis 47:19" "1 Kings 18:5" "Hosea 6:2" "Nehemiah 5:2"], :n 8, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 19, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:06:51.735252071Z", :model "glm-5.2"}