{:tier :glm-5.2, :verse 35, :comments [{:quotes [{:he "לוא", :translit "lo", :gloss "not"} {:he "ב' במסורה מלאים", :translit "bet be-masorah mle'im", :gloss "two in the Masorah plene"} {:he "הכא", :translit "haka", :gloss "here"} {:he "ואידך", :translit "ve-idekh", :gloss "and the other"} {:he "אם לוא יגיד ונשא עונו", :translit "im lo yagid ve-nasa ono", :gloss "if he does not tell and he bears his iniquity"} {:he "לא אוכל לקום מפניך מפני התרפים", :translit "lo ukhal lakum mi-panekha mipnei ha-terafim", :gloss "I cannot rise before you because of the terafim"} {:he "אבל מפני אחר אקום", :translit "aval mipnei acher akum", :gloss "but before another I will rise"} {:he "אם לו לא יגיד", :translit "im lo lo yagid", :gloss "if to him he does not tell"} {:he "ונשא עונו", :translit "ve-nasa ono", :gloss "and he bears his iniquity"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לוא" "אם לוא יגיד ונשא עונו"]}], :frame {:text "The phrase אם לוא יגיד ונשא עונו appears at Leviticus 5:1 regarding one who withholds testimony. The Talmud derives that one who suppresses testimony is liable only when summoned before a claimant (תובע) who demands testimony specifically from him; he is not liable to seek out others of his own accord (Shavuot 34b). Ba'al HaTurim links the word לוא in Genesis 31:35, where Rachel excuses herself from rising, to this same phrase, reading her refusal as analogous to the legal exemption.", :sources ["Leviticus 5:1" "Shavuot 34b"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לוא" "אם לוא יגיד ונשא עונו"], :by :selah, :located [{:phrase "לוא", :refs ["Genesis 31:35" "Leviticus 5:1" "1 Samuel 2:24" "1 Samuel 14:30" "1 Samuel 19:4" "1 Kings 22:18" "2 Kings 5:17" "2 Kings 6:12"], :n 28, :lens :exact} {:phrase "אם לוא יגיד ונשא עונו", :refs ["Leviticus 5:1"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 31, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:09:28.515791513Z", :model "glm-5.2"}