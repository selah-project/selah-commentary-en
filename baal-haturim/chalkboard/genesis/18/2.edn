{:tier :glm-5.2, :verse 2, :comments [{:quotes [{:he "והנה שלשה", :translit "vehineh shloshah", :gloss "and behold three"} {:he "אלו מיכאל גבריאל ורפאל", :translit "elu mikhael gavriel verafa'el", :gloss "these are Michael Gabriel and Raphael"}], :mechanisms [{:kind :gematria, :a "והנה שלשה", :b "אלו מיכאל גבריאל ורפאל"}], :frame {:text "The three visitors who appeared to Abraham are identified as angels, each dispatched for a distinct task. Michael came to announce that Sarah would bear a son (Genesis 18:10). Raphael came to heal Abraham after his circumcision (Genesis 18:1, contextualized by b. Bava Metzi'a 86b). Gabriel came to overturn Sodom (Genesis 19:24–25). The full identification of the three by name and assignment appears at b. Bava Metzi'a 86b.", :sources ["Genesis 18:1" "Genesis 18:10" "Genesis 19:24-25" "b. Bava Metzi'a 86b"]}}], :arithmetic [{:kind :gematria, :a "והנה שלשה", :a-value 701, :b "אלו מיכאל גבריאל ורפאל", :b-value 701, :lens :standard, :by :selah, :equal? true}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:06:25.027087951Z", :model "glm-5.2"}