{:tier :glm-5.2, :verse 9, :comments [{:quotes [{:he "ויאמרו אליו", :translit "vayomru elav", :gloss "and they said to him"} {:he "אמרו אליה איו", :translit "imru eileh eiyo", :gloss "they said to her, woe"}], :mechanisms [{:kind :gematria, :a "ויאמרו אליו", :b "אמרו אליה איו"}], :frame {:text "According to the midrashic tradition, the visitors directed their question about Sarah to Abraham ('they said to him'), but Scripture uses language that also carries the message 'they said to her.' The appended word איו ('woe') signals the tragic dimension: Sarah would not merit to raise this child to adulthood, as she dies before Isaac's binding (Genesis 23:1–2).", :sources ["Genesis 18:9" "Genesis 23:1"]}}], :arithmetic [{:kind :gematria, :a "ויאמרו אליו", :a-value 310, :b "אמרו אליה איו", :b-value 310, :lens :standard, :by :selah, :equal? true}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:06:29.653660636Z", :model "glm-5.2"}