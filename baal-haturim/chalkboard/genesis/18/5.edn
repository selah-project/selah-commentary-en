{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "ואקחה פת לחם", :translit "v'echechah pat lechem", :gloss "and I will take a morsel of bread"} {:he "קחו פת לחם", :translit "kechu pat lechem", :gloss "take a morsel of bread"}], :mechanisms [{:kind :other, :note "Singular first person 'I will take' instead of plural imperative 'take' implies the host personally breaks the bread."}], :frame {:text "The Talmud establishes that the one who breaks bread says the blessing on behalf of all, and the practice is that the host breaks bread (Shabbat 77a; Berakhot 39b).", :sources ["Shabbat 77a" "Berakhot 39b"]}} {:quotes [{:he "לבכם", :translit "levavchem", :gloss "your heart"} {:he "שיתו לבכם לחילה", :translit "shitu levavchem la-cheilah", :gloss "set your heart to her army"} {:he "וראיתם ושש לבכם", :translit "u're'item v'sas levavchem", :gloss "and you shall see and your heart shall rejoice"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["לבכם" "שיתו לבכם לחילה" "וראיתם ושש לבכם"]}], :frame {:text "Abraham's pain over lacking guests is addressed in the Talmud's statement that the third day after circumcision is the most painful, yet he sat at the tent entrance watching for travelers (Bava Metzia 86b). Ba'al HaTurim links this pain to the word לבכם at Genesis 18:5, and reads the other two Masorah occurrences of לבכם as reflecting the same theme: distress giving way to rejoicing (Song of Songs 6:4; Isaiah 66:14).", :sources ["Bava Metzia 86b" "Song of Songs 6:4" "Isaiah 66:14"]}}], :arithmetic [{:kind :other, :note "Singular first person 'I will take' instead of plural imperative 'take' implies the host personally breaks the bread.", :by :selah, :ran? false} {:kind :masorah, :count 3, :occurrences ["לבכם" "שיתו לבכם לחילה" "וראיתם ושש לבכם"], :by :selah, :located [{:phrase "לבכם", :refs ["Genesis 18:5" "Isaiah 66:14" "Psalms 48:14"], :n 3, :lens :exact} {:phrase "שיתו לבכם לחילה", :refs ["Psalms 48:14"], :n 1, :lens :exact} {:phrase "וראיתם ושש לבכם", :refs ["Isaiah 66:14"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 18, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:06:31.057188750Z", :model "glm-5.2"}