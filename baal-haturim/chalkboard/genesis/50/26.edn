{:tier :glm-5.2, :verse 26, :comments [{:quotes [{:he "ויחנטו", :translit "va-yechantu", :gloss "and they embalmed"} {:he "ויחנטו את ישראל", :translit "va-yechantu et yisra'el", :gloss "and they embalmed Israel"} {:he "ויחנטו את יוסף", :translit "va-yechantu et yosef", :gloss "and they embalmed Joseph"} {:he "יספדוניה דדלה ידלוניה", :translit "yaspdunia dedalah yidlunia", :gloss "they will eulogize him, the one who drew him up"} {:he "ויישם בארון", :translit "va-yasem ba-aron", :gloss "and he placed in a coffin"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ויחנטו את ישראל" "ויחנטו את יוסף"]} {:kind :other, :note "Aramaic aphorism: measure-for-measure — the one who mourns him is the one who raised him"}], :frame {:text "The Talmud cites the Aramaic aphorism יספדוניה דדלה ידלוניה to express a measure-for-measure principle: the Egyptians mourned and embalmed Jacob because Joseph had honored his father through embalming (Ketubot 111a). Genesis 50:2–3 records that Joseph commanded his physicians to embalm Jacob, and Genesis 50:26 records that Joseph himself was embalmed and placed in a coffin in Egypt.", :sources ["Ketubot 111a" "Genesis 50:2-3" "Genesis 50:26"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ויחנטו את ישראל" "ויחנטו את יוסף"], :by :selah, :located [{:phrase "ויחנטו את ישראל", :refs [], :n 0, :lens :plene-insensitive} {:phrase "ויחנטו את יוסף", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Aramaic aphorism: measure-for-measure — the one who mourns him is the one who raised him", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 50, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:12:49.704911940Z", :model "glm-5.2"}