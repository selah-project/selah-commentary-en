{:tier :glm-5.2, :verse 19, :comments [{:quotes [{:he "התחת אלהים אני", :translit "hatachat elohim ani", :gloss "am I in place of God"} {:he "התחת זאת לא יומת שמעי", :translit "hatachat zot lo yumat shimei", :gloss "for this Shimei shall not die"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["התחת אלהים אני" "התחת זאת לא יומת שמעי"]} {:kind :other, :note "Joseph echoes Jacob's rebuke of Rachel in Genesis 30:2, using the identical phrase התחת אלהים אני"}], :frame {:text "Jacob rebuked Rachel with the phrase 'Am I in place of Elohim?' when she demanded children from him (Genesis 30:2). Joseph, Jacob's son, now answers his brothers with the same expression (Genesis 50:19). The Ba'al HaTurim reads this linguistic recurrence as the brothers having absorbed Jacob's mode of speech from Joseph. The third occurrence of this root-phrase is the verse 'for this Shimei shall not be die' (2 Samuel 19:23), where David refrains from punishing Shimei, linking all three moments where a speaker deflects another's demand for judgment by invoking divine authority.", :sources ["Genesis 30:2" "Genesis 50:19" "2 Samuel 19:23"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["התחת אלהים אני" "התחת זאת לא יומת שמעי"], :by :selah, :located [{:phrase "התחת אלהים אני", :refs ["Genesis 50:19"], :n 1, :lens :exact} {:phrase "התחת זאת לא יומת שמעי", :refs ["2 Samuel 19:22"], :n 1, :lens :exact}]} {:kind :other, :note "Joseph echoes Jacob's rebuke of Rachel in Genesis 30:2, using the identical phrase התחת אלהים אני", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 50, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:12:41.602781696Z", :model "glm-5.2"}