{:tier :glm-5.2, :verse 15, :comments [{:quotes [{:he "לו ישטמנו יוסף", :translit "lu yis't'menu yosef", :gloss "will Joseph hate us"} {:he "ברוך שעשה לי נס במקום הזה", :translit "baruch she'asa li nes ba'makom ha'zeh", :gloss "Blessed is He who performed for me a miracle in this place"} {:he "י\"מ", :translit "y.m.", :gloss "some say"}], :mechanisms [{:kind :other, :note "Passing-by-the-pit story: Joseph blesses at the site where he was cast, and brothers interpret this as remembering."}], :frame {:text "The blessing 'Blessed is He who performed for me a miracle in this place' follows the Talmudic model for blessings at a site where one experienced a miracle, as established in Berakhot 54a and 58b, where one who sees a place where miracles were performed for Israel or for himself recites a blessing. Joseph's act of pausing at the pit and reciting a blessing of gratitude is cast in this established liturgical framework.", :sources ["Berakhot 54a" "Berakhot 58b"]}}], :arithmetic [{:kind :other, :note "Passing-by-the-pit story: Joseph blesses at the site where he was cast, and brothers interpret this as remembering.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 50, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:12:39.408146280Z", :model "glm-5.2"}