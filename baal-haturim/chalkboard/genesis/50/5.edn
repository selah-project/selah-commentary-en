{:tier :glm-5.2, :verse 5, :comments [{:quotes [{:he "אנכי מת", :translit "anokhi met", :gloss "I am dying"} {:he "ג' במסורה", :translit "gimmel b'masorah", :gloss "three in the Masorah"} {:he "הכא ביעקב", :translit "haka b'ya'akov", :gloss "here regarding Jacob"} {:he "ואידך במשה", :translit "v'idach b'moshe", :gloss "and the other regarding Moses"} {:he "ואידך ביוסף", :translit "v'idach b'yosef", :gloss "and the other regarding Joseph"} {:he "יעקב לא מת", :translit "ya'akov lo met", :gloss "Jacob did not die"} {:he "אנכי מת", :translit "anokhi met", :gloss "I am dying"}], :mechanisms [{:kind :masorah, :count 3, :occurrences ["אנכי מת"]}], :frame {:text "The phrase אנכי מת appears three times in Scripture: spoken by Jacob in Genesis 50:5 (the verse's framing of Jacob's words to Joseph), by Moses in Deuteronomy 31:27 and Deuteronomy 34:5, and by Joseph in Genesis 50:24-26. The statement that Jacob did not die is found in Ta'anit 5b, where Rav Nachman is challenged on his claim that Jacob lives, since he was embalmed and buried; the response cites Genesis 49:33, where the text says Jacob 'was gathered to his people,' which is read as indicating continued life. The Ba'al HaTurim resolves the tension by noting that all three patriarchs-figures use identical language of death.", :sources ["Ta'anit 5b" "Genesis 50:5" "Genesis 50:26" "Deuteronomy 34:5"]}}], :arithmetic [{:kind :masorah, :count 3, :occurrences ["אנכי מת"], :by :selah, :located [{:phrase "אנכי מת", :refs ["Genesis 48:21" "Genesis 50:5" "Genesis 50:24" "Deuteronomy 4:22"], :n 4, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 50, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:12:37.634050624Z", :model "glm-5.2"}