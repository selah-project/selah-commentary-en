{:tier :glm-5.2, :verse 24, :comments [{:quotes [{:he "אנכי מת ואלהים פקד יפקד אתכם", :translit "anokhi met ve-elohim pakad yifkod etkhem", :gloss "I am dying and God will surely remember you"} {:he "אנכי ב\"ו", :translit "anokhi bov", :gloss "I [am] in it [i.e., alive today]"} {:he "היום כאן ומחר בקבר", :translit "ha-yom kan u-machar ba-kever", :gloss "today here and tomorrow in the grave"} {:he "הקב\"ה מלך חי וקים", :translit "ha-kadosh barukh hu melekh chai ve-kayam", :gloss "the Holy One blessed be He [is a] living and enduring King"} {:he "הוא יפקד אתכם", :translit "hu yifkod et-khem", :gloss "He will remember you"} {:he "שני פעמים פ\"א", :translit "shnei fe'amim pei-alef", :gloss "two times [the letters] pe alef"} {:he "כשם שמלכתי פ' שנים", :translit "k'shem she-malakhti pei shanim", :gloss "just as I ruled eighty [peh] years"} {:he "כך יבוא לכם גואל בן שמונים שנה", :translit "kach yavo lakhem go'el ben shemonim shanah", :gloss "so will come to you a redeemer eighty years old"} {:he "יפקוד לשון חסרון", :translit "yifkod lashon cheseron", :gloss "yifkod in the sense of deficiency"} {:he "ולא נפקד ממנו איש", :translit "ve-lo nifkad mi-menu ish", :gloss "and not one was missing from us"} {:he "פקוד חסר מת' ק\"ץ שנה וישאר רד\"ו", :translit "pakud chaser mi-tav kuf-tzadi shanah ve-nish'ar raish-dalet-vav", :gloss "pakud defective minus four hundred [and] ninety years and two hundred ten remain"}], :mechanisms [{:kind :gematria, :a "שני פעמים פקד פקד", :b "פ' שנים"} {:kind :gematria, :a "פקוד חסר", :b "מת' ק\"ץ שנה וישאר רד\"ו"} {:kind :other, :note "פקד read as 'be missing/deficient' per Numbers 31:49"}], :frame {:text "The doubling of a verb in Hebrew (here פקד יפקד, Genesis 50:24) carries emphasis; the Ba'al HaTurim reads the doubled root as hinting at two distinct events or meanings. The number 210 (רד\"ו) matches the tradition that Israel dwelt in Egypt 210 years out of the 400 announced to Abraham (Genesis 15:13). Numbers 31:49 uses נפקד in the sense 'was missing,' anchoring the alternate reading. The suggestion that the redeemer would be eighty years old is the Ba'al HaTurim's own chronological inference from the doubled פקד.", :sources ["Genesis 50:24" "Genesis 15:13" "Numbers 31:49"]}}], :arithmetic [{:kind :gematria, :a "שני פעמים פקד פקד", :a-value 968, :b "פ' שנים", :b-value 480, :lens :standard, :by :selah, :equal? false} {:kind :gematria, :a "פקוד חסר", :a-value 458, :b "מת' ק\"ץ שנה וישאר רד\"ו", :b-value 1712, :lens :standard, :by :selah, :equal? false} {:kind :other, :note "פקד read as 'be missing/deficient' per Numbers 31:49", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 50, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:12:51.830948264Z", :model "glm-5.2"}