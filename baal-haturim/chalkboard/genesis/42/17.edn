{:tier :glm-5.2, :verse 17, :comments [{:quotes [{:he "אל משמר שלשת ימים", :translit "el mishmar shloshet yamim", :gloss "into custody three days"} {:he "ויפשיטו את כתנתו", :translit "vaypashitu et kutonto", :gloss "and they stripped his tunic"} {:he "וישליכו", :translit "vayashlikhu", :gloss "and they cast [him]"} {:he "וימכרו", :translit "vayimkeru", :gloss "and they sold [him]"}], :mechanisms [{:kind :other, :note "Midah ke-neged midah: the three days of imprisonment correspond to three offenses the brothers committed against Joseph."}], :frame {:text "The brothers stripped Joseph of his tunic (Genesis 37:23), cast him into the pit (Genesis 37:24), and sold him to the Ishmaelites (Genesis 37:28). Joseph's action in Genesis 42:17 of imprisoning his brothers for three days is read as a measured response to these three acts, following the principle of measure for measure.", :sources ["Genesis 37:23" "Genesis 37:24" "Genesis 37:28" "Genesis 42:17"]}}], :arithmetic [{:kind :other, :note "Midah ke-neged midah: the three days of imprisonment correspond to three offenses the brothers committed against Joseph.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 42, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:15.446139697Z", :model "glm-5.2"}