{:tier :glm-5.2, :verse 8, :comments [{:quotes [{:he "לא הכירוהו", :translit "lo hiki'ruhu", :gloss "they did not recognize him"} {:he "ויראו אותו מרחוק ולא הכירוהו", :translit "va-yir'u oto merachoq va-lo hiki'ruhu", :gloss "and they saw him from afar and did not recognize him"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["לא הכירוהו" "ויראו אותו מרחוק ולא הכירוהו"]} {:kind :other, :note "Gezerah shavah linking the two occurrences via shared phrase לא הכירוהו"}], :frame {:text "The phrase ויראו אותו מרחוק ולא הכירוהו appears in Job 2:12, where Job's three friends see him from afar and do not recognize him because his suffering had so altered his appearance. Ba'al HaTurim draws a direct comparison: just as Job's friends failed to recognize him due to physical transformation from affliction, Joseph's brothers failed to recognize him due to his transformation from slave to viceroy of Egypt.", :sources ["Job 2:12" "Genesis 42:8"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["לא הכירוהו" "ויראו אותו מרחוק ולא הכירוהו"], :by :selah, :located [{:phrase "לא הכירוהו", :refs ["Genesis 42:8" "Job 2:12"], :n 2, :lens :plene-insensitive} {:phrase "ויראו אותו מרחוק ולא הכירוהו", :refs [], :n 0, :lens :plene-insensitive}]} {:kind :other, :note "Gezerah shavah linking the two occurrences via shared phrase לא הכירוהו", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 42, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:12.665622721Z", :model "glm-5.2"}