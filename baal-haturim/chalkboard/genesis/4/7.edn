{:tier :glm-5.2, :verse 7, :comments [{:quotes [{:he "תשוקתו", :translit "tishukato", :gloss "his longing"} {:he "אני לדודי ועלי תשוקתו", :translit "ani le-dodi ve-alai tishukato", :gloss "I am my beloved's and upon me is his longing"} {:he "ואליך תשוקתו", :translit "ve-eilekha tishukato", :gloss "and toward you is his longing"} {:he "אני לדודי ודודי לי ועלי תשוקתו", :translit "ani le-dodi ve-dodi li ve-alai tishukato", :gloss "I am my beloved's and my beloved is mine and upon me is his longing"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["תשוקתו" "אני לדודי ועלי תשוקתו"]}], :frame {:text "The rabbis identify two distinct longings denoted by the word תשוקה: the wicked's craving toward sin, anchored in Genesis 4:7 (ואליך תשוקתו), and God's longing upon Israel, anchored in Song of Songs 7:11 (אני לדודי ודודי לי ועלי תשוקתו). The Song of Songs verse is read allegorically: Israel declares devotion to God and God reciprocates with longing for Israel.", :sources ["Genesis 4:7" "Song of Songs 7:11"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["תשוקתו" "אני לדודי ועלי תשוקתו"], :by :selah, :located [{:phrase "תשוקתו", :refs ["Genesis 4:7" "Song of Songs 7:11"], :n 2, :lens :exact} {:phrase "אני לדודי ועלי תשוקתו", :refs ["Song of Songs 7:11"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 4, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:04:28.137237073Z", :model "glm-5.2"}