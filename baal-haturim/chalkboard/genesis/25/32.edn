{:tier :glm-5.2, :verse 32, :comments [{:quotes [{:he "ולמה זה", :translit "u'lama zeh", :gloss "and why this"} {:he "ולמה זה הבל תהבלו", :translit "u'lama zeh hevel tahavelu", :gloss "and why this would you deal falsely"} {:he "הבל", :translit "hevel", :gloss "futility"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["ולמה זה" "ולמה זה הבל תהבלו"]} {:kind :other, :note "Gezerah shavah linking two rare phrases sharing ולמה זה to draw a thematic parallel"}], :frame {:text "Esau's declaration in Genesis 25:32, 'הנה אנכי הולך למות, ולמה זה לי הבכורה' ('Look, I am going to die, so why this birthright to me?'), is read by the Sages as a denial of the afterlife and the resurrection of the dead — he saw no ultimate consequence to spiritual inheritance. The phrase 'הלך אחרי ההבל' echoes the language of Proverbs 5:6, 'פן תפלס ארח חיים... הלך לא ידעו ולא ידעה', and the term הבל (futility) connects to the wordplay of the second occurrence in Jeremiah.", :sources ["Genesis 25:32" "Proverbs 5:6" "Jeremiah 23:26"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["ולמה זה" "ולמה זה הבל תהבלו"], :by :selah, :located [{:phrase "ולמה זה", :refs ["Genesis 25:32" "2 Samuel 19:43" "Job 27:12"], :n 3, :lens :exact} {:phrase "ולמה זה הבל תהבלו", :refs ["Job 27:12"], :n 1, :lens :exact}]} {:kind :other, :note "Gezerah shavah linking two rare phrases sharing ולמה זה to draw a thematic parallel", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 25, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:08:07.501017475Z", :model "glm-5.2"}