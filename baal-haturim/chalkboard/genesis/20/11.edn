{:tier :glm-5.2, :verse 11, :comments [{:quotes [{:he "והרגוני", :translit "veheraguni", :gloss "and they will kill me"} {:he "והרגוני על דבר אשתי", :translit "veheraguni al dvar ishti", :gloss "and they will kill me on account of my wife"} {:he "והרגוני ושבו אל רחבעם", :translit "veheraguni veshavu el rechav'am", :gloss "and they will kill me and return to Rehoboam"} {:he "עו\"א", :translit "akum", :gloss "idol worshippers (עובדי כוכבים ומזלות)"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והרגוני על דבר אשתי" "והרגוני ושבו אל רחבעם"]}], :frame {:text "The phrase והרגוני ושבו אל רחבעם appears in the aftermath of Jeroboam's revolt against the house of David (1 Kings 12:27). Ba'al HaTurim reads the shared phrase והרגוני as linking Abraham's fear in Genesis 20:11 with Jeroboam's assessment of Israel in that generation. Abraham says there is no fear of God in this place, implying the people are like idolaters (Genesis 20:11). The spelling distinction—plene here, defective there—signals a qualitative difference between Abraham's contemporaries and Jeroboam's.", :sources ["Genesis 20:11" "1 Kings 12:27"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והרגוני על דבר אשתי" "והרגוני ושבו אל רחבעם"], :by :selah, :located [{:phrase "והרגוני על דבר אשתי", :refs ["Genesis 20:11"], :n 1, :lens :exact} {:phrase "והרגוני ושבו אל רחבעם", :refs ["1 Kings 12:27"], :n 1, :lens :plene-insensitive}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 20, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:07:00.224304701Z", :model "glm-5.2"}