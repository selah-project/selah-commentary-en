{:tier :glm-5.2, :verse 29, :comments [{:quotes [{:he "והורדתם", :translit "v'horadtem", :gloss "and you shall bring down"} {:he "והורדתם את אבי הנה", :translit "v'horadtem et avi henah", :gloss "and you shall bring down my father here"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["והורדתם" "והורדתם את אבי הנה"]}], :frame {:text "The parable of an animal being led to slaughter by first bringing its offspring appears in multiple rabbinic sources. In Leviticus Rabbah 22:8 a cow resists being led to slaughter until her calf is brought ahead of her, and the midrash applies this to Israel being drawn after their children. Genesis Rabbah 91:9 addresses Jacob's descent to Egypt: he was reluctant to leave the land until word of Joseph drew him down willingly.", :sources ["Leviticus Rabbah 22:8" "Genesis Rabbah 91:9"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["והורדתם" "והורדתם את אבי הנה"], :by :selah, :located [{:phrase "והורדתם", :refs ["Genesis 42:38" "Genesis 44:29" "Genesis 45:13" "1 Kings 1:33"], :n 4, :lens :exact} {:phrase "והורדתם את אבי הנה", :refs ["Genesis 45:13"], :n 1, :lens :exact}]}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 44, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:34.266084628Z", :model "glm-5.2"}