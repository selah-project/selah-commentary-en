{:tier :glm-5.2, :verse 6, :comments [{:quotes [{:he "וקציר", :translit "ve-katzir", :gloss "and harvest"} {:he "כל ימי הארץ זרע וקציר", :translit "kol y'mei ha-aretz zera ve-katzir", :gloss "all the days of the earth, seed and harvest"} {:he "זרע וקציר לא ישבותו", :translit "zera ve-katzir lo yishbotu", :gloss "seed and harvest shall not cease"} {:he "אשר אין חריש וקציר", :translit "asher ein charish ve-katzir", :gloss "which there is no plowing and harvest"} {:he "אולי לא נחיה עד שנקצור", :translit "ulai lo nichyeh ad she-niktzor", :gloss "perhaps we will not live until we harvest"}], :mechanisms [{:kind :masorah, :count 2, :occurrences ["וקציר" "זרע וקציר"]} {:kind :other, :note "Word substitution: חריש (plowing) replaces זרע (sowing) because Joseph's brothers feared they might not survive to harvest."}], :frame {:text "The verse Genesis 8:22 records God's postdiluvian decree: 'זרע וקציר וקור וחום וקיץ וחורף ויום ולילה לא ישבתו' — 'seedtime and harvest and cold and heat and summer and winter and day and night shall not cease.' Ba'al HaTurim reasons that Joseph could not have intended to announce a permanent cessation of agricultural cycles, since that would contradict the divine decree in Genesis 8:22. Rather, Joseph referred to the temporary absence of plowing during the famine years.", :sources ["Genesis 8:22" "Genesis 45:6"]}}], :arithmetic [{:kind :masorah, :count 2, :occurrences ["וקציר" "זרע וקציר"], :by :selah, :located [{:phrase "וקציר", :refs ["Genesis 8:22" "Genesis 45:6" "Ruth 2:23"], :n 3, :lens :exact} {:phrase "זרע וקציר", :refs ["Genesis 8:22"], :n 1, :lens :exact}]} {:kind :other, :note "Word substitution: חריש (plowing) replaces זרע (sowing) because Joseph's brothers feared they might not survive to harvest.", :by :selah, :ran? false}], :book :genesis, :voice :baal-haturim, :lang :en, :chapter 45, :discipline "bht-chalkboard-v1", :timestamp "2026-07-12T23:11:37.775366643Z", :model "glm-5.2"}